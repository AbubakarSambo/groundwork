 "report": {
  "id": "c0a922fa-f905-4eba-8e74-eae8b2b2f3c5",
  "releasedAt": null,
  "releasedSessions": [],
  "sharedPicture": "One of the five people has answered so far. Most report that the work is on track but that they are waiting for a decision from another team. One person has mentioned a target of 40 shops which is not in the record.\n\nWairimu Njoroge reported in the week of 9 November that the main piece of work is on track and that it is waiting for a decision from another team.\n\nAmani Wekesa reported in the week of 9 November that the main piece of work is on track and that it is waiting for a decision from another team.\n\nIn the week of 16 November, Chidi Okeke closed a deal with Naivas Thika for 40 cartons a week and a 450k deal with Kilele. Chidi is waiting for a buyer to reply.\n\nZawadi Mwangi reported in the week of 16 November that the main piece of work is on track and that it is waiting for a decision from another team.\n\nJuma Otieno reported in the week of 2 November that the main piece of work is on track and that it is waiting for a decision from another team.\n\nIn the week of 16 November, Neema Kamau met with three shops in Westlands. Neema mentioned a target of 40 shops, but the record shows zero progress against it.\n\nThe team's target is to add 40 new shops ordering each week. The progress of other team members is not clear from their reports.",
  "theOpening": "Most report that the work is on track but that they are waiting for a decision from another team. One person has mentioned a target of 40 shops which is not in the record.",
  "createdAt": "2026-11-20T07:58:27.290Z",
  "agreements": [
   "Every person on the team is waiting for a decision or a reply from someone outside the team."
  ],
  "divergences": [
   {
    "topic": "How progress against the team's target of 40 new shops a week is described.",
    "atStake": "If this difference in reporting holds, the team will not have a clear or accurate picture of its collective progress towards the quarterly target.",
    "evidence": [
     "Chidi Okeke's record for the week of 16 November shows a closed deal for 40 cartons a week with Naivas Thika.",
     "Wairimu Njoroge's record for the week of 9 November describes progress as being on track without specifics."
    ],
    "positions": [
     {
      "view": "Chidi Okeke reports closing a deal for 40 cartons a week with Naivas Thika and pursuing another with Quickmart.",
      "participantLabel": "Chidi Okeke"
     },
     {
      "view": "Wairimu Njoroge and other team members describe progress in general terms, stating that the work is on track without reporting specific new shops.",
      "participantLabel": "Wairimu Njoroge"
     }
    ],
    "settledBy": "Agree on a standard way to report progress each week that includes the number of shops closed and their value, and have each team member report in that format next week."
   }
  ]
