# API base URL (dev uses the Vite proxy at /api when unset)
VITE_API_URL=

# Where invite links point. Leave empty to use the page's own origin, which is right almost everywhere.
VITE_APP_URL=

# PostHog (optional analytics)
VITE_PUBLIC_POSTHOG_KEY=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
