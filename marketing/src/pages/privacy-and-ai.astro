---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.myground.work';
---
<!--
  PRIVACY AND AI.
  
  THIS COPY IS HAFSAH'S, VERBATIM. The only change made to it here is straight apostrophes in place
  of curly ones, because the build refuses curly quotes on every page (see the plain-punctuation
  check). Do not reword these three protections to match today's implementation: they are written
  with "may", which is a statement of what Groundwork is permitted to do, and narrowing them to
  what the code does this week is how a page stops saying what the company means.
  
  WHAT THE CODE OWES THIS PAGE is a separate document: PRIVACY-AND-AI-AUDIT.md, with a verdict and
  evidence per claim and the tests that keep each one true. If an audit finding ever contradicts a
  sentence here, the fix is the infrastructure. Nothing internal belongs on this page: no
  configurations, no project names, no credit arrangements, no provider tiers.
-->
<Layout title="Privacy and AI · Groundwork" description="Your team's work stays private. Groundwork staff have no way to read your check-ins in the product, and public AI models do not learn from your data." canonicalPath="/privacy-and-ai">
  <style>
    *,*::before,*::after{box-sizing:border-box}
    body{margin:0;overflow-x:hidden}
    .gw-nav-link{font-size:13px;font-weight:500;color:var(--gw-sub);background:none;border:none;cursor:pointer;padding:6px 11px;border-radius:6px;font-family:inherit;transition:all .15s;white-space:nowrap;text-decoration:none;display:inline-block;}
    .gw-nav-link:hover{background:var(--gw-paper-2);color:var(--gw-text);}
    .gw-btn-ghost{font-size:13px;font-weight:600;color:var(--gw-navy);background:none;border:1px solid var(--gw-blue-b);cursor:pointer;padding:7px 14px;border-radius:6px;font-family:inherit;white-space:nowrap;transition:background .15s;text-decoration:none;display:inline-block;}
    .gw-btn-ghost:hover{background:var(--gw-blue-bg);}
    .gw-btn-solid{font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border:none;cursor:pointer;padding:7px 14px;border-radius:6px;font-family:inherit;white-space:nowrap;transition:background .15s;text-decoration:none;display:inline-block;}
    .gw-btn-solid:hover{background:#1557A0;}
    .gw-footer-btn{font-size:12px;color:rgba(255,255,255,.38);background:none;border:none;cursor:pointer;font-family:inherit;text-decoration:none;}
    .gw-footer-btn:hover{color:rgba(255,255,255,.65);}
    .p-card{background:var(--gw-card);border:1px solid var(--gw-border);border-radius:12px;padding:22px 24px;}
    /* The drawn ring, at this page's smaller size. The kit is in global.css; only the
       measurements are this page's. A page about what nobody can read should still look like
       the rest of the site, which is now drawn. */
    .p-num{width:30px;height:30px;font-size:13px;}
    @media(max-width:620px){
      .gw-nav-links{display:none !important;}
    }
  </style>

  <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--gw-bg);min-height:100vh;color:var(--gw-text);">

    <Nav current="/privacy-and-ai" />

    <main style="max-width:600px;margin:0 auto;padding:56px 24px 80px;">
      <p style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--gw-navy);font-weight:700;margin-bottom:12px;">Privacy and AI</p>
      <h1 style="font-size:32px;font-weight:800;color:var(--gw-text);line-height:1.2;margin-bottom:16px;">Your team data is private.</h1>
      <!-- THE PAGE IN ONE SENTENCE, DRAWN. Three promises, and a reader decides here whether to
           read the three cards under them. Drawn rather than boxed for the same reason the home
           page's line is: this is a person saying what the product will not do. -->
      <div class="gw-drawn" style="margin-bottom:44px;">
        <span class="gw-bubble" aria-hidden="true"></span>
        <p style="font-size:16px;color:var(--gw-dark);line-height:1.7;margin:0;"><span class="gw-marker">Groundwork staff can't read it.</span> Public AI models don't learn from it. Groundwork gets better without exposing your organization.</p>
      </div>

      <div style="display:flex;flex-direction:column;gap:16px;margin-bottom:40px;">

        <div class="p-card">
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:12px;">
            <div class="p-num gw-drawn-num">1</div>
            <div style="font-size:17px;font-weight:700;color:var(--gw-text);">Your work stays private</div>
          </div>
          <p style="font-size:14px;color:var(--gw-sub);line-height:1.75;margin:0;">Groundwork staff cannot access your OKRs, check-ins, team performance, evidence, or underlying organizational data. We only see information you deliberately send to us, such as a complaint or support request.</p>
        </div>

        <div class="p-card">
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:12px;">
            <div class="p-num gw-drawn-num">2</div>
            <div style="font-size:17px;font-weight:700;color:var(--gw-text);">Public AI models do not learn from your data</div>
          </div>
          <p style="font-size:14px;color:var(--gw-sub);line-height:1.75;margin:0;">Groundwork may use leading AI providers to process information, including models from OpenAI, Anthropic (Claude), Google (Gemini), and others. We use protected API infrastructure and configurations where customer data is not used to train or improve these providers' public/general-purpose models. We do not intentionally submit customer data for their model training or fine-tuning.</p>
        </div>

        <div class="p-card">
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:12px;">
            <div class="p-num gw-drawn-num">3</div>
            <div style="font-size:17px;font-weight:700;color:var(--gw-text);">Groundwork can learn privately</div>
          </div>
          <p style="font-size:14px;color:var(--gw-sub);line-height:1.75;margin:0;">Groundwork may use permitted, privacy-preserving signals to improve Groundwork's own internal systems and models. That learning stays within Groundwork and is not contributed to OpenAI, Claude, Gemini, or other public AI models for training.</p>
        </div>


        <div class="p-card">
          <div style="display:flex;gap:14px;align-items:center;margin-bottom:12px;">
            <div class="p-num gw-drawn-num">4</div>
            <div style="font-size:17px;font-weight:700;color:var(--gw-text);">Where your answers are kept, and who reads them</div>
          </div>
          <p style="font-size:14px;color:var(--gw-sub);line-height:1.75;margin:0;">Your answers are stored on our servers. They are read by Google's models, which turn them into the record, the board and the reports. Nobody else reads your conversation. The people in a check-in see short lines taken from what you said, once the team's report is shared.</p>
        </div>

      </div>

      <div style="text-align:center;">
        <a class="gw-btn-solid" href={`${APP_URL}/start`} style="padding:13px 28px;font-size:14px;">Start a check-in for your team</a>
      </div>
    </main>

    <footer style="background:var(--gw-dark);padding:32px 24px;text-align:center;">
      <div style="display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:16px;">
        <svg width="18" height="14" viewBox="0 0 22 17" fill="none">
          <rect x="5"  y="0"  width="12" height="3" rx="1.5" fill="white" opacity="0.45"/>
          <rect x="2"  y="6"  width="18" height="3" rx="1.5" fill="white" opacity="0.72"/>
          <rect x="0"  y="12" width="22" height="3" rx="1.5" fill="white"/>
        </svg>
        <span style="font-size:14px;font-weight:700;color:rgba(255,255,255,.85);">Groundwork</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;margin-bottom:20px;">
        <a class="gw-footer-btn" href="/">Home</a>
        <a class="gw-footer-btn" href="/how-it-works">How it works</a>
        <a class="gw-footer-btn" href="/pricing">Pricing</a>
        <a class="gw-footer-btn" href="/privacy-and-ai">Privacy and AI</a>
        <a class="gw-footer-btn" href="/about">About</a>
      </div>
      <p style="font-size:11px;color:rgba(255,255,255,.2);margin:0;">&#169; 2026 Groundwork</p>
    </footer>

  </div>
</Layout>
