<script>
  /* The scenario picker. One report visible; the tab sets which. */
  var tabs = document.querySelectorAll('.tab');
  var cases = document.querySelectorAll('.case');
  tabs.forEach(function (t) {
    t.addEventListener('click', function () {
      tabs.forEach(function (x) { x.setAttribute('aria-selected', 'false'); });
      t.setAttribute('aria-selected', 'true');
      cases.forEach(function (c) { c.classList.toggle('on', c.dataset.case === t.dataset.tab); });
    });
  });

  /* Sections arrive as you reach them. Off entirely for anybody who has asked
     for reduced motion - the CSS only sets the start state inside that query. */
  if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { rootMargin: '0px 0px -10% 0px' });
    document.querySelectorAll('.fade').forEach(function (el) { io.observe(el); });
  } else {
    document.querySelectorAll('.fade').forEach(function (el) { el.classList.add('in'); });
  }
</script>
