<!-- ABOUT -->
<div id="lp-about" style="display:none">
  <div class="l-wrap-sm">
    <p class="l-sec-label">About</p>
    <h2 class="l-sec-h2">Built by people who kept running into the same problem.</h2>
    <div style="display:flex;flex-direction:column;gap:18px;margin-bottom:40px">
      <p style="font-size:15px;color:#4A5568;line-height:1.8">We kept discovering the same thing. Problems almost never started with bad people. They started because different people quietly believed different things, and nobody realised until it became expensive. Groundwork exists so leaders don't discover misalignment months after it starts.</p>
      <p style="font-size:15px;color:#4A5568;line-height:1.8">Real contribution went unseen. Real disagreements went unnamed. Because there was no place for each person to put down their own account and see where it matched everyone else's.</p>
      <p style="font-size:15px;color:#4A5568;line-height:1.8">Groundwork was built to be that place. Each person gives their own account. The report shows where they agree and where they don't. Nobody has to argue their version. The record does it.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:36px">
      <div style="padding:20px;background:#F5F3EF;border-radius:8px;border:1px solid #E2E0DB">
        <h3 style="font-size:14px;font-weight:700;color:#1A1916;margin-bottom:6px">The product</h3>
        <p style="font-size:12px;color:#6B6560;line-height:1.6">A private check-in for each person. One shared report. For two people or twenty.</p>
      </div>
      <div style="padding:20px;background:#F5F3EF;border-radius:8px;border:1px solid #E2E0DB">
        <h3 style="font-size:14px;font-weight:700;color:#1A1916;margin-bottom:6px">The company</h3>
        <p style="font-size:12px;color:#6B6560;line-height:1.6">Groundwork is an independent product. We built it because the tools that existed either captured one side of the picture or required everyone to be in the same room.</p>
      </div>
    </div>
    <div style="display:flex;flex-direction:column;gap:14px;margin-bottom:36px">
      <p style="font-size:15px;color:#4A5568;line-height:1.8">Built for the moments that matter most. Something starting. Someone stepping up. A team that needs to see the same picture again.</p>
      <p style="font-size:15px;color:#4A5568;line-height:1.8">Built for founders, managers, partners, and teams who would rather get aligned early than manage the fallout later.</p>
      <p style="font-size:15px;color:#4A5568;line-height:1.8">Built first for African leaders and the companies they run, and useful anywhere people start things together.</p>
    </div>
    <div style="display:grid;grid-template-columns:1fr;gap:16px;margin-bottom:36px">
      <div style="padding:20px;background:#F5F3EF;border-radius:8px;border:1px solid #E2E0DB">
        <h3 style="font-size:14px;font-weight:700;color:#1A1916;margin-bottom:6px">Our headquarters</h3>
        <p style="font-size:12px;color:#6B6560;line-height:1.6">Groundwork<br>9 Wendy Court, David Osieli Road<br>Westlands, Nairobi, Kenya</p>
      </div>
    </div>
    <div style="text-align:center">
      <p style="font-size:13px;color:#9B9590;margin-bottom:10px">Questions or feedback</p>
      <a href="mailto:hello@myground.work" style="font-size:15px;font-weight:700;color:#0C447C;text-decoration:none">hello@myground.work</a>
    </div>
  </div>
</div>

<!-- FOOTER -->
<footer class="l-footer">
  <div class="l-footer-inner">
    <div style="display:flex;align-items:center;gap:9px">
      <svg width="18" height="14" viewBox="0 0 22 17" fill="none">
        <rect x="5"  y="0"  width="12" height="3" rx="1.5" fill="#93C5FD" opacity="0.4"/>
        <rect x="2"  y="6"  width="18" height="3" rx="1.5" fill="#93C5FD" opacity="0.65"/>
        <rect x="0"  y="12" width="22" height="3" rx="1.5" fill="#93C5FD"/>
      </svg>
      <span style="font-size:13px;font-weight:700;color:white">Groundwork</span>
    </div>
    <div class="l-footer-links" style="display:flex;gap:20px">
      <button onclick="lNav('how')"      style="font-size:12px;color:rgba(255,255,255,.38);background:none;border:none;cursor:pointer;font-family:var(--font)">How it works</button>
      <button onclick="lNav('usecases')" style="font-size:12px;color:rgba(255,255,255,.38);background:none;border:none;cursor:pointer;font-family:var(--font)">Use cases</button>
      <button onclick="lNav('pricing')"  style="font-size:12px;color:rgba(255,255,255,.38);background:none;border:none;cursor:pointer;font-family:var(--font)">Pricing</button>
      <button onclick="lNav('about')"    style="font-size:12px;color:rgba(255,255,255,.38);background:none;border:none;cursor:pointer;font-family:var(--font)">About</button>
    </div>
    <div style="font-size:11px;color:rgba(255,255,255,.22)">© 2026 Groundwork</div>
  </div>
</footer>

</div><!-- /s-land -->

<script>
(function(){

var pages = ['home','how','usecases','pricing','about'];
window.lNav = function(p){
  pages.forEach(function(pg){
    var el = document.getElementById('lp-'+pg);
    if(el) el.style.display = pg===p?'block':'none';
  });
  document.querySelectorAll('.l-nav-link').forEach(function(b,i){
    b.classList.toggle('active', pages[i]===p);
  });
  /* INSTANT, not smooth. Smooth-scrolling to the top from four thousand pixels
     down takes seconds, during which the new page is already rendered above you
     and you are still looking at the old one going past. Changing page is not a
     scroll gesture. */
  window.scrollTo(0, 0);
};

/* Typewriter - prototype uses id=lt / id=lc but hero has static h1; skip */

/* Feed */
var items = [
  {t:'check-in',   c:'#5DCAA5', h:'Kwame completed session 3',     s:'Cofounder ground · technical record building'},
  {t:'confidence', c:'#93C5FD', h:'Ground confidence 3/5 to 4/5',  s:'Both parties active · cross-reference fired'},
  {t:'new ground', c:'#E8A94A', h:'Tarini opened a new ground',     s:'Head of Growth invited · starting mode'},
  {t:'report',     c:'#93C5FD', h:'Report generating',              s:'Both parties completed session 4'},
  {t:'signal',     c:'#5DCAA5', h:'Specificity increasing',         s:'Pattern signal · 3 consecutive sessions'},
  {t:'check-in',   c:'#5DCAA5', h:'Amara submitted her check-in',   s:'Contribution confirmed by downstream team'},
  {t:'resolved',   c:'#E8A94A', h:'Ground closed',                  s:'Alignment confirmed · both parties'},
  {t:'new ground', c:'#E8A94A', h:'New ground opened',              s:'Something new is starting · 2 parties'},
  {t:'check-in',   c:'#5DCAA5', h:'Priya completed session 2',      s:'Invisible contribution surfaced'},
  {t:'record',     c:'#93C5FD', h:'Resolution record written',      s:'Belongs to both parties permanently'},
  {t:'confidence', c:'#93C5FD', h:'Ground confidence: 5/5',         s:'Comprehensive evidence · full cross-reference'},
  {t:'check-in',   c:'#5DCAA5', h:'Ibrahim completed session 1',    s:'Cofounder ground · both accounts independent'},
];
var feed=document.getElementById('lf'),ecount=document.getElementById('lec');
var shown=[],idx=0,total=0;
function timeAgo(ms){var s=Math.floor(ms/1000);return s<60?s+'s ago':Math.floor(s/60)+'m ago';}
function addItem(){
  var it=items[idx%items.length];idx++;total++;
  var ts=Date.now(),d=document.createElement('div');d.className='l-feed-item';
  d.innerHTML='<div style="display:flex;align-items:center;justify-content:space-between;gap:8px">'+
    '<div style="display:flex;align-items:center;gap:6px">'+
    '<span style="font-size:9px;font-weight:700;padding:2px 6px;border-radius:3px;background:'+it.c+'22;color:'+it.c+';text-transform:uppercase;letter-spacing:.04em">'+it.t+'</span>'+
    '<span style="font-size:12px;font-weight:600;color:rgba(255,255,255,.85)">'+it.h+'</span></div>'+
    '<span class="lts" data-ts="'+ts+'" style="font-size:10px;color:rgba(255,255,255,.22);flex-shrink:0;white-space:nowrap">just now</span></div>'+
    '<div style="font-size:11px;color:rgba(255,255,255,.32);margin-top:2px">'+it.s+'</div>';
  shown.push({el:d,ts:ts});
  if(shown.length>4){
    var old=shown.shift();
    old.el.style.transition='opacity .3s';old.el.style.opacity='0';
    setTimeout(function(){if(old.el.parentNode)old.el.parentNode.removeChild(old.el);},320);
  }
  if(feed) feed.appendChild(d);
  if(ecount) ecount.textContent=total+' events';
}
function updTimes(){if(feed) feed.querySelectorAll('.lts').forEach(function(e){e.textContent=timeAgo(Date.now()-parseInt(e.dataset.ts));});}
if(feed){
  for(var k=0;k<3;k++) addItem();
  setInterval(addItem,3800);setInterval(updTimes,12000);
}

/* Stats */
var v=[12,3,47];
function flash(id,val,col){var e=document.getElementById(id);if(!e)return;e.textContent=val;e.style.color=col;setTimeout(function(){e.style.color='white';},700);}
setInterval(function(){var r=Math.random();if(r<.45){v[2]++;flash('ls3',v[2],'#5DCAA5');}else if(r<.7){v[0]++;flash('ls1',v[0],'#93C5FD');}else{v[1]++;flash('ls2',v[1],'#E8A94A');}},9000);

/* Cycling situations: fading paragraphs */
var sits=[
  "Clarity before commitment.",
  "Turn assumptions into agreements.",
  "See where people quietly disagree.",
  "Better decisions start with better ground."
];
var sitEl=document.getElementById('l-sit-text');
var sitIdx=0;
function cycleSit(){
  if(!sitEl) return;
  sitEl.style.opacity='0';
  setTimeout(function(){
    sitIdx=(sitIdx+1)%sits.length;
    sitEl.textContent=sits[sitIdx];
    sitEl.style.opacity='1';
  },650);
}
if(sitEl){ sitEl.textContent=sits[0]; setTimeout(function(){ sitEl.style.opacity='1'; },60); }
setInterval(cycleSit,5600);

/* Scroll fade */
var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add('in');});},{threshold:0.1});
document.querySelectorAll('.l-fade').forEach(function(el){obs.observe(el);});

})();
</script>

</body>
</html>
