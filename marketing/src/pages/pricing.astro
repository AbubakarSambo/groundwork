---
import Nav from '../components/Nav.astro';
import Layout from '../layouts/Layout.astro';
import { SERVICES } from '../site.mjs';
const APP_URL = import.meta.env.PUBLIC_APP_URL ?? 'https://app.myground.work';
---
<Layout title="Pricing · Groundwork" description="Teams of fewer than 20 people get 1 month free, WhatsApp included, no card required. Subscribe as your team grows. Unlimited sessions and reports on every plan." canonicalPath="/pricing">
  <style>
    *,*::before,*::after{box-sizing:border-box}
    body{margin:0;overflow-x:hidden}
    .gw-nav-link{font-size:13px;font-weight:500;color:var(--gw-sub);background:none;border:none;cursor:pointer;padding:6px 11px;border-radius:6px;font-family:inherit;transition:all .15s;white-space:nowrap;text-decoration:none;display:inline-block;}
    .gw-nav-link:hover{background:var(--gw-paper-2);color:var(--gw-text);}
    .gw-btn-ghost{font-size:13px;font-weight:600;color:var(--gw-navy);background:none;border:1px solid var(--gw-blue-b);cursor:pointer;padding:7px 14px;border-radius:6px;font-family:inherit;white-space:nowrap;transition:background .15s;text-decoration:none;display:inline-block;}
    .gw-btn-ghost:hover{background:var(--gw-blue-bg);}
    .gw-btn-solid{font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border:none;cursor:pointer;padding:7px 14px;border-radius:6px;font-family:inherit;white-space:nowrap;transition:background .15s;text-decoration:none;display:inline-block;}
    .gw-btn-solid:hover{background:#1557A0;}
    .gw-footer-btn{font-size:12px;color:rgba(255,255,255,.38);background:none;border:none;cursor:pointer;font-family:inherit;text-decoration:none;}
    .gw-footer-btn:hover{color:rgba(255,255,255,.65);}
    .plan-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:14px;margin-bottom:14px;}
    .plan-card{background:#fff;border:1px solid var(--gw-border);border-radius:12px;padding:22px 18px;display:flex;flex-direction:column;}
    .why-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:14px;}
    .why-card{background:#fff;border:1px solid var(--gw-border);border-radius:10px;padding:18px 18px;}
    .faq-item{border-bottom:1px solid var(--gw-border);padding:18px 0;}
    /* The DIY-vs-Guided compare. A grid rather than a table so the label can
       sit above its two answers on a narrow screen instead of being squeezed
       into a third of the width. */
    .del-row{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:12px;padding:12px 0;border-top:1px solid var(--gw-border);}
    .del-row:first-of-type{border-top:none;}
    .del-lbl{font-size:12.5px;font-weight:700;color:var(--gw-text);}
    .del-cell{font-size:12.5px;color:var(--gw-sub);line-height:1.6;}
    .del-head{font-size:11px;letter-spacing:.06em;text-transform:uppercase;font-weight:700;color:var(--gw-muted);}
    .faq-item:last-child{border-bottom:none;}
    @media(max-width:620px){
      .gw-nav-links{display:none !important;}
      .plan-grid{grid-template-columns:1fr;}
      .why-grid{grid-template-columns:1fr;}
      /* One column, and the column headings become inline labels on each cell
         so "DIY" and "Guided" are still attached to what they describe. */
      .del-row{grid-template-columns:1fr;gap:5px;}
      .del-head-row{display:none;}
      .del-cell::before{font-weight:700;color:var(--gw-text);}
      .del-cell.diy::before{content:'DIY: ';}
      .del-cell.guided::before{content:'Guided: ';}
    }
  </style>

  <div style="font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;background:var(--gw-bg);min-height:100vh;color:var(--gw-text);">

    <Nav current="/pricing" />

    <main style="max-width:760px;margin:0 auto;padding:56px 24px 80px;">

      <!-- Header -->
      <p style="font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--gw-navy);font-weight:700;margin-bottom:12px;">Pricing</p>
      <h1 style="font-size:34px;font-weight:800;color:var(--gw-text);line-height:1.2;margin-bottom:16px;">Pricing</h1>
      <p style="font-size:16px;color:var(--gw-sub);line-height:1.7;margin-bottom:44px;max-width:520px;">Teams of fewer than 20 people get 1 month free, WhatsApp included, no card required. Subscribe as your team grows. Unlimited sessions and reports on every plan.</p>

      <!-- The free month (fix list item 6; the light prototype's s74, word for word): one month, WhatsApp included, no card. -->
      <div style="background:var(--gw-paper);border:2px solid var(--gw-navy);border-radius:12px;padding:24px 26px;margin-bottom:40px;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap;">
        <div style="flex:1;min-width:220px;">
          <div style="display:flex;align-items:baseline;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
            <span style="font-size:15px;font-weight:700;color:var(--gw-text);">1 month free</span>
            <span style="font-size:12px;color:var(--gw-muted);">Teams of fewer than 20 people</span>
          </div>
          <p style="font-size:13.5px;color:var(--gw-sub);line-height:1.65;margin:0 0 12px;">Everything on every plan, WhatsApp included, free for your first month. No card required. Unlimited check-ins, sessions and reports.</p>
          <ul style="font-size:12.5px;color:var(--gw-sub);padding-left:18px;margin:0 0 12px;line-height:1.9;">
            <li>1 month</li>
            <li>WhatsApp included</li>
            <li>Fewer than 20 people</li>
            <li>Unlimited check-ins</li>
            <li>Unlimited sessions</li>
            <li>Unlimited reports</li>
          </ul>
          <p style="font-size:12.5px;color:var(--gw-muted);margin:0;">After your free month, subscribe to keep going. Teams of 20 or more start on a plan.</p>
        </div>
        <div style="text-align:right;flex-shrink:0;">
          <div style="font-size:30px;font-weight:800;color:var(--gw-text);">$0</div>
          <div style="font-size:12px;color:var(--gw-muted);">for 1 month</div>
          <a class="gw-tap" href={`${APP_URL}/auth?mode=signup`} style="display:inline-block;margin-top:12px;font-size:12px;font-weight:600;color:#fff;background:var(--gw-navy);border-radius:7px;padding:6px 14px;text-decoration:none;">Start your free month</a>
        </div>
      </div>

      <!-- Org subscriptions -->
      <h2 style="font-size:20px;font-weight:800;color:var(--gw-text);margin-bottom:8px;">Subscribe as your team grows</h2>
      <p style="font-size:14px;color:var(--gw-sub);line-height:1.65;margin-bottom:24px;">Every person with a Groundwork account counts as a seat. Each plan includes a number of seats; add more any time for +$5 a seat a month. Unlimited check-ins, sessions and reports.</p>

      <div class="plan-grid">
        <div class="plan-card">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:4px;">Starter</div>
          <div style="font-size:26px;font-weight:800;color:var(--gw-navy);margin-bottom:2px;">$25<span style="font-size:13px;font-weight:500;color:var(--gw-muted);">/mo</span></div>
          <div style="font-size:12px;color:var(--gw-muted);margin-bottom:12px;">5 seats included<br /><b>+$5 per extra seat</b><br />WhatsApp: +$4 a month per person who uses it</div>
          <p style="font-size:12px;color:var(--gw-sub);line-height:1.6;flex-grow:1;margin-bottom:16px;">For small teams getting each person's own account on the record.</p>
          <a class="gw-tap" href={`${APP_URL}/billing`} style="display:block;text-align:center;font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border-radius:8px;padding:9px;text-decoration:none;">Subscribe</a>
        </div>
        <div class="plan-card">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:4px;">Small Team</div>
          <div style="font-size:26px;font-weight:800;color:var(--gw-navy);margin-bottom:2px;">$90<span style="font-size:13px;font-weight:500;color:var(--gw-muted);">/mo</span></div>
          <div style="font-size:12px;color:var(--gw-muted);margin-bottom:12px;">20 seats included<br /><b>+$5 per extra seat</b><br />WhatsApp: +$4 a month per person who uses it</div>
          <p style="font-size:12px;color:var(--gw-sub);line-height:1.6;flex-grow:1;margin-bottom:16px;">For growing teams running multiple check-ins at once.</p>
          <a class="gw-tap" href={`${APP_URL}/billing`} style="display:block;text-align:center;font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border-radius:8px;padding:9px;text-decoration:none;">Subscribe</a>
        </div>
        <div class="plan-card">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:4px;">Growth</div>
          <div style="font-size:26px;font-weight:800;color:var(--gw-navy);margin-bottom:2px;">$400<span style="font-size:13px;font-weight:500;color:var(--gw-muted);">/mo</span></div>
          <div style="font-size:12px;color:var(--gw-muted);margin-bottom:12px;">100 seats included<br /><b>+$5 per extra seat</b><br />WhatsApp: +$4 a month per person who uses it</div>
          <p style="font-size:12px;color:var(--gw-sub);line-height:1.6;flex-grow:1;margin-bottom:16px;">For organizations running Groundwork across departments or client groups.</p>
          <a class="gw-tap" href={`${APP_URL}/billing`} style="display:block;text-align:center;font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border-radius:8px;padding:9px;text-decoration:none;">Subscribe</a>
        </div>
        <div class="plan-card">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:4px;">Business</div>
          <div style="font-size:26px;font-weight:800;color:var(--gw-navy);margin-bottom:2px;">$900<span style="font-size:13px;font-weight:500;color:var(--gw-muted);">/mo</span></div>
          <div style="font-size:12px;color:var(--gw-muted);margin-bottom:12px;">250 seats included<br /><b>+$5 per extra seat</b><br />WhatsApp: +$4 a month per person who uses it</div>
          <p style="font-size:12px;color:var(--gw-sub);line-height:1.6;flex-grow:1;margin-bottom:16px;">For larger organizations with multiple teams and check-ins in flight.</p>
          <a class="gw-tap" href={`${APP_URL}/billing`} style="display:block;text-align:center;font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border-radius:8px;padding:9px;text-decoration:none;">Subscribe</a>
        </div>
        <div class="plan-card">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:4px;">Scale</div>
          <div style="font-size:26px;font-weight:800;color:var(--gw-navy);margin-bottom:2px;">$1,650<span style="font-size:13px;font-weight:500;color:var(--gw-muted);">/mo</span></div>
          <div style="font-size:12px;color:var(--gw-muted);margin-bottom:12px;">500 seats included<br /><b>+$5 per extra seat</b><br />WhatsApp: +$4 a month per person who uses it</div>
          <p style="font-size:12px;color:var(--gw-sub);line-height:1.6;flex-grow:1;margin-bottom:16px;">For organizations running Groundwork across many teams at once.</p>
          <a class="gw-tap" href={`${APP_URL}/billing`} style="display:block;text-align:center;font-size:13px;font-weight:700;color:#fff;background:var(--gw-navy);border-radius:8px;padding:9px;text-decoration:none;">Subscribe</a>
        </div>
      </div>

      <!-- WhatsApp, explained once (the light prototype's s74, word for word). -->
      <div style="background:var(--gw-paper);border:1px solid var(--gw-border);border-radius:12px;padding:20px 24px;margin-bottom:24px;">
        <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">WhatsApp check-ins, on any plan</div>
        <p style="font-size:13px;color:var(--gw-sub);line-height:1.65;margin:0;">Your team can check in on WhatsApp instead of the app. You pay only for people who use it: $4 a person a month, on any plan, never more than your seats. It’s included in your free month.</p>
      </div>

      <!-- Enterprise -->
      <div style="background:var(--gw-dark);border-radius:12px;padding:22px 26px;margin-bottom:48px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;">
        <div>
          <div style="font-size:15px;font-weight:700;color:#fff;margin-bottom:6px;">Enterprise</div>
          <p style="font-size:13px;color:rgba(255,255,255,.6);line-height:1.6;margin:0;">For organizations with custom needs, volume pricing, or dedicated support.</p>
        </div>
        <!-- The Enterprise tier's only control, and it was a mailto too. Same fix, and it arrives
             already saying which conversation this is. -->
        <a class="gw-tap" href={`${APP_URL}/talk-to-us?about=other`} style="font-size:13px;font-weight:700;color:#fff;border:1px solid rgba(255,255,255,.3);border-radius:8px;padding:9px 20px;text-decoration:none;white-space:nowrap;">Contact us</a>
      </div>

      <!--
        RUN IT YOURSELF, OR WITH SUPPORT.
        
        What sat here was a DIY-versus-Guided comparison table, a note about booking two sessions
        back to back, a block about how a coach is chosen, and a second heading introducing the same
        three cards a second time. Removed on Hafsah's instruction, and the reason is worth keeping:
        it explained the shape of an offer at length before showing what any of it costs. The three
        cards below say what the things are and what they cost, which is what somebody on a pricing
        page is there for.
      -->
      <h2 style="font-size:20px;font-weight:800;color:var(--gw-text);margin-bottom:8px;">Run it yourself, or with support</h2>
      <p style="font-size:14px;color:var(--gw-sub);line-height:1.65;margin-bottom:22px;">The plans above are the software, and most teams run it on their own. These three are for when you would rather not: a coach in the room, somebody to set you up, or an engineer to connect it to the tools you already use.</p>

      <div class="why-grid" style="margin-bottom:16px;">
        <div class="why-card">
          <div style="font-size:13px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">A coach in the room</div>
          <p style="font-size:26px;font-weight:800;color:var(--gw-text);margin:0 0 2px;">{SERVICES.coachingPerMonth} per month</p>
          <p style="font-size:12px;color:var(--gw-muted);margin:0 0 8px;">or {SERVICES.coachingRetainer} a year for twelve sessions</p>
          <p style="font-size:12.5px;color:var(--gw-sub);line-height:1.65;margin:0 0 6px;">A coach reads the report with your team and turns what it found into a decision somebody owns.</p>
          <p style="font-size:12.5px;color:var(--gw-sub);line-height:1.65;margin:0;">The annual plan is {SERVICES.coachingMonthly} a month for twelve sessions, held by a team, attached to one scenario, or belonging to one person. You can take it a month at a time instead.</p>
        </div>
        <div class="why-card">
          <div style="font-size:13px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">Setting you up</div>
          <p style="font-size:26px;font-weight:800;color:var(--gw-text);margin:0 0 2px;">{SERVICES.setupMonthly} a month</p>
          <p style="font-size:12px;color:var(--gw-muted);margin:0 0 8px;">two two-hour sessions a month</p>
          <p style="font-size:12.5px;color:var(--gw-sub);line-height:1.65;margin:0 0 6px;">We reach out to support your teams, and they book the time that suits them.</p>
          <p style="font-size:12.5px;color:var(--gw-sub);line-height:1.65;margin:0;">Opt in a month at a time, for as long as it is useful.</p>
        </div>
        <div class="why-card">
          <div style="font-size:13px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">Integration support</div>
          <p style="font-size:26px;font-weight:800;color:var(--gw-text);margin:0 0 2px;">{SERVICES.integrationSupport}</p>
          <p style="font-size:12px;color:var(--gw-muted);margin:0 0 8px;">one dedicated engineer, for a month</p>
          <p style="font-size:12.5px;color:var(--gw-sub);line-height:1.65;margin:0 0 6px;">One of our engineers works with your team to embed Groundwork in the tools you already use.</p>
          <p style="font-size:12.5px;color:var(--gw-sub);line-height:1.65;margin:0;">Pick the month your team has the time.</p>
        </div>
      </div>

      <div style="background:var(--gw-blue-bg);border-left:3px solid var(--gw-navy);border-radius:0 8px 8px 0;padding:16px 20px;margin-bottom:48px;">
        <p style="font-size:13px;color:var(--gw-sub);line-height:1.75;margin:0 0 8px;">All three start with a call, and none of them is charged to a card. Subscribe first, ask from inside the product, and we will tell you the number before anybody starts. What you agree is invoiced by us afterwards.</p>
        <!--
          A BUTTON, NOT AN UNDERLINED PHRASE. This is the only way to buy any of the three things
          above, and it was styled as a footnote in the same weight as the sentence before it. If
          asking for a call is the action the section exists for, it has to look like the action.
        -->
        <!--
          A FORM, NOT A MAILTO. This was `mailto:hello@myground.work`, which does nothing at all for
          anybody without a configured mail client - so the only route to the one thing on this page
          you cannot self-serve was a link that appeared broken. The audit said it plainly: no form,
          nothing captured, nothing followed up. It now opens a request that lands in the back
          office and sends a confirmation.
        -->
        <a href={`${APP_URL}/talk-to-us`} style="display:inline-block;background:var(--gw-navy);color:#fff;font-size:14px;font-weight:700;padding:11px 22px;border-radius:7px;text-decoration:none;margin-top:4px;">Request a call &#8594;</a>
      </div>

      <!-- FAQ -->
      <h2 style="font-size:20px;font-weight:800;color:var(--gw-text);margin-bottom:8px;">Common questions</h2>
      <p style="font-size:14px;color:var(--gw-sub);margin-bottom:24px;">Answers to what most people ask before they start.</p>

      <div style="margin-bottom:48px;">
        <div class="faq-item">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">What counts as a "person" on my plan?</div>
          <p style="font-size:13px;color:var(--gw-sub);line-height:1.65;margin:0;">Every person with a Groundwork account in your organization counts, whether they create check-ins or just take part in them. Guests with no account do not count.</p>
        </div>
        <div class="faq-item">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">Do I need a card to start?</div>
          <p style="font-size:13px;color:var(--gw-sub);line-height:1.65;margin:0;">No. Teams of fewer than 20 people get their first month free, with no payment details. You add a card when you subscribe, before the free month ends, or straight away if your team is 20 or more.</p>
        </div>
        <div class="faq-item">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">Can I cancel a subscription at any time?</div>
          <p style="font-size:13px;color:var(--gw-sub);line-height:1.65;margin:0;">Yes. Cancel from the billing page and your subscription ends at the close of the billing period. No penalties, no questions.</p>
        </div>
        <div class="faq-item">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">What happens to my check-ins and reports if I cancel?</div>
          <p style="font-size:13px;color:var(--gw-sub);line-height:1.65;margin:0;">Nothing is deleted. Your reports and history stay on your account. You can read everything that happened. Check-ins pause until you subscribe again.</p>
        </div>
        <div class="faq-item">
          <div style="font-size:14px;font-weight:700;color:var(--gw-text);margin-bottom:6px;">Does every participant need to pay?</div>
          <p style="font-size:13px;color:var(--gw-sub);line-height:1.65;margin:0;">No. Billing is at the organization level, based on your team size. Participants who have a Groundwork account count as a seat. External participants without an account do not.</p>
        </div>
      </div>

      <!-- 7b: a visitor can arrive on pricing from a search and never see the
           homepage. One line, so they know what they would be buying. -->
      <div style="background:var(--gw-paper);border:1px solid var(--gw-border);border-radius:10px;padding:18px 20px;margin-bottom:8px;">
        <p style="font-size:14px;color:var(--gw-sub);line-height:1.75;margin:0;">Every plan works the same way: each person gives their own account, privately. Nobody is scored, ranked or watched, and no one sees anyone else's raw answers.</p>
      </div>

      <div style="text-align:center;padding:36px 28px;">
        <a class="gw-btn-solid" href={`${APP_URL}/start`} style="padding:11px 24px;font-size:14px;">Start a check-in for your team, free</a>
      </div>

    </main>

    <footer style="background:var(--gw-dark);padding:32px 24px;text-align:center;">
      <div style="display:flex;align-items:center;justify-content:center;gap:9px;margin-bottom:16px;">
        <svg width="18" height="14" viewBox="0 0 22 17" fill="none">
          <rect x="5"  y="0"  width="12" height="3" rx="1.5" fill="white" opacity="0.45"/>
          <rect x="2"  y="6"  width="18" height="3" rx="1.5" fill="white" opacity="0.72"/>
          <rect x="0"  y="12" width="22" height="3" rx="1.5" fill="white"/>
        </svg>
        <span style="font-size:14px;font-weight:700;color:rgba(255,255,255,.85);">Groundwork</span>
      </div>
      <div style="display:flex;align-items:center;justify-content:center;gap:16px;flex-wrap:wrap;margin-bottom:20px;">
        <a class="gw-footer-btn" href="/">Home</a>
        <a class="gw-footer-btn" href="/how-it-works">How it works</a>
        <a class="gw-footer-btn" href="/pricing">Pricing</a>
        <a class="gw-footer-btn" href="/privacy-and-ai">Privacy and AI</a>
        <a class="gw-footer-btn" href="/about">About</a>
      </div>
      <p style="font-size:11px;color:rgba(255,255,255,.2);margin:0;">&#169; 2026 Groundwork</p>
    </footer>

  </div>
</Layout>
