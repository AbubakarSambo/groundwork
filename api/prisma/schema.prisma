  groundId        String?  @map("ground_id")
  /// What the notes were built from, so the same record again writes nothing.
  inputKey        String?  @map("input_key")
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, roleName])
  @@map("role_gap_notes")
}

/// A REQUEST TO SPEND (E7, the spending and budgets suite, U.17): who asks, how much, for what, and
/// the team it counts against (the person's department when they asked). Waiting until the one who
/// approves it says yes or no; kept with who decided and when. People ask by telling Groundwork, which
/// is the engine's part (docs/requests-to-engine.md, request 26). Who reads and decides it is decided
/// in suites/the-spending.service.ts. Nothing here reaches a check-in or its report.
model SpendRequest {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  userId         String    @map("user_id")
  amount         Decimal   @db.Decimal(14, 2)
  what           String    @db.VarChar(300)
  team           String?   @db.VarChar(120)
  status         String    @default("waiting") @db.VarChar(16)
  decidedById    String?   @map("decided_by_id")
  decidedAt      DateTime? @map("decided_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  /// The approval step it is on, from 0 (decision 85, build step 4). Today's answers have one step.
  step           Int       @default(0)
  /// How far down that step's list of rules it has been passed on, from 0.
  escalatedTo    Int       @default(0) @map("escalated_to")
  /// When it started waiting at this step, or for the person it was passed to. Null: since it was asked.
  stepSince      DateTime? @map("step_since")
  /// Who approved each step so far, in order, by sign-in.
  approvedByIds  String[]  @default([]) @map("approved_by_ids")
  /// The category the admin named that it is for ("Fuel", a project), when the spending rules have
  /// categories (decision 85, build step 9). Empty with none set, and on every request kept before.
  category       String?   @db.VarChar(40)
  /// The evidence the rules asked for when it was asked: "receipt", "quote", or both. Only that it is
  /// needed; no file is kept. Empty when none was needed.
  evidenceNeeded String[]  @default([]) @map("evidence_needed")
  /// The reason the person who declined it gave, in their words, told to the person who asked
  /// (decision 85, build step 9, as leave has). Empty when none was given, and on every request before.
  declineReason  String?   @map("decline_reason") @db.Text
  /// FINANCE'S PART, after the last approval (decision 85, build step 10). Whoever looks after finance
  /// checks it (verified), records the budget line it is paid from (code), and marks it paid with the
  /// day it was paid. Each step is also in `suite_events`, with who and when. All empty on every request
  /// kept before, and on any request finance has not touched.
  verifiedById   String?   @map("verified_by_id")
  verifiedAt     DateTime? @map("verified_at")
  /// The budget line or category finance records it under, in finance's own words.
  code           String?   @db.VarChar(80)
  /// The day it was paid, as finance says it.
  paidOn         DateTime? @map("paid_on") @db.Date
  paidById       String?   @map("paid_by_id")
  /// The evidence finance has had: "receipt", "quote". Only that it was given; no file is kept.
  evidenceGiven  String[]  @default([]) @map("evidence_given")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("spend_requests")
}

/// ONE TEAM'S BUDGET FOR ONE MONTH (E7, U.17), set by an admin. `month` is the first day of it.
model TeamBudget {
  id             String   @id @default(uuid())
