// Groundwork — contribution intelligence platform
// Core unit is a "Ground" (an alignment ground): one situation, two parties,
// building toward one defined decision. See README for the product model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // manages grounds, billing activation, sees the alignment feed
  MEMBER // a regular person who checks in
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_SETUP
  PASSWORD_RESET
  PARTICIPANT_INVITE // magic link for a participant added to a ground
}

enum CareFeeStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELLED
}

// The six entry states collapse into the scenario the initiator selects.
enum GroundScenario {
  NEW_HIRE
  NEW_COFOUNDER
  NEW_ADVISOR
  NEW_PROJECT
  NEW_MANAGER
  CONTRACT_RENEWAL
  RECOGNITION
  DRIFT
  CRISIS_ALIGNMENT
  OKR_ALIGNMENT
  WORKPLAN_BUDGET
  PULSE_CHECK
  REALIGN_TEAM
  PIP
  BOARD_STRATEGY
  COHORT_CHECK
  ACUTE_SHOCK // a jarring event just happened; build the shared picture before any decision
  /// The honest default when a described situation matches no card.
  ///
  /// Before this, "Describe your own situation" carried REALIGN_TEAM in its card config, so a routing
  /// failure silently produced a "get a team back on the same page" ground - with that scenario's
  /// board, questions and end states - while telling the person they were getting "a general ground
  /// where each person gives their own read privately". For a cohort of managers who never work
  /// together that is the wrong shape entirely, and nothing said so.
  ///
  /// This is that general ground, existing in its own right rather than borrowed.
  OPEN_READ
}

//
// PRIVATE (alignment) or SHARED (delivery). Chosen at creation, shown on every
// surface, NEVER switchable.
//
// Why immutable: if a ground could flip from private to shared, a participant
// who checked in believing their account was private would have it exposed.
// That is the worst possible failure for a trust product. Enforced at the data
// layer (updateTimeline and every other update path must reject a mode change)
// and guarded by a test that bites.
//
// PRIVATE: accounts are never visible to other parties. Output is the alignment
// report only. This is the product as it was before the board existed.
// SHARED: extracted, attributed entries feed a board everyone on the ground can
// read. Each person still ALSO has their own private report; the board is an
// additional surface, not a replacement.
//
enum GroundMode {
  PRIVATE
  SHARED
}

// Three moments from the conversation design.
enum GroundMoment {
  STARTING
  RECOGNITION
  RESOLUTION
}

enum GroundStatus {
  /// A member created this and an org admin has not accepted it yet. Nothing has
  /// been invited and no check-in can open: the approval is worthless if anybody
  /// has already been asked to take part. Admin-created grounds skip this.
  AWAITING_APPROVAL
  AWAITING_LEAD // admin created this for a lead; lead invited but has not confirmed yet
  OPEN // created, parties may not all be added
  AWAITING_PARTIES // waiting on check-ins
  REPORT_READY // legacy: report was ready but ground awaited manual billing activation. No longer written (since 60ce541, 2026-06-24) - report release now auto-activates straight to ACTIVE (reports.listener.ts). Retained for legacy rows + readers.
  ACTIVE // admin activated -> billing running
  PAUSED // temporarily paused (e.g. active legal proceedings detected)
  RESOLVED // both confirmed an end state
  STALLED // full period elapsed with no resolution
  CLOSED // permanent record, billing stopped
}

enum PartyType {
  INITIATOR // opened the ground
  PARTICIPANT // added by the initiator; never sees the initiator's record
}

enum CheckInStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLINED // willingness gate answered no — itself a useful record
}

enum TurnRole {
  AI
  PERSON
}

// Structured data extracted from a check-in. Belongs to the person.
enum RecordEntryType {
  SUCCESS_DEFINITION
  TIMEFRAME
  COMMITMENT
  ASK
  INTENT
  TOLERANCE
  WORRY
  TENSION
}

// Three-period rule: CANDIDATE until observed in 3 consecutive periods.
enum PatternStatus {
  CANDIDATE
  SURFACED
}

enum Cadence {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  SEQUENTIAL // no fixed schedule: the initiator's check-in opens the team's next round
  ONE_TIME // a single check-in, no follow-up round ever scheduled
}

enum BillingEventType {
  CARE_FEE         // $25/month/account (platform fee)
  PARTICIPANT_FEE  // $25/unique participant/month across active grounds
  SESSION_FEE      // $5 per additional session
  SUBSCRIPTION_FEE // org subscription (Starter/SmallTeam/Growth/Business/Enterprise)
  FREE_EXTENSION   // one-time free session extension per org
}

enum SubscriptionPlan {
  STARTER     // up to 5 people, $25/mo
  SMALL_TEAM  // up to 20 people, $50/mo
  GROWTH      // up to 100 people, $100/mo
  BUSINESS    // up to 250 people, $200/mo
  SCALE       // up to 1,000 people, $400/mo
  ENTERPRISE  // unlimited, contact sales
}

enum EvidenceType {
  DOCUMENT_AT_AGREEMENT
  DOCUMENT_AFTER
  CHECK_IN
  ANCHORED_RECALL
  UNANCHORED_RECALL
}

enum BillingEventStatus {
  PENDING
  PAID
  FAILED
}

enum CompanyStage {
  IDEA
  PRE_REVENUE
  EARLY_REVENUE
  SCALING
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  email     String?

  // Billing (Stripe, USD). Care fee is the always-on commitment device.
  stripeCustomerId       String?       @map("stripe_customer_id")
  careFeeStatus          CareFeeStatus @default(NONE) @map("care_fee_status")
  careFeeSubscriptionId  String?       @map("care_fee_subscription_id")
  defaultPaymentMethodId String?       @map("default_payment_method_id")
  gracePeriodUntil       DateTime?     @map("grace_period_until")
  freeSessionsUsed   Int     @default(0)     @map("free_sessions_used")
  firstGroundUsed    Boolean @default(false) @map("first_ground_used")
  freeExtensionUsed  Boolean @default(false) @map("free_extension_used")
  allowCodeCreation  Boolean @default(false) @map("allow_code_creation")
  // Exists in the database, referenced nowhere in the codebase. Declared here
  // so the schema matches reality; removing it should be a deliberate decision
  // with a migration of its own, not a side effect of a drift fix.
  contributorBypass  Boolean @default(false) @map("contributor_bypass")

  // Org subscription
  subscriptionPlan      SubscriptionPlan? @map("subscription_plan")
  subscriptionStatus    String?           @map("subscription_status") // active | paused | cancelled
  subscriptionStripeId  String?           @map("subscription_stripe_id")
  subscriptionPeriodEnd DateTime?         @map("subscription_period_end")

  companyStage CompanyStage? @map("company_stage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  grounds          Ground[]
  billingEvents    BillingEvent[]
  orgIntelligence  OrgIntelligence[]
  contributorCodes ContributorCode[]

  @@map("organizations")
  styleProfiles PersonStyleProfile[]
  memberships    OrganizationMembership[]
}

model User {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  email           String   @unique
  passwordHash    String?  @map("password_hash")
  firstName       String   @map("first_name")
  lastName        String   @map("last_name")
  jobTitle        String?  @map("job_title")
  role            UserRole @default(MEMBER)
  isActive        Boolean  @default(true) @map("is_active")
  isEmailVerified Boolean  @default(false) @map("is_email_verified")
  isPlatformAdmin      Boolean  @default(false) @map("is_platform_admin")
  googleId             String?  @unique @map("google_id")
  emailNotifications   Boolean  @default(true) @map("email_notifications")
  // E.164 format (e.g. "+2348012345678"). Global uniqueness - one Groundwork
  // WhatsApp number serves everyone, so a phone number identifies exactly one
  // account, not one per org. Set by the user in Settings, or by an
  // admin/HR adding it on someone's behalf via the org roster.
  phoneNumber          String?  @unique @map("phone_number")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokens                   EmailVerificationToken[]
  groundsInitiated         Ground[]                   @relation("GroundInitiator")
  participantLinks         GroundParticipant[]
  adminProfile             AdminProfile?
  contributorCodes         ContributorCode[]          @relation("ContributorCodes")
  redeemedCodes            ContributorCode[]          @relation("RedeemedCodes")
  codeRedemptions          ContributorCodeRedemption[] @relation("CodeRedemptions")
  entryDraft               EntryDraft?

  @@index([organizationId])
  @@map("users")
  styleProfiles PersonStyleProfile[]
  memberships     OrganizationMembership[]
}

// ---------------------------------------------------------------------------
// Server-side draft of an anonymous entry session, written the moment the
// person gives their email (POST /auth/entry-save) - the ISSUE-17 consent
// moment. Makes the post-verification commit independent of which browser
// opens the magic link: before this, the transcript and commit metadata lived
// only in the originating browser's localStorage, and a link opened anywhere
// else silently skipped the commit (the ground "vanished").
// One live draft per user (upserted). draftToken authorizes pre-auth updates
// from the entry page (org name, contributors typed after the email was
// sent). consumedAt + groundId make commit idempotent.
// ---------------------------------------------------------------------------
// A signup that has been asked for but not yet proved.
//
// NOTHING IS PROVISIONED UNTIL THE ADDRESS IS VERIFIED. Before this model
// existed, submitting an email on the entry flow's save panel immediately created
// a User with role ADMIN and an Organization, both live, with
// `is_email_verified = false`. Typing a stranger's work address provisioned an
// organisation and an admin account in their name, and they learned about it only
// if they happened to read the activation mail.
//
// Everything the signup needs now waits here - the address, the person's name,
// the organisation name if they typed one, and the whole anonymous session
// transcript - keyed to the verification token. The Organization, the User and
// the EntryDraft are created in one transaction when, and only when, the link in
// the mail is opened.
//
// `email` is unique so a second attempt refreshes the pending record rather than
// stacking duplicates. It is deliberately NOT a foreign key to anything: a
// pending signup is not yet a member of anything.
//
// See GW-001 in journey/run18/ISSUES-LOG.md.
model PendingSignup {
  id         String   @id @default(uuid())
  email      String   @unique
  token      String   @unique
  firstName  String   @map("first_name")
  orgName    String?  @map("org_name")
  // The anonymous session, carried verbatim so the ground can be built after
  // verification from any browser - not only the one that started it.
  payload    Json?
  history    Json?
  // The draft token the entry page keeps, so post-email edits (the org name
  // arrives this way) can still reach this record before there is a user.
  draftToken String?  @unique @map("draft_token")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("pending_signups")
}

model EntryDraft {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  draftToken String    @unique @map("draft_token")
  payload    Json
  history    Json
  consumedAt DateTime? @map("consumed_at")
  groundId   String?   @map("ground_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entry_drafts")
}

// ---------------------------------------------------------------------------
// Delivery log for outbound email, correlated to Resend by resend_id (the id
// returned by resend.emails.send; dev-mode sends get a dev-<uuid>). Status is
// updated by the Resend webhook (delivered / bounced / complained) - upserted
// by resend_id, so webhook retries are naturally idempotent. The latest
// invite-kind row per participant is mirrored onto
// GroundParticipant.inviteDeliveryStatus for cheap rendering.
// ---------------------------------------------------------------------------
model EmailDelivery {
  id            String    @id @default(uuid())
  resendId      String    @unique @map("resend_id")
  email         String
  kind          String // PARTICIPANT_INVITE | LEAD_INVITE | MAGIC_LINK | REMINDER | OTHER
  participantId String?   @map("participant_id")
  groundId      String?   @map("ground_id")
  status        String    @default("SENT") // SENT | DELIVERED | BOUNCED | COMPLAINED
  detail        String?
  statusAt      DateTime? @map("status_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([participantId])
  @@map("email_deliveries")
}

// ---------------------------------------------------------------------------
// Per-admin preference profile — built from past grounds, used to deepen
// probing on new grounds. Never used to skip questions.
// ---------------------------------------------------------------------------
model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  signals   Json     @default("[]") // string[] of observed preference signals
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// The Ground — the core transactional unit
// ---------------------------------------------------------------------------

model Ground {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  initiatorId    String         @map("initiator_id")
  scenario       GroundScenario
  moment         GroundMoment
  status         GroundStatus   @default(OPEN)
  label          String
  // Alignment (private) vs delivery (shared). Immutable after creation - see the
  // GroundMode enum comment. Defaults to PRIVATE so any ground created by a path
  // that does not set it explicitly is private, never accidentally shared.
  mode           GroundMode     @default(PRIVATE)

  timelineDays  Int     @map("timeline_days")
  /// DID THE LEAD CHOOSE THIS, OR DID WE.
  ///
  /// `timelineDays` is not nullable and `cadence` has a default, so both are set on every ground from
  /// the moment it exists - by the lead if they said so, and by `DEFAULT_TIMELINE_DAYS[scenario]` if
  /// they did not. The context chat's gap reader asked about duration only when it was ABSENT, and it
  /// is never absent, so the question G37 exists to ask has never once been asked.
  ///
  /// These say which it was. Found by trying to null the column to test the gap and discovering the
  /// constraint forbids it.
  timelineStated Boolean @default(false) @map("timeline_stated")
  cadenceStated  Boolean @default(false) @map("cadence_stated")
  timelineWeeks Int?    @map("timeline_weeks")
  cadence       Cadence @default(FORTNIGHTLY)
  cadenceAnchorDay Int? @map("cadence_anchor_day") // weekly: 0=Sun..6=Sat ("every Monday"); monthly: 1-31 (day of month)
  startsAt      DateTime? @map("starts_at") // when the first scheduled check-in opens (start date)
  endsAt        DateTime? @map("ends_at")   // no new check-ins scheduled after this (end date)
  endState      String? @map("end_state") // the decision the process worked toward
  resolutionState String? @map("resolution_state") // pre-agreed intended outcome set at creation
  brief           String? @map("brief") // initiator's opening brief, written at ground creation
  groundAuditLog Json?  @map("ground_audit_log") // append-only JSON log of timeline/cadence changes
  createdByUserId String? @map("created_by_user_id") // the admin who set this up for a lead; null for self-serve grounds

  // Lifecycle / billing markers
  billingActivatedAt  DateTime? @map("billing_activated_at") // admin activated report
  billingEnabled      Boolean   @default(false) @map("billing_enabled")
  paymentConfirmed    Boolean   @default(false) @map("payment_confirmed")
  resolvedAt          DateTime? @map("resolved_at")
  closedAt            DateTime? @map("closed_at")
  pausedAt            DateTime? @map("paused_at") // set when status transitions to PAUSED

  sessionsBalance     Int     @default(1) @map("sessions_balance")
  // When true (default), participants cannot see each other's email address - only
  // their own. Names, roles, roster and presence stay visible. Initiator-only toggle;
  // enforced in the get() read path. (Column name predates the participant-to-participant
  // scope; it now hides contact from ALL other participants, not just cross-org.)
  restrictExternalVisibility Boolean @default(true) @map("restrict_external_visibility")
  // Do the people on this ground actually see each other's work?
  //
  // Nullable on purpose: null means "nobody has said", and the scenario family
  // supplies a sensible default. Once the lead or an admin answers, their answer
  // wins - because the scenario cannot know. A cohort of trainers who share a
  // site do see each other; a delivery team split across regions does not. This
  // decides whether the board's fairness reads have any ground to stand on, so
  // guessing it from the scenario alone is how a competent person gets read as
  // absent (see reads.ts).
  peopleWorkTogether Boolean? @map("people_work_together")
  // Can the parties see who else is on this ground and how each is doing?
  //
  // Nullable: null means nobody has said, and the kind of ground supplies the
  // default - hidden where the period decides something about a person, shown
  // where they are delivering together. The lead or an admin overrides it,
  // because only they know whether seeing each other helps or corrodes. On a
  // probation cohort a visible roster tells four people exactly who their rivals
  // are; on a delivery team the same roster is how they coordinate.
  peersVisibleToEachOther Boolean? @map("peers_visible_to_each_other")
  isFreeGround        Boolean @default(true) @map("is_free_ground")
  accessCodeId        String? @map("access_code_id")
  freeReason          String? @map("free_reason")  // "FIRST_GROUND" | "ACCESS_CODE"
  freeParticipantCap  Int     @default(4) @map("free_participant_cap")
  joinToken           String? @unique @map("join_token")

  promptVersionId     String? @map("prompt_version_id")
  stripeScenarioSubId String? @map("stripe_scenario_sub_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization             Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiator                User                       @relation("GroundInitiator", fields: [initiatorId], references: [id])
  promptVersion            PromptVersion?             @relation(fields: [promptVersionId], references: [id])
  accessCode               ContributorCode?           @relation("GroundAccessCode", fields: [accessCodeId], references: [id])
  participants             GroundParticipant[]
  checkIns                 CheckIn[]
  report                   Report?
  patternDetections        PatternDetection[]
  resolution               Resolution?
  outcome                  Outcome?
  outcomeFeedback          OutcomeFeedback[]
  billingEvents            BillingEvent[]
  documents                GroundDocument[]
  personObjectives         PersonObjective[]
  baselineEntries          GroundBaselineEntry[]
  leadContextNotes         LeadContextNote[]
  reportActivations          ReportActivation[]
  objectives                 GroundObjective[]
  dependencies               GroundDependency[]
  workMentions               WorkMention[]
  poll                       GroundPoll?
  participantRequests        ParticipantRequest[]
  contributorCodeRedemptions ContributorCodeRedemption[]

  @@index([organizationId])
  @@index([status])
  @@map("grounds")
  // Versioned targets. A goal change is a new chapter, not an overwrite.
  baselines           GroundBaseline[]
  participantNotes ParticipantNote[]
  /// Who accepted or declined this ground, and when. Null on a ground that never
  /// needed accepting - an admin's own, or one created before the gate existed.
  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  /// Why it was declined, in the admin's words. Shown to whoever created it.
  declineReason  String?   @map("decline_reason") @db.Text
}

 // WHAT A PERSON WAS LAST ASKED TO DO, AND WHAT HAPPENED TO IT.
 //
 // Coaching is one small step, then a wait, then the next step chosen from what
 // actually happened. That only works if the step survives between sessions, so
 // this is the memory the whole mechanic rests on.
 //
 // PRIVATE BY CONSTRUCTION. One row per person per ground, readable only by that
 // person. It never reaches a report, a board, or a lead, and it must never be
 // reachable from a resolution: a firing is the ultimate verdict on a person and
 // this product does not produce verdicts. If somebody reviewing the code could
 // wire this into a termination justification, the wall is not built right.
 // People would never answer honestly again if their own coaching could be used
 // against them.
 // WHAT THE GROUND WAS AIMING AT, AND WHEN THAT CHANGED.
 //
 // Real work does not hold still: priorities shift, a project's definition of
 // done moves, a hire's role is redefined. The coach must not keep coaching
 // toward a superseded goal, and must never read the period before a pivot as
 // failure against a bar that did not exist yet.
 //
 // That needs the target to be VERSIONED rather than overwritten. A goal change
 // is a new chapter with a marked transition, never an erasure of the old one:
 // effort toward the old goal stays real, and banked success stays banked.
 //
 // HARD GUARDRAIL: a goal change must never become a way to erase somebody's
 // record or to manufacture failure. "The goal changed" cannot wipe a win and
 // cannot declare anyone behind.
model GroundBaseline {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  ground        Ground   @relation(fields: [groundId], references: [id], onDelete: Cascade)

  // Sequential. Version 1 is what the ground was created with.
  version       Int      @default(1)
  // What success looks like, in the lead's own words, at this version.
  successLooksLike String? @map("success_looks_like")
  // What has to be true for it to be reachable.
  conditions    Json?
  // Why it changed, if they said. Never inferred, never invented.
  changeReason  String?  @map("change_reason")

  // When this version took effect. Everything before it belongs to the last one.
  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([groundId, version])
  @@index([groundId])
  @@map("ground_baselines")
}

model CoachingState {
  id                String   @id @default(uuid())
  participantId     String   @unique @map("participant_id")
  participant       GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // The single step last given. One at a time, never a list.
  currentStep       String?  @map("current_step")
  // Which session it was given in, so the next one can open on it.
  stepGivenAt       Int?     @map("step_given_at")
  // Which staircase they are on, and how far up.
  staircase         String?
  staircasePosition Int      @default(0) @map("staircase_position")
   // Prior steps and what became of them: done, not done, did more, sideways.
   //
   // Kept because "you have not managed this twice" is the moment to shrink the
   // step or change tack, and without the history the coach repeats itself at
   // somebody, which is the failure this mechanic exists to avoid.
  history           Json?

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("coaching_states")
}

model GroundParticipant {
  id                 String    @id @default(uuid())
  groundId           String    @map("ground_id")
  userId             String?   @map("user_id") // null until they accept the invite
  email              String
  partyType          PartyType
  // The lead chose "managing only" at confirm-lead: they oversee the ground but
  // never give their own account. Only ever true for an INITIATOR row. They are
  // NOT created a session-1 check-in and are excluded from the readiness count
  // in isSessionReadyForReport - otherwise the ground would wait forever on an
  // account that will never come. See grounds.service.ts confirmLead/isSessionReadyForReport.
  managingOnly       Boolean   @default(false) @map("managing_only")
  roleAsDescribed    String?   @map("role_as_described") // role as the initiator described it
  willingnessEvidence  Boolean? @map("willingness_evidence") // willingness gate Q1
  willingnessCadence   Boolean? @map("willingness_cadence") // willingness gate Q2
  invitedAt          DateTime? @map("invited_at")
  notifiedAt         DateTime? @map("notified_at") // never added silently
  // Mirror of the LATEST invite-kind EmailDelivery status for this participant
  // (SENT | DELIVERED | BOUNCED | COMPLAINED) - written by the Resend webhook.
  inviteDeliveryStatus String? @map("invite_delivery_status")
  // Magic-link invite (cleared once accepted; userId is set on accept).
  inviteToken          String?   @unique @map("invite_token")
  inviteTokenExpiresAt DateTime? @map("invite_token_expires_at")
  // Rolling specificity scores (Agent 1) used for trust calibration / tone.
  specificityHistory   Float[]   @default([]) @map("specificity_history")
  lastNudgedAt         DateTime? @map("last_nudged_at") // throttles reminder emails (B1)
  soloArtifact         String?   @db.Text @map("solo_artifact") // single-party record summary after session 1 (B2)
  soloArtifactAt       DateTime? @map("solo_artifact_at")
  soloArtifactShared   Boolean   @default(false) @map("solo_artifact_shared") // whether participant chose to share their individual report
  // Explicit "my account is accurate, I'm done" confirmation. Corrections
  // (startSelfCorrectionSession) remain possible after this is set - it does
  // not block them - but any correction session started afterward is stamped
  // CheckIn.isPostSignOff so it surfaces as a flagged, visible update rather
  // than silently reshaping a record the other party may have already seen.
  signedOffAt          DateTime? @map("signed_off_at")
  // Which function map reads this person fairly (SALES, PRODUCT, ENGINEERING, ...).
  // Detection is CONTINUOUS, not a tag set once: the stated role is only a starting
  // prior, and the engine revises this from what the person's work is actually made
  // of over sessions. Someone titled "product manager" whose account is all
  // coordination and clearing blockers reads as functionally PROJECT_MANAGEMENT.
  // Confidence stays low until the pattern is consistent, and a low-confidence
  // profile must not be coached from - see role-maps.ts.
   // WHEN THEY ARRIVED, WENT AWAY, AND LEFT.
   //
   // The three-period rule is only fair while every period was one this person
   // was present for and able to answer in. Without dates the engine cannot tell
   // "said nothing" from "was not there", and the naive read is unkind in every
   // direction: a joiner is behind for weeks before they existed here, somebody
   // on parental leave accrues "went quiet", and a person who has left keeps
   // being coached and keeps being read.
   //
   // See participation-timeline.ts, which is the arithmetic these feed.
  joinedAt             DateTime? @map("joined_at")   // null = present from the start
  leftAt               DateTime? @map("left_at")     // quit, removed, or let go. Freeze, never erase.
   // Authorized absence: the DATES ONLY.
   //
   // The engine must never store, infer, or surface the REASON. Medical,
   // parental, bereavement, sabbatical: none of it is the engine's business, all
   // of it is a liability, and "on leave" is the entire fact it needs. Shape is
   // [{ from, to }], to null while still away.
  leavePeriods         Json?     @map("leave_periods")
  coachingState        CoachingState?
  detectedFunction     String?   @map("detected_function")
  detectedFunctionConfidence Float? @map("detected_function_confidence")
  detectedFunctionAt   DateTime? @map("detected_function_at")
  // THE COFOUNDER INTAKE IS GONE. Twelve free-text columns lived here -
  // founding/role/personal/exit intent, compensation/autonomy/recognition/
  // growth/relationship asks, financial floor, stress and relational tolerance -
  // each up to 4000 characters.
  //
  // They were written by a PATCH route, from a client function no page ever
  // called, and read by nothing: no report, no board, no prompt. The single
  // apparent reader was `hasIntake = !!foundingIntent`, which was returned to
  // the client and consumed by nothing either.
  //
  // So the schema stood ready to store someone's salary floor and how much
  // stress they can take, in a column no feature opened. Unused personal data is
  // not neutral - it is a liability that grows quietly, and this is a product
  // whose landing page makes promises about what happens to what people tell it.
  // The engine already learns this in conversation, where it is probed, evidenced
  // and visible to the person in their own record.
  createdAt          DateTime  @default(now()) @map("created_at")

  ground            Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  user              User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkIns          CheckIn[]
  recordEntries     RecordEntry[]
  notes             ParticipantNote[]
  patternDetections PatternDetection[]
  outcomeFeedback   OutcomeFeedback[]
  documents         GroundDocument[]
  personObjectives  PersonObjective[]
  leadContextNotes  LeadContextNote[]
  resolutionConfirmations ResolutionConfirmation[]
  reportActivations       ReportActivation[]
  dependenciesFrom        GroundDependency[] @relation("DependencyFrom")
  dependenciesOn          GroundDependency[] @relation("DependencyOn")
  mentionsMade            WorkMention[]      @relation("MentionSource")
  mentionsAbout           WorkMention[]      @relation("MentionAbout")

  @@unique([groundId, email])
  @@index([groundId])
  @@map("ground_participants")
}

// ---------------------------------------------------------------------------
// Conversation — each party checks in INDEPENDENTLY. Never cross-readable.
// ---------------------------------------------------------------------------

model CheckIn {
  id            String        @id @default(uuid())
  groundId      String        @map("ground_id")
  participantId String        @map("participant_id")
  sessionNumber Int           @map("session_number") // 1, 2, ...
  status        CheckInStatus @default(NOT_STARTED)
  availableFrom DateTime?     @map("available_from") // cadence gate — session 2+ opens after this date
  startedAt     DateTime?     @map("started_at")
  completedAt    DateTime?     @map("completed_at")
  warningFiredAt DateTime?     @map("warning_fired_at")
  sessionReadyNotifiedAt DateTime? @map("session_ready_notified_at") // one-shot: "your check-in is now open" email sent
  patternsAnalyzedAt DateTime? @map("patterns_analyzed_at") // pattern sweep has processed this period
  nextCommitment String?       @map("next_commitment")
  closedReason  String?        @map("closed_reason") // e.g. "willingness_declined"
  willingnessConfirmed Boolean @default(true) @map("willingness_confirmed") // willingness gate result
  specificityLevel     String?  @map("specificity_level")
  specificityDimensions Json?   @map("specificity_dimensions")
  recallConfidence     String?  @map("recall_confidence")
  isClarification      Boolean  @default(false) @map("is_clarification") // true when session is correcting a flagged inference
  clarificationTarget  String?  @map("clarification_target") // inference id from report.inferences being corrected
  isSelfCorrection     Boolean  @default(false) @map("is_self_correction") // true when session is correcting the participant's OWN prior session
  selfCorrectionTargetSession Int? @map("self_correction_target_session") // the session number being corrected
  // True when this self-correction session was started AFTER the participant
  // had already signed off (GroundParticipant.signedOffAt). Not a block - just
  // a flag so the shared report can surface it as "updated after sign-off"
  // instead of blending it in as if it had always been there.
  isPostSignOff        Boolean  @default(false) @map("is_post_sign_off")
  // Closing-round marker: same conversation, flagged final - the person is
  // told to document thoroughly and the final report reads the whole arc.
  isFinal       Boolean       @default(false) @map("is_final")
  createdAt     DateTime      @default(now()) @map("created_at")

  ground        Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant   GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  turns         ConversationTurn[]
  recordEntries RecordEntry[]
  workMentions  WorkMention[]

  @@unique([participantId, sessionNumber])
  @@index([groundId])
  @@map("check_ins")
}

model ConversationTurn {
  id        String   @id @default(uuid())
  checkInId String   @map("check_in_id")
  role      TurnRole
  content   String   @db.Text
  stage     String? // which conversation stage produced this turn
  createdAt DateTime @default(now()) @map("created_at")

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId])
  @@map("conversation_turns")
}

model RecordEntry {
  id            String          @id @default(uuid())
  participantId String          @map("participant_id")
  checkInId     String?         @map("check_in_id")
  type          RecordEntryType
  evidenceType  EvidenceType    @default(CHECK_IN)
  text          String          @db.Text // the person's exact words where possible
  recallBased   Boolean         @default(true) @map("recall_based") // false = anchored to a document
  dimensionThreadKey String?    @map("dimension_thread_key") // groups entries across sessions by theme
  anchored_question_id String?  @map("anchored_question_id") // which verbatim question produced this entry
  createdAt     DateTime        @default(now()) @map("created_at")

  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  checkIn     CheckIn?          @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@map("record_entries")
}

// ---------------------------------------------------------------------------
// Delivery board objects (SHARED-mode grounds only).
//
// The board is a delivery-shaped rendering of the delivery-relevant parts of
// the report. These models hold the things the report itself does not: the
// frame the lead set, the handoffs between people, the meeting record, and the
// availability poll. Everything else the board shows is derived from data that
// already exists (check-ins, record entries, the report, patterns).
//
// All of these are read-only on the board with one exception: the availability
// poll, because availability is logistics and never touches an account.
// ---------------------------------------------------------------------------

// A target the lead set. The board shows progress against these.
// HOW TO TALK TO ONE PERSON, REMEMBERED ACROSS GROUNDS.
//
// An eighteen-ground org run found the same colleague met as a stranger five
// times. One participant asked what a "ground" was in five separate grounds and
// got a good plain answer in each; the product never once remembered he asked.
//
// WHAT THIS DELIBERATELY DOES NOT HOLD: anything anyone said. No topics, no
// accounts, no ground names, no outcomes. A ground is a closed container - a
// person speaking to two colleagues in one and seven in another has to be able
// to trust that the two do not leak into the seven. Carrying content across
// would break the only promise the product really makes, and would mean someone
// on a performance plan in March has it following them into a cohort in June.
//
// So this holds only HOW to speak to them: do they need the vocabulary
// explained, do they answer in a line, have they asked who reads this. Style,
// never substance. Everything here could be shown to the person it describes
// without embarrassment, which is the bar it has to clear.
model PersonStyleProfile {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  organizationId String @map("organization_id")

  // They asked what a product term meant. Explain plainly, do not assume.
  needsPlainLanguage Boolean @default(false) @map("needs_plain_language")
  // They answer briefly. Ask one thing at a time and expect short replies.
  answersBriefly     Boolean @default(false) @map("answers_briefly")
  // They have asked who reads this. Say so early, without being asked again.
  asksWhoReadsThis   Boolean @default(false) @map("asks_who_reads_this")
  // How many grounds they have taken part in. Orientation only.
  groundsSeen        Int     @default(0) @map("grounds_seen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("person_style_profiles")
}

model GroundObjective {
  id        String   @id @default(uuid())
  groundId  String   @map("ground_id")
  name      String
  target    Int?     // null = a qualitative objective, tracked but not counted
  // Snapshot of the count at the previous session, so the board can show the
  // delta ("+2 this session") without recomputing history every read.
  prevCount Int      @default(0) @map("prev_count")
  count     Int      @default(0)
  // A dimension the lead ADDED mid-phase. A new target means nothing until
  // people have checked in against it, so the board flags it as new and shows
  // who has been asked and who has not.
  addedAtSession Int? @map("added_at_session")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId])
  @@map("ground_objectives")
}

enum DependencyStatus {
  BLOCKING
  WAITING
  CLEARED
}

//
// A handoff between two people, extracted from a check-in when someone names a
// dependency. This is the board's real differentiator: the critical path is not
// who is behind, it is what is blocked on whom.
//
// Extracted from the OWN account of the person who is waiting (fromParticipant).
// Never created by one person asserting something about another's obligations
// without it appearing in their own account of their own work.
//
model GroundDependency {
  id                String           @id @default(uuid())
  groundId          String           @map("ground_id")
  fromParticipantId String           @map("from_participant_id")
  onParticipantId   String?          @map("on_participant_id") // null = waiting on someone/something outside the ground
  onLabel           String?          @map("on_label") // free text when the blocker is not a participant
  what              String           @db.Text // "the sales deck", "paying-user pricing"
  // What happens once this clears. The board shows this so a handoff reads as a
  // consequence, not just a status.
  then              String?          @db.Text
  status            DependencyStatus @default(WAITING)
  sourceCheckInId   String?          @map("source_check_in_id")
  clearedAt         DateTime?        @map("cleared_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  ground          Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  fromParticipant GroundParticipant @relation("DependencyFrom", fields: [fromParticipantId], references: [id], onDelete: Cascade)
  onParticipant   GroundParticipant? @relation("DependencyOn", fields: [onParticipantId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@map("ground_dependencies")
}

// Why a piece of someone else's work showed up in this person's account.
enum WorkMentionKind {
  // Credit: this account says the other person moved something. Feeds the
  // hidden-contribution read - the quiet load-bearer whose own account is modest.
  CREDIT
  // Coverage: this account describes doing work that sits in the other person's
  // remit. Feeds "where work is landing".
  COVERAGE
  // Named as a blocker. Explains coverage rather than counting as it.
  BLOCKED_BY
}

// A resolved, ID-level reference from one person's account to ANOTHER
// participant's work.
//
// This exists because matching on first names is not good enough to carry a read
// about a person: it false-positives on common names, misses anyone referred to
// differently, and cannot tell crediting someone from covering for them. Both
// "where work is landing" and the hidden-contribution read need a precise answer
// to "whose work did this account reference, and in what sense", so it is
// resolved once, at extraction time, and stored as participant ids.
//
// sourceParticipant is whose account it appeared in; aboutParticipant is whose
// work it concerns. A name that does not resolve to a participant is DROPPED,
// never guessed - a wrong attribution here is worse than a missing one.
model WorkMention {
  id                  String          @id @default(uuid())
  groundId            String          @map("ground_id")
  sourceParticipantId String          @map("source_participant_id")
  aboutParticipantId  String          @map("about_participant_id")
  checkInId           String?         @map("check_in_id")
  sessionNumber       Int             @default(1) @map("session_number")
  kind                WorkMentionKind
  // The referenced work in the source's own words. Counted and summarised in the
  // product's words; never shown to the person it is about.
  text                String          @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")

  ground            Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  sourceParticipant GroundParticipant @relation("MentionSource", fields: [sourceParticipantId], references: [id], onDelete: Cascade)
  aboutParticipant  GroundParticipant @relation("MentionAbout", fields: [aboutParticipantId], references: [id], onDelete: Cascade)
  checkIn           CheckIn?          @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@index([aboutParticipantId])
  @@map("work_mentions")
}

//
// Availability poll. THE ONLY thing anyone adds on the board, because
// availability is logistics and never touches an account.
//
model GroundPoll {
  id        String   @id @default(uuid())
  groundId  String   @unique @map("ground_id")
  question  String
  createdAt DateTime @default(now()) @map("created_at")

  ground  Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  options GroundPollOption[]

  @@map("ground_polls")
}

model GroundPollOption {
  id      String   @id @default(uuid())
  pollId  String   @map("poll_id")
  label   String
  // GroundParticipant ids who marked themselves available for this option.
  whoIds  String[] @default([]) @map("who_ids")
  sortOrder Int    @default(0) @map("sort_order")

  poll GroundPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@map("ground_poll_options")
}

// ---------------------------------------------------------------------------
// The Report — the shared picture. Released to BOTH parties simultaneously.
// ---------------------------------------------------------------------------

model Report {
  id              String    @id @default(uuid())
  groundId        String    @unique @map("ground_id")
  sharedPicture   String    @db.Text @map("shared_picture")
  agreements      Json // where both accounts agree
  divergences     Json // the gap — never framed as one side being right
  centralQuestion String    @db.Text @map("central_question")
  engagement      Json? // engagement-quality + confidence header: per-party session counts, % document-backed, coverage band (B4)
  inferences      Json?     // array of { id, text, participantId, sessionNumber } — items the AI inferred rather than directly quoted
  promptVersionId String?   @map("prompt_version_id")
  finalSynthesis  Json?     @map("final_synthesis") // closing-round report: per-goal arc lines, tier, end-state framing
  // Where a manager's account of how they led differs from a report's account
  // of how they were led. Produced by the same synthesis that finds divergences,
  // so it is stated as a gap and never quotes either side.
  leadershipGaps  Json?     @map("leadership_gaps")
  arcSignals      Json?     @map("arc_signals") // deterministic F1-F5 features per party (advisory surface reads this)
  releasedAt      DateTime? @map("released_at") // set once, atomically, for both
  createdAt       DateTime  @default(now()) @map("created_at")

  ground        Ground         @relation(fields: [groundId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id])

  @@map("reports")
}

// ---------------------------------------------------------------------------
// Participant requests — suggested by existing participants to the initiator
// ---------------------------------------------------------------------------

enum ParticipantRequestStatus {
  PENDING
  APPROVED
  DISMISSED
}

model ParticipantRequest {
  id               String                   @id @default(uuid())
  groundId         String                   @map("ground_id")
  requestedByEmail String                   @map("requested_by_email")
  requestedEmail   String                   @map("requested_email")
  requestedName    String?                  @map("requested_name")
  reason           String                   @db.Text
  status           ParticipantRequestStatus @default(PENDING)
  createdAt        DateTime                 @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId])
  @@map("participant_requests")
}

// ---------------------------------------------------------------------------
// Pattern detection — behavioural signals, NEVER verdicts. Three-period rule.
// ---------------------------------------------------------------------------

model PatternDetection {
  id              String        @id @default(uuid())
  groundId        String        @map("ground_id")
  participantId   String        @map("participant_id")
  code            String // D1..D8, B1..B12, K/E/R/F codes — see Part 4
  periodsObserved Int           @default(1) @map("periods_observed")
  lastPeriodNumber Int?         @map("last_period_number") // session number of the most recent period; enforces consecutiveness
  status          PatternStatus @default(CANDIDATE)
  observationText String?       @db.Text @map("observation_text") // plain language, never a score
  // Accuracy feedback: did the admin or participant confirm this was accurate?
  accuracyRating  Boolean?      @map("accuracy_rating") // true = accurate, false = inaccurate, null = not yet rated
  ratedAt         DateTime?     @map("rated_at")
  ratedBy         String?       @map("rated_by") // userId of rater
  firstSeenAt     DateTime      @default(now()) @map("first_seen_at")
  lastSeenAt      DateTime      @default(now()) @map("last_seen_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, code])
  @@index([groundId])
  @@index([code, accuracyRating]) // for per-code accuracy aggregation
  @@map("pattern_detections")
}

// ---------------------------------------------------------------------------
// Resolution — a ground closes only when BOTH parties confirm an end state.
// ---------------------------------------------------------------------------

model Resolution {
  id             String    @id @default(uuid())
  groundId       String    @unique @map("ground_id")
  endState       String    @map("end_state") // latest leading proposal; the agreed end state once closed
  decisionRights Json?     @map("decision_rights")
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  ground        Ground                   @relation(fields: [groundId], references: [id], onDelete: Cascade)
  confirmations ResolutionConfirmation[]

  @@map("resolutions")
}

// Per-party end-state confirmation. A ground closes only when every ACTIVE party
// (one who accepted their invite) has confirmed the SAME end state. For two-party
// grounds this is exactly the old "both confirm" behaviour; for project / team
// grounds it generalises to N parties.
model ResolutionConfirmation {
  id            String   @id @default(uuid())
  resolutionId  String   @map("resolution_id")
  participantId String   @map("participant_id")
  endState      String   @map("end_state")
  confirmedAt   DateTime @default(now()) @map("confirmed_at")

  resolution  Resolution        @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([resolutionId, participantId])
  @@index([resolutionId])
  @@map("resolution_confirmations")
}

// ---------------------------------------------------------------------------
// The moat: versioned prompts + outcome data + anonymised cross-org learning
// ---------------------------------------------------------------------------

model PromptVersion {
  id          String    @id @default(uuid())
  key         String // e.g. "system", "report_synthesis", "scenario.drift"
  version     Int
  content     String    @db.Text
  summary     String?   @db.Text // change summary — every change is logged
  isActive    Boolean   @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  // These two exist in the database and are RENDERED by the prompt-versioning
  // page (the draft badge and the "by <user>" line), but were missing from this
  // schema - so the API never returned them and both features were silently
  // dead. Declared rather than dropped: dropping would have destroyed data a
  // live surface still expects.
  isDraft     Boolean   @default(false) @map("is_draft")
  activatedBy String?   @map("activated_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  grounds Ground[]
  reports Report[]

  @@unique([key, version])
  @@map("prompt_versions")
}

model Outcome {
  id              String        @id @default(uuid())
  groundId        String        @unique @map("ground_id")
  promptVersionId String?       @map("prompt_version_id")
  resolvedState   String        @map("resolved_state")
  moment          GroundMoment? // the data point: prompt version, moment, end state, session count
  sessionCount    Int?          @map("session_count")
  resolvable      Boolean? // learning signal: was this resolvable at session 1?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([promptVersionId])
  @@map("outcomes")
}

// Post-resolution feedback from each party: did this process help you reach a
// decision that felt fair and grounded in evidence? The seed of the learning loop.
model OutcomeFeedback {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String   @map("participant_id")
  feltFair      Boolean  @map("felt_fair")
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groundId, participantId])
  @@index([groundId])
  @@map("outcome_feedback")
}

model OrgIntelligence {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  patternSummary Json     @map("pattern_summary") // anonymised — no PII, no names
  anonymised     Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@map("org_intelligence")
}


model BillingEvent {
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  groundId       String?            @map("ground_id")
  type           BillingEventType
  amountCents    Int                @map("amount_cents")
  currency       String             @default("USD")
  periodStart    DateTime           @map("period_start")
  periodEnd      DateTime           @map("period_end")
  stripeInvoiceId String?           @map("stripe_invoice_id")
  status         BillingEventStatus @default(PENDING)
  createdAt      DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ground       Ground?      @relation(fields: [groundId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("billing_events")
}

model ContributorCode {
  id              String    @id @default(uuid())
  organizationId  String    @map("organization_id")
  code            String    @unique
  sessionsGranted Int       @default(1) @map("sessions_granted")
  sessionsUsed    Int       @default(0) @map("sessions_used")
  createdByUserId  String    @map("created_by_user_id")
  note             String?   // optional label for the admin (e.g. "for the marketing team")
  allowCodeCreation Boolean  @default(false) @map("allow_code_creation")
  isActive          Boolean  @default(true)  @map("is_active")
  parentCodeId      String?  @map("parent_code_id")
  redeemedByUserId  String?  @map("redeemed_by_user_id")
  expiresAt         DateTime @default(dbgenerated("NOW() + INTERVAL '90 days'")) @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                       @relation("ContributorCodes", fields: [createdByUserId], references: [id])
  redemptions    ContributorCodeRedemption[]
  parentCode     ContributorCode?           @relation("CodeHierarchy", fields: [parentCodeId], references: [id])
  childCodes     ContributorCode[]          @relation("CodeHierarchy")
  redeemedBy     User?                      @relation("RedeemedCodes", fields: [redeemedByUserId], references: [id])
  groundsCreated Ground[]                   @relation("GroundAccessCode")

  @@index([organizationId])
  @@map("contributor_codes")
}

model ContributorCodeRedemption {
  id               String   @id @default(uuid())
  codeId           String   @map("code_id")
  groundId         String   @map("ground_id")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")
  redeemedByUserId String?  @map("redeemed_by_user_id")
  freeReason       String?  @map("free_reason")

  code       ContributorCode @relation(fields: [codeId], references: [id])
  ground     Ground          @relation(fields: [groundId], references: [id], onDelete: Cascade)
  redeemedBy User?           @relation("CodeRedemptions", fields: [redeemedByUserId], references: [id])

  @@map("contributor_code_redemptions")
}

/// Who a document is for. Three answers, because there are three real cases and
/// the product currently answers all of them the same way by accident.
///
/// OPEN    everyone in the ground. The brief, the plan, the terms - the things a
///         ground is measured against, which are useless if only one person has
///         them.
/// CLOSED  the lead only. What they know that is not everybody's to read.
/// OWN     the uploader only. A participant's evidence for their own account,
///         which is the current behaviour for every document and the default.
enum DocumentVisibility {
  OPEN
  CLOSED
  OWN
}

/// What one person is trying to achieve, in their words. (G13)
///
/// A ground holds one success definition and it belongs to the lead, so a hire
/// with no objective of their own infers one from whatever number was named -
/// which is exactly what Ground 1's report closed on. This is the missing field.
///
/// authoredBy and seenBySubject are not metadata. A proposal nobody has seen is
/// never read against, and the two columns are what makes that arithmetic rather
/// than an instruction. See an-objective-belongs-to-a-person.ts.
model PersonObjective {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String   @map("participant_id")

  text          String   @db.Text
  /// 'lead' or 'self'. Who wrote the CURRENT text.
  authoredBy    String   @map("authored_by")
  /// Whether the person it belongs to has seen the current text.
  seenBySubject Boolean  @default(false) @map("seen_by_subject")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groundId, participantId])
  @@map("person_objectives")
}

/// Where this stood on day one, recorded on purpose. (G14)
///
/// DELIBERATELY HAS NO updatedAt AND NO EDIT PATH. Somebody will want to correct
/// it - the first session usually reveals the day-one description was wrong, and
/// fixing it feels like accuracy. It is the opposite: half the findings this
/// product makes are the distance between what people believed at the start and
/// what turned out to be true. Corrected, a baseline becomes a second
/// description of the present and the arc disappears. A correction goes in as a
/// new row with its own date.
model GroundBaselineEntry {
  id        String   @id @default(uuid())
  groundId  String   @map("ground_id")

  text      String   @db.Text
  capturedAtSession Int @map("captured_at_session")

  createdAt DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, createdAt])
  @@map("ground_baseline_entries")
}

model GroundDocument {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String?  @map("participant_id")
  fileName      String   @map("file_name")
  mimeType      String   @map("mime_type")
  content       String   @db.Text
  assessment    Json?    // { suggests: string[], willDo: string[] } - Gemini's read of the doc, correctable

  // WHO CAN SEE THIS. Nobody decided the current behaviour: documents.list
  // filters on participantId, so every document is private to whoever uploaded
  // it. Right for a participant's own evidence, backwards for the lead's - a job
  // description or a grant's terms reach nobody, and those are exactly the things
  // everybody should be working from.
  //
  // OWN is the default so existing documents keep behaving as they do and
  // CONTEXT_ENABLED off is genuinely the old product. See DocumentVisibility.
  visibility    DocumentVisibility @default(OWN)

  createdAt DateTime @default(now()) @map("created_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([groundId, participantId])
  @@map("ground_documents")
}

// Lead-supplied context: a private typed note the initiator adds about a specific
// participant (participantId set) or about the ground (participantId null). It
// DIRECTS and WEIGHTS synthesis - never becomes a stated claim, and is never shown
// to the person it is about. Deliberately its OWN store, NEVER a RecordEntry: the
// corpus reads these separately into a labeled LEAD-SUPPLIED CONTEXT section so the
// AI can never attribute the lead's framing to the party's own words.
model LeadContextNote {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String?  @map("participant_id") // null = about the ground; set = about that person
  authorUserId  String   @map("author_user_id") // the initiator who wrote it
  text          String   @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@map("lead_context_notes")
}

// ---------------------------------------------------------------------------
// Compliance — disclaimer acknowledgement gate before first session.
// ---------------------------------------------------------------------------


// ---------------------------------------------------------------------------
// Report activation — a per-party reveal confirmation, not a mutual gate.
// Release (Report.releasedAt) happens independently of this, driven by
// session completion; activation only controls what a given party sees
// AFTER release. Each party's own row gates only their own view - one
// party activating has no effect on any other party's access, and there is
// no "wait for the other side" behavior (see ReportsService.get()). The
// initiator is exempt and always sees full content once released.
// ---------------------------------------------------------------------------

enum ReportActivationStatus {
  PENDING   // party has not yet activated
  ACTIVATED // party pressed "release report"
}

model ReportActivation {
  id            String                 @id @default(uuid())
  groundId      String                 @map("ground_id")
  participantId String                 @map("participant_id")
  status        ReportActivationStatus @default(PENDING)
  activatedAt   DateTime?              @map("activated_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groundId, participantId])
  @@index([groundId])
  @@map("report_activations")
}

// ---------------------------------------------------------------------------
// Usage events — append-only ops log. Never updated, never deleted.
// Drives the ops dashboard and billing audit trail.
// ---------------------------------------------------------------------------

enum UsageEventType {
  GROUND_CREATED
  CHECK_IN_STARTED
  CHECK_IN_COMPLETED
  REPORT_REQUESTED       // party triggers mutual reveal
  REPORT_RELEASED        // both activated; releasedAt stamped on Report
  BILLING_ACTIVATED
  PARTICIPANT_INVITED
  PARTICIPANT_ACCEPTED
  ORG_CREATED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELLED
}

model UsageEvent {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  groundId       String?        @map("ground_id")
  participantId  String?        @map("participant_id")
  userId         String?        @map("user_id")
  type           UsageEventType
  meta           Json?          // arbitrary key-value for event-specific detail
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([groundId])
  @@index([type, createdAt])
  @@map("usage_events")
}

// ---------------------------------------------------------------------------
// Pattern thresholds — tunable per code without a deploy.
// One row per pattern code. Missing rows fall back to hardcoded defaults.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Platform settings — generic singleton key/value store for admin-toggleable
// platform-wide flags (e.g. WhatsApp on/off). Not org-scoped: there is one
// Groundwork WhatsApp number serving every org, so this is a single row per
// key, not one per organization.
// ---------------------------------------------------------------------------

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // userId of last editor

  @@map("platform_settings")
}

model FeedbackSubmission {
  id        String   @id @default(uuid())
  tab       String
  pill      String
  text      String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tab, createdAt])
  @@map("feedback_submissions")
}

model PatternConfig {
  id                   String   @id @default(uuid())
  code                 String   @unique // e.g. "D4", "B2", "F1"
  consecutivePeriods   Int      @default(3) @map("consecutive_periods") // three-period gate
  outputScoreMax       Float?   @map("output_score_max")   // detector fires when outputScore < this
  outputScoreMin       Float?   @map("output_score_min")   // detector fires when outputScore > this
  thinkingScoreMax     Float?   @map("thinking_score_max")
  thinkingScoreMin     Float?   @map("thinking_score_min") // detector fires when thinkingScore > this
  meetingScoreMax      Float?   @map("meeting_score_max")
  meetingScoreMin      Float?   @map("meeting_score_min")
  specificityScoreMax  Float?   @map("specificity_score_max")
  keywordCountMin      Int?     @map("keyword_count_min")  // for keyword-based detectors
  enabled              Boolean  @default(true)
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedBy            String?  @map("updated_by") // userId of last editor

  @@map("pattern_configs")
}

/// SOMETHING YOU WROTE DOWN BETWEEN SESSIONS.
///
/// A ground now reads like a channel, and a channel invites you to type. But a
/// session is a closed record, so between sessions there is nothing to add to it -
/// and the honest answer to "can I type here" is yes, into something that is NOT
/// your account.
///
/// WHY THIS IS NOT A RecordEntry, which is where it would naturally have gone.
/// RecordEntry IS the record. `reports.service.ts` reads it to build the shared
/// report, and `context.service.ts` reads the OTHER party's entries. So a sentence
/// typed between sessions, unprompted and unexamined, would become part of the
/// account that gets compared against somebody else's - which is the one thing the
/// engine's design forbids. A note is not an account. It has never been questioned.
///
/// WHAT IT IS FOR. It is carried into the next session as something to ASK about.
/// The engine sees "they noted this between sessions" and raises it; whatever they
/// then say under questioning becomes the record, through the normal path. That
/// makes the note useful rather than a scratchpad, and keeps the rule that the
/// record holds what was said in a session.
///
/// It is private to the person, always. Never in a report, never to the lead,
/// never to another party.
model ParticipantNote {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String   @map("participant_id")
  text          String   @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  /// The check-in that picked it up. Null until a session has seen it, so a note
  /// is raised once rather than in every session from now on.
  carriedIntoCheckInId String? @map("carried_into_check_in_id")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, carriedIntoCheckInId])
  @@map("participant_notes")
}

/// SOMEBODY CAN BELONG TO MORE THAN ONE ORGANISATION.
///
/// `User.email` is globally unique, so one address is one row - which is why there
/// was no way to be in two organisations at once. Rather than break that (and every
/// lookup that depends on it), membership becomes its own table and
/// `User.organizationId` becomes the ACTIVE one: the org whose data the token scopes
/// every query to.
///
/// That is what makes the switch tractable. Every org-scoped query in the product
/// already reads `organizationId` off the token, so switching means issuing a new
/// token - not rewriting the queries.
///
/// The role is per membership. Somebody can administer their own company and be an
/// ordinary member of a client's organisation, and flattening that to one role would
/// either over-grant or under-grant in one of them.
model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           UserRole @default(MEMBER)
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("organization_memberships")
}
