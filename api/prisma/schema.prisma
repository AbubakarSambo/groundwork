/// ONE PERFORMANCE REVIEW (E4, the reviews suite, U.17), started for a review that falls due
/// (`EvaluationDue`, which the daily reminder already reads). Holds what people write: the manager's
/// own words, the person's own view, and the manager's decision with its reasons. `noticed` is the
/// engine's "What Groundwork noticed", each line with how it is known, written by the engine with the
/// prompt version that ran (docs/requests-to-engine.md, request 23); empty until then. There is no
/// score and no verdict here. Hours and leave never feed it (decisions rule 10). Who reads which part
/// is decided in suites/the-reviews.service.ts, never on the screen.
model PerformanceReview {
  id                     String    @id @default(uuid())
  organizationId         String    @map("organization_id")
  evaluationDueId        String    @unique @map("evaluation_due_id")
  personExternalId       String    @map("person_external_id")
  startedById            String    @map("started_by_id")
  startedAt              DateTime  @default(now()) @map("started_at")
  managersWords          String?   @map("managers_words") @db.Text
  managersWordsById      String?   @map("managers_words_by_id")
  managersWordsAt        DateTime? @map("managers_words_at")
  theirView              String?   @map("their_view") @db.Text
  theirViewAt            DateTime? @map("their_view_at")
  noticed                Json?
  noticedPromptVersionId String?   @map("noticed_prompt_version_id")
  decision               String?   @db.Text
  decisionReasons        String?   @map("decision_reasons") @db.Text
  decidedById            String?   @map("decided_by_id")
  decidedAt              DateTime? @map("decided_at")
  /// THE RECORD, INTERPRETED (decision 85, item 4; build step 12). What Groundwork understands from the
  /// record about the person's work in the review's period: the check-ins they took part in, the goals
  /// and work-plan items they own, what they committed to and how each was settled, and what they said
  /// was holding them up. Written once, from rows and without a model, when the review starts, so it
  /// reads the same whenever it is opened. Stored as facts with ids, never as sentences with names:
  /// each reader is served the sentences in their own words (suites/the-record-read-for-a-review.ts),
  /// and only the lines from check-ins they are in. Never hours, never leave.
  recordRead             Json?     @map("record_read")
  /// The first day of the period the record was read for. The last day is `startedAt`.
  recordFrom             DateTime? @map("record_from")
  /// THE APPEAL (decision 113, bug B-024). The person appeals a decided review, saying why; they may add to it
  /// until it is decided. It goes to an admin who is not whoever decided the review (and not the person).
  /// With no such admin it is saved and stays open, and `appealAskedForAdminAt` says the reviewer was asked to
  /// add one. Read by the person, the admin who decides it, and (once decided) the reviewer; nobody else.
  appeal                 String?   @map("appeal") @db.Text
  appealAdditions        Json?     @map("appeal_additions")
  appealedAt             DateTime? @map("appealed_at")
  appealAskedForAdminAt  DateTime? @map("appeal_asked_for_admin_at")
  appealOutcome          String?   @map("appeal_outcome")
  appealReasons          String?   @map("appeal_reasons") @db.Text
  appealDecidedById      String?   @map("appeal_decided_by_id")
  appealDecidedAt        DateTime? @map("appeal_decided_at")
  /// The decision and reasons as they stood before an appeal changed them, so nothing is lost.
  appealDecisionWas      Json?     @map("appeal_decision_was")

  organization Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  corrections  PerformanceReviewCorrection[]

  @@index([organizationId, personExternalId])
  @@map("performance_reviews")
}

/// THE PERSON'S CORRECTION OF ONE LINE OF THEIR REVIEW (build step 12). The person marks a line of
/// "the record, interpreted" as wrong and says what is true. It is kept beside the line and never
/// changes the line or the record it came from. A second correction of the same line is a new row, so
/// nothing the person said is lost; the latest is the one served. Who reads it is decided in
/// suites/the-reviews.service.ts: the person, and whoever may read that line.
model PerformanceReviewCorrection {
  id         String   @id @default(uuid())
  reviewId   String   @map("review_id")
  /// The line's key in `PerformanceReview.recordRead`.
  lineKey    String   @map("line_key") @db.VarChar(120)
  /// What the person says is true, in their own words.
  whatIsTrue String   @map("what_is_true") @db.Text
  byUserId   String   @map("by_user_id")
  createdAt  DateTime @default(now()) @map("created_at")

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, lineKey, createdAt])
  @@map("performance_review_corrections")
}

/// HOURS SPENT ON ONE CLIENT OR PROJECT ON ONE DAY (E3, the time sheets suite, U.17). FOR BILLING
/// ONLY (decisions rule 10): nothing here is evidence about how well anybody works, and nothing outside
/// the suites reads it, so it never reaches a check-in, its record or its report. Who reads which row is
/// decided in suites/the-time-sheets.service.ts. `client` is one of the names the admin listed when
/// switching the suite on.
model TimeEntry {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  client         String   @db.VarChar(120)
  onDay          DateTime @map("on_day") @db.Date
  minutes        Int
  /// Billable or not, as the person said of this one entry ("3 hours on Internal, not billable").
  /// Null: it follows the time sheet rules for its client or project (the-time-sheet-rules.ts), and
  /// with no rules set every hour is billable. For billing only (decision 10).
  billable       Boolean?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, onDay])
  @@index([organizationId, userId, onDay])
  @@map("time_entries")
}

/// ONE PERSON'S WEEK OF HOURS, APPROVED (E3, U.17): who approved it, when, and the total they saw.
/// Hours added after that make the week wait again, because the total no longer matches.
model TimeWeek {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  userId          String   @map("user_id")
  /// The Monday the week starts on.
  weekOf          DateTime @map("week_of") @db.Date
  /// The total the last step approved. Null until the last step approves (decision 85, build step 4).
