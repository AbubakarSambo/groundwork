/// ONE RECORD OF WHO DID WHAT ON A SUITE'S REQUEST (decision 85, build step 5): asked (after the
/// say-back and the yes), told, approved at a step, declined, passed on, started, decided. On what
/// information is kept as references to rows only, never a copy of anybody's words.
model SuiteEvent {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  /// leave, spend, time or reviews.
  suite          String   @db.VarChar(16)
  /// The request: a leave or spending request's id, a review's id, or for hours the person's sign-in and the week's Monday joined by "|".
  ref            String   @db.VarChar(200)
  /// asked, told, approved, declined, escalated, started, decided, questioned, answered, and for
  /// spending finance's verified, coded, evidence, exported and paid.
  kind           String   @db.VarChar(16)
  /// Who did it, by sign-in. Empty when Groundwork did it (telling, passing on).
  byUserId       String?  @map("by_user_id")
  /// Who it went to: who was told, or who it was passed to. Empty for any admin.
  toUserId       String?  @map("to_user_id")
  /// The approval step it happened at, from 0.
  step           Int?
  /// On what information, as references to rows only.
  basis          Json?
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, suite, ref, at])
  @@map("suite_events")
}

/// A QUESTION ABOUT A REQUEST, AND THE ANSWER (decision 85, build step 7). The person who decides a
/// request asks the person who made it, and the request keeps waiting. Both are in the words each of
/// them wrote, read only by the people who may read the request (the-leave-board.service.ts); the
/// record of who did what (`SuiteEvent`) keeps only that a question was asked and answered, with this
/// row's id.
model SuiteQuestion {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  /// leave or spend.
  suite          String    @db.VarChar(16)
  /// The request's id.
  ref            String    @db.VarChar(200)
  /// Who asked: the person who decides it.
  askedById      String    @map("asked_by_id")
  /// Who was asked: the person who made the request.
  toUserId       String    @map("to_user_id")
  question       String    @db.Text
  answer         String?   @db.Text
  askedAt        DateTime  @default(now()) @map("asked_at")
  answeredAt     DateTime? @map("answered_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, suite, ref])
  @@index([organizationId, toUserId, answeredAt])
  @@map("suite_questions")
}

/// EACH CHANGE OF A SUITE'S RULES (decision 85, build step 5): a suite switched on or off with its
