  startedById      String   @map("started_by_id")
  startedAt        DateTime @default(now()) @map("started_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        LeavingStep[]

  /// The name the 27 September migration actually created: Postgres cuts identifiers at 63 characters.
  @@unique([organizationId, personExternalId, lastDay], map: "leaving_checklists_organization_id_person_external_id_last_day_")
  @@map("leaving_checklists")
}

/// One step of a leaving list: handover, equipment, access or pay. Who owns it, and when it was done
