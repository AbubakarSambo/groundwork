  escalatedTo     Int       @default(0) @map("escalated_to")
  stepSince       DateTime? @map("step_since")
  approvedByIds   String[]  @default([]) @map("approved_by_ids")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, weekOf])
  @@map("time_weeks")
}

/// WHAT A CLIENT AGREED TO PAY FOR (E3, U.17): "Naivas Ngong Road: installing 12 freezers (whole job)",
