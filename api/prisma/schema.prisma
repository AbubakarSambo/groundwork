model SuiteRuleChange {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  /// The suite's key, or "duties", or "workflows".
  suite          String   @db.VarChar(24)
  changedById    String?  @map("changed_by_id")
  changedAt      DateTime @default(now()) @map("changed_at")
  /// What it was: { isOn, answers }, or nothing when it had never been set.
  before         Json?
  /// What it became: { isOn, answers }.
  after          Json

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, changedAt])
  @@map("suite_rule_changes")
}

/// The engine's text is written by the engine (docs/requests-to-engine.md, request 15), stored in
/// labels like a report, and named for each reader only when served. Who reads which column is
/// decided in suggestions.service.ts, never on the screen. `verdict` is served to nobody.
model Suggestion {
  id                 String @id @default(uuid())
  organizationId     String @map("organization_id")
  groundId           String @map("ground_id")
  /// The person the suggestion is about.
  aboutParticipantId String @map("about_participant_id")

  /// keep | reward | support | plan | exit. For the engine only; never served to anybody.
  verdict String @db.VarChar(16)

  /// For the lead: "Groundwork suggests a performance plan for Daniel".
  headline          String   @db.Text
  /// For the lead: why, from the facts.
  why               String   @db.Text
  whatWouldChangeIt String?  @map("what_would_change_it") @db.Text
  /// The person's own words from a check-in, which the people in that check-in may read.
  theirOwnAnswer    String?  @map("their_own_answer") @db.Text
  /// What the lead's decision would say if they agree, for them to change before saving.
  ifYouAgree        String?  @map("if_you_agree") @db.Text
  /// Other decisions the lead might choose instead.
  otherChoices      String[] @map("other_choices")
  /// Set when the suggestion is about how the check-in ends: the end state suggested.
  forTheEnding      String?  @map("for_the_ending") @db.VarChar(40)

  /// For the person it is about: the facts about their work, never the verdict.
  factsForThem             String  @map("facts_for_them") @db.Text
  whatWouldChangeItForThem String? @map("what_would_change_it_for_them") @db.Text

  /// Which version of the engine's instructions wrote it.
  promptVersionId String? @map("prompt_version_id")

  /// THE LEAD'S DECISION, with their reasons. The person reads both.
  decision       String?   @db.Text
  decisionReason String?   @map("decision_reason") @db.Text
  decidedById    String?   @map("decided_by_id")
  decidedAt      DateTime? @map("decided_at")

  /// WHEN THE PERSON CAUGHT UP (decision 75, item 24). Set when, before anyone decided, they are back at or
  /// above the threshold that reached this suggestion; cleared if they fall below it again before a decision.
  /// The original facts are never rewritten. Frozen once decided.
  caughtUpAt DateTime? @map("caught_up_at")

  /// THE PERSON'S SIDE, in their own words. The lead reads it beside the facts.
  theirSide   String?   @map("their_side") @db.Text
  theirSideAt DateTime? @map("their_side_at")

  /// THE PERSON'S APPEAL, and an admin's decision on it with the admin's reasons.
  appeal            String?   @db.Text
  appealedAt        DateTime? @map("appealed_at")
  /// stands | changed
  appealOutcome     String?   @map("appeal_outcome") @db.VarChar(16)
  appealReason      String?   @map("appeal_reason") @db.Text
  appealDecidedById String?   @map("appeal_decided_by_id")
  appealDecidedAt   DateTime? @map("appeal_decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  about  GroundParticipant @relation("SuggestionAbout", fields: [aboutParticipantId], references: [id], onDelete: Cascade)

  @@index([groundId])
  @@index([aboutParticipantId])
  @@index([organizationId, appealedAt])
  @@map("suggestions")
}

// Per-party end-state confirmation. A ground closes only when every ACTIVE party
// (one who accepted their invite) has confirmed the SAME end state. For two-party
// grounds this is exactly the old "both confirm" behaviour; for project / team
// grounds it generalises to N parties.
model ResolutionConfirmation {
  id            String   @id @default(uuid())
  resolutionId  String   @map("resolution_id")
  participantId String   @map("participant_id")
  endState      String   @map("end_state")
  confirmedAt   DateTime @default(now()) @map("confirmed_at")

  resolution  Resolution        @relation(fields: [resolutionId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([resolutionId, participantId])
  @@index([resolutionId])
  @@map("resolution_confirmations")
}

// ---------------------------------------------------------------------------
// The moat: versioned prompts + outcome data + anonymised cross-org learning
// ---------------------------------------------------------------------------

model PromptVersion {
  id          String    @id @default(uuid())
  key         String // e.g. "system", "report_synthesis", "scenario.drift"
  version     Int
  content     String    @db.Text
  summary     String?   @db.Text // change summary — every change is logged
  isActive    Boolean   @default(false) @map("is_active")
  activatedAt DateTime? @map("activated_at")
  // These two exist in the database and are RENDERED by the prompt-versioning
  // page (the draft badge and the "by <user>" line), but were missing from this
  // schema - so the API never returned them and both features were silently
  // dead. Declared rather than dropped: dropping would have destroyed data a
  // live surface still expects.
  isDraft     Boolean   @default(false) @map("is_draft")
  activatedBy String?   @map("activated_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  grounds Ground[]
  reports Report[]
  patternDetections PatternDetection[]

  @@unique([key, version])
  @@map("prompt_versions")
}

model Outcome {
  id              String        @id @default(uuid())
  groundId        String        @unique @map("ground_id")
  promptVersionId String?       @map("prompt_version_id")
  resolvedState   String        @map("resolved_state")
  moment          GroundMoment? // the data point: prompt version, moment, end state, session count
  sessionCount    Int?          @map("session_count")
  resolvable      Boolean? // learning signal: was this resolvable at session 1?
  notes           String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([promptVersionId])
  @@map("outcomes")
}

// Post-resolution feedback from each party: did this process help you reach a
// decision that felt fair and grounded in evidence? The seed of the learning loop.
model OutcomeFeedback {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String   @map("participant_id")
  feltFair      Boolean  @map("felt_fair")
  note          String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groundId, participantId])
  @@index([groundId])
  @@map("outcome_feedback")
}

/// WHEN A ROUND CLOSED, AS A FACT RATHER THAN A CALCULATION.
///
/// A round is complete when every participant who is not managing-only has a COMPLETED check-in at
/// that session number. That rule already existed - on the CLIENT, in GroundAdminPage, derived from
/// the check-in list on every render. Nothing on the server knew a round had closed, so nothing
/// could act on it: the delivery discipline of holding a report until everyone is in had no event
/// to hang on, and two screens computing the same rule separately is how they come to disagree.
///
/// The row IS the idempotency guard. `@@unique([groundId, roundNumber])` means the event fires
/// exactly once per round however many times a check-in is written to COMPLETED - which happens
/// from four places, including a cron that auto-closes stale sessions.
model RoundCompletion {
  id               String   @id @default(uuid())
  groundId         String   @map("ground_id")
  /// One integer, one name: the same number CheckIn.sessionNumber carries (fix plan B13).
  sessionNumber    Int      @map("session_number")
  /// How many people the session was waiting on when it closed. Kept because the participant list
  /// changes: somebody added later must not make a closed session look as though it reopened.
  participantCount Int      @map("participant_count")
  completedAt      DateTime @default(now()) @map("completed_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@unique([groundId, sessionNumber])
  @@index([groundId])
  @@map("round_completions")
}

/// HOW THE ASSISTANT APPEARS INSIDE A CUSTOMER'S OWN APPLICATION.
///
/// Their server mints a short-lived token for whoever is logged in; the widget exchanges it for a
/// Groundwork session. Their login is the only login - there is no Groundwork password for an end
/// user, and no second account for anybody.
///
/// THE SIGNING SECRET IS STORED, LIKE A WEBHOOK'S AND UNLIKE A CREDENTIAL'S, because it is used to
/// VERIFY rather than compared against a hash of something arriving. Same reasoning, opposite
/// direction: we hold it so we can check their signature.
model EmbedConfig {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Shared secret their server signs identity tokens with. HS256, because every language they
  /// might use has it built in and a key pair is a support burden for no gain at this size.
  signingSecret String @map("signing_secret")

  /// The domains the widget may be loaded from. This populates the frame-ancestors policy, so an
  /// empty list means the panel renders nowhere - which is the safe direction for a setting
  /// somebody has not finished filling in.
  allowedDomains String[] @map("allowed_domains")

  /// 'floating' or 'anchor'.
  placement String @default("floating")

  /// Departments whose people see NO launcher at all - not a disabled one, nothing. Matched against
  /// the department SCIM sends. Named for what a customer configures rather than for a role model
  /// that does not exist here yet.
  outOfScopeDepartments String[] @default([]) @map("out_of_scope_departments")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("embed_configs")
}

/// AN ORGANISATION'S OWN WHATSAPP NUMBER.
///
/// WhatsApp used to be one number for the whole platform, set in our environment and switched on by
/// us. A customer wants their sales team to check in on the organisation's own number, set up by
/// their admin at Connect. This is that connection: Meta's Cloud API ids and tokens for one org, the
/// secret their inbound webhooks are signed with, and the verify token Meta's subscribe handshake
/// answers. One per organisation; the platform number stays as the fallback for organisations
/// without one.
model WhatsAppConnection {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Meta's id for the phone number messages are sent from.
  phoneNumberId     String  @map("phone_number_id")
  /// The WhatsApp Business Account the number belongs to. Kept for the admin's reference.
  businessAccountId String? @map("business_account_id")
  /// The number itself, as the admin reads it. Display only.
  displayNumber     String? @map("display_number")
  /// The permanent system-user token Meta issued. Sends messages; never shown back after saving.
  accessToken       String  @map("access_token")
  /// The app secret inbound webhooks are signed with. Verified on every POST.
  appSecret         String  @map("app_secret")
  /// What Meta's subscribe handshake must echo. Ours to generate, theirs to paste into Meta.
  verifyToken       String  @map("verify_token")

  /// WHICH OF OUR TEMPLATE NAMES THIS ORGANISATION HAS HAD APPROVED, BY META, UNDER ITS OWN APP.
  ///
  /// Approval belongs to whoever owns the Meta app. On our own number that is us, and the names
  /// live in WHATSAPP_APPROVED_TEMPLATES. On an organisation's own number it is THEM - and the send
  /// path was reading our env var for their sends, so a customer who did everything right and got
  /// their own templates approved still had every business-initiated message recorded as not sent.
  ///
  /// The names are ours (a-message-outside-the-window.ts) because the product composes the bodies;
  /// what an organisation submits to Meta is those same names. This records which came back approved.
  approvedTemplates String[] @default([]) @map("approved_templates")

  enabled        Boolean   @default(true)
  connectedAt    DateTime  @default(now()) @map("connected_at")
  lastInboundAt  DateTime? @map("last_inbound_at")
  lastOutboundAt DateTime? @map("last_outbound_at")
  /// WHEN META LAST CHECKED THE CALLBACK ADDRESS AND IT ANSWERED (U.18, #/settings/whatsapp, step 3).
  /// Set by the subscribe handshake when the verify token matches. Null until then, and the setup
  /// page says "Not proven yet" rather than guessing.
  webhookVerifiedAt DateTime? @map("webhook_verified_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("whatsapp_connections")
}

/// WHICH CHECK-IN A WHATSAPP NUMBER IS TALKING TO. A person with two sessions open picks one from a
/// list; the pick is remembered here so every following message lands in the same one until it
/// closes. One row per number per organisation.
/// A LINE THE MODEL HAS ALREADY WORDED. The report, the session report and the board hand the
/// engine's drafts to the model for wording on every read, and the same drafts came back the same
/// way ten seconds later. Keyed by a hash of the style, the instruction and the draft, so an
/// unchanged record costs one lookup and a changed one costs one model call.
/// WHAT AN ACCOUNT SHOWS, MADE ONCE AND KEPT. One row per completed check-in per source hash: the
/// lead's read of that account against the check-in's purpose. Derived, never their words, never
/// evidence - see conversation/what-an-account-shows.ts. A changed transcript is a new hash and a
/// new read; an unchanged one is this row.
model WhatAnAccountShows {
  id            String   @id @default(uuid())
  checkInId     String   @map("check_in_id")
  groundId      String   @map("ground_id")
  participantId String   @map("participant_id")
  sourceHash    String   @map("source_hash")
  text          String   @db.Text
  withheld      Int      @default(0)
  derived       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([checkInId, sourceHash])
  @@index([groundId])
  @@map("what_an_account_shows")
}

model WordedLine {
  key       String   @id
  text      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("worded_lines")
}

/// EVERY OUTBOUND WHATSAPP MESSAGE, AND WHETHER IT WENT. A reply is composed AFTER the model call and
/// the session decrement, and a report after a synthesis and up to four polls - so a send that failed
/// silently was money spent on a message nobody received, and nothing anywhere recorded it. This row
/// is what makes a paid-for-and-undelivered message findable at all. Organisation null is the
/// platform number.
model WhatsAppSend {
  id             String    @id @default(uuid())
  organizationId String?   @map("organization_id")
  phone          String
  checkInId      String?   @map("check_in_id")
  kind           String?
  sentAt         DateTime? @map("sent_at")
  failedAt       DateTime? @map("failed_at")
  status         Int?
  error          String?   @db.Text
  /// The id Meta gave the message (decision 106 item 1). A reply to it carries this id, so it reaches the check-in it was about.
  providerMessageId String? @map("provider_message_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([failedAt])
  @@index([providerMessageId])
  @@map("whatsapp_sends")
}

/// HOW MANY WHATSAPP MESSAGES AN ORGANISATION SENT IN ONE CALENDAR MONTH (decision 78), counted as
/// they go, so the plan's monthly limit can be held. `month` is the calendar month in UTC, as
/// "2026-10". `held` counts messages that were not sent because of the add-on or the limit.
/// `adminToldAt` is when the organisation's admins were told the limit was reached, so they are told once.
model WhatsAppMonthlyUse {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  month          String
  sent           Int       @default(0)
  held           Int       @default(0)
  adminToldAt    DateTime? @map("admin_told_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, month])
  @@map("whatsapp_monthly_use")
}

model WhatsAppThread {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  phone          String
  /// Null while the person has been asked which check-in and has not yet said.
  checkInId      String?   @map("check_in_id")
  /// When the "which one?" list was sent. A typed number is a pick only while this is fresh (a-whatsapp-message-is-routed.ts).
  pickPendingAt  DateTime? @map("pick_pending_at")
  /// A leave, hours or spending request asked about during a check-in ("Shall I treat this as a leave
  /// request?"), waiting for the person's yes or no (decision 82, item 2). Kept here, not in one copy
  /// of the API's memory, so the answer finds it after a restart or on another copy. The kind
  /// (`leave`, `hours`, `spending`), the words (the yes hands them to Ask Groundwork, the no puts them
  /// in the check-in), and when it was asked. All three are cleared on the answer. After ten minutes with no answer, the next message puts the words in the check-in.
  /// The kind `answer` is a reply that may be the person's answer to a question about their own request.
  requestKind    String?   @map("request_kind")
  requestWords   String?   @map("request_words")
  requestAskedAt DateTime? @map("request_asked_at")
  /// The question about the person's own request (a `SuiteQuestion` id) they were already asked about
  /// here, "Is this your answer to Wairimu's question about your leave?" (decision 85, build step 7).
  /// While `requestKind` is `answer`, it is the question the held words would answer. It stays after
  /// a no, so the same question is asked about once only.
  questionAskedAbout String? @map("question_asked_about")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([organizationId, phone])
  @@index([requestAskedAt])
  @@map("whatsapp_threads")
}

/// A REDELIVERED WHATSAPP MESSAGE IS NOT A SECOND ANSWER. Meta redelivers when it does not get a 200
/// in time; each redelivery was another model turn, another slot against the answer ceiling and, on
/// a session not yet opened, another session spent. The handler claims the message id here first.
model WhatsAppInboundMessage {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  messageId      String   @map("message_id")
  handledAt      DateTime @default(now()) @map("handled_at")

  @@unique([organizationId, messageId])
  @@map("whatsapp_inbound_messages")
}

/// WHICH ORGANISATION A NUMBER WRITING TO THE PLATFORM NUMBER MEANS. The platform webhook has no
/// organisation in its URL; the sender's number is looked up on every roster and, when it is on more
/// than one, the person is asked and the answer is kept here. One row per phone.
model WhatsAppOrganisationPick {
  phone          String    @id
  organizationId String?   @map("organization_id")
  pickPendingAt  DateTime? @map("pick_pending_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("whatsapp_organisation_picks")
}

/// ONE CREDENTIAL PAIR PER INTEGRATION, SO ONE CAN BE REVOKED WITHOUT KILLING THE OTHERS.
///
/// A customer connecting their OKR tool, their HRIS and a script somebody wrote gets three of
/// these. Sharing one pair across all three means the day the script leaks, revoking it takes the
/// HRIS down too - so the customer does not revoke, and a leaked credential stays live because
/// turning it off costs too much.
///
/// THE SECRET IS NOT HERE. Only its hash is, exactly as with a password: this table is readable by
/// anyone who can read the database, and a stored secret is a stored secret whatever it authorises.
/// It is shown once at issue and never again, and the console offers rotation rather than recovery.
model ApiCredential {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  /// What this pair is for, in the customer's words. Shown in the console beside its last use, so
  /// revoking is a decision somebody can actually make.
  name             String
  clientId         String @unique @map("client_id")
  clientSecretHash String @map("client_secret_hash")
  /// What it may do. Chosen at issue and never widened by a request - a token can only ever ask for
  /// a subset of what its credential already holds.
  /// THE SYSTEM THIS CREDENTIAL SPEAKS FOR, AND NOT THE CREDENTIAL ITSELF.
  ///
  /// A roster belongs to a system — "workday", "bamboohr" — and `Person` is keyed on it. This used
  /// to be the `clientId`, which is random on every issue, so rotating a credential changed the
  /// identity of every person in the organisation and the next sync duplicated the whole roster
  /// silently. Existing credentials keep their clientId here, because that is what their people
  /// were written under. See `people/whose-roster-is-this.ts`.
  sourceSystem     String @map("source_system")

  /// THE CREDENTIAL THAT TOOK OVER FROM THIS ONE.
  ///
  /// Set by Replace. Rotating is three steps — issue, deploy, revoke — and the middle one is a
  /// person going away to change a config file. Without this the page cannot tell the difference
  /// between "still in use" and "replaced and forgotten", and a superseded key stays live for
  /// months because nobody remembers which of the two the integration is actually using.
  replacedByClientId String? @map("replaced_by_client_id")

  scopes String[]

  /// WHOSE WORK THIS CREDENTIAL MAY SEE, when it should not see all of it.
  ///
  /// Scopes say what a token may DO. They said nothing about whom to, so a credential that could read
  /// findings read every finding in the organisation - and a sales integration and an engineering one
  /// were the same integration with different names.
  ///
  /// Empty means the whole organisation, which is what every existing credential means and what a
  /// single-team customer wants. A non-empty list is a fence: only these people's records, and only
  /// check-ins they are on.
  boundToPersonExternalIds String[]  @default([]) @map("bound_to_person_external_ids")
  /// Last authenticated use, for the console. Written on token issue rather than on every call:
  /// the question it answers is "is this integration alive", and per-request writes would put a
  /// write on the hot path of every read.
  lastUsedAt               DateTime? @map("last_used_at")
  revokedAt                DateTime? @map("revoked_at")
  createdByUserId          String?   @map("created_by_user_id")
  createdAt                DateTime  @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("api_credentials")
}

/// A WRITE THAT ARRIVED TWICE MUST NOT HAPPEN TWICE.
///
/// Their system retries. A network timeout on our side looks identical to a refusal from theirs, so
/// a well-behaved integration retries a push it cannot confirm - and without this, a retried bulk
/// import is a second import. The key is theirs, the window is 24 hours, and the stored response is
/// replayed verbatim so a retry is indistinguishable from the original call.
/// A STRIPE EVENT WE COULD NOT HANDLE, KEPT SO IT IS NOT LOST. The webhook used to let a throw become
/// a non-2xx, so a deterministic failure stuck for ever with Stripe retrying and nobody told. Now the
/// event is written here with what went wrong, Stripe is answered 200, and the hourly retry works
/// from this record. `resolvedAt` is set when a retry succeeds; a platform admin can list the rest.
model StripeEventFailure {
  id          String    @id @default(uuid())
  eventId     String    @unique @map("event_id")
  eventType   String    @map("event_type")
  error       String    @db.Text
  payload     Json
  attempts    Int       @default(1)
  lastTriedAt DateTime  @default(now()) @map("last_tried_at")
  resolvedAt  DateTime? @map("resolved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([resolvedAt, lastTriedAt])
  @@map("stripe_event_failures")
}

model IdempotencyRecord {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  key                String
  /// Method and path, so the same key on a different call is a client error rather than a silent
  /// replay of an unrelated response.
  endpoint           String
  /// A HASH OF THE REQUEST BODY, and the field that makes this safe rather than dangerous.
  ///
  /// Without it, the same key arriving with a DIFFERENT payload replays the first response - so a
  /// client generating one key per retry loop rather than per operation pushes five hundred
  /// subjects, gets five hundred cheerful 200s, and stores one. Their write is not refused, it is
  /// answered with somebody else's answer. Found by sending two different bodies under one key on
  /// the running server and watching the second come back as the first.
  requestFingerprint String   @map("request_fingerprint")
  statusCode         Int      @map("status_code")
  responseBody       Json     @map("response_body")
  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([organizationId, key, endpoint])
  @@index([createdAt])
  @@map("idempotency_records")
}

/// WHERE A CUSTOMER WANTS TO BE TOLD, AND HOW THEY KNOW IT WAS US.
///
/// THE SECRET IS STORED, NOT HASHED, and that is a real difference from `ApiCredential`. A
/// credential is verified - we compare what arrives against a hash and never need the original. A
/// webhook secret is USED: every delivery is signed with it, so it has to be recoverable. It is
/// therefore a genuine secret at rest in this table, which is why rotation exists, why the old
/// secret keeps working for a grace window, and why this note is here rather than the difference
/// being left for somebody to notice.
model WebhookEndpoint {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  url            String
  secret         String
  /// The previous secret, still accepted for a grace window so rotation needs no downtime.
  previousSecret String?   @map("previous_secret")
  rotatedAt      DateTime? @map("rotated_at")
  /// Which events this endpoint wants. Empty means none - never "all", because a customer who adds
  /// an endpoint and forgets to choose should get silence rather than everything we ever emit.
  events         String[]
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")

  /// WHEN SOMEBODY REMOVED IT, rather than the row being deleted.
  ///
  /// `remove` was a hard delete, and deliveries cascade off this row — so removing an endpoint
  /// took the entire delivery log with it. That log is the only record of what we sent a customer
  /// and whether it arrived, and it is exactly what somebody asks for after an incident: "did you
  /// send us the event or not". Removing an endpoint is a decision about the FUTURE, so it stops
  /// deliveries and keeps the history.
  removedAt DateTime? @map("removed_at")

  /// When we last told this customer that deliveries to this endpoint are dying.
  ///
  /// Seven attempts over about twenty-one hours and then DEAD, with a warning in our own logs and
  /// nothing that reaches the customer. Their integration silently stops receiving. One notice per
  /// endpoint per day, because a broken endpoint produces a dead delivery for every event.
  deadNoticeAt DateTime? @map("dead_notice_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  /// Attempt failed; it will be retried.
  FAILED
  /// Out of attempts. Kept, and visible - a dead letter nobody can see is a lost message.
  DEAD
}

/// EVERY ATTEMPT, KEPT AND VISIBLE.
///
/// The delivery log is not diagnostics for us - it is the thing a customer opens when their system
/// did not do what they expected, and the question is always the same: did you send it, and what
/// did we say back. So the response code and body are recorded, including on success, and a dead
/// letter stays in the table rather than being cleaned up.
model WebhookDelivery {
  id             String                @id @default(uuid())
  organizationId String                @map("organization_id")
  endpointId     String                @map("endpoint_id")
  /// Stable across retries, so a receiver can dedupe. THE SAME id is replayed, deliberately.
  eventId        String                @map("event_id")
  eventType      String                @map("event_type")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  lastAttemptAt  DateTime?             @map("last_attempt_at")
  /// When it is next due. Null once delivered or dead.
  nextAttemptAt  DateTime?             @map("next_attempt_at")
  responseCode   Int?                  @map("response_code")
  /// Truncated. Somebody else's error page can be a megabyte of HTML.
  responseBody   String?               @map("response_body") @db.Text
  createdAt      DateTime              @default(now()) @map("created_at")

  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([organizationId, createdAt])
  @@map("webhook_deliveries")
}

enum ImportJobState {
  QUEUED
  RUNNING
  /// Finished. NOT the same as "everything worked" - see `failed`.
  COMPLETED
  /// The job itself died. Individual bad rows do not put a job here.
  ABANDONED
}

/// A BULK IMPORT, AND WHAT IT COULD NOT TAKE.
///
/// The interesting half of this model is the failures, not the counts. A customer pushing four
/// thousand objectives where row 2,847 is malformed must not be told "3,999 succeeded" and left to
/// find the other one: a summary count is a report that something is wrong with no way to act on
/// it, which is worse than a plain error because it looks like it was handled.
///
/// So the job SKIPS AND REPORTS rather than halting or rolling back. Halting means one bad row
/// blocks the other 3,999 for however long it takes a human to notice. Rolling back means the same,
/// plus the customer's whole sync has to be re-run for a typo. Skipping is the only option that
/// leaves them with working data and a specific list of what to fix.
model ImportJob {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  sourceSystem   String         @map("source_system")
  kind           String
  state          ImportJobState @default(QUEUED)

  total     Int @default(0)
  succeeded Int @default(0)
  failed    Int @default(0)

  /// THE ROWS THEMSELVES, so a restart does not lose them.
  ///
  /// The work used to run from the request body held in memory. A deploy mid-import left the job
  /// RUNNING forever and the remaining rows gone - not failed, not retryable, GONE, because the
  /// only copy was in a process that no longer existed, while the customer's system held a 200
  /// saying the import had started.
  ///
  /// Null once the job finishes, because keeping every batch forever would make this table the
  /// largest thing in the database for no reason after the fact.
  payload     Json?
  /// How many rows of `payload` have been attempted. Where a resumed job picks up.
  cursor      Int       @default(0)
  /// Touched on every batch of progress, so a job whose process died can be told from a slow one.
  heartbeatAt DateTime? @map("heartbeat_at")

  /// Why the job as a whole died, if it did. Null when individual rows failed but the job ran.
  error       String?   @db.Text
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  failures     ImportJobFailure[]

  @@index([organizationId, createdAt])
  @@map("import_jobs")
}

/// ONE ROW THAT COULD NOT BE TAKEN, NAMED SPECIFICALLY ENOUGH TO FIX.
///
/// The position AND the external id, because either alone is not enough: a customer whose file has
/// no ids yet cannot use the id, and one whose rows were reordered cannot use the position.
model ImportJobFailure {
  id         String  @id @default(uuid())
  jobId      String  @map("job_id")
  /// Zero-based position in the batch as it was sent.
  index      Int
  externalId String? @map("external_id")
  /// The reason, in the words the customer would need to fix it - never a stack trace.
  message    String  @db.Text

  job ImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("import_job_failures")
}

/// DETECTION HOLDS ITS TONGUE WHILE A CUSTOMER'S DATA ARRIVES.
///
/// A first sync of several thousand objectives trips every detector at once. Day one of a
/// deployment then looks like a wall of findings about work nobody has discussed yet, and the
/// customer reasonably concludes the tool is broken.
///
/// STAMPED AT IMPORT TIME, WHICH IS THE WHOLE POINT. No detector exists yet to be suppressed. If
/// this were computed when detectors arrive, the first customer's window would already be over -
/// the import that should have started it happened months earlier and left no trace. Recording it
/// now costs a row and is the only version that works later.
model DetectionQuietPeriod {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  /// INITIAL_IMPORT for an org's first, BULK_IMPORT for any later one above the threshold.
  reason         String
  /// What triggered it, so an admin asking "why is it quiet" gets an answer rather than a date.
  importJobId    String?  @map("import_job_id")
  subjectCount   Int      @map("subject_count")
  startedAt      DateTime @default(now()) @map("started_at")
  endsAt         DateTime @map("ends_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, endsAt])
  @@map("detection_quiet_periods")
}

enum DraftState {
  DRAFTING
  /// Colleagues have been pulled in and are answering in their own conversations.
  GATHERING
  /// Somebody disagrees on a field that matters. Cannot reach READY from here.
  CONTESTED
  READY
  SEEDED
  ABANDONED
}

/// AN OBJECTIVE BEING WRITTEN, BEFORE IT IS ONE.
///
/// Most objectives are written in a planning session with no memory of what happened last cycle.
/// This has that memory - `groundedOnFindingIds` holds the findings it was built from, so "why is
/// the target fourteen days" has an answer six months later instead of a shrug.
///
/// A record rather than a conversation, because a draft that lives only in a chat cannot be shown,
/// resumed, or reasoned about - and the whole point is that several people write it without a
/// meeting.
model ObjectiveDraft {
  id                      String  @id @default(uuid())
  organizationId          String  @map("organization_id")
  /// Who started it, as an identity id.
  initiatorExternalId     String  @map("initiator_external_id")
  /// The org objective this one hangs under, where it cascades from one.
  parentSubjectExternalId String? @map("parent_subject_external_id")

  workingTitle            String    @map("working_title")
  proposedMeasure         String?   @map("proposed_measure")
  proposedTarget          String?   @map("proposed_target")
  proposedOwnerExternalId String?   @map("proposed_owner_external_id")
  proposedDueDate         DateTime? @map("proposed_due_date")

  /// WHY THIS NUMBER, AND HOW IT WILL BE MOVED.
  ///
  /// The draft agreed a measure and a target and neither says either. The seed
  /// gate checked that people AGREED, which is a different thing from the
  /// objective being any good: six people can agree on a number none of them
  /// can explain.
  proposedJustification String? @map("proposed_justification") @db.Text
  proposedApproach      String? @map("proposed_approach") @db.Text

  /// The prior-cycle evidence this was built from. A draft carries its own reasons.
  groundedOnFindingIds String[] @map("grounded_on_finding_ids")

  state                   DraftState @default(DRAFTING)
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  seededSubjectExternalId String?    @map("seeded_subject_external_id")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  participants  DraftParticipant[]
  contributions DraftContribution[]
  contentions   DraftContention[]

  @@index([organizationId, state])
  @@map("objective_drafts")
}

enum DraftParticipantState {
  INVITED
  RESPONDED
  /// A first-class outcome. Declining is an answer, and recording it as silence would make somebody
  /// who said no indistinguishable from somebody who never saw it.
  DECLINED
}

model DraftParticipant {
  id                  String                @id @default(uuid())
  draftId             String                @map("draft_id")
  personExternalId    String                @map("person_external_id")
  invitedByExternalId String                @map("invited_by_external_id")
  state               DraftParticipantState @default(INVITED)
  invitedAt           DateTime              @default(now()) @map("invited_at")
  respondedAt         DateTime?             @map("responded_at")

  draft ObjectiveDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([draftId, personExternalId])
  @@map("draft_participants")
}

/// WHAT ONE PERSON SAID THE OBJECTIVE SHOULD BE.
///
/// Each contributor's own conversation is their own - they see the emerging draft and never each
/// other's turns. This is the part of what they said that was ABOUT the draft, which is a different
/// thing from a transcript and is the only part anybody else sees.
model DraftContribution {
  id               String   @id @default(uuid())
  draftId          String   @map("draft_id")
  personExternalId String   @map("person_external_id")
  /// Which field they were speaking to: 'title' | 'measure' | 'target' | 'dueDate' | 'general'.
  field            String
  body             String   @db.Text
  createdAt        DateTime @default(now()) @map("created_at")

  draft ObjectiveDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, field])
  @@map("draft_contributions")
}

/// WHERE PEOPLE DO NOT AGREE, HELD OPEN RATHER THAN SETTLED.
///
/// THIS IS THE OUTPUT, NOT AN ERROR STATE. If the initiator proposes fourteen days and a
/// contributor says that was never achievable, the draft carries the disagreement - it does not
/// average them, and it does not let the initiator's version stand because they typed first.
///
/// Divergence detection at the moment it is worth most: before an objective is set, rather than
/// three months into failing it.
model DraftContention {
  id         String    @id @default(uuid())
  draftId    String    @map("draft_id")
  field      String
  /// Each position and who holds it. Visible to the people drafting, which is the point of it -
  /// they are trying to agree, and cannot without knowing what the other one thinks.
  positions  Json
  openedAt   DateTime  @default(now()) @map("opened_at")
  resolvedAt DateTime? @map("resolved_at")
  /// What they settled on, once they settle.
  resolution String?

  draft ObjectiveDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, resolvedAt])
  @@map("draft_contentions")
}

enum RecommendationState {
  PROPOSED
  ACCEPTED
  DECLINED
  /// Overtaken. The gap closed on its own before anybody acted on it.
  EXPIRED
}

/// WORK THIS OBJECTIVE NEEDS THAT NOBODY HAS PICKED UP.
///
/// The turn from a tool that observes work into one that generates it, and the line it must not
/// cross is doing so silently. It PROPOSES; a person accepts; the acceptance is recorded. Nothing
/// here creates work on somebody's behalf, and a recommendation nobody accepted is a suggestion
/// that was made and declined rather than a task somebody now owes.
///
/// EVERY ONE CARRIES THE GAP IT CLOSES. A proposal a person cannot interrogate is one they either
/// take on faith or ignore, and both are worse than not making it - so `rationale` holds what was
/// observed, in the same shape a finding does, and `sourceDetectorIds` points at the findings it
/// came from.
model Recommendation {
  id                String  @id @default(uuid())
  organizationId    String  @map("organization_id")
  /// 'todo' | 'objective_draft' | 'owner_needed' | 'dependency_record' | 'conversation_needed'.
  kind              String
  subjectExternalId String? @map("subject_external_id")
  /// Who it is for, where it is for somebody in particular. Null for a gap that is nobody's yet -
  /// which is most of the interesting ones.
  personExternalId  String? @map("person_external_id")

  /// What is being suggested, in a sentence somebody would say.
  body              String   @db.Text
  /// What was observed. Never a score, never a judgement - the same discipline as a finding.
  rationale         Json
  sourceDetectorIds String[] @map("source_detector_ids")

  state                RecommendationState @default(PROPOSED)
  proposedAt           DateTime            @default(now()) @map("proposed_at")
  resolvedAt           DateTime?           @map("resolved_at")
  /// Who accepted or declined it. A recommendation acted on has somebody's name against it.
  resolvedByExternalId String?             @map("resolved_by_external_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
  @@index([organizationId, subjectExternalId])
  @@map("recommendations")
}

/// HOW SOMEBODY COMES TO BE CARRYING A PIECE OF WORK.
enum ContributionKind {
  /// From the imported graph. What their tool says.
  ASSIGNED
  /// They described doing this work themselves.
  STATED
  /// Somebody else described them doing it.
  REFERENCED
  /// They cleared a blocker for somebody on it. Not produced yet - there are no blockers.
  UNBLOCKING
}

/// WHO IS ACTUALLY CARRYING THE WORK, AS AGAINST WHO THE ORG CHART SAYS.
///
/// The two differ, and the difference is invisible to every tool in the customer's stack: theirs
/// knows who is assigned, and only the conversations know who is doing it.
///
/// WHAT THIS DELIBERATELY DOES NOT HOLD is who said it. A REFERENCED contribution means somebody
/// else described this person doing this work - and storing WHICH somebody would be attributed
/// testimony sitting in a table, one careless serialiser away from leaving the boundary. The fact
/// that matters is that other people describe them doing it; which colleague said so is not ours to
/// keep, and a count cannot be turned back into a quote.
///
/// Not a ranking of people. Two findings come off this - somebody carrying load with no formal
/// place, and somebody formally on work they are never mentioned in - and both are about how the
/// WORK is distributed rather than about how hard anybody is trying.
model Contribution {
  id                String           @id @default(uuid())
  organizationId    String           @map("organization_id")
  personExternalId  String           @map("person_external_id")
  subjectExternalId String           @map("subject_external_id")
  kind              ContributionKind

  /// How many times this was seen. For REFERENCED, how many DISTINCT other people described it -
  /// one colleague saying it four times is one person's opinion, not four.
  weight   Int   @default(1)
  /// What was seen, in a shape that cannot be turned back into who said it.
  evidence Json?

  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personExternalId, subjectExternalId, kind])
  @@index([organizationId, subjectExternalId])
  @@index([organizationId, personExternalId])
  @@map("contributions")
}

/// A BEHAVIOUR SEEN, ACCUMULATED ACROSS GROUNDS AND AGAINST A SUBJECT.
///
/// ONE VOCABULARY, TWO SCOPES. `PatternDetection` stays exactly as it is and stays authoritative
/// inside its ground - the thirty-eight codes, the three-period rule and the collusion confirmation
/// are earned. This is the same code seen from org level, which is the only place a behaviour can
/// be tied to a piece of the customer's own work or watched across more than one check-in.
///
/// Additive. Nothing in the live product reads this; grounds write it alongside what they already
/// write, and if the org layer turns out to be the wrong shape, deleting it loses nothing.
///
/// NEVER A VERDICT. Same rule as the codes it carries: this is a reason to have a conversation, and
/// what leaves the API is the evidence rather than a judgement about a person - see §12.8 and the
/// serialiser that enforces it.
model DetectorResult {
  id                String  @id @default(uuid())
  organizationId    String  @map("organization_id")
  /// The identity system's id, so a finding survives somebody having no Groundwork account.
  personExternalId  String? @map("person_external_id")
  /// What it is about, where it is about a piece of work rather than a person.
  subjectExternalId String? @map("subject_external_id")

  /// An existing pattern code (D1, B9, R1...) or one of the genuinely new keys. One namespace.
  key        String
  severity   String @default("medium")
  /// What was seen, in a shape a person could check. Never a score.
  evidence   Json
  /// How sure, where that can be said. Null where it cannot, rather than a made-up number.
  confidence Float?

  /// Which ground it was mirrored from, when it came from one. A pointer; the ground's own row
  /// stays authoritative for the ground.
  sourceGroundId           String? @map("source_ground_id")
  sourcePatternDetectionId String? @unique @map("source_pattern_detection_id")

  firstSeenAt DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  resolvedAt  DateTime? @map("resolved_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, key, resolvedAt])
  @@index([organizationId, subjectExternalId])
  @@index([organizationId, personExternalId])
  @@map("detector_results")
}

/// WHAT KIND OF THING A KNOWLEDGE CARD HOLDS.
///
/// The customer's own configuration and working material, so "how we work here" can be asked
/// instead of living in one person's head. A large part of what they are buying.
enum KnowledgeKind {
  OBJECTIVE
  PRODUCT_MAP
  ROLE_BRIEF
  HANDBOOK
  ONBOARDING_BRIEF
  COMMITMENT_NORM
  BENCHMARK
  PLAYBOOK
  DOCUMENT
  DECISION_RECORD
  RESOURCE
}

/// SOMETHING THE ORGANISATION HAS DECIDED, AS IT STOOD AT A POINT IN TIME.
///
/// VERSIONED BY SUPERSESSION, NEVER UPDATED IN PLACE. A finding from March has to be explainable by
/// the handbook as it stood in March, and a card edited in place makes that impossible - the
/// evidence changes underneath the conclusion and nobody can tell it happened. So a substantive
/// change writes a NEW card and closes the old one's `effectiveTo`.
///
/// A typo is different and `PATCH` exists for it: fixing "recieve" does not create a new version of
/// the truth, and forcing one would fracture the effective-date history for no gain.
///
/// `key` is the customer's own name for the thing and is stable across versions. `(org, key)` is
/// therefore NOT unique - the whole history lives under one key, and exactly one row of it has a
/// null `effectiveTo`.
model KnowledgeRetrieval {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  personExternalId String   @map("person_external_id")
  /// What was asked, so a bad retrieval can be reproduced.
  query            String   @db.Text
  /// The cards, in the order they were ranked, with their scores.
  cards            Json
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("knowledge_retrievals")
}

model KnowledgeCard {
  id             String        @id @default(uuid())
  organizationId String        @map("organization_id")
  kind           KnowledgeKind
  /// Stable across versions. Their name for it: "expenses", "on-call", "how we price".
  key            String
  title          String
  body           String        @db.Text
  /// Where it came from, in their words - a wiki url, a document name. Never fetched.
  sourceRef      String?       @map("source_ref")

  version        Int     @default(1)
  /// The card that replaced this one. Set when superseded, so a chain can be walked either way.
  supersededById String? @unique @map("superseded_by_id")

  effectiveFrom DateTime  @default(now()) @map("effective_from")
  /// Null on the current version, and exactly one version per key may have it null.
  effectiveTo   DateTime? @map("effective_to")

  /// Where a card arrived by API rather than being written in the console.
  externalId   String?   @map("external_id")
  sourceSystem String?   @map("source_system")
  syncedAt     DateTime? @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
  @@index([organizationId, key, effectiveFrom])
  /// TRIGRAM, WHICH IS WHY THIS NEEDS SAYING TWICE.
  ///
  /// Retrieval matches a question against card titles and bodies with `pg_trgm` - a plain btree
  /// index cannot serve that, and without these it is a sequential scan over every card in the
  /// organisation. They lived only in SQL, so Prisma did not know they existed and the next
  /// generated migration would have dropped them: the product would simply have got slower, with
  /// nothing to point at.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([body(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("knowledge_cards")
}

/// WHICH CARDS WENT INTO WHICH REPLY.
///
/// So an admin who thinks an answer is wrong can trace it to the card that produced it, rather than
/// to a model that cannot be asked. Without this, "why did it say that" has no answer at all, and
/// the honest response to a customer would be a shrug.
/// SOMEBODY ASKING THAT A DOCUMENT BECOME "HOW WE DO IT HERE".
///
/// A document uploaded to a check-in belongs to that check-in and to whoever uploaded it. That is
/// right for somebody's own evidence and wrong for the contracting process, which everybody should
/// be working from - and until now the only way to make one organisation-wide was to push it
/// through the machine API, which most customers will never do.
///
/// PROPOSING IS NOT APPROVING, and the gap between them is the point. An ordinary document is
/// somebody's file. An approved one becomes what people's own accounts get held up against when
/// they walk through a process, so making one is a small piece of authority and it sits with the
/// person who holds the account.
///
/// WHO MAY PROPOSE: anybody who can open a check-in - an admin or a lead. They are the people
/// describing how their part of the company works. Somebody who only takes part in check-ins is
/// not setting process and does not propose.
/// HOW STRONG A PIECE OF EVIDENCE IS.
///
/// The whole point of keeping it. "A transaction completed", "the sales app recorded a visit and a
/// note", "a calendar entry existed" and "they told us" are four different claims, and a product
/// that flattens them into "evidence says" will tell a CEO something it cannot support.
enum EvidenceStrength {
  /// Something happened that could not have happened otherwise. A payment, a signed contract.
  COMPLETED
  /// A record in a system somebody operates, written at the time. A logged visit with a note.
  RECORDED
  /// Evidence that something was ARRANGED, which is not evidence that it happened. A calendar entry.
  ARRANGED
  /// Somebody's own account. The commonest kind, and a real kind - it is just not corroboration.
  SELF_REPORTED
}

/// WHAT KIND OF THING HAPPENED WITH SOMEBODY OUTSIDE THE ORGANISATION.
///
/// Deliberately short and deliberately not a sales taxonomy. These are the shapes a piece of
/// evidence takes, not stages of a pipeline - there is no LEAD, no QUALIFIED, no CLOSED_WON here
/// and there must not be, because that is a CRM's job and this is not a CRM.
enum InteractionKind {
  VISIT
  CALL
  MESSAGE
  MEETING
  PROPOSAL
  TRANSACTION

  /// TECHNICAL WORK, WHICH IS THE SAME PROBLEM AS A CUSTOMER VISIT AND WAS NOT ASKED ABOUT.
  ///
  /// "The feature is shipped" is one sentence covering eight different states, and a company whose
  /// leaders cannot read the code has no way to tell which one is meant. These are the states that
  /// leave a record somebody else wrote: a merge happened, a test run happened, a deploy happened.
  ///
  /// They are kinds of Interaction rather than a new table because an interaction is already
  /// exactly this - a thing that happened, at a time, with a strength saying how well it is
  /// evidenced. A deploy log is a system's own record; a screenshot of one is somebody's account.
  /// That distinction is `EvidenceStrength` and it needed no changing at all.
  MERGE
  TEST_RUN
  DEPLOY
  RELEASE
  INCIDENT
}

/// SOMETHING THAT HAPPENED WITH A CUSTOMER, AND WHAT WE ACTUALLY KNOW ABOUT IT.
///
/// The missing edge. A check-in could hold what somebody SAID they did and had no way to hold what
/// a system recorded - so "did he visit the shop" was unanswerable, and the honest version of the
/// product could only ever narrate self-reports.
///
/// THREE CLAIMS THAT MUST STAY SEPARATE. That somebody was at a shop, that a conversation happened,
/// and that a meaningful conversation happened are three different things, and no evidence here
/// proves the third. `kind` and `strength` together are what stop a report claiming it: a VISIT at
/// RECORDED strength says a visit was logged, and nothing more.
///
/// NO CONVERSATION CONTENT. `note` is the short line somebody wrote at the time - "owner not in",
/// "asked for pricing". What was said belongs to the people who said it.
model Interaction {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  /// Whose work this was, by the customer's own id for them. Same identifier SCIM uses.
  personExternalId       String  @map("person_external_id")
  /// Which counterparty, by the id the customer's system knows it as. Null where none was named.
  counterpartyExternalId String? @map("counterparty_external_id")

  kind     InteractionKind
  strength EvidenceStrength

  /// When it happened, as THEIR system observed it - never when we heard about it.
  happenedAt DateTime @map("happened_at")

  /// The short line written at the time. Never a transcript and never what was said.
  note String? @db.Text

  /// WHERE THIS CAME FROM. A record with no provenance is a rumour with a timestamp.
  sourceSystem String  @map("source_system")
  externalId   String? @map("external_id")

  /// SOMEBODY SAYS THIS IS WRONG.
  ///
  /// External evidence is not infallible: an app fails, a shop is duplicated, a call happens on a
  /// phone nothing is connected to. The person's account is kept BESIDE the record and neither
  /// overrules the other - a discrepancy preserved is worth more than a certainty invented.
  disputedAt   DateTime? @map("disputed_at")
  disputedById String?   @map("disputed_by_id")
  disputeNote  String?   @map("dispute_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// Pushing the same record twice updates it rather than doubling somebody's activity.
  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, personExternalId, happenedAt])
  @@index([organizationId, counterpartyExternalId, happenedAt])
  @@map("interactions")
}

model KnowledgeProposal {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  /// The document being proposed. Kept as a pointer so the words stay where they were written.
  documentId   String @map("document_id")
  /// Who asked. Shown to the admin deciding, because who is proposing it is part of the decision.
  proposedById String @map("proposed_by_id")

  /// PENDING | APPROVED | DECLINED.
  status String @default("PENDING")

  /// The admin who decided, and when. Null while it waits.
  decidedById   String?   @map("decided_by_id")
  decidedAt     DateTime? @map("decided_at")
  /// Why it was declined, in their words. Shown to whoever proposed it - a decision with no reason
  /// reads as the product losing it.
  declineReason String?   @map("decline_reason") @db.Text

  /// The card this became, once approved. The key `KnowledgeCard` is stored under.
  cardKey String? @map("card_key")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  document     GroundDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  /// One live proposal per document. Asking twice is somebody wondering whether the first worked.
  @@unique([documentId, status])
  @@index([organizationId, status])
  @@map("knowledge_proposals")
}

/// EVERY TURN OF A PANEL CONVERSATION, KEPT.
///
/// Two reasons, and the second is the one that made it necessary now. It is the running history the
/// assistant needs to pick up a thread later. And it is how "never propose on the first turn" is
/// answerable at all - a stateless endpoint cannot know whether it has met somebody before, and
/// proposing to write something down within a second of a stranger opening a panel is exactly the
/// behaviour that makes people close it.
///
/// Scoped to one person. Never another participant's turns, ever.
model AssistantTurn {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  personExternalId String   @map("person_external_id")
  /// 'person' or 'assistant'.
  role             String
  content          String   @db.Text
  /// Which lane answered and which spoke, so a strange reply can be traced without keeping prompts.
  lane             String?
  composedBy       String?  @map("composed_by")
  createdAt        DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, personExternalId, createdAt])
  /// Trigram, for recall over what somebody said. Same reason as the knowledge cards above: SQL-only
  /// meant Prisma would have dropped it.
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
  @@map("assistant_turns")
}

enum ProposalState {
  /// Echoed back, waiting for a plain yes.
  PARKED
  ACCEPTED
  DECLINED
  /// The conversation moved on. Not a refusal, and it can never fire afterwards.
  DROPPED
}

/// AN ACTION THAT HAS BEEN OFFERED AND NOT YET TAKEN.
///
/// The assistant noticed something worth writing down and said so. Nothing has happened yet, and
/// nothing happens without a plain yes.
///
/// THE DROP IS THE POINT. Anything other than a clear yes or no ends this - not just a "no". If a
/// proposal could sit parked while the conversation moved on, a "yes" three turns later, meant for
/// something else entirely, would fire it. A stale yes writing something somebody has forgotten
/// being asked about is the exact failure that makes a confirm gate worse than no gate at all.
model AssistantProposal {
  id                  String        @id @default(uuid())
  organizationId      String        @map("organization_id")
  personExternalId    String        @map("person_external_id")
  /// What kind of thing it would create. Only 'commitment' today.
  kind                String
  /// What was echoed back, word for word, so what they agreed to is what is on the record.
  summary             String        @db.Text
  payload             Json
  state               ProposalState @default(PARKED)
  createdAt           DateTime      @default(now()) @map("created_at")
  resolvedAt          DateTime?     @map("resolved_at")
  /// What it made, once it made something. The read-back: success is reported on this, not on intent.
  createdCommitmentId String?       @map("created_commitment_id")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, personExternalId, state])
  @@map("assistant_proposals")
}

enum CommitmentState {
  OPEN
  KEPT
  /// The date they gave has passed and nobody has said it is done.
  SLIPPED
  /// Withdrawn or overtaken. Not a failure, and counted as neither.
  DROPPED
}

/// SOMETHING SOMEBODY SAID THEY WOULD DO, HELD ACROSS GROUNDS.
///
/// `PersonObjective` with kind COMMITMENT already holds this INSIDE a ground, and it stays exactly
/// as it is - this accumulates alongside it, so a person's word carries from one check-in to the
/// next instead of ending when the ground does. Nothing in the live product reads this yet.
///
/// A DATE AND THE WORDS ARE DIFFERENT THINGS, and the existing model is right about that: `dueSaid`
/// is what they actually said, never parsed. "End of the quarter" is a real answer and turning it
/// into the 30th is a guess wearing a fact's clothes. So `dueAt` is set ONLY when somebody gave a
/// date, and everything that depends on time - slipping, following up - runs only on rows that have
/// one. A commitment with words and no date is never reported as late, because we do not know.
/// WHAT WOULD HAVE TO BE TRUE FOR THIS TO BE DONE, AGREED ONCE AND KEPT.
///
/// "Five core scenarios reliably in production" is one sentence and five things, and nothing could
/// hold the five - so a report could say the accounts differ and never say two of five. The
/// definition of done was re-argued every session because it lived nowhere.
///
/// ORDERED, because a sequence is usually what somebody means. CHECKED OFF ONLY WITH A REASON,
/// because a tick with nothing behind it is the "shipped" problem in a smaller box.
model AcceptanceCriterion {
  id                String    @id @default(uuid())
  organizationId    String    @map("organization_id")
  /// The Subject this is part of, by the customer's own id for it.
  subjectExternalId String    @map("subject_external_id")
  /// What has to be true, in the words of whoever agreed it. Never rewritten.
  text              String    @db.Text
  ordinal           Int
  /// MET only when somebody said what showed it. Null is the ordinary state and is not a failure.
  metAt             DateTime? @map("met_at")
  /// What showed it. Required to mark one met - see the guard.
  metBecause        String?   @map("met_because") @db.Text
  /// Who said so, by the customer's id for them.
  metByExternalId   String?   @map("met_by_external_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, subjectExternalId, ordinal])
  @@index([organizationId, subjectExternalId])
  @@map("acceptance_criteria")
}

/// A NUMBER FROM THE CUSTOMER'S OWN PRODUCT.
///
/// The only evidence in this system that does not depend on somebody's account of themselves.
/// Everything else Groundwork weighs is a description: what a person says happened, what a
/// colleague says happened, what a document says was agreed. A crash rate is none of those, and
/// "the product is stable" beside "crash rate 8 percent" is a conversation nobody could otherwise
/// have.
///
/// IT IS NOT ANALYTICS AND MUST NOT BECOME ANALYTICS. No time series, no dimensions, no queries,
/// no charts. One number, what it counts, when it was true, and where it came from - enough to sit
/// beside a claim, and deliberately not enough to be the place anybody looks at their metrics.
model ProductMetric {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  /// The customer's own name for it. "crash_rate", "active_vehicles". Their words, not ours.
  key               String
  /// What it counts, in words a person reads. Without this a number is a number.
  says              String   @db.Text
  value             Float
  /// "percent", "vehicles", "ms". Optional, because not everything has one.
  unit              String?
  /// When the number was TRUE, which is not when it was sent.
  asOf              DateTime @map("as_of")
  /// What produced it, so a reader can weigh it. A dashboard export is not a database read.
  sourceSystem      String   @map("source_system")
  /// What it is about, where it is about one thing. Points at a Subject by the customer's id.
  subjectExternalId String?  @map("subject_external_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key, asOf])
  @@index([organizationId, subjectExternalId])
  @@map("product_metrics")
}

/// A TO-DO IS YOURS. A commitment is to somebody and follows you into your check-in; a to-do is a
/// note to yourself that nobody else reads and no report weighs. Kept apart so that "buy milk" never
/// turns up as a promise somebody slipped on.
model Todo {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  /// The identity system's id, the same one commitments use.
  personExternalId String @map("person_external_id")

  text    String    @db.Text
  /// Their words for when. Kept as said.
  dueSaid String?   @map("due_said")
  /// Only where a date was actually given.
  dueAt   DateTime? @map("due_at")

  state  TodoState @default(OPEN)
  /// chat | api
  source String    @default("chat")

  createdAt DateTime  @default(now()) @map("created_at")
  doneAt    DateTime? @map("done_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, personExternalId, state])
  @@map("todos")
}

enum TodoState {
  OPEN
  DONE
  DROPPED
}

model Commitment {
  id                String  @id @default(uuid())
  organizationId    String  @map("organization_id")
  /// The identity system's id, so this survives a person having no Groundwork account.
  personExternalId  String  @map("person_external_id")
  /// What it is against, when it is against anything.
  subjectExternalId String? @map("subject_external_id")

  text    String    @db.Text
  /// Their words for the deadline. Always kept.
  dueSaid String?   @map("due_said")
  /// A date, ONLY where one was actually given. Null is the normal case and is not a gap.
  dueAt   DateTime? @map("due_at")

  state CommitmentState @default(OPEN)

  /// Where it came from, so a commitment captured in passing can be told from one written down.
  source                  String  @default("check_in")
  /// The ground and row it was mirrored from, when it came from a check-in. A pointer, not a copy
  /// of the truth: the ground's own record stays authoritative for the ground.
  sourceGroundId          String? @map("source_ground_id")
  sourcePersonObjectiveId String? @unique @map("source_person_objective_id")

  statedAt         DateTime  @default(now()) @map("stated_at")
  resolvedAt       DateTime? @map("resolved_at")
  /// When somebody was last asked about it, so they are not asked twice in a day.
  lastFollowedUpAt DateTime? @map("last_followed_up_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, personExternalId, state])
  @@index([organizationId, state, dueAt])
  @@map("commitments")
}

/// A PERSON IN THE CUSTOMER'S ORGANISATION, AS THEIR IDENTITY SYSTEM DESCRIBES THEM.
///
/// DELIBERATELY NOT A `User`. A User here is an account: it has a password hash, a verified email,
/// a role, and a GLOBALLY unique email address. Provisioning into it would mean every person a
/// customer's HRIS knows about gets an account they never asked for, and two customers employing
/// the same contractor would collide on that unique email. It would also make deprovisioning a
/// question about somebody's login rather than about their record.
///
/// So this is the roster, and `linkedUserId` is where the two meet if and when that person actually
/// signs in. Additive: nothing about accounts, auth or grounds changes.
///
/// JOINER, MOVER, LEAVER are the three things this has to get right, and only the first is easy.
/// A mover is a `managerExternalId` change and must not read as a new person. A leaver is
/// `active: false` - SCIM's own deprovisioning signal - which stamps `deactivatedAt` and is what
/// the retention and handover rules will hang off. Nothing is ever hard deleted, because the work
/// history is the organisation's even when the person has gone.
model Person {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  /// Their identity system's id for this person. The `externalId` every subject points at.
  externalId     String @map("external_id")
  sourceSystem   String @map("source_system")

  /// SCIM's required handle. Usually an email or a directory login.
  userName    String  @map("user_name")
  displayName String? @map("display_name")
  givenName   String? @map("given_name")
  familyName  String? @map("family_name")
  email       String?
  title       String?
  department  String?
  /// Per-participant timezone, so cadence windows and nudge timing resolve where the person is
  /// rather than where the server is.
  timezone    String?

  /// The reporting line. Held as their id rather than a foreign key, because a manager may be
  /// pushed after their report and a roster must not refuse a person for naming someone not yet
  /// sent. Resolved at read; unresolved is reported rather than hidden.
  managerExternalId String? @map("manager_external_id")

  /// The number they message from, E.164, from SCIM phoneNumbers[] or the people route. Matched
  /// before any number a person typed into Settings, because the roster is the customer's truth.
  phone                 String?
  /// STOP means stop, by the means the channel offers (whatsapp/a-message-outside-the-window.ts).
  whatsappStoppedAt     DateTime? @map("whatsapp_stopped_at")
  whatsappConsentAt     DateTime? @map("whatsapp_consent_at")
  /// The last time THIS person wrote to us on WhatsApp: Meta's 24-hour service window is measured from it.
  whatsappLastInboundAt DateTime? @map("whatsapp_last_inbound_at")

  /// SCIM's own signal, kept as it arrives. `deactivatedAt` is the moment it first became false.
  active        Boolean   @default(true)
  deactivatedAt DateTime? @map("deactivated_at")

  /// Set if this person ever signs in to Groundwork. Null for most of a roster, and that is normal.
  ///
  /// SIX MODELS REPRESENT A HUMAN BEING - User, Person, GroundParticipant, OpsPerson, PendingSignup,
  /// PendingJoin - each for a stated reason, and this is the documented seam between the two that
  /// matter most. A constraint enforced on one of them is not enforced on the others; anybody adding
  /// a seventh should say here why the six will not do (fix plan B13, P7-002).
  linkedUserId String? @map("linked_user_id")

  /// THE DAY THEY WERE LAST PROMPTED, and the whole of the once-a-day rule.
  ///
  /// A date rather than a timestamp on purpose: the rule is "not twice in a day", which is a
  /// question about the calendar and not about elapsed hours. A timestamp would make somebody
  /// nudged at 23:50 fair game at 00:05.
  lastNudgedOn DateTime? @map("last_nudged_on") @db.Date

  syncedAt  DateTime @default(now()) @map("synced_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, active])
  @@index([organizationId, managerExternalId])
  @@index([organizationId, phone])
  @@map("people")
}

/// WHAT KIND OF WORK AN IMPORTED SUBJECT IS.
enum SubjectType {
  OBJECTIVE
  PROJECT
  DECISION
  /// A shop, a prospect, a client - somebody outside the organisation that work happens with.
  ///
  /// Until this existed "Shop A" was a string inside a sentence, so the same shop in week one and
  /// week three were unrelated text and nothing could be attached to either. It is a Subject rather
  /// than a new table because a counterparty is exactly what a Subject already is: a thing the
  /// customer's own system names, that people do work against.
  ///
  /// IT IS NOT A CRM RECORD AND MUST NOT BECOME ONE. No contacts, no deal value, no stage, no
  /// pipeline. A name and an id, so evidence and conversation can point at the same shop twice.
  COUNTERPARTY
}

/// A PIECE OF THE CUSTOMER'S OWN WORK, HELD AS A POINTER.
///
/// CAREFUL WITH THE WORD. In the rest of this schema "subject" means the PERSON an expectation is
/// about - `PersonObjective.seenBySubject` is whether that person has seen it. Here it means a
/// thing being worked on. The two are not related and the collision is deliberate rather than
/// accidental: the API contract this serves is `/subjects`, and inventing a private synonym for the
/// endpoint's own noun would be worse. Nothing existing is renamed.
///
/// POINTER, NOT COPY, which is the whole design and is not new here - `PersonObjective.trackedUrl`
/// already does exactly this for a ticket, for exactly this reason. What is stored is the address,
/// the wording AS OF THE LAST SYNC, and when we last looked. There is no parallel editable version,
/// nothing is polled, and past a staleness window it renders as stale rather than as now. A second
/// editable representation of the customer's objective would be the failure this product exists to
/// end: two places that must agree, each defensible alone, nothing reconciling them.
///
/// ORG-SCOPED AND ADDITIVE. Grounds are untouched and keep working exactly as they do. This
/// accumulates alongside them; the machine API, the handover brief and the board read it.
model Subject {
  id             String      @id @default(uuid())
  organizationId String      @map("organization_id")
  /// The customer's own id for it. Unique per source system within an org - the same string may
  /// legitimately mean different things in two different tools.
  externalId     String      @map("external_id")
  sourceSystem   String      @map("source_system")
  type           SubjectType

  /// The wording as of `syncedAt`. Never edited here; an edit is proposed back or not offered.
  title   String  @db.Text
  measure String? @db.Text
  target  String? @db.Text

  /// WHY THIS NUMBER, AND HOW IT WILL BE MOVED.
  ///
  /// Carried on the objective rather than left behind in the draft that agreed
  /// it: the reason a target exists is the first thing to go missing, and it is
  /// needed most in the check-in where the target is being missed.
  ///
  /// Nullable, because an objective imported from a customer's own system
  /// arrives with whatever that system holds — and refusing an import for a
  /// missing sentence would mean refusing their data. Drafts agreed in here are
  /// refused without both.
  justification String? @db.Text
  approach      String? @db.Text

  /// Held as the customer's own identifiers rather than resolved to rows, because the person may
  /// not have been pushed yet and a subject must not fail to import for naming somebody unknown.
  ownerExternalId        String? @map("owner_external_id")
  contributorExternalIds Json?   @map("contributor_external_ids")
  parentExternalId       String? @map("parent_external_id")

  startDate DateTime? @map("start_date") @db.Date
  dueDate   DateTime? @map("due_date") @db.Date
  /// THE CUSTOMER'S OWN WORD, not an enum of ours. Their tool's states are theirs, and mapping
  /// them onto ours at the boundary would be a translation nobody could audit later.
  status    String?

  /// 'imported' here, always. The value exists so that this and a `PersonObjective` written by a
  /// lead or by the person themselves can never render identically: those two were said out loud
  /// to somebody, and an imported one was assigned by a system that cannot say whether anyone has
  /// seen it. Whether a given person HAS seen it is per-person and does not belong on this row.
  authoredBy String @default("imported") @map("authored_by")

  /// When their system last told us. Staleness is measured from here and nowhere else.
  syncedAt        DateTime  @default(now()) @map("synced_at")
  /// Soft delete. Their tool dropped it; the findings that referenced it stay readable.
  sourceDeletedAt DateTime? @map("source_deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  /// The upsert key from the API contract: (org, sourceSystem, externalId).
  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, type])
  @@index([organizationId, syncedAt])
  @@map("subjects")
}

model BillingEvent {
  id              String             @id @default(uuid())
  organizationId  String             @map("organization_id")
  groundId        String?            @map("ground_id")
  type            BillingEventType
  amountCents     Int                @map("amount_cents")
  currency        String             @default("USD")
  periodStart     DateTime           @map("period_start")
  periodEnd       DateTime           @map("period_end")
  /// UNIQUE, because the webhook's idempotency check was leaning on nothing.
  /// `checkout.session.completed` looked the id up and skipped if found, but the read and the write
  /// were not atomic with respect to each other and no constraint stood behind them - so two
  /// concurrent deliveries of one Stripe event could both pass the check, credit the balance twice
  /// and log the charge twice. Nullable-unique is fine in Postgres: the event types that have no
  /// invoice leave it null, and multiple nulls are permitted.
  stripeInvoiceId String?            @unique @map("stripe_invoice_id")
  status          BillingEventStatus @default(PENDING)
  createdAt       DateTime           @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ground       Ground?      @relation(fields: [groundId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("billing_events")
}

model ContributorCode {
  id                String   @id @default(uuid())
  organizationId    String   @map("organization_id")
  code              String   @unique
  sessionsGranted   Int      @default(1) @map("sessions_granted")
  sessionsUsed      Int      @default(0) @map("sessions_used")
  createdByUserId   String   @map("created_by_user_id")
  note              String? // optional label for the admin (e.g. "for the marketing team")
  allowCodeCreation Boolean  @default(false) @map("allow_code_creation")
  isActive          Boolean  @default(true) @map("is_active")
  parentCodeId      String?  @map("parent_code_id")
  redeemedByUserId  String?  @map("redeemed_by_user_id")
  /// Written as Postgres itself stores it. The equivalent `NOW() + INTERVAL '90 days'` is the same
  /// expression and the same behaviour, but Postgres normalises it on the way in, so `migrate diff`
  /// reported the column as permanently changed and no amount of re-migrating would settle it.
  expiresAt         DateTime @default(dbgenerated("(now() + '90 days'::interval)")) @map("expires_at")
  createdAt         DateTime @default(now()) @map("created_at")

  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      User                        @relation("ContributorCodes", fields: [createdByUserId], references: [id])
  redemptions    ContributorCodeRedemption[]
  parentCode     ContributorCode?            @relation("CodeHierarchy", fields: [parentCodeId], references: [id])
  childCodes     ContributorCode[]           @relation("CodeHierarchy")
  redeemedBy     User?                       @relation("RedeemedCodes", fields: [redeemedByUserId], references: [id])
  groundsCreated Ground[]                    @relation("GroundAccessCode")

  @@index([organizationId])
  @@map("contributor_codes")
}

model ContributorCodeRedemption {
  id               String   @id @default(uuid())
  codeId           String   @map("code_id")
  groundId         String   @map("ground_id")
  redeemedAt       DateTime @default(now()) @map("redeemed_at")
  redeemedByUserId String?  @map("redeemed_by_user_id")
  freeReason       String?  @map("free_reason")

  code       ContributorCode @relation(fields: [codeId], references: [id])
  ground     Ground          @relation(fields: [groundId], references: [id], onDelete: Cascade)
  redeemedBy User?           @relation("CodeRedemptions", fields: [redeemedByUserId], references: [id])

  @@map("contributor_code_redemptions")
}

/// Who a document is for. Three answers, because there are three real cases and
/// the product currently answers all of them the same way by accident.
///
/// OPEN    everyone in the ground. The brief, the plan, the terms - the things a
///         ground is measured against, which are useless if only one person has
///         them.
/// CLOSED  the lead only. What they know that is not everybody's to read.
/// OWN     the uploader only. A participant's evidence for their own account,
///         which is the current behaviour for every document and the default.
enum DocumentVisibility {
  OPEN
  CLOSED
  OWN
}

/// What one person is trying to achieve, in their words. (G13)
///
/// A ground holds one success definition and it belongs to the lead, so a hire
/// with no objective of their own infers one from whatever number was named -
/// which is exactly what Ground 1's report closed on. This is the missing field.
///
/// authoredBy and seenBySubject are not metadata. A proposal nobody has seen is
/// never read against, and the two columns are what makes that arithmetic rather
/// than an instruction. See an-objective-belongs-to-a-person.ts.
/// WHAT KIND OF THING SOMEBODY IS BEING HELD TO.
///
/// Teams track different shapes - to-dos, commitments, OKRs, targets, tickets, a definition of
/// success, a standing role expectation - and holding them all as one untyped sentence is why a
/// session cannot press on any of them properly. "Clear the queue to under twenty" and "be someone
/// the team can rely on" are both real, and they are checked in completely different ways.
///
/// A kind is NOT a separate feature. It is a familiar name for a common pairing of `check` and
/// `dueKind` below. An OKR is deliberately absent: it is a GOAL with several TARGETs hanging under
/// it, which is a parent and children, not a ninth kind - building it as its own object would give
/// a target a second place to live.
enum ObjectiveKind {
  TODO /// done or not, by a date
  COMMITMENT /// a to-do somebody else is waiting on. `owedToParticipantId` is the point of it
  TARGET /// a number crosses a line
  GOAL /// a judgement, over a cycle
  SUCCESS_DEFINITION /// a judgement, for the whole check-in
  ROLE_EXPECTATION /// a judgement, standing, no end
  REFERENCE /// a ticket or issue settled somewhere else. We hold a pointer, never a copy
}

/// HOW WE WOULD KNOW IT HAPPENED. The axis this redesign adds.
///
/// NOT_CHECKABLE is a real answer and the most useful one: it is what turns the interview's next
/// question into "how would we know?", and it stops an unmeasurable sentence sitting on somebody's
/// record looking like a target they failed.
enum ObjectiveCheck {
  DONE_OR_NOT
  A_NUMBER
  A_JUDGEMENT
  NOT_CHECKABLE
}

/// BY WHEN. A date, a cycle, or standing with no end - which is what a role expectation is.
enum ObjectiveDue {
  A_DATE
  A_CYCLE
  STANDING
  NOT_SAID
}

/// WHOSE IT IS. The third value came from checking the design against "many people in the same
/// role": a cohort of twenty branch managers who never meet. Writing one role expectation onto
/// twenty rows is twenty things that can drift, so it is written once and shown on every row.
enum ObjectiveScope {
  ONE_PERSON
  EVERYONE_IN_ROLE
  WHOLE_CHECK_IN
}

model PersonObjective {
  id            String @id @default(uuid())
  groundId      String @map("ground_id")
  participantId String @map("participant_id")

  text String @db.Text

  /// THE PRIMITIVE. See ObjectiveKind. Every one of these is nullable and defaulted, because every
  /// row that already exists was written before any of it and none of them are wrong - they are
  /// simply untyped, and the interview fills them in when it next asks.
  kind    ObjectiveKind?  @map("kind")
  check   ObjectiveCheck? @map("check")
  dueKind ObjectiveDue?   @map("due_kind")
  /// The words they used for the deadline - "Thursday", "end of the quarter". Never parsed into a
  /// date: a record of what was said, not a guess at what was meant.
  dueSaid String?         @map("due_said")
  /// THE DATE THOSE WORDS MEAN, WHERE THEY UNAMBIGUOUSLY MEAN ONE.
  ///
  /// `dueSaid` stays exactly as it was and is still what anybody is shown: it is what the person
  /// said, and a record of the words is the thing this product is for. This is the machine's
  /// reading of them, and it exists because words cannot answer "is this late".
  ///
  /// NULL IS THE COMMON CASE AND MUST STAY COMFORTABLE. "Soon", "after the holidays", "once
  /// procurement clears" are all real answers and none of them is a date. A guess here becomes a
  /// missed deadline on somebody's record that they never agreed to, so nothing is inferred from
  /// a vague phrase - the interview asks instead.
  ///
  /// Set only from an explicit day, a named month-end, or a phrase with exactly one meaning
  /// relative to the day it was said.
  dueDate DateTime?       @map("due_date")

  /// THE NUMBER, WHERE THE PROMISE HAS ONE, PULLED OUT OF THE SENTENCE.
  ///
  /// "£150k of qualified pipeline by October" is one sentence, and the sentence is what a person
  /// reads. But nothing could compare it to anything: a report could say the promise existed and
  /// never that forty of the hundred and fifty had arrived.
  ///
  /// `text` is untouched and stays what somebody said. These two are a reading of it, set only when
  /// the promise is checked by a number and that number is unambiguous. Null everywhere else,
  /// which is most expectations - a judgement is a real answer and always was.
  target  String? @map("target")
  /// What is being counted, in their words: "qualified pipeline", "proposals", "days".
  measure String? @map("measure")

  /// WHY THIS NUMBER, AS IT WAS STATED WHEN THE TARGET WAS SET.
  ///
  /// The session where the target is being missed is the one where the reason
  /// matters most and is least likely to still be in anybody's head. Without it
  /// that session can only ask about the gap, which invites an excuse; with it
  /// it can ask whether the reason still holds, which is a question about the
  /// target rather than about the person.
  ///
  /// Carried under the same rule as the objective it belongs to: it is what was
  /// stated when the target was set, NOT something this person agreed to.
  whyThisNumber String? @map("why_this_number") @db.Text

  /// WHERE THIS HAS GOT TO. OPEN until somebody says otherwise.
  ///
  /// Nothing could end before this. An expectation set on day one looked identical on day ninety
  /// whether it was met, quietly dropped, or replaced by a different one - so a check-in could not
  /// tell a live promise from a dead one, and a report could not either.
  ///
  /// CHANGED is not MET and not DROPPED, and keeping it separate is the point: an expectation that
  /// moved is a different thing from one that was missed, and reading the second as the first is
  /// the unfairest mistake this product could make.
  status              String         @default("OPEN") @map("status")
  /// When the status last moved, so a report can say what was true at a point in time.
  statusChangedAt     DateTime?      @map("status_changed_at")
  scope               ObjectiveScope @default(ONE_PERSON) @map("scope")
  /// COMMITMENT only: who is waiting on it. The whole difference between a to-do and a commitment.
  owedToParticipantId String?        @map("owed_to_participant_id")
  /// 'lead' or 'self'. Who wrote the CURRENT text.
  authoredBy          String         @map("authored_by")

  /// WHERE THIS CAME FROM, when it did not come from the conversation.
  ///
  /// A seeded objective is one the customer's own system says was already agreed - "Sahar owns a
  /// six-client Q4 target, approved by Hafsah, effective 1 October". Groundwork should start from
  /// that rather than making somebody rediscover it, and it has to be able to tell an agreement
  /// somebody else recorded from something said in a check-in. Once the text is written down those
  /// two look identical without these columns.
  ///
  /// Null on everything extracted from conversation, which is the overwhelming majority.
  sourceSystem         String?          @map("source_system")
  /// EMPTY, NOT NULL, and that is what makes several seeded objectives possible.
  ///
  /// A planning system holds six targets for one person in a quarter; the check-in engine must still
  /// hold one, because `(groundId, participantId, kind)` is what stops the conversation writing two
  /// contradictory expectations with nothing to say which holds.
  ///
  /// Adding a NULLABLE externalId to that key would have removed the guarantee silently - Postgres
  /// treats NULLs as distinct, so two conversation rows would both insert. A partial index keeps
  /// both and cannot be expressed in Prisma, and this repository already removed one of those for
  /// exactly that reason. An empty string is the version that works: conversation rows all share it
  /// and stay one-per-kind, seeded rows carry their own id and may be many.
  externalId           String           @default("") @map("external_id")
  /// Who signed it off in THEIR system. Not a Groundwork approval.
  approvedByExternalId String?          @map("approved_by_external_id")
  effectiveFrom        DateTime?        @map("effective_from")
  /// Whether the person it belongs to has seen the current text.
  /// WHERE THIS IS SETTLED, WHEN THE KIND IS REFERENCE.
  ///
  /// A ticket's truth is in Jira, Linear or Asana. Copying its state onto this row would create the
  /// exact failure the product exists to end - two places that must agree, each defensible alone,
  /// nothing reconciling them. So this holds the address, the words somebody used for the state, and
  /// WHEN THEY LAST LOOKED. Stale is then shown as stale rather than presented as now.
  ///
  /// It sits on the expectation rather than in a table of its own because a ticket IS an expectation
  /// whose truth is settled elsewhere. A parallel table made a second, unconnected representation of
  /// the same work - which is the same failure, arriving as a feature.
  ///
  /// Never polled and never synced. A sync would make it a copy again.
  proposedChanges      ProposedChange[]
  trackedUrl           String?          @map("tracked_url")
  lastSeenState        String?          @map("last_seen_state")
  lastSeenAt           DateTime?        @map("last_seen_at")

  seenBySubject Boolean @default(false) @map("seen_by_subject")

  /// GW-EXP-1b. Whether the lead has told this person the expectation, on the lead's own account:
  /// TOLD | NOT_TOLD | UNSURE | NOT_ASKED. Null on rows written before this existed.
  ///
  /// This is the highest-value field on the model. An expectation nobody has been told is the failure
  /// the product was built to catch, and a live session already volunteers "your record now shows that
  /// gap clearly" - which is only true if the gap is stored.
  awareness       String? @map("awareness")
  /// The lead's own words about the telling, where they said anything.
  awarenessDetail String? @map("awareness_detail") @db.Text

  /// GW-EXP-3. Whether this expectation and the person's OWN stated idea of success connect:
  /// ALIGNS | DIFFERS | CANNOT_TELL. Null while they have not said what success looks like to them,
  /// which the surface reports as "not yet said" rather than as agreement.
  ///
  /// CANNOT_TELL IS NOT A FAILURE STATE AND MUST SURVIVE. `mayCompare` already refuses to infer
  /// connection from word overlap, and it is right to: a read that guesses will manufacture agreement
  /// that is not there, or conflict that is not there, and both are worse than silence. "Cannot tell"
  /// is a prompt for a human conversation, which is the honest answer much of the time.
  alignment     String? @map("alignment")
  /// One sentence on what connects them or does not. Never a verdict on the person.
  alignmentNote String? @map("alignment_note") @db.Text

  /// GW-EXP-7. The person's own words objecting to this expectation, said in their own check-in.
  ///
  /// WHY IT NEEDS ITS OWN FIELD. Without one the arrangement is lopsided in the direction that matters:
  /// the lead can change an expectation and everybody sees the new words with a reason attached, while
  /// the person it is about can only disagree into a transcript nobody opens. One side has a visible
  /// lever, the other has a private complaint.
  ///
  /// This is NOT the alignment read. "They described doing well differently" is a difference of view;
  /// this is "I think this expectation is wrong", which is a different claim and deserves saying so.
  /// It never changes the expectation - one person still owns that - it makes the objection visible.
  objection   String?   @map("objection") @db.Text
  objectionAt DateTime? @map("objection_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  // ONE ROW PER PERSON PER KIND, not one row per person.
  //
  // This was @@unique([groundId, participantId]) - a single expectation each, forever. Invisible
  // while an expectation was one untyped sentence, and plainly wrong the moment they were typed: a
  // lead saying "Abubakar owes Hafsah the plan by Friday, and he owns escalations from now on" is
  // stating a COMMITMENT and a ROLE EXPECTATION, and the second silently overwrote the first.
  //
  // Restating the same kind for the same person is a REVISION and updates in place, which is what
  // keeps seenBySubject honest when the words change. A different kind is a different thing and
  // gets its own row.
  /// One per kind for the conversation, several for an integration - see `externalId`.
  @@unique([groundId, participantId, kind, externalId])
  /// Upsert key for a seeded objective, so a customer pushing the same agreement twice updates it
  /// rather than colliding with the constraint above. `sourceSystem` is null for everything the
  /// conversation writes, and Postgres treats NULLs as distinct - so those rows never collide here.
  @@unique([groundId, sourceSystem, externalId])
  @@index([groundId, participantId])
  @@map("person_objectives")
}

/// Where this stood on day one, recorded on purpose. (G14)
///
/// DELIBERATELY HAS NO updatedAt AND NO EDIT PATH. Somebody will want to correct
/// it - the first session usually reveals the day-one description was wrong, and
/// fixing it feels like accuracy. It is the opposite: half the findings this
/// product makes are the distance between what people believed at the start and
/// what turned out to be true. Corrected, a baseline becomes a second
/// description of the present and the arc disappears. A correction goes in as a
/// new row with its own date.
model GroundBaselineEntry {
  id       String @id @default(uuid())
  groundId String @map("ground_id")

  text              String @db.Text
  capturedAtSession Int    @map("captured_at_session")

  createdAt DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, createdAt])
  @@map("ground_baseline_entries")
}

/// A DOCUMENT THAT LIVES SOMEWHERE ELSE, RECORDED RATHER THAN READ.
///
/// Its own table, and that is the whole safety argument. A link kept alongside uploaded documents
/// would be a row with no text sitting where every prompt-assembling read expects text, and the
/// assistant would answer about a contract having seen nothing but its name. Here there is no
/// filter for anybody to forget: a read that assembles document text cannot reach one of these.
model DocumentElsewhere {
  id            String  @id @default(uuid())
  groundId      String  @map("ground_id")
  participantId String? @map("participant_id")

  /// Scheme, host and path. NEVER the query string — sharing links carry tokens, and a token in a
  /// row the whole check-in can read hands the document to everybody who can see the link.
  url     String
  /// Where it lives, in the words a person uses: "Google Docs", "Dropbox".
  livesIn String @map("lives_in")
  title   String

  /// The same three answers an uploaded document has. It arrives OWN and is opened by saying so.
  visibility DocumentVisibility @default(OWN)

  /// What they said about it as they put it in, kept as they said it.
  note String? @db.Text

  addedByUserId String?  @map("added_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([groundId, participantId])
  @@map("documents_elsewhere")
}

/// SOMETHING SOMEBODY HAS TO DO, FROM A TERM BOTH SIDES AGREED THE READING OF.
///
/// There is no state here that means breached and no path to one. The strongest thing this holds is
/// the responsible side saying, in their own words, that it was not done. Missing evidence is
/// "nothing has been shown either way" and is not a claim about anybody. See
/// `alignment/an-obligation-is-not-evidence-of-itself.ts`.
model Obligation {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  groundId       String @map("ground_id")

  /// The term it comes from. An obligation with no term is a duty nobody agreed to.
  termId String @map("term_id")

  says  String @db.Text
  whose String

  /// Where it has one. Some obligations are continuous.
  dueOn DateTime? @map("due_on") @db.Date

  /// One of the seven in ObligationState. None of them is "breached".
  state String @default("not due yet")

  /// What anybody said about it, in their words: [{ by, said }].
  accounts Json @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, state])
  @@map("obligations")
}

/// A PARTY THAT IS AN ORGANISATION, RATHER THAN A LIST OF PEOPLE SOMEBODY INVITED.
///
/// Both sides are named, and each says which of their own people take part. This grants standing on
/// ONE check-in and nothing anywhere else — the tenant boundary is untouched, and every read stays
/// scoped to an organisation. A party with no account here is normal: the other side of a contract
/// has not usually bought this product. See `alignment/a-party-is-an-organisation.ts`.
model GroundParty {
  id       String @id @default(uuid())
  groundId String @map("ground_id")

  /// 'the side that set it up' | 'the other side'. The first carries no extra rights.
  side String
  /// What they are called, in their own words.
  name String

  /// Their organisation here, where they have one. Null is normal.
  organizationId String? @map("organization_id")

  /// Who named them, and when. A side that appeared with no trace of who added it is one nobody
  /// can query later.
  namedByUserId String?  @map("named_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@unique([groundId, side])
  @@index([organizationId])
  @@map("ground_parties")
}

/// WHAT ONE SIDE SAID, AND WHETHER THE OTHER HAS BEEN ASKED.
///
/// Without this row, a thing one side said in July is by September indistinguishable from a thing
/// both sides confirmed. `claim` never reaches the other side; `about` is the neutral subject they
/// are asked, so two free accounts can be compared and neither was led. See
/// `alignment/an-assertion-waits-for-the-other-side.ts`.
model Assertion {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  groundId       String @map("ground_id")

  /// What was said, in their words. NEVER shown to the other side.
  claim String @db.Text
  /// The subject, in neutral words. The only thing the other side is asked about.
  about String

  by           String
  theOtherSide String @map("the_other_side")

  /// 'said by one side' | 'the other side has been asked' | 'both sides say the same' | 'the two accounts differ'
  state String @default("said by one side")

  /// The question the other side was asked, kept so it can be checked for what it gave away.
  asked   String?   @map("asked") @db.Text
  askedAt DateTime? @map("asked_at")

  /// Their own account, in their words.
  theirAccount String?   @map("their_account") @db.Text
  answeredAt   DateTime? @map("answered_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, state])
  @@map("assertions")
}

/// AN AGREEMENT BETWEEN TWO SIDES, AND WHAT IS IN FORCE WHEN.
///
/// Not contract management: no clause library, no redlining, no signatures. Enough to answer what
/// is in force, since when, and who checked it — which a relationship that cannot answer has no
/// ground to stand an argument on. See `alignment/an-agreement-is-versioned-never-edited.ts`.
model Agreement {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  groundId       String @map("ground_id")

  /// What the two sides call it.
  says String

  createdAt DateTime @default(now()) @map("created_at")

  ground   Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  versions AgreementVersion[]

  @@index([groundId])
  @@map("agreements")
}

/// A VERSION IS NEVER EDITED, AND THAT IS THE WHOLE DESIGN.
///
/// The moment one can be edited, "what did the agreement say in July" stops having an answer — and
/// July is when the thing being argued about happened. An amendment is a new version with its own
/// start date; the old one keeps standing over the period it covered. In a disagreement between two
/// companies, the side that can quietly change the record is the side nobody should believe.
model AgreementVersion {
  id          String @id @default(uuid())
  agreementId String @map("agreement_id")

  /// 1, 2, 3. An amendment is the next number, never a change to the last one.
  number Int

  /// 'being put together' | 'in force' | 'replaced'
  state String @default("being put together")

  inForceFrom DateTime  @map("in_force_from") @db.Date
  inForceTo   DateTime? @map("in_force_to") @db.Date

  /// Who said this is what was signed, by name. Both sides, or it is not in force.
  agreedBy String[] @map("agreed_by")

  /// WHEN IT WAS EXECUTED, AND WHO SAYS SO.
  ///
  /// Kept apart from `agreedBy` because agreeing and signing are different moments and people
  /// collapse them constantly: both sides saying they want a change is not the change. And signed
  /// is still not in force — an amendment signed in October that starts in January governs nothing
  /// in November. Where a version stands is worked out from these facts rather than stored, so a
  /// row cannot sit in a standing its own dates contradict.
  signedAt   DateTime? @map("signed_at")
  signedSaid String?   @map("signed_said")

  /// The document it came from, where there is one.
  documentId String? @map("document_id")

  createdAt DateTime @default(now()) @map("created_at")

  agreement Agreement       @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  terms     AgreementTerm[]

  @@unique([agreementId, number])
  @@index([agreementId, inForceFrom])
  @@map("agreement_versions")
}

/// A READING IS A PROPOSAL UNTIL A PERSON SAYS OTHERWISE.
///
/// The most dangerous object in this programme: a model reads a contract, produces "revenue share
/// 20%", and a company is held to a sentence nobody signed. What a term in each state may be used
/// for is decided in `alignment/a-term-is-not-true-because-a-model-read-it.ts`, as arithmetic
/// rather than as a note in a prompt.
model AgreementTerm {
  id        String @id @default(uuid())
  versionId String @map("version_id")

  /// What it is about, in the words people use: "revenue share", "payment terms".
  says  String
  /// The reading itself, as plain words. Never a formula this product then executes.
  reads String @db.Text

  /// 'read from the document' | 'checked by one side' | 'agreed by both' | 'read differently by each side'
  state String @default("read from the document")

  /// Which clause, so anybody can go and look.
  clause String?

  /// Who has said the reading is right, by name. Never a count.
  checkedBy String[] @map("checked_by")

  /// "THAT IS NOT WHAT I SAID", FOR A TERM.
  ///
  /// The record has had this press since nine model extractors started writing rows: a line is
  /// marked, never deleted, and from that moment counts toward nothing. A term read out of a
  /// document by a model, and an understanding taken off a transcript by one, are the same kind of
  /// object and had no equivalent - so somebody shown a reading they never gave had nowhere to say
  /// so, on the one surface where being held to words you did not say costs money.
  ///
  /// Marked, not deleted, for the same reason as everywhere else: the row is the evidence that the
  /// read was made, and a table that quietly loses its mistakes cannot be audited for them.
  disputedAt DateTime? @map("disputed_at")
  /// Who said it was wrong, by the name a person reads. Never a user id.
  disputedBy String?   @map("disputed_by")

  /// Where the two sides read it differently: [{ by, reads, unsaidAt? }]. The most useful thing
  /// this can find - and `unsaidAt` is how one side takes their own half back without erasing that
  /// it was recorded, or touching anybody else's.
  readDifferently Json? @map("read_differently")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  version AgreementVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("agreement_terms")
}

/// A FIGURE, HELD AS A VALUE RATHER THAN AS A SENTENCE IN A DOCUMENT.
///
/// The object that makes arithmetic possible at all. Money is minor units and an integer, because
/// a reconciliation out by a cent is one nobody trusts again. See
/// `alignment/a-figure-is-a-value-with-a-source.ts` for what it refuses to do.
model ReportedFigure {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  groundId       String @map("ground_id")

  /// What it is a figure OF, in the words the person used: "revenue", "VAT declared".
  says       String
  /// Minor units. Integer, always.
  minorUnits Int    @map("minor_units")
  currency   String

  /// Inclusive calendar dates. A period is not a timestamp.
  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date

  /// Where it came from, and who is attached to it. A figure nobody is attached to cannot be
  /// asked about, and asking is the whole method.
  source   String
  statedBy String @map("stated_by")
  from     String

  /// The document it was read out of, where it was. Null for one somebody typed or said.
  documentId String? @map("document_id")

  /// A MODEL'S READING IS NOT THE FIGURE UNTIL A PERSON SAYS SO.
  ///
  /// The most dangerous failure in this whole area is an extracted number becoming fact. A figure
  /// read out of a document by a model is held here unconfirmed, and nothing compares it to
  /// anything until somebody who would know has said it is right.
  confirmedAt     DateTime? @map("confirmed_at")
  confirmedByUser String?   @map("confirmed_by_user")

  createdAt DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, periodFrom])
  @@map("reported_figures")
}

/// A DIFFERENCE THAT SURVIVES THE CONVERSATION.
///
/// Without a row, a mismatch noticed in a meeting is gone by next month and the pattern across
/// months — the thing that actually matters — never forms. States are in
/// `alignment/what-does-not-add-up.ts`; note that none of them is "breach".
model Difference {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  groundId       String @map("ground_id")

  /// What was compared, in the words a person reads.
  between    String
  minorUnits Int      @map("minor_units")
  currency   String
  periodFrom DateTime @map("period_from") @db.Date
  periodTo   DateTime @map("period_to") @db.Date

  /// 'not explained yet' | 'explained' | 'explained before, not now' | 'no longer there'
  state String @default("not explained yet")

  /// The figures it was computed from, so the arithmetic can always be shown.
  statedFigureId   String   @map("stated_figure_id")
  countedFigureIds String[] @map("counted_figure_ids")

  /// Which candidate explanations a person has ruled out, in their own answers.
  ruledOut String[] @map("ruled_out")

  /// What somebody said accounted for it, in their words. Never summarised into a verdict.
  accountedForBy String?   @map("accounted_for_by") @db.Text
  accountedAt    DateTime? @map("accounted_at")

  /// The last question asked about it, so the same one is not asked twice in a row.
  lastAsked   String?   @map("last_asked") @db.Text
  lastAskedAt DateTime? @map("last_asked_at")

  /// It was raised in this session, and carries into later ones until it is no longer there.
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, state])
  @@map("differences")
}

model GroundDocument {
  id               String  @id @default(uuid())
  groundId         String  @map("ground_id")
  participantId    String? @map("participant_id")
  fileName         String  @map("file_name")
  mimeType         String  @map("mime_type")
  content          String  @db.Text
  assessment       Json? // { suggests: string[], willDo: string[] } - Gemini's read of the doc, correctable
  /// WHAT THIS DOCUMENT HOLDS: the numbers, the dates and the one line saying what it is, read once at
  /// upload. Kept because four surfaces read it - the chat, the Context tab, the list and the board's
  /// targets - and a read done per surface is four different answers to one question. See
  /// what-a-document-holds.ts.
  holds            Json?
  /// When the chat said what this document holds. Null until it has; the conversation opens with it
  /// once and never again, the way a note carried into a session is raised once.
  holdsSaidAt      DateTime? @map("holds_said_at")
  /// WHAT THE PERSON WANTS LOOKED FOR IN IT, IN THEIR WORDS.
  ///
  /// A file arrives with no instructions and the session has to guess what mattered about it. In
  /// the chat the person can say so as they attach it, because there is a conversation to say it
  /// into; on the Context tab there was nowhere to put it, so a forty page architecture document
  /// went in mute. This is that sentence, kept with the document rather than turned into a turn.
  uploaderNote     String? @map("uploader_note") @db.Text
  // WHAT KIND OF THING THIS IS. typed | photo | scan | screenshot | generated | pasted | conversation.
  // A typed contract is a source. A photo of a whiteboard is a source but partial. Model-generated
  // notes are somebody's recollection one step removed, and do not raise a band the way a source does.
  origin           String? @db.VarChar(24)
  // The uploader described it; this is whether the file reads as what they said: { matches, reads, checkedAt }.
  descriptionCheck Json?   @map("description_check")

  // WHO CAN SEE THIS. Nobody decided the current behaviour: documents.list
  // filters on participantId, so every document is private to whoever uploaded
  // it. Right for a participant's own evidence, backwards for the lead's - a job
  // description or a grant's terms reach nobody, and those are exactly the things
  // everybody should be working from.
  //
  // OWN is the default so existing documents keep behaving as they do and
  // CONTEXT_ENABLED off is genuinely the old product. See DocumentVisibility.
  visibility DocumentVisibility @default(OWN)

  /// A RECORD OF A CONVERSATION - a call transcript, a meeting summary, a message thread.
  ///
  /// Marked because it is a different kind of thing from a job description or a workplan, and the
  /// difference is not about us. Other people are in it who never signed up to this product, and
  /// the person uploading it is the only one in a position to have told them.
  ///
  /// False on everything uploaded before this existed, and on most things after: a strategy deck is
  /// not a conversation and does not need any of what follows.
  isConversation Boolean @default(false) @map("is_conversation")

  /// WHO SAID THEY HAD TOLD THE PEOPLE IN IT, AND WHEN.
  ///
  /// Not a tick-box in a settings page somebody clicked through a year ago. The person uploading a
  /// conversation confirms, at the moment of uploading, that the people in it know their
  /// conversations may be used this way - because they are the only one who can have had that
  /// conversation, and the moment they are doing it is the only moment the question lands.
  ///
  /// Null on anything that is not a conversation. Required before one is stored: the file is
  /// refused rather than kept pending, because a transcript sitting in a database waiting for
  /// permission is the thing this is meant to prevent.
  consentConfirmedAt   DateTime? @map("consent_confirmed_at")
  consentConfirmedById String?   @map("consent_confirmed_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  proposals KnowledgeProposal[]

  @@index([groundId, participantId])
  @@map("ground_documents")
}

// Lead-supplied context: a private typed note the initiator adds about a specific
// participant (participantId set) or about the ground (participantId null). It
// DIRECTS and WEIGHTS synthesis - never becomes a stated claim, and is never shown
// to the person it is about. Deliberately its OWN store, NEVER a RecordEntry: the
// corpus reads these separately into a labeled LEAD-SUPPLIED CONTEXT section so the
// AI can never attribute the lead's framing to the party's own words.
/// WHO A CONTEXT NOTE IS FOR. Visibility only - it never touches what the note may be USED for.
///
/// The two are separate axes and conflating them is what made a shared note feel impossible. Who can
/// see something is a choice. Whether it can be quoted is fixed by what kind of thing it is, and a
/// note is somebody's words about a situation, so it never becomes evidence however widely it is
/// read. Widening the audience must never widen the use.
enum ContextNoteAudience {
  /// The default, and what every existing note is. Only the lead who wrote it.
  LEAD_ONLY
  /// The lead's framing, read by everyone in the check-in. Still never quotable.
  EVERYONE
}

/// WHAT SOMEBODY SAYS THEY DELIVERED, against what was expected of them.
///
/// The counterpart nobody had built. A participant could read what was expected of them and had
/// nowhere to put what they actually did, so the report only ever heard it if they happened to say it
/// in a session. This gives the report a THIRD thing to compare: what was expected, what they say they
/// did, and what everybody else's accounts corroborate.
///
/// IT IS NOT THEIR ACCOUNT, and that distinction is load-bearing. Like a between-session note, it
/// reaches their next session as something to ASK ABOUT - what they say under questioning is what
/// becomes the record.
model Delivery {
  id            String  @id @default(uuid())
  groundId      String  @map("ground_id")
  participantId String  @map("participant_id")
  /// The expectation this is offered against. Null where they delivered something nobody asked for -
  /// which is worth recording, and is exactly the contribution a report otherwise misses.
  objectiveId   String? @map("objective_id")

  text     String  @db.Text
  /// Where the evidence is, in their words. A link, a document name, a date.
  evidence String? @db.Text

  /// Set once a session has picked it up, so it is raised ONCE rather than in every session after.
  carriedIntoCheckInId String? @map("carried_into_check_in_id")

  createdAt DateTime @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  /// SetNull, not Cascade: if the expectation is replaced, what they did still happened.
  objective   PersonObjective?  @relation(fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([groundId, participantId])
  @@map("deliveries")
}

model LeadContextNote {
  id            String              @id @default(uuid())
  groundId      String              @map("ground_id")
  participantId String?             @map("participant_id") // null = about the ground; set = about that person
  authorUserId  String              @map("author_user_id") // the initiator who wrote it
  text          String              @db.Text
  /// See ContextNoteAudience. EVERYONE is always about the whole check-in - a shared note about one
  /// named person would be a public judgement of them, which is the one thing this product refuses.
  audience      ContextNoteAudience @default(LEAD_ONLY)
  /// DECISION 63, 30 September 2026: set only when adding or sharing this note was done by an admin
  /// standing in because the lead had left the organisation. See who-may-confirm-setup.ts.
  confirmedByAdminNote String? @map("confirmed_by_admin_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@map("lead_context_notes")
}


/// WHAT SOMEBODY SAID THEY WOULD DO, AND WHETHER ANYBODY KNOWS IF IT HAPPENED.
///
/// Hafsah, 22 September 2026, after pasting a quarter into the context chat: thirteen outstanding
/// items and six personal commitments came out of the read and had nowhere to go. The product kept
/// every number and dropped every action, because a target is a row and an action was not.
///
/// STATUS IS NEVER INFERRED. It starts UNKNOWN and only a person moves it: her whole point about
/// accountability is that "did you do your task" is the wrong question and "did the thing happen"
/// is the right one, and a status the product guessed would answer neither. An item with no owner
/// keeps `participantId` null rather than being attached to the nearest name.
/// WHAT THIS CHECK-IN KNOWS, ONE LINE AT A TIME.
///
/// Hafsah, 22 September 2026, looking at the Context page after a paste landed: "this context page
/// is a mess, it is meant collate resources and context... the content needs to be parsed and
/// paraphrased in sections - we should have strategy bucket, or notes/tips etc. those sections are
/// so bulky." And: "the 'only you see this bit' shouldnt exist."
///
/// The paste used to write four long notes, each one a list inside a single blob of text. A blob
/// cannot be edited, shared, retired or asked about, so the page could only ever print it. A line is
/// a row now: it has a kind, so it can sit in a named bucket; an audience, so the team can read the
/// ones about the work; and an id, so "drop that one" is a sentence rather than a form.
///
/// WHAT IS NEVER SHARED. A line ABOUT a person, a question for them, or a thing between two of them
/// is the lead's read and stays the lead's - shown to nobody else, quoted to nobody, ever. That is
/// enforced where it is written, not left to whoever reads it.
enum ContextItemKind {
  /// How this team wins work and what it leads with.
  STRATEGY
  /// A rule or practice: "no proposal before qualification".
  WAY_OF_WORKING
  /// Something still to decide, and nobody has.
  DECISION
  /// Two versions of one fact, a figure nobody approved, a task nobody knows is finished.
  UNSETTLED
  /// Anything else worth keeping.
  NOTE
  /// The lead's read of one person. Never shared, never quoted.
  ABOUT_A_PERSON
  /// A question the lead wants put to one person in their own check-in.
  QUESTION_FOR_PERSON
  /// Something involving two named people that belongs to neither alone.
  BETWEEN_PEOPLE
}

model GroundContextItem {
  id            String          @id @default(uuid())
  groundId      String          @map("ground_id")
  kind          ContextItemKind
  /// The line as the page shows it: short, plain, paraphrased.
  text          String          @db.Text
  /// What the lead actually wrote, where the line is a paraphrase of it. Retrievable in the chat.
  saidAs        String?         @map("said_as") @db.Text
  /// Who reads it. The three person-kinds above are always LEAD_ONLY, whatever is passed.
  audience      ContextNoteAudience @default(EVERYONE)
  /// Whose it is, for the person-kinds. Null for everything about the work.
  aboutParticipantId String?    @map("about_participant_id")
  /// PASTE, CHAT or LEAD.
  source        String          @default("PASTE")
  authorUserId  String?         @map("author_user_id")
  /// When it stopped being live - a decision made, a rule dropped. Kept rather than deleted.
  closedAt      DateTime?       @map("closed_at")
  /// QUESTION_FOR_PERSON only. The question exactly as Groundwork will ask it, word for word: a
  /// draft until the lead confirms it, and the lead's own wording where they changed it. Decision
  /// 34, 28 September 2026: the lead sees the exact question before it goes, and confirms it.
  exactQuestion String?         @map("exact_question") @db.Text
  /// When the lead confirmed `exactQuestion`. Null means it is not asked - never, by anybody - and
  /// the lead is shown it as waiting for them. Every line written before 28 September starts here.
  questionConfirmedAt DateTime? @map("question_confirmed_at")
  /// DECISION 63, 30 September 2026: set only when this line, or this question's confirming or
  /// declining, was done by an admin standing in because the lead had left the organisation - never
  /// by the lead themselves. The plain sentence people on the check-in read, for example "Ngozi
  /// Bello confirmed this because Tunde Ade has left the organisation." See who-may-confirm-setup.ts.
  confirmedByAdminNote String? @map("confirmed_by_admin_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [aboutParticipantId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@index([aboutParticipantId])
  @@map("ground_context_items")
}

/// A PLAN, READ INTO PROPOSALS, WAITING FOR THE LEAD (week 13, screens request 6a).
///
/// The lead pastes a plan or picks a document, and each goal, role, commitment and rule in it is
/// kept here as one proposal. Nothing reaches the targets, roles, commitments or rules until the
/// lead confirms that one proposal (decision 12): then exactly one row is written, and its id is
/// kept here. Only the person who runs the check-in reads these; a participant never does.
model PlanProposal {
  id              String    @id @default(uuid())
  groundId        String    @map("ground_id")
  createdByUserId String    @map("created_by_user_id")
  /// GOAL, ROLE, COMMITMENT or RULE.
  kind            String
  /// The one plain sentence the lead reads.
  says            String    @db.Text
  /// The structured values: the person, the number, the date exactly as written, and so on.
  fields          Json
  /// The plan's own words it came from, exactly.
  fromThePlan     String    @map("from_the_plan") @db.Text
  /// Where the plan came from: the file's name, or null for pasted text.
  fromDocument    String?   @map("from_document")
  /// PENDING, CONFIRMED or NOT_NOW. An edit keeps it PENDING and sets `editedAt`.
  status          String    @default("PENDING")
  editedAt        DateTime? @map("edited_at")
  decidedAt       DateTime? @map("decided_at")
  decidedByUserId String?   @map("decided_by_user_id")
  /// The row it became when confirmed, in the table its kind lands in.
  becameId        String?   @map("became_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, status])
  @@map("plan_proposals")
}

/// A PASTE IS TAKEN ONCE.
///
/// Read live, 22 September 2026: a lead said yes to the list, then said yes again a minute later
/// because nothing on screen told them it had landed. The second read of the same text renamed
/// things - "document the top 10 questions" became "create a list of the top 10 questions" - so the
/// dedupe on words could not see they were the same, and the list carried both.
///
/// Matching text will always be imperfect. Matching the PASTE is exact: its hash is kept here on a
/// full yes, and a second yes to the same text writes nothing and says so. A partial yes ("yes, but
/// not the 12m") deliberately does NOT land here, because the part left out may still be taken later.
model GroundPaste {
  id        String   @id @default(uuid())
  groundId  String   @map("ground_id")
  /// SHA-256 of the trimmed paste. The text itself is not kept: it is already on the record as what it wrote.
  hash      String
  createdAt DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@unique([groundId, hash])
  @@map("ground_pastes")
}

model GroundCommitment {
  id            String  @id @default(uuid())
  groundId      String  @map("ground_id")
  /// Whose it is. Null where the paste named an action and no owner - which is most of them.
  participantId String? @map("participant_id")
  /// The action, in the words it was written in.
  text          String  @db.Text
  /// What it is for, where that was said. Never invented.
  outcome       String? @db.Text
  /// The timing in its own words ("this week", "friday", "before Thursday") - never parsed to a date.
  whenSaid      String? @map("when_said")
  /// True where the person said it themselves; false where the lead is the one saying they will.
  explicit      Boolean @default(true)
  /// UNKNOWN until somebody says. DONE, NOT_DONE and DROPPED are only ever set by a person.
  status        String  @default("UNKNOWN")
  /// Where it came from: PASTE, CHECK_IN, LEAD.
  source        String  @default("PASTE")
  authorUserId  String? @map("author_user_id")
  /// The check-in this was last put to somebody in, so it is not raised again every session.
  carriedIntoCheckInId String? @map("carried_into_check_in_id")
  /// The session they first said it in. Null on a PASTE, which has no session.
  statedInSession Int? @map("stated_in_session")
  /// True only when `text` is the person's own words: an unbroken passage of what they typed in the
  /// session they said it in. A paste, a lead's edit or a tidied action stays false, and a report may
  /// only put the text in quotation marks when it is true. See reports/a-quote-is-what-they-said.
  saidWordForWord Boolean @default(false) @map("said_word_for_word")
  /// The same, for `whenSaid`: their own words for when.
  whenSaidWordForWord Boolean @default(false) @map("when_said_word_for_word")
  /// The sessions they said it again in, unresolved. Saying it again is not a second commitment -
  /// it is the same one, still open, and this is what makes that countable.
  saidAgainIn Int[] @default([]) @map("said_again_in")
  /// WHEN IT WAS SETTLED, DONE OR NOT DONE, so "kept in the last four weeks" counts by when it was
  /// settled, not when it was promised (week 9). Null while it is open, and on rows settled before
  /// this column existed.
  settledAt           DateTime? @map("settled_at")
  /// The check-in whose own words settled it. Null when a person settled it by hand.
  settledInCheckInId  String?   @map("settled_in_check_in_id")
  /// HOW IT WAS SETTLED, so a screen can show the mark (week 9, decision 12): SAID on the person's own
  /// word (in a check-in or by hand), PROVEN by a document they added themselves, CONFIRMED by the
  /// colleague who received it. Proof never settles NOT_DONE. Null while it is open. See
  /// conversation/settled-by-proof.ts.
  settledBy           String?   @map("settled_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ground      Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@index([participantId])
  @@map("ground_commitments")
}

// ---------------------------------------------------------------------------
// Compliance — disclaimer acknowledgement gate before first session.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Report activation — a per-party reveal confirmation, not a mutual gate.
// Release (Report.releasedAt) happens independently of this, driven by
// session completion; activation only controls what a given party sees
// AFTER release. Each party's own row gates only their own view - one
// party activating has no effect on any other party's access, and there is
// no "wait for the other side" behavior (see ReportsService.get()). The
// initiator is exempt and always sees full content once released.
// ---------------------------------------------------------------------------

enum ReportActivationStatus {
  PENDING // party has not yet activated
  ACTIVATED // party pressed "release report"
}

/// WHAT THE REPORT SAID AT THE END OF ONE ROUND.
///
/// `Report` is one row per check-in and every round overwrites it, so the shared picture is always
/// the current one and the day-14 picture is gone the moment day 30 runs. That is right for a
/// living document and wrong for a record: a ninety-day account of somebody's first quarter was
/// being re-derived from transcripts at the end rather than read back from what was actually said
/// at the time, and nothing could show that an earlier account had changed.
///
/// SO THE CURRENT REPORT IS LEFT EXACTLY AS IT IS and each completed round is copied here. Every
/// existing read path - the ground page, the board, the admin view - still reads `Report` and did
/// not change. This is additive, and it is the smaller half of the two ways to fix it.
///
/// READABLE, NOT JUST FUEL. Hafsah's call: the people who were in a round can read that round's
/// report afterwards. A report somebody read at day 14 stays what they read, which is a stronger
/// promise than the product made before.
///
/// AMENDED IN PLACE AND MARKED, also her call. A late correction changes the round it belongs to
/// rather than creating a second version of the same round - the product already tells people when
/// something was "updated after sign-off", and two rows for one round would say the same thing
/// worse.
model ReportRound {
  id            String @id @default(uuid())
  groundId      String @map("ground_id")
  /// The session number every party had completed when this was taken. Named for what it is (B13).
  sessionNumber Int    @map("session_number")

  /// The report as it stood, in the same shape the live one holds.
  sharedPicture   String @map("shared_picture") @db.Text
  agreements      Json
  divergences     Json
  centralQuestion String @map("central_question") @db.Text

  /// THE ONE LINE THIS ROUND FOUND, which is what sits at the top of its report.
  ///
  /// Kept because it is the only part of a round somebody wants at a glance, and it was computed
  /// live and thrown away. The check-in list showed each ground's BRIEF instead - the sentence it
  /// was set up with - so four goal check-ins read the same and the list said nothing about where
  /// any of them was.
  ///
  /// Nullable: rounds kept before this existed have none, and a round can legitimately produce no
  /// finding at all. The card falls back to the brief either way.
  finding String? @db.Text

  /// When the round closed. Not when this row was written - a retry days later is still that round.
  takenAt DateTime @map("taken_at")

  /// Set when a late correction changed this round after it was first taken. Null on every round
  /// that has not been touched since, which is almost all of them.
  amendedAt   DateTime? @map("amended_at")
  /// One line on what changed, in the product's own words. Shown wherever the round is read.
  amendedNote String?   @map("amended_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  /// One row per round. A second synthesis of the same round amends this one.
  @@unique([groundId, sessionNumber])
  @@index([groundId, sessionNumber])
  @@map("report_rounds")
}

/// WHO HAS BEEN TOLD A ROUND'S REPORT IS READY, ONCE EACH.
///
/// release() mailed everybody the first time a report released and never again: `releasedAt` is
/// stamped once, so session two's report told nobody, and with an open link the round released at
/// the first two answers and the forty-eight who answered afterwards got nothing. One row per person
/// per round, written when their mail goes; the send is skipped where a row exists. Hafsah, 22 Sep
/// 2026: "we want people to get a link to the report."
model ReportNotice {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  participantId String   @map("participant_id")
  sessionNumber Int      @map("session_number")
  sentAt        DateTime @default(now()) @map("sent_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@unique([groundId, participantId, sessionNumber])
  @@map("report_notices")
}

model ReportActivation {
  id            String                 @id @default(uuid())
  groundId      String                 @map("ground_id")
  participantId String                 @map("participant_id")
  status        ReportActivationStatus @default(PENDING)
  activatedAt   DateTime?              @map("activated_at")
  createdAt     DateTime               @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([groundId, participantId])
  @@index([groundId])
  @@map("report_activations")
}

// ---------------------------------------------------------------------------
// Usage events — append-only ops log. Never updated, never deleted.
// Drives the ops dashboard and billing audit trail.
// ---------------------------------------------------------------------------

enum UsageEventType {
  GROUND_CREATED
  CHECK_IN_STARTED
  CHECK_IN_COMPLETED
  REPORT_REQUESTED // party triggers mutual reveal
  REPORT_RELEASED // both activated; releasedAt stamped on Report
  BILLING_ACTIVATED
  PARTICIPANT_INVITED
  PARTICIPANT_ACCEPTED
  ORG_CREATED
  SUBSCRIPTION_STARTED
  SUBSCRIPTION_CANCELLED
  /// A model call made for nobody signed in: the /start page's FAQ and classifier (fix plan F13).
  ANONYMOUS_MODEL_CALL
}

model UsageEvent {
  id             String         @id @default(uuid())
  organizationId String?        @map("organization_id")
  groundId       String?        @map("ground_id")
  participantId  String?        @map("participant_id")
  userId         String?        @map("user_id")
  type           UsageEventType
  meta           Json? // arbitrary key-value for event-specific detail
  createdAt      DateTime       @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([groundId])
  @@index([type, createdAt])
  @@map("usage_events")
}

// ---------------------------------------------------------------------------
// Pattern thresholds — tunable per code without a deploy.
// One row per pattern code. Missing rows fall back to hardcoded defaults.
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Platform settings — generic singleton key/value store for admin-toggleable
// platform-wide flags (e.g. WhatsApp on/off). Not org-scoped: there is one
// Groundwork WhatsApp number serving every org, so this is a single row per
// key, not one per organization.
// ---------------------------------------------------------------------------

model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by") // userId of last editor

  @@map("platform_settings")
}

/// SOMEBODY ASKING TO SPEAK TO A COACH BEFORE THEY OPEN ANYTHING.
///
/// Not a scenario, and deliberately not a ground: nothing is created, nobody is invited, no check-in
/// opens. It is the only path available to the person the picker cannot help - somebody told to set
/// this up, looking at twenty situations, who does not know which one their problem is. Their previous
/// options were to guess or to leave.
///
/// WHY NOT FeedbackSubmission, which already has a status and an admin view. A request has a person,
/// an organisation, a team size, a stated intention and a real lifecycle. Filed as feedback, all of
/// that becomes a `text` blob and the lifecycle disappears.
///
/// EVERY FIELD IS REQUIRED EXCEPT ONE, and that is the point rather than an oversight. A one-click
/// "talk to a coach" button produces volume and no signal; an organisation, a team size and two
/// written lines is more effort than an idle click and less than a form nobody finishes. The price is
/// shown before the send button too, which is the most honest filter available and filters on the
/// right thing.
model CoachRequest {
  id                 String    @id @default(uuid())
  name               String
  /// The single most useful filter. A request with no organisation behind it is not a client.
  orgName            String    @map("org_name")
  email              String
  /// Roughly how many people. Decides whether this is a conversation or a programme, before anybody
  /// spends a call finding out.
  teamSize           String    @map("team_size")
  /// What they want help with, in their own words. A minimum length is enforced at the DTO: somebody
  /// who will not write two lines will not turn up to a session.
  intention          String    @db.Text
  /// Optional. Distinguishes "I cannot work out which situation this is" from "I want somebody to run
  /// it for me" - those get different first replies.
  triedAlready       Boolean?  @map("tried_already")
  /// WHEN THEY WANT THE FIRST CONVERSATION, ASKED BEFORE THEY DECIDE.
  ///
  /// The point of a coach here is help shaping the check-in somebody is about to set up, which is
  /// worth nothing if the first conversation lands after they have set it up. So the request
  /// carries a time they are asking for rather than starting a thread that agrees one later.
  ///
  /// A REQUEST, NOT A BOOKING, and the wording everywhere has to keep saying so. Nothing here holds
  /// a slot in anybody's calendar - a coach confirms - and a product that let somebody leave
  /// believing they had an appointment would be worse than one that never offered.
  ///
  /// Null when they asked without naming a time, which stays a perfectly good request.
  preferredAt        DateTime? @map("preferred_at")
  /// new | contacted | booked | done | declined. A string rather than an enum because the lifecycle of
  /// a sales conversation is not something to migrate the database over.
  status             String    @default("new")
  /// Set when the confirmation email is accepted by the provider, so a request whose only promise was
  /// an email can be seen to have had one sent. Null means it has not gone.
  confirmationSentAt DateTime? @map("confirmation_sent_at")
  /// Free-mail addresses are not refused, they are marked, so the back office can see what it has.
  isFreeMail         Boolean   @default(false) @map("is_free_mail")
  /// Set when an existing open request from the same address is asked again, so the back office shows
  /// one person asking twice rather than two people asking once.
  askedAgainAt       DateTime? @map("asked_again_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@index([email])
  @@map("coach_requests")
}

/// SOMEBODY ASKING TO TALK TO US ABOUT CONNECTING THEIR SYSTEMS.
///
/// The Connect page explains the API well and ended at "see the plans". An admin evaluating this
/// for a company does not want a plan, they want half an hour with their own engineers in the room,
/// and the only way to reach anybody was a mailto on a different page.
///
/// NOT FEEDBACK, WHICH IS WHY IT IS NOT A FeedbackSubmission. Feedback is anonymous by design and
/// has a fixed vocabulary of tabs and pills. A request for a call that does not say who to call
/// back is a request nobody can act on.
///
/// The note is theirs, in their words, and nothing is inferred from it.
/// WHAT A CALL IS ABOUT, WHICH IS NOT A PERMISSION.
///
/// Every one of these is the same request: somebody asks to talk to us, our team talks to them, and
/// what they agreed is invoiced afterwards by hand. Nothing here is sold from a form, so nothing
/// here gates anything - this is a subject line, so whoever picks the call up knows what it is
/// about before they ring back.
enum ServiceRequestKind {
  /// Something else, or not said. The original, and what every row written before this was.
  CALL
  /// Coaching. Sahar in the room when the report lands.
  COACHING
  /// Hands-on setup: somebody to get them running and train their team.
  HANDS_ON
  /// Help connecting Groundwork to systems they already run.
  INTEGRATION
}

model CallRequest {
  /// Which of the four. Defaulted so every row written before this reads as what it was.
  kind           ServiceRequestKind @default(CALL)
  id             String             @id @default(uuid())
  organizationId String             @map("organization_id")
  /// Who asked. They are the one to call.
  requestedById  String             @map("requested_by_id")
  /// What they want to talk about. Optional: asking is the signal, the note is a courtesy.
  note           String?            @db.Text

  /// new | contacted | closed. Read by whoever works through these, not by the product.
  status String @default("new")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("call_requests")
}

model FeedbackSubmission {
  id        String   @id @default(uuid())
  tab       String
  pill      String
  text      String?
  status    String   @default("new")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tab, createdAt])
  @@map("feedback_submissions")
}

/// SOMETHING YOU WROTE DOWN BETWEEN SESSIONS.
///
/// A ground now reads like a channel, and a channel invites you to type. But a
/// session is a closed record, so between sessions there is nothing to add to it -
/// and the honest answer to "can I type here" is yes, into something that is NOT
/// your account.
///
/// WHY THIS IS NOT A RecordEntry, which is where it would naturally have gone.
/// RecordEntry IS the record. `reports.service.ts` reads it to build the shared
/// report, and `context.service.ts` reads the OTHER party's entries. So a sentence
/// typed between sessions, unprompted and unexamined, would become part of the
/// account that gets compared against somebody else's - which is the one thing the
/// engine's design forbids. A note is not an account. It has never been questioned.
///
/// WHAT IT IS FOR. It is carried into the next session as something to ASK about.
/// The engine sees "they noted this between sessions" and raises it; whatever they
/// then say under questioning becomes the record, through the normal path. That
/// makes the note useful rather than a scratchpad, and keeps the rule that the
/// record holds what was said in a session.
///
/// It is private to the person, always. Never in a report, never to the lead,
/// never to another party.
model ParticipantNote {
  id                   String   @id @default(uuid())
  groundId             String   @map("ground_id")
  participantId        String   @map("participant_id")
  text                 String   @db.Text
  createdAt            DateTime @default(now()) @map("created_at")
  /// The check-in that picked it up. Null until a session has seen it, so a note
  /// is raised once rather than in every session from now on.
  carriedIntoCheckInId String?  @map("carried_into_check_in_id")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@index([participantId, carriedIntoCheckInId])
  @@map("participant_notes")
}

/// SOMEBODY CAN BELONG TO MORE THAN ONE ORGANISATION.
///
/// `User.email` is globally unique, so one address is one row - which is why there
/// was no way to be in two organisations at once. Rather than break that (and every
/// lookup that depends on it), membership becomes its own table and
/// `User.organizationId` becomes the ACTIVE one: the org whose data the token scopes
/// every query to.
///
/// That is what makes the switch tractable. Every org-scoped query in the product
/// already reads `organizationId` off the token, so switching means issuing a new
/// token - not rewriting the queries.
///
/// The role is per membership. Somebody can administer their own company and be an
/// ordinary member of a client's organisation, and flattening that to one role would
/// either over-grant or under-grant in one of them.
/// WHO IS WAITING TO BE LET INTO AN ORGANISATION, AND WHO DECIDED.
///
/// Adding an address to a check-in used to make that address a MEMBER of your organisation the
/// moment they accepted: `participants.service.ts` accept() created the User inside the same
/// transaction, verified, with no approval and nobody asked. Two consequences nobody chose - a
/// stranger became a member of your company, and because a seat is any active user (common/seats.ts)
/// they went onto your bill at the same time.
///
/// So an address that is not already in the organisation is QUEUED here instead. The account is
/// still created, because they need one to write their own account of things and because the
/// alternative is holding their words in a second place - but it holds no seat and cannot check in
/// until an admin says yes. See `nobody-joins-your-company-by-being-invited-to-a-check-in.ts`.
model MembershipRequest {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  userId         String @map("user_id")
  /// Kept beside the user because an admin reading the queue is reading addresses, and because a
  /// declined request may outlive the account it was for.
  email          String

  /// Who added them, and to what. Both optional: a request can outlive either.
  requestedByUserId String? @map("requested_by_user_id")
  groundId          String? @map("ground_id")

  status          MembershipRequestStatus @default(PENDING)
  /// Set when somebody decided. Never written by anything automatic.
  decidedByUserId String?                 @map("decided_by_user_id")
  decidedAt       DateTime?               @map("decided_at")
  /// Why it was declined, in the admin's words.
  reason          String?                 @db.Text

  /// TRUE WHEN THE PERSON ACCEPTED A REAL INVITATION to a check-in, rather than a link shared with
  /// many people. Only then does their "Almost in" page name the admin who was asked (Hafsah, 26
  /// September). False for every request made before this and for the join link.
  viaInvitation   Boolean                 @default(false) @map("via_invitation")
  /// When the person last pressed "Remind". Once a day, counted from this or from when they asked.
  lastRemindedAt  DateTime?               @map("last_reminded_at")

  createdAt DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId, status])
  @@map("membership_requests")
}

enum MembershipRequestStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A FREE RUN, PROMISED TO AN ADDRESS BEFORE THERE IS AN ORGANISATION TO GIVE IT TO.
///
/// "We put in someone's email and their org gets free use for three months, and when they sign up
/// they see it." The grant therefore cannot hang off an organisation: at the moment it is made, the
/// person has no account and no organisation, and the whole point is that it is waiting for them.
///
/// It is keyed by email, claimed once, and the clock starts at the claim rather than at the grant -
/// so a promise made in September and taken up in November is still its whole length. One month by
/// default: every free run is one month (Hafsah, 5 October 2026).
model FreeRun {
  id              String           @id @default(uuid())
  /// Lowercased at the write, because an address is not case sensitive and a grant that misses is
  /// worse than no grant: the person signs up, sees nothing, and pays or leaves.
  email           String           @unique
  months          Int              @default(1)
  /// What the free run covers. Not a separate "unlimited" idea: it is one of the plans we sell, so
  /// the caps, the wording and the upgrade path are the ones that already exist.
  plan            SubscriptionPlan @default(GROWTH)
  note            String?
  grantedByUserId String?          @map("granted_by_user_id")
  createdAt       DateTime         @default(now()) @map("created_at")

  /// Set together when somebody signs up on this address. `endsAt` is what the gates read.
  claimedByOrganizationId String?   @map("claimed_by_organization_id")
  claimedAt               DateTime? @map("claimed_at")
  endsAt                  DateTime? @map("ends_at")
  /// Withdrawn before it was taken up. Kept rather than deleted: who was promised what is a record.
  revokedAt               DateTime? @map("revoked_at")

  @@index([claimedByOrganizationId])
  @@map("free_runs")
}

model OrganizationMembership {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           UserRole @default(MEMBER)
  /// WHERE THEY SIT IN THIS ORGANISATION (U.4, the prototype's "Where they sit" and "Team"). Set by an
  /// admin on the People page. They describe the organisation and grant nothing: what somebody can do
  /// still comes only from `role` and their access to each check-in (decisions.md, rule 3). On the
  /// membership, not the account, because the same person sits differently in each organisation.
  /// Separate from the imported staff record's `Person.department`, which the read rule for leads
  /// uses; this field is read by no access rule.
  level           String?  @db.VarChar(120)
  team            String?  @db.VarChar(120)
  /// Who they report to here: another person's user id in this organisation. An id rather than a
  /// relation, so a person leaving never deletes the line above them; unresolved reads as nobody.
  reportsToUserId String?  @map("reports_to_user_id")
  /// HELD FOR A SEAT (U.4 re-review). A guest from another organisation, added to a check-in here
  /// when the plan had no seat for them. They are on the People page ("No seat on your plan") and
  /// on the no-seat card, hold no seat (common/seats.ts), and are not offered the check-in until a
  /// seat is freed and their invitation is sent, which clears this.
  heldForASeat    Boolean  @default(false) @map("held_for_a_seat")
  /// HOW THEY CAME TO BE HERE (U.3 review), so the sidebar can say why they are in it: "domain" (their
  /// email domain may join), "link" (the organisation's invite link). Null where nothing recorded it,
  /// and then no reason is given. "On its list of people" is read from the staff record instead.
  joinedHow       String?  @map("joined_how") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@map("organization_memberships")
}

/// WHO HELD THIS ROLE, AND WHEN THEY STOPPED.
///
/// The spec keys this to a `role` record. There is no `role` table here - roles exist as a static
/// library of functions and as free text on a participant - so this holds the NAME the organisation
/// already uses, the same way `roleAsDescribed` does. Inventing half a role model to satisfy a
/// foreign key would have been the worse of the two: a table nothing populates, joined to by a
/// thing that works, is how a schema starts lying.
///
/// Two jobs, and the second is the one nobody asks for until it is too late. It is the trigger for
/// a handover brief; and `startedAt` is the real onboarding window that `no_checkin` currently
/// approximates with how long somebody has been in the directory.
model RoleAssignment {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  /// The person holding it, by their identity system's id - the same key every org-scoped record uses.
  personExternalId String @map("person_external_id")
  /// The role as the organisation names it. Free text on purpose - see the note above.
  roleName         String @map("role_name")

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  /// The assignment this one takes over from. Set on the INCOMING assignment, so a handover is
  /// something the successor has rather than something the leaver is owed - which is the right way
  /// round, because the leaver has gone.
  predecessorAssignmentId String? @unique @map("predecessor_assignment_id")

  /// Stamped when the brief has been built, so it is built once. §13's ageing rule makes this
  /// load-bearing: turn content ages out, and a brief built afterwards is built from data already
  /// gone.
  handoverReadyAt DateTime? @map("handover_ready_at")
  /// The brief itself, generated at handover and then immutable - it describes a moment.
  handoverBrief   Json?     @map("handover_brief")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  predecessor  RoleAssignment? @relation("Succession", fields: [predecessorAssignmentId], references: [id], onDelete: SetNull)
  successor    RoleAssignment? @relation("Succession")

  @@index([organizationId, personExternalId])
  @@index([organizationId, roleName, endedAt])
  @@map("role_assignments")
}

/// WHAT SOMEBODY NEW TO A ROLE HAS TO GET THROUGH, PER ROLE.
///
/// Keyed by role NAME rather than a role id, for the same reason `RoleAssignment` is - there is no
/// role table, and a foreign key to a thing that does not exist is worse than a string that works.
model OnboardingTrack {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")
  roleName       String @map("role_name")
  name           String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gates        OnboardingGate[]

  /// One track per role. Two would mean somebody joining had two answers about what they owe.
  @@unique([organizationId, roleName])
  @@map("onboarding_tracks")
}

/// One thing to get through. Configurable per role - account set up, brief read, first check-in.
model OnboardingGate {
  id          String  @id @default(uuid())
  trackId     String  @map("track_id")
  /// Stable across renames, because a status points at a gate and a rename must not orphan it.
  key         String
  name        String
  description String? @db.Text
  ordinal     Int
  /// An optional gate is a suggestion. Only required ones hold the window open.
  required    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  track    OnboardingTrack    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  statuses OnboardingStatus[]

  @@unique([trackId, key])
  @@index([trackId, ordinal])
  @@map("onboarding_gates")
}

enum GateState {
  PENDING
  DONE
  /// Deliberately let through - somebody who has done this before elsewhere. Counts as closed for
  /// the window, and is kept distinct from DONE so "did they actually do it" stays answerable.
  WAIVED
}

/// WHERE ONE PERSON HAS GOT TO ON ONE GATE.
///
/// The spec keys this to `participantId`. Participants are ground-scoped and this is not - somebody
/// onboarding into a role has one set of gates whatever grounds they are in - so it keys on the
/// person's external id like every other org-scoped record here.
model OnboardingStatus {
  id               String    @id @default(uuid())
  organizationId   String    @map("organization_id")
  personExternalId String    @map("person_external_id")
  gateId           String    @map("gate_id")
  state            GateState @default(PENDING)
  completedAt      DateTime? @map("completed_at")
  /// What was done, as a pointer rather than a copy - a document id, a check-in id. Never content.
  evidenceRef      String?   @map("evidence_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  gate         OnboardingGate @relation(fields: [gateId], references: [id], onDelete: Cascade)

  @@unique([personExternalId, gateId])
  @@index([organizationId, personExternalId])
  @@map("onboarding_statuses")
}

/// PROPOSED, ACCEPTED, DECLINED, EXPIRED - and never "launched".
enum ScenarioCandidateState {
  PROPOSED
  ACCEPTED
  DECLINED
  /// Nobody answered before the evidence went stale. Not a decline: it is asked again if the
  /// situation is still there, because silence is not a no.
  EXPIRED
}

/// A CONVERSATION THE RECORD SUGGESTS IS NEEDED. NOTHING MORE THAN THAT.
///
/// The spec's own sentence is the design: "detection is a proposal, never a launch", and it says
/// where that matters most - a system that silently opens a performance improvement conversation
/// because a detector crossed a line is a system nobody will let near their staff.
///
/// So this table holds a suggestion addressed to a named person, with the evidence that produced it
/// and how sure it is. A ground is created when they say yes and not before, which is why there is
/// no groundId here until there is.
model ScenarioCandidate {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  scenario       GroundScenario

  /// What it is about. Both nullable: a NEW_HIRE is about a person, a DRIFT is about a subject,
  /// and REALIGN_TEAM is about a subject and several people at once.
  subjectExternalId String? @map("subject_external_id")
  personExternalId  String? @map("person_external_id")

  /// Why, in the shape the detector produced it. Never anybody's words - see the payload rules.
  evidence   Json
  /// How sure, 0 to 1. Shown rather than thresholded away, so somebody can decline a weak one
  /// knowing it was weak.
  confidence Float

  /// The appropriate authority: the subject owner, the lead, or the person themselves.
  proposedToPersonExternalId String   @map("proposed_to_person_external_id")
  proposedAt                 DateTime @default(now()) @map("proposed_at")

  state      ScenarioCandidateState @default(PROPOSED)
  resolvedAt DateTime?              @map("resolved_at")
  /// After this, it stops asking. Silence is not consent and it is not refusal either.
  expiresAt  DateTime               @map("expires_at")

  /// Set when accepting created one. Null everywhere else, which is most of the time.
  groundId String? @map("ground_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, state, expiresAt])
  @@index([organizationId, scenario, subjectExternalId])
  @@index([organizationId, proposedToPersonExternalId, state])
  @@map("scenario_candidates")
}

/// WHAT SOMEBODY WANTS BY MAIL, AND THE ONE THING AN ADMIN CANNOT OVERRIDE.
///
/// §13D.3: per-participant and per-lead opt-out, honoured WITHOUT an admin override. That sentence
/// is why this is a record keyed to the person rather than a setting on the organisation - a
/// preference an admin can flip is not a preference, and the whole reason people answer honestly
/// here is that the product does what it said it would.
/// A MAIL HELD FOR THE MORNING, NOT DROPPED. When quiet hours apply, sendEmail writes the rendered
/// mail here instead of sending it, and held-mail.cron.ts sends what is due. Before this, the digest
/// loop logged "quiet_hours" and moved on: a round that completed at 21:00 local was never announced.
model ScheduledEmail {
  id        String    @id @default(uuid())
  toAddress String    @map("to_address")
  subject   String
  html      String    @db.Text
  sender    String?
  context   Json?
  notBefore DateTime  @map("not_before")
  sentAt    DateTime? @map("sent_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([sentAt, notBefore])
  @@map("scheduled_emails")
}

/// A FAILURE THE PRODUCT KNOWS ABOUT IS WRITTEN WHERE A PERSON CAN FIND IT. A suppressed mail, a
/// bounce, a quiet-hours hold, a failed WhatsApp send: each was a log line or nothing. One row per
/// outcome, from the one door mail goes through and the one WhatsApp sends go through. The screen
/// that reads it is a client job; the point of writing it now is that every fact has somewhere to go.
model Notification {
  id             String   @id @default(uuid())
  organizationId String?  @map("organization_id")
  channel        String
  toAddress      String   @map("to_address")
  sender         String?
  subject        String?
  outcome        String
  because        String?  @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([toAddress, createdAt])
  @@index([outcome, createdAt])
  @@map("notifications")
}

model EmailPreference {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  personExternalId String @map("person_external_id")

  /// One mail per round with the headline and a link. Never a mail per finding.
  roundDigest Boolean @default(true) @map("round_digest")
  /// A commitment they said they would do and have not. Shares the §12 budget with the panel.
  nudges      Boolean @default(true)

  /// Their local hours, so nothing lands at 3am. Null means the organisation default is used.
  quietBeforeHour Int? @map("quiet_before_hour")
  quietAfterHour  Int? @map("quiet_after_hour")

  /// The link on every mail. Long, random, and it works without signing in - somebody who wants to
  /// stop hearing from us must not have to remember a password to do it.
  unsubscribeToken String    @unique @map("unsubscribe_token")
  /// Set when they used it. Turns everything off at once and outranks the individual flags.
  unsubscribedAt   DateTime? @map("unsubscribed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personExternalId])
  @@map("email_preferences")
}

/// HOW LONG RAW CONVERSATION IS KEPT AFTER SOMEBODY LEAVES.
///
/// §13C.1. A departed person's check-ins are the substrate for every finding about the objectives
/// they touched, so a hard delete guts the record - and keeping their words indefinitely against
/// somebody who has left is a real exposure. The window is the customer's to set, BOUNDED at both
/// ends: a floor so it cannot be set to zero and break the product, and a ceiling so it cannot be
/// set to forever and stop being a retention policy.
model RetentionPolicy {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Days a departed person's raw turns are kept. Clamped in code, not only here.
  turnRetentionDays Int @default(180) @map("turn_retention_days")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("retention_policies")
}

/// WHAT THE DEPARTURE JOB DID, KEPT AFTER THE THING IT DID IT TO IS GONE.
///
/// §13C.1: "deletion is a job with an audit record, not a cascade." The distinction is the whole
/// point - a cascade leaves nothing behind saying it happened, so the first question a security
/// review asks ("show me that you deleted it") has no answer. This row outlives the data.
model DepartureRecord {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  personExternalId String @map("person_external_id")

  /// When they left, from the assignment. The clock the window is measured against.
  departedAt     DateTime  @map("departed_at")
  /// When the raw turns actually went. Null while the window is still open.
  turnsDeletedAt DateTime? @map("turns_deleted_at")

  /// Counts, never contents. What was closed, collapsed and deleted, so the job is auditable
  /// without the audit itself becoming a copy of what was removed.
  commitmentsClosed Int @default(0) @map("commitments_closed")
  blockersClosed    Int @default(0) @map("blockers_closed")
  findingsCollapsed Int @default(0) @map("findings_collapsed")
  turnsDeleted      Int @default(0) @map("turns_deleted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personExternalId, departedAt])
  @@index([organizationId, turnsDeletedAt])
  @@map("departure_records")
}

/// PROPOSED, AND NOT YET TRUE.
enum ProposedChangeState {
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  /// Overtaken by a later proposal about the same objective. Not a refusal.
  SUPERSEDED
  /// Withdrawn by whoever proposed it.
  CANCELLED
}

/// SIX IS STILL THE TARGET WHILE FOUR IS BEING ASKED FOR.
///
/// Without this the two cannot coexist. Somebody says in a check-in that six should be four, it sits
/// in a transcript, and a later summary may treat four as the number - which is a proposal becoming
/// an agreement because nobody modelled the difference.
///
/// Deliberately NOT a general workflow engine. It holds one proposed change to one objective, who
/// must approve it, and what happened. Approval itself may be done here or in the customer's own
/// system; this records the outcome either way.
model ProposedChange {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  /// The agreement being asked about. The current value stays on it, untouched.
  personObjectiveId String @map("person_objective_id")

  /// What is being asked for, in the same words somebody would use.
  proposedText String  @map("proposed_text") @db.Text
  /// Why. The reason is the part an approver actually needs, and the part most often lost.
  reason       String? @db.Text

  /// Who asked, and who must answer. Both by their identity system's id.
  proposedByExternalId String @map("proposed_by_external_id")
  approverExternalId   String @map("approver_external_id")

  state               ProposedChangeState @default(AWAITING_APPROVAL)
  /// Set on approval or rejection. Who actually decided, which may differ from who was asked.
  decidedByExternalId String?             @map("decided_by_external_id")
  /// Where it was decided: 'groundwork' or the customer's system name. An approval nobody can
  /// locate afterwards is not much of an approval.
  decidedIn           String?             @map("decided_in")
  decidedAt           DateTime?           @map("decided_at")
  decisionNote        String?             @map("decision_note") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personObjective PersonObjective @relation(fields: [personObjectiveId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
  @@index([personObjectiveId, state])
  @@map("proposed_changes")
}

/// HOW OFTEN THE ROLE'S ONE CONVERTING ACTION IS MEANT TO HAPPEN.
///
/// Separate from `Cadence`, which is how often a check-in runs. They are different clocks with
/// different meanings, and sharing an enum would mean adding QUARTERLY to check-in scheduling - a
/// change to a screen nobody asked for, made by a detector.
enum ActionCadence {
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  QUARTERLY
}

/// A ROLE AS A RECORD, WHICH IS WHAT `neglected_primary` WAS WAITING FOR.
///
/// A role was only ever a name on an assignment, so the one detector in the spec that needs a role
/// to carry something - its hardest, highest-value action and how often that action is due - could
/// not be built. It is named in NEEDS_ROLES in one-vocabulary-two-scopes.ts for that reason.
model Role {
  id             String  @id @default(uuid())
  organizationId String  @map("organization_id")
  /// The customer's own word for it. Assignments name a role by this or by `name`.
  key            String
  name           String
  description    String? @db.Text

  /// §6.3. The one action the role turns on, and the clock it runs against. Both or neither: a key
  /// with no cadence has no period to be judged in, and a cadence with no key names nothing.
  primaryActionKey     String?        @map("primary_action_key")
  /// What to call it in a sentence a person reads. Falls back to the key when absent.
  primaryActionName    String?        @map("primary_action_name")
  primaryActionCadence ActionCadence? @map("primary_action_cadence")

  externalId   String?   @map("external_id")
  sourceSystem String?   @map("source_system")
  syncedAt     DateTime? @map("synced_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
  @@map("roles")
}

/// ONE OCCURRENCE OF A ROLE'S PRIMARY ACTION, PUSHED BY THE CUSTOMER'S OWN SYSTEMS.
///
/// The action happens in their world - a customer visit, a test run, a value presented - so this
/// product cannot observe it and must be told. Kept as its own record rather than folded into
/// `Contribution`, which is about a SUBJECT and answers a different question: contributions say who
/// is carrying which piece of work, and this says whether a particular act happened at all.
model PrimaryActionEvent {
  id               String   @id @default(uuid())
  organizationId   String   @map("organization_id")
  personExternalId String   @map("person_external_id")
  /// Matches `Role.primaryActionKey`. Not a foreign key: an event may arrive before the role is
  /// configured, and dropping it then would lose a fact the customer has already told us.
  actionKey        String   @map("action_key")
  occurredAt       DateTime @map("occurred_at")
  /// Where it can be seen in their system. What makes the finding checkable rather than asserted.
  sourceRef        String?  @map("source_ref")
  sourceSystem     String?  @map("source_system")
  /// Their id for this occurrence, so the same event pushed twice is one event.
  externalId       String?  @map("external_id")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceSystem, externalId])
  @@index([organizationId, personExternalId, actionKey, occurredAt])
  @@map("primary_action_events")
}

// ===========================================================================
// THE OPS SYSTEM — the back office the Groundwork team runs on.
//
// This is not part of the Groundwork product. It is our own company's
// management system, and it happens to live in the same database because we
// are one company with one deployment, not because the two are related.
//
// Two rules hold this boundary, and both are enforced by spec:
//
//   1. No `Ops*` model may hold a foreign key into a product table. The one
//      link is `OpsPerson.userId`, and it exists so a person can sign in with
//      the account they already have. Nothing reads through it.
//   2. No product code may import ops code, and no ops code may import
//      product code.
//
// The test of the boundary: swap this system for somebody else's ERP and
// every check-in still works; turn check-ins off and we can still run the
// company.
// ===========================================================================

/// What somebody does here. Gives default capabilities and nothing more —
/// `OpsGrant` is the truth about what a person may do.
enum OpsFunctionalRole {
  CEO
  SALES_MARKETING
  PRODUCT_TECH_LEAD
  TECH
  CONTRIBUTOR
}

enum OpsPeriodKind {
  /// A named, dated list of the companies we are trying to land. Was called a
  /// SPRINT, which is engineering vocabulary for something that is not
  /// engineering — and read as a two-week iteration to everybody who met it.
  TARGET_LIST
  QUARTER
  /// A biweekly operating cycle. Hangs off a quarter.
  CYCLE
}

enum OpsPeriodStatus {
  PLANNED
  OPEN
  CLOSED
}

/// Where a company has got to with us. Deliberately product-neutral: these are
/// the stages any company would use for a client going live on anything.
enum OpsCompanyStage {
  LINED_UP
  USE_CASE_CONFIRMED
  PRODUCT_READY
  ONBOARDED
  LIVE
}

/// Which part of the company an activity belongs to. One log, seven domains —
/// so that "count these within a window, and show me which ones" is written
/// once instead of five times that drift.
enum OpsActivityDomain {
  SALES
  FUNDING
  DEPLOYMENT
  PRODUCT
  TECH
  STRATEGY
  MARKETING
}

/// A person in our team. Not a Groundwork user — some of us have no account,
/// and a person who leaves keeps their record and loses their grants.
model OpsPerson {
  id String @id @default(uuid())

  /// Stable handle used by the seed and by anything that names a person in
  /// config. Survives a name change.
  key         String  @unique
  displayName String  @map("display_name")
  email       String? @unique

  /// Sign-in only. The single nullable link to the product's user table, and
  /// nothing in the ops system reads through it for anything but auth.
  userId String? @unique @map("user_id")

  functionalRole OpsFunctionalRole @map("functional_role")
  active         Boolean           @default(true)

  createdAt DateTime @default(now()) @map("created_at")

  /// FURTHER ACCOUNTS THAT OPEN THE BACK OFFICE AS THIS PERSON. `userId` is the first; one human
  /// with a work address and a personal one is still one person here, not two.
  accounts OpsPersonAccount[]

  grants             OpsGrant[]               @relation("OpsGrantHolder")
  attributions       OpsAttribution[]         @relation("OpsAttributionContributor")
  positioning        OpsPositioningRecord[]   @relation("OpsPositioningContributor")
  agreement          OpsContributorAgreement? @relation("OpsContributorAgreementHolder")
  contributorTargets OpsContributorTarget[]   @relation("OpsContributorTargetHolder")

  @@index([active])
  @@map("ops_people")
}

model OpsPersonAccount {
  id       String    @id @default(uuid())
  personId String    @map("person_id")
  userId   String    @unique @map("user_id")
  addedAt  DateTime  @default(now()) @map("added_at")
  person   OpsPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId])
  @@map("ops_person_accounts")
}

/// THE BACK OFFICE HAS A DOOR. Signing in opens the product; opening /ops or /admin also needs a
/// code sent to the signed-in email, good for a week, unless the session came from Google, which
/// already did the second check. One row per user, replaced on each verification.
model BackOfficePass {
  userId        String    @id @map("user_id")
  via           String
  verifiedAt    DateTime  @default(now()) @map("verified_at")
  expiresAt     DateTime  @map("expires_at")
  /// The code in flight, hashed, and when it stops being accepted. Cleared on verification.
  codeHash      String?   @map("code_hash")
  codeExpiresAt DateTime? @map("code_expires_at")
  /// Wrong guesses against the code in flight. A six-digit code is a million guesses; without a
  /// counter, an attacker with a session on a staff account could simply try them. Reset whenever a
  /// new code is sent, and the code is destroyed when this passes the ceiling.
  wrongGuesses  Int       @default(0) @map("wrong_guesses")

  @@map("back_office_passes")
}

/// One capability held by one person. A role suggests a set; this table decides.
///
/// Kept as rows rather than an array so that granting and revoking are ordinary
/// writes with a timestamp and an author, and so a capability check is an index
/// lookup rather than a scan of somebody's role.
model OpsGrant {
  id       String @id @default(uuid())
  personId String @map("person_id")

  /// `domain:action`, e.g. `sales:write`, `roadmap:approve`. The route asks for
  /// one of these by name; it never asks what somebody's role is.
  capability String

  grantedAt DateTime @default(now()) @map("granted_at")
  /// Who granted it. Null for the seed, which grants the defaults.
  grantedBy String?  @map("granted_by")

  person OpsPerson @relation("OpsGrantHolder", fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, capability])
  @@index([capability])
  @@map("ops_grants")
}

/// A window of time the company works in: the September sprint, a quarter, or
/// a biweekly cycle inside one.
model OpsPeriod {
  id   String        @id @default(uuid())
  key  String        @unique
  name String
  kind OpsPeriodKind

  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  /// What this period is for, in a sentence. Optional because a cycle usually
  /// inherits its point from the quarter above it.
  goal   String?         @db.Text
  status OpsPeriodStatus @default(PLANNED)

  parentPeriodId String? @map("parent_period_id")

  contributorTargets OpsContributorTarget[] @relation("OpsContributorTargetPeriod")

  parentPeriod OpsPeriod?  @relation("OpsPeriodParent", fields: [parentPeriodId], references: [id], onDelete: Restrict, map: "ops_periods_parent_fkey")
  childPeriods OpsPeriod[] @relation("OpsPeriodParent")

  @@index([kind, startsOn])
  @@map("ops_periods")
}

/// A standing area of the company with an owner. Five of these, seeded.
model OpsWorkstream {
  id   String @id @default(uuid())
  key  String @unique
  name String

  ownerPersonId            String  @map("owner_person_id")
  /// Who watches it without running it. Usually the CEO.
  oversightPersonId        String? @map("oversight_person_id")
  /// Who does the building where the owner does not build.
  technicalPartnerPersonId String? @map("technical_partner_person_id")

  /// The named areas this workstream covers, for the board headings.
  areas String[]

  @@map("ops_workstreams")
}

/// A company we are selling to, deploying for, or already serving.
///
/// One identity. Sales, use cases, deployment and attribution all point here,
/// which is how "do not create duplicate company records" becomes a property of
/// the schema instead of a rule somebody has to remember.
model OpsCompany {
  id   String @id @default(uuid())
  key  String @unique
  name String

  primaryContactName  String? @map("primary_contact_name")
  primaryContactEmail String? @map("primary_contact_email")
  primaryContactPhone String? @map("primary_contact_phone")

  /// How they reached us, in our own words.
  source                   String?
  /// The contributor who brought them, when one did.
  originatingContributorId String? @map("originating_contributor_id")
  /// The target list they are on, when they are on one.
  targetListId             String? @map("target_list_id")

  stage         OpsCompanyStage @default(LINED_UP)
  ownerPersonId String?         @map("owner_person_id")

  nextAction      String?   @map("next_action")
  nextActionDueAt DateTime? @map("next_action_due_at")
  blockerSummary  String?   @map("blocker_summary") @db.Text

  liveAt DateTime? @map("live_at")
  notes  String?   @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  attributions            OpsAttribution[]
  useCases                OpsClientUseCase[]
  deployments             OpsDeployment[]
  commercialOpportunities OpsCommercialOpportunity[]

  @@index([stage])
  @@index([targetListId])
  @@map("ops_companies")
}

/// Something that happened, in any part of the company.
///
/// Every metric in this system needs the same three things from its evidence: a
/// count inside a window, a first-occurrence test, and a list you can open. One
/// log gives all three one implementation.
model OpsActivity {
  id String @id @default(uuid())

  domain OpsActivityDomain
  /// The specific kind within the domain — `call`, `demo`, `proposal_sent`,
  /// `application_submitted`. Free text on purpose: new kinds appear faster
  /// than migrations ship, and nothing branches on the value.
  kind   String

  actorPersonId String? @map("actor_person_id")

  /// What it happened against. Not a foreign key: an activity outlives the
  /// record it describes, and losing the history to a delete is worse than
  /// holding a pointer that can go stale.
  recordType String  @map("record_type")
  recordId   String  @map("record_id")
  companyId  String? @map("company_id")

  happenedAt  DateTime @map("happened_at")
  note        String?  @db.Text
  /// Where somebody else can go and see this for themselves.
  evidenceUrl String?  @map("evidence_url")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([domain, happenedAt])
  @@index([recordType, recordId])
  @@index([companyId, happenedAt])
  @@index([actorPersonId, happenedAt])
  @@map("ops_activities")
}

// --- Phase 2: the September sprint -----------------------------------------

/// How far a contributor's introduction has got. The line at which one counts
/// toward a target is a SETTING, not a hard-coded stage — see `OpsSetting`.
enum OpsQualifyingStatus {
  INTRODUCED
  READY
  QUALIFIED
}

/// Whether the product supports what a company actually wants to do.
enum OpsUseCaseReadiness {
  UNKNOWN
  REVIEWING
  GAP_IDENTIFIED
  IN_PROGRESS
  PRODUCT_READY
}

/// A client's journey from signed to getting something out of it.
///
/// Product-neutral on purpose. `FIRST_USE` and `firstUseAt` mean "they used the
/// thing"; for us that happens to be a check-in, and it would still mean exactly
/// what it says if we sold something else tomorrow.
enum OpsDeploymentStage {
  READY_SIGNED
  SETUP
  ONBOARDING
  FIRST_USE
  LIVE
}

/// A decision, stored rather than hard-coded.
///
/// Anything on this table is something a person chose and could choose
/// differently: where the qualifying line sits, what currency we count in, which
/// clock the boards show. Burying those in code makes changing one a deploy and
/// makes disagreeing with one an argument about a constant.
model OpsSetting {
  key   String  @id
  value String
  /// What choosing differently would change, so the next person is not guessing.
  note  String? @db.Text

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("ops_settings")
}

/// A contributor brought this company to us.
///
/// Unique on (company, contributor) so the same introduction cannot be counted
/// twice — which is the only way a target made of introductions stays honest.
model OpsAttribution {
  id            String @id @default(uuid())
  companyId     String @map("company_id")
  contributorId String @map("contributor_id")

  /// How they know them, in the contributor's own words.
  sourceType   String  @map("source_type")
  sourceDetail String? @map("source_detail") @db.Text

  introducedAt     DateTime            @map("introduced_at")
  qualifyingStatus OpsQualifyingStatus @default(INTRODUCED) @map("qualifying_status")
  qualifiedAt      DateTime?           @map("qualified_at")

  notes String? @db.Text

  company     OpsCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contributor OpsPerson  @relation("OpsAttributionContributor", fields: [contributorId], references: [id], onDelete: Restrict)

  @@unique([companyId, contributorId])
  @@index([contributorId, qualifyingStatus])
  @@map("ops_attributions")
}

/// How many companies somebody is expected to bring, and by when.
model OpsContributorTarget {
  id       String @id @default(uuid())
  personId String @map("person_id")
  periodId String @map("period_id")

  targetCount Int      @map("target_count")
  dueDate     DateTime @map("due_date") @db.Date
  active      Boolean  @default(true)

  /// A standing target, or an expectation of one sprint. Kept apart so a
  /// sprint's "bring one ready company" never reads as the year's number.
  isTargetListExpectation Boolean @default(false) @map("is_sprint_expectation")

  person OpsPerson @relation("OpsContributorTargetHolder", fields: [personId], references: [id], onDelete: Cascade)
  period OpsPeriod @relation("OpsContributorTargetPeriod", fields: [periodId], references: [id], onDelete: Restrict)

  @@unique([personId, periodId, isTargetListExpectation])
  @@map("ops_contributor_targets")
}

/// What one company actually wants to do, and whether we support it yet.
model OpsClientUseCase {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  title            String
  description      String? @db.Text
  /// What they expect to happen, step by step, in their words.
  expectedWorkflow String? @map("expected_workflow") @db.Text
  category         String?

  productReadiness OpsUseCaseReadiness @default(UNKNOWN) @map("product_readiness")
  /// Three separate gaps because three different people close them.
  productGap       String?             @map("product_gap") @db.Text
  uxGap            String?             @map("ux_gap") @db.Text
  technicalGap     String?             @map("technical_gap") @db.Text

  ownerId  String? @map("owner_id")
  priority Int     @default(3)

  nextAction      String?   @map("next_action")
  targetReadyDate DateTime? @map("target_ready_date")
  statusNotes     String?   @map("status_notes") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  company     OpsCompany       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  links       OpsUseCaseLink[]
  deployments OpsDeployment[]

  @@index([productReadiness])
  @@map("ops_client_use_cases")
}

/// Getting one company from signed to actually using the thing.
model OpsDeployment {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  useCaseId String? @map("use_case_id")

  deploymentOwnerId String  @map("deployment_owner_id")
  productOwnerId    String? @map("product_owner_id")
  technicalOwnerId  String? @map("technical_owner_id")

  stage OpsDeploymentStage @default(READY_SIGNED)

  startDate      DateTime  @map("start_date")
  targetLiveDate DateTime? @map("target_live_date")
  actualLiveDate DateTime? @map("actual_live_date")

  onboardingStartedAt   DateTime? @map("onboarding_started_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  /// They used the thing. For us that is a check-in; the field does not know that.
  firstUseAt            DateTime? @map("first_use_at")
  /// They got something out of it. For us that is a report.
  firstResultAt         DateTime? @map("first_result_at")

  /// Which of the three teams is holding this up, when one is.
  blockerType    String? @map("blocker_type")
  blockerSummary String? @map("blocker_summary") @db.Text

  nextAction        String?   @map("next_action")
  nextActionOwnerId String?   @map("next_action_owner_id")
  nextActionDueAt   DateTime? @map("next_action_due_at")

  notes String? @db.Text

  company OpsCompany        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  useCase OpsClientUseCase? @relation(fields: [useCaseId], references: [id], onDelete: SetNull)

  @@index([stage])
  @@index([blockerType])
  @@map("ops_deployments")
}

// --- Phase 3: pipeline, campaigns, and getting people live -----------------

enum OpsMarketingStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELLED
}

/// THE OLD SALES PIPELINE IS GONE.
///
/// It ran beside the commercial one - same companies, same stages, a different
/// set of numbers, and no record of who created anything. Two pipelines is how
/// a company ends up with two answers to "how much are we selling", and the
/// commercial pipeline is the one that carries attribution.
///
/// Its rows were migrated rather than dropped, and every one arrived as
/// NEEDS_REVIEW. Nothing was inferred: not from who owned the sale, not from
/// who created the record. Where the old table's unused originatingContributorId
/// held somebody, that became a CLAIM for them to have approved - a claim, not
/// a credit, because a field nobody ever filled in deliberately is not evidence.

/// A campaign, a piece of content, an event. Lightweight on purpose.
model OpsMarketingActivity {
  id    String @id @default(uuid())
  title String

  activityType String  @map("activity_type")
  channel      String?

  /// WHAT THIS CAMPAIGN IS BEING RUN FOR, AS A ROW.
  ///
  /// `objective` was a sentence, which is a note about intent and not a
  /// connection: nothing could ask what is running for a given objective, and a
  /// campaign could not be checked against the quarter it was actually in.
  ///
  /// The sentence stays alongside it, because the link says WHICH objective and
  /// only the sentence says WHY this campaign serves it.
  ///
  /// Nullable for the campaigns that came before the rule. New ones are refused
  /// without it, in the service, where a refusal can be a sentence.
  objectiveId String? @map("objective_id")
  objective   String? @db.Text

  ownerId   String    @map("owner_id")
  startDate DateTime  @map("start_date")
  endDate   DateTime? @map("end_date")

  status OpsMarketingStatus @default(PLANNED)

  /// The string an opportunity's `source` carries when it came from here.
  /// Matching on it is how "this campaign generated two leads" gets checked.
  campaignSource String? @map("campaign_source")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  opportunities   OpsCommercialOpportunity[]
  linkedObjective OpsObjective?              @relation("OpsMarketingObjective", fields: [objectiveId], references: [id], onDelete: SetNull)

  @@index([status, startDate])
  @@index([objectiveId])
  @@map("ops_marketing_activities")
}

// --- Phase 4: what we build, and who says so -------------------------------

enum OpsRoadmapStatus {
  PROPOSED
  READY
  IN_PROGRESS
  BLOCKED
  COMPLETED
}

enum OpsWorkItemStatus {
  OPEN
  IN_PROGRESS
  BLOCKED
  RESOLVED
}

enum OpsApprovalType {
  ROADMAP
  REPRIORITISATION
  COMMERCIAL
  SPEND
  RESOURCING
  /// A deck, a campaign, a page of site copy. Signed off against the version of
  /// the product statement it was checked against, so changing what we say we
  /// are reopens everything signed against the old words.
  RESOURCE
}

enum OpsApprovalStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

/// Something we intend to build.
///
/// `approvalRequired` is the field that makes the roadmap a decision rather than
/// a list: an item carrying it cannot leave PROPOSED until an approval says so.
/// The rule lives in the service and is asserted by a spec, because a boolean
/// nobody enforces is a comment.
model OpsRoadmapItem {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text

  productArea String? @map("product_area")
  itemType    String  @map("item_type")

  /// A STANDING ITEM IS NOT A PROPOSAL.
  ///
  /// Everything else on this roadmap can be argued with, reprioritised or
  /// dropped. One or two cannot: they are the frame the others sit in, and
  /// showing them in the same list with the same controls makes them look like
  /// opinions somebody could disagree with.
  ///
  /// A standing item has no approval and no status somebody moves. It has a
  /// definition of done, and the definition is COMPUTED - see
  /// `what-solid-means.ts`. Typing "done" against "every bug fixed" would be
  /// the one place on this board where a claim outranks a count.
  standing Boolean @default(false)
  priority Int     @default(3)

  ownerId      String? @map("owner_id")
  proposedById String  @map("proposed_by_id")

  relatedCompanyId String? @map("related_company_id")
  relatedUseCaseId String? @map("related_use_case_id")

  targetDate DateTime?        @map("target_date")
  status     OpsRoadmapStatus @default(PROPOSED)

  approvalRequired Boolean @default(false) @map("approval_required")

  rationale     String? @db.Text
  expectedValue String? @map("expected_value") @db.Text
  evidenceUrl   String? @map("evidence_url")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  /// A stable handle for the seeded items, so re-seeding does not duplicate them.
  key String? @unique

  @@index([status, priority])
  @@map("ops_roadmap_items")
}

/// A bug, a piece of infrastructure, a technical blocker.
model OpsTechItem {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text

  itemType String @map("item_type")
  /// How bad. Free text so a new severity does not need a migration, and
  /// nothing branches on the value — the board sorts by it and that is all.
  severity String

  ownerId String? @map("owner_id")

  relatedCompanyId     String? @map("related_company_id")
  relatedUseCaseId     String? @map("related_use_case_id")
  relatedRoadmapItemId String? @map("related_roadmap_item_id")
  relatedDeploymentId  String? @map("related_deployment_id")

  status        OpsWorkItemStatus @default(OPEN)
  targetDate    DateTime?         @map("target_date")
  blockerReason String?           @map("blocker_reason") @db.Text
  evidenceUrl   String?           @map("evidence_url")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([status, severity])
  @@index([relatedCompanyId])
  @@map("ops_tech_items")
}

/// An interface problem, and where it was noticed.
model OpsUXItem {
  id           String  @id @default(uuid())
  title        String
  affectedFlow String? @map("affected_flow")
  description  String? @db.Text
  /// Whose words this came from. A UX problem somebody reported is worth more
  /// than one somebody thought of, and the board should be able to tell.
  sourceNote   String? @map("source_note") @db.Text

  relatedCompanyId String? @map("related_company_id")
  relatedUseCaseId String? @map("related_use_case_id")

  severity String
  ownerId  String? @map("owner_id")

  status      OpsWorkItemStatus @default(OPEN)
  targetDate  DateTime?         @map("target_date")
  evidenceUrl String?           @map("evidence_url")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([status, severity])
  @@map("ops_ux_items")
}

/// What a use case needs, whatever kind of item that is.
///
/// One table rather than three arrays: a readiness row has to ask "what is
/// outstanding against this" once, not once per item type.
model OpsUseCaseLink {
  id        String @id @default(uuid())
  useCaseId String @map("use_case_id")

  /// `OpsRoadmapItem`, `OpsTechItem` or `OpsUXItem`.
  targetType String @map("target_type")
  targetId   String @map("target_id")

  createdAt DateTime @default(now()) @map("created_at")

  useCase OpsClientUseCase @relation(fields: [useCaseId], references: [id], onDelete: Cascade)

  @@unique([useCaseId, targetType, targetId])
  @@map("ops_use_case_links")
}

/// One mechanism for every decision.
///
/// Roadmap, spend, resourcing and commercial all come through here, so the CEO
/// has one queue rather than four, and so "who decided this, and when" has the
/// same answer everywhere.
model OpsApproval {
  id           String          @id @default(uuid())
  approvalType OpsApprovalType @map("approval_type")

  requesterId String @map("requester_id")
  approverId  String @map("approver_id")

  relatedRecordType String @map("related_record_type")
  relatedRecordId   String @map("related_record_id")

  requestSummary String            @map("request_summary") @db.Text
  status         OpsApprovalStatus @default(PENDING)
  decisionNote   String?           @map("decision_note") @db.Text

  createdAt DateTime  @default(now()) @map("created_at")
  decidedAt DateTime? @map("decided_at")

  @@index([status, createdAt])
  @@index([relatedRecordType, relatedRecordId])
  @@map("ops_approvals")
}

// --- Phase 5: what we said we would do, and what happened ------------------

enum OpsObjectiveStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  MISSED
  ARCHIVED
}

enum OpsCommitmentStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  MISSED
}

enum OpsTodoStatus {
  OPEN
  DONE
  CANCELLED
}

/// What a workstream is trying to achieve this quarter.
model OpsObjective {
  id           String @id @default(uuid())
  periodId     String @map("period_id")
  workstreamId String @map("workstream_id")

  title       String
  description String? @db.Text
  ownerId     String  @map("owner_id")

  /// WHAT SETTING THIS BUYS, AND WHY THIS RATHER THAN SOMETHING ELSE.
  ///
  /// The form asked for a title, an area and a sentence, which is a note rather
  /// than an objective. These four fields are the difference.
  ///
  /// `serves` is the same four values a piece of work can serve, so an
  /// objective and the work under it are answering one question in one
  /// vocabulary. `instead` is the conveyor belt: "why is this the best use of
  /// time" is unanswerable in the abstract and only answerable against the
  /// alternative, and nobody writes it down unless the form makes them.
  serves        OpsServes?
  justification String?    @db.Text
  instead       String?    @db.Text

  /// THE SALES ARITHMETIC, KEPT AS ITS TWO PARTS.
  ///
  /// "Eight companies at fifteen thousand" is a claim about the pipeline, and
  /// the pipeline is in this system. Stored as the two numbers rather than the
  /// product of them, so the claim can be checked against what is actually
  /// there rather than only admired.
  companiesExpected    Int? @map("companies_expected")
  valuePerCompanyCents Int? @map("value_per_company_cents")

  status   OpsObjectiveStatus @default(DRAFT)
  priority Int                @default(3)

  createdAt DateTime @default(now()) @map("created_at")

  keyResults OpsKeyResult[]
  campaigns  OpsMarketingActivity[] @relation("OpsMarketingObjective")

  @@index([periodId, status])
  @@map("ops_objectives")
}

/// A number that says whether the objective happened.
///
/// `measurementSource` is either a metric key or the literal MANUAL. Anything
/// else is a typo, and a key result measured by a typo silently becomes a
/// number nobody updates — so the resolver refuses rather than falling back.
model OpsKeyResult {
  id          String @id @default(uuid())
  objectiveId String @map("objective_id")

  title      String
  metricType String @map("metric_type")

  targetValue  Decimal  @map("target_value") @db.Decimal(14, 2)
  unit         String
  startValue   Decimal? @map("start_value") @db.Decimal(14, 2)
  /// Only ever read for a MANUAL key result. A sourced one computes on read, so
  /// a stored value would be a second answer that goes stale.
  currentValue Decimal  @default(0) @map("current_value") @db.Decimal(14, 2)

  measurementSource String @map("measurement_source")

  /// WHY THIS NUMBER, AND HOW IT WILL BE MOVED.
  ///
  /// A key result was a target and a source: what to reach and where the number
  /// comes from. Neither says whether the target is the right one or whether
  /// anybody has thought about how to hit it — and a number with no approach
  /// behind it is a wish with a deadline.
  ///
  /// Kept apart on purpose. The justification is why this number is the one
  /// that matters; the approach is what somebody is actually going to do. They
  /// fail differently: a good reason with no plan is a hope, and a good plan
  /// for the wrong number is worse.
  justification String? @db.Text
  approach      String? @db.Text

  ownerId String   @map("owner_id")
  dueDate DateTime @map("due_date") @db.Date

  status OpsObjectiveStatus @default(ACTIVE)

  objective OpsObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@map("ops_key_results")
}

/// What one person said they would do in one cycle.
model OpsCommitment {
  id                String  @id @default(uuid())
  ownerId           String  @map("owner_id")
  operatingPeriodId String  @map("operating_period_id")
  workstreamId      String? @map("workstream_id")

  linkedObjectiveId String? @map("linked_objective_id")
  linkedKeyResultId String? @map("linked_key_result_id")

  title       String
  description String? @db.Text

  measureType String   @map("measure_type")
  targetValue Decimal? @map("target_value") @db.Decimal(14, 2)
  unit        String?

  startDate DateTime @map("start_date") @db.Date
  dueDate   DateTime @map("due_date") @db.Date

  /// As with a key result, only read when the commitment is measured by hand.
  currentValue Decimal? @map("current_value") @db.Decimal(14, 2)

  status        OpsCommitmentStatus @default(NOT_STARTED)
  /// Orthogonal to status on purpose: work that is blocked is still in
  /// progress, and collapsing the two loses the fact somebody needs help.
  blocked       Boolean             @default(false)
  blockerReason String?             @map("blocker_reason") @db.Text

  measurementSource String @map("measurement_source")

  actualResult String?   @map("actual_result") @db.Text
  evidenceUrl  String?   @map("evidence_url")
  closedAt     DateTime? @map("closed_at")

  createdAt DateTime @default(now()) @map("created_at")

  links OpsCommitmentLink[]

  @@index([ownerId, operatingPeriodId])
  @@index([status, dueDate])
  @@map("ops_commitments")
}

/// What a commitment is pointed at, whatever kind of record that is.
model OpsCommitmentLink {
  id           String @id @default(uuid())
  commitmentId String @map("commitment_id")

  targetType String @map("target_type")
  targetId   String @map("target_id")

  commitment OpsCommitment @relation(fields: [commitmentId], references: [id], onDelete: Cascade)

  @@unique([commitmentId, targetType, targetId])
  @@map("ops_commitment_links")
}

/// A task. Deliberately the lightest record here.
model OpsTodo {
  id      String @id @default(uuid())
  title   String
  ownerId String @map("owner_id")

  assignedById String?   @map("assigned_by_id")
  dueDate      DateTime? @map("due_date") @db.Date

  status OpsTodoStatus @default(OPEN)

  relatedRecordType String? @map("related_record_type")
  relatedRecordId   String? @map("related_record_id")

  notes String? @db.Text

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  @@index([ownerId, status])
  @@map("ops_todos")
}

// --- Phase 6: the CEO's own functions --------------------------------------

enum OpsFundingStage {
  TARGET
  CONTACTED
  MEETING
  FOLLOW_UP
  APPLICATION_DILIGENCE
  COMMITTED
  CLOSED
  /// Terminal.
  DECLINED
}

enum OpsStrategicStatus {
  IDENTIFIED
  OUTREACH
  ENGAGED
  OPPORTUNITY_CREATED
  COMPLETED
  DORMANT
  CLOSED
}

enum OpsRequestStatus {
  OPEN
  DECIDED
}

enum OpsExpenseStatus {
  REQUESTED
  /// Claimed by somebody who holds the decision themselves. Money out, but not
  /// reviewed by a second person, and kept apart so the ledger never implies
  /// it was.
  RECORDED
  APPROVED
  PAID
  REJECTED
}

/// Somebody who might fund us.
model OpsFundingOpportunity {
  id             String  @id @default(uuid())
  funderName     String  @map("funder_name")
  primaryContact String? @map("primary_contact")

  fundingType String  @map("funding_type")
  source      String?
  ownerId     String  @map("owner_id")

  stage OpsFundingStage @default(TARGET)

  askAmount  Decimal? @map("ask_amount") @db.Decimal(14, 2)
  currency   String   @default("USD")
  instrument String?

  lastActivityAt      DateTime? @map("last_activity_at")
  nextAction          String?   @map("next_action")
  nextActionDueAt     DateTime? @map("next_action_due_at")
  applicationDeadline DateTime? @map("application_deadline")

  /// What they said yes to, and what actually arrived. Kept apart because the
  /// gap between them is the only interesting number in a fundraise.
  committedAmount Decimal? @map("committed_amount") @db.Decimal(14, 2)
  closedAmount    Decimal? @map("closed_amount") @db.Decimal(14, 2)

  statusNote String? @map("status_note") @db.Text
  notes      String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([stage, lastActivityAt])
  @@index([nextActionDueAt])
  @@map("ops_funding_opportunities")
}

/// A relationship that could turn into a customer, a funder, a partner or a
/// contributor. Tracked because network access is work, and untracked work
/// stops happening.
model OpsStrategicOpportunity {
  id              String  @id @default(uuid())
  personOrNetwork String  @map("person_or_network")
  organization    String?

  opportunityType String  @map("opportunity_type")
  objective       String? @db.Text
  ownerId         String  @map("owner_id")

  status OpsStrategicStatus @default(IDENTIFIED)
  source String?

  lastActivityAt DateTime? @map("last_activity_at")
  nextStep       String?   @map("next_step")
  nextStepDueAt  DateTime? @map("next_step_due_at")

  impactNote      String? @map("impact_note") @db.Text
  /// What this turned into, so a conversion is a link rather than a claim.
  convertedToType String? @map("converted_to_type")
  convertedToId   String? @map("converted_to_id")

  linkedContributorId String? @map("linked_contributor_id")
  notes               String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("ops_strategic_opportunities")
}

/// "We cannot deliver X without Y." The decision lives on an approval.
model OpsResourceRequest {
  id          String @id @default(uuid())
  requesterId String @map("requester_id")

  supportNeeded String @map("support_needed") @db.Text
  reason        String @db.Text

  affectedWorkType String? @map("affected_work_type")
  affectedRecordId String? @map("affected_record_id")

  urgency         String
  requestedByDate DateTime? @map("requested_by_date")

  status OpsRequestStatus @default(OPEN)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([status])
  @@map("ops_resource_requests")
}

/// Somebody spent money and wants it back.
model OpsExpense {
  id          String   @id @default(uuid())
  requesterId String   @map("requester_id")
  date        DateTime @db.Date
  description String   @db.Text
  category    String

  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("USD")

  receiptUrl String? @map("receipt_url")
  notes      String? @db.Text

  status OpsExpenseStatus @default(REQUESTED)

  submittedAt    DateTime  @default(now()) @map("submitted_at")
  approvedById   String?   @map("approved_by_id")
  approvedAt     DateTime? @map("approved_at")
  paidAt         DateTime? @map("paid_at")
  rejectedReason String?   @map("rejected_reason") @db.Text

  @@index([requesterId, status])
  @@index([status])
  @@map("ops_expenses")
}

/// Money in. Entered by hand, which is what gives the balance a real basis
/// rather than a computed guess.
model OpsEarningsEntry {
  id       String   @id @default(uuid())
  date     DateTime @db.Date
  amount   Decimal  @db.Decimal(14, 2)
  currency String   @default("USD")
  source   String
  note     String?  @db.Text

  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([date])
  @@map("ops_earnings_entries")
}

// --- Phase 8: the seam out to Groundwork -----------------------------------

/// How the ops system reaches Groundwork, and what happened last time it did.
///
/// One row. The secret is never read back out of it — `PATCH` writes, nothing
/// returns it — because a connection screen that shows a client secret is a
/// credential printed on a monitor in an open-plan office.
model OpsIntegration {
  id String @id @default("the-one-row")

  /// Off by default, and turning it off must change nothing on any ops board.
  /// That is the test of whether these are two systems or one.
  enabled Boolean @default(false)

  baseUrl      String? @map("base_url")
  clientId     String? @map("client_id")
  clientSecret String? @map("client_secret")

  /// The secret Groundwork signs its webhooks with, handed over when we
  /// registered where to send them. Ours to check against, and it never leaves
  /// this side — see `what-groundwork-tells-us.ts`.
  webhookSecret String? @map("webhook_secret")

  /// The check-in our objectives are attached to, in the Groundwork we push to.
  ///
  /// Evidence attaches to an objective that exists ON a check-in, so without
  /// this there is nowhere for our numbers to land - which is exactly what
  /// happened for the whole of the first build: every push returned 200 and
  /// wrote nothing. The adapter does not open one itself: opening a check-in
  /// invites people and starts a conversation, and a nightly job should not do
  /// that on anybody's behalf.
  checkInId String? @map("check_in_id")

  /// THE TWO THINGS THE PANEL NEEDS, AND NOTHING ELSE DOES.
  ///
  /// A machine credential opens the data routes. The assistant panel is a
  /// different act: a browser on OUR page asking Groundwork about the person
  /// looking at it, and a machine secret in a browser is a machine secret in
  /// developer tools. So the panel goes the way a customer's does - our server
  /// signs a short assertion about who is signed in, with a secret shared with
  /// Groundwork, and the browser carries only that.
  /// IT MUST BE THE ORGANISATION THE CREDENTIAL ABOVE WRITES INTO.
  ///
  /// The token names a person by their externalId inside an organisation, and
  /// SCIM puts that person into whichever organisation the machine credential
  /// belongs to. Point this at a different one and the handshake answers
  /// `visible: false` about somebody plainly on the team, with nothing to say
  /// why. Cost two rounds to find while integrating our own back office.
  organizationId String? @map("organization_id")
  embedSecret    String? @map("embed_secret")

  /// What the last push did, in the API's own words.
  lastSyncAt      DateTime? @map("last_sync_at")
  lastSyncOk      Boolean?  @map("last_sync_ok")
  lastSyncSummary String?   @map("last_sync_summary") @db.Text
  lastSyncDetail  String?   @map("last_sync_detail") @db.Text

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("ops_integration")
}

// --- The moat, and what gets built on it -----------------------------------

/// One of the five things the defensible advantage is made of.
///
/// Seeded and stable: these are the components of the moat as the company
/// defines them, and they change when the strategy changes rather than when
/// somebody has an idea.
/// THE FREEZE: A STABLE PRODUCT, AND NOTHING ADDED TO IT.
///
/// Phase one's objective, made enforceable. "No more additions or
/// modifications. Purely make what exists work for the use cases."
///
/// APPEND-ONLY, because turning it off is a decision with a name against it.
/// Each row is that decision; the newest is the state. A freeze that could be
/// switched off silently is a rule that lasts until the first person in a hurry.
///
/// It carries an end date because a freeze nobody remembers to lift becomes the
/// reason nothing ships in March.
model OpsFreeze {
  id   String  @id @default(uuid())
  isOn Boolean @map("is_on")

  /// Why, in words. Required both ways: turning it ON and turning it OFF are
  /// both decisions somebody has to account for later.
  because String    @db.Text
  /// When it should lift. Advisory rather than automatic — a freeze that
  /// expires on its own ends without anybody deciding it should.
  until   DateTime? @db.Date

  decidedById String   @map("decided_by_id")
  decidedAt   DateTime @default(now()) @map("decided_at")

  @@index([decidedAt])
  @@map("ops_freezes")
}

/// WHAT A PIECE OF WORK SERVES, DECLARED WHEN IT IS PROPOSED.
///
/// One table for every kind of item — roadmap, tech, UX — rather than four
/// columns on each of three models. Two reasons beyond tidiness: the rule and
/// its wording live in one place, and "work that named nothing" becomes a join
/// rather than three queries that have to agree with each other.
///
/// Nothing here blocks. An item naming nothing is LISTED, at the moment it is
/// proposed and the answer is cheapest.
model OpsWhatItServes {
  id String @id @default(uuid())

  /// 'OpsRoadmapItem' | 'OpsTechItem' | 'OpsUXItem'. A plain string, because
  /// this table must not need a foreign key into every kind of work there will
  /// ever be.
  recordType String @map("record_type")
  recordId   String @map("record_id")

  serves         OpsServes
  /// The use case or moat component it points at, when it points at one.
  servesRecordId String?   @map("serves_record_id")
  /// Why this, and why now. The sentence somebody has to write down.
  justification  String    @db.Text

  /// WHAT THIS MAKES US DEPEND ON, AND WHO OWNS IT.
  ///
  /// The second threat, and the only one that cannot be detected — a tool or an
  /// asset belonging to the person adding it. Declared here; the lockfile is the
  /// witness that does not have to be trusted.
  dependsOn        String? @map("depends_on") @db.Text
  dependsOnOwnedBy String? @map("depends_on_owned_by")

  declaredById String   @map("declared_by_id")
  declaredAt   DateTime @default(now()) @map("declared_at")

  @@unique([recordType, recordId])
  @@index([serves])
  @@map("ops_what_it_serves")
}

/// WHAT A PIECE OF WORK CAN SERVE, AND NOTHING ELSE.
/// A STRETCH OF THE COMPANY'S PLAN. NOT A PERIOD.
///
/// The five phases of the workplan — prove it, build the team, sell it, scale
/// it, raise on it. They OVERLAP: proving runs through October while the team
/// phase runs to November and selling starts in October. That overlap is the
/// whole reason this is its own table rather than a kind of OpsPeriod. A period
/// contains objectives, has one set of dates, and only one is current; two
/// phases are routinely running at once, and a quarter can sit inside two.
///
/// `exitCondition` is what has to be true to be done with it, and `exitMetric`
/// is the key it is read from — so "are we out of this phase" is answered by
/// the same registry every other number comes from, rather than by an opinion
/// in a meeting. Nullable, because one of the five has an exit nobody has
/// turned into a number yet, and recording that honestly is better than
/// inventing one.
model OpsPhase {
  id      String @id @default(uuid())
  key     String @unique
  ordinal Int

  name   String
  /// What this phase is for, in the words it was agreed in.
  intent String @db.Text

  startsOn DateTime @map("starts_on") @db.Date
  endsOn   DateTime @map("ends_on") @db.Date

  exitCondition String   @map("exit_condition") @db.Text
  /// A key in the metric registry, or null while the exit is not yet a number.
  exitMetric    String?  @map("exit_metric")
  exitTarget    Decimal? @map("exit_target") @db.Decimal(14, 2)

  /// WHETHER WORK MAY BE JUSTIFIED AS MAKING THE COMPANY OPERABLE WHILE THIS
  /// PHASE IS RUNNING.
  ///
  /// True for exactly one phase. The fifth thing a piece of work can serve is
  /// bounded by the phase that makes it legitimate; outside that window it is
  /// the loophole every measure eventually grows.
  permitsOperability Boolean @default(false) @map("permits_operability")

  @@index([ordinal])
  @@map("ops_phases")
}

enum OpsServes {
  /// It unblocks a customer use case.
  SALES
  /// It adds to one of the five moat components.
  MOAT
  /// It unlocks a customer we could not have taken before.
  UNLOCKS_A_CUSTOMER
  /// Security, a migration, a broken build. Necessary, invisible, and counted —
  /// with an approval, so it is not the drawer everything gets filed in.
  KEEPING_IT_UP
  /// Hiring, onboarding, the operating manual, the things that make a company
  /// of six work. Real contribution and not product work, so it is bounded by
  /// the phase that makes it legitimate rather than available forever.
  MAKES_THE_COMPANY_OPERABLE
}

/// WHAT WE SAY THIS PRODUCT IS, AND WHAT IT IS NOT.
///
/// The statement every piece of marketing is held up against. It lived in slide
/// three of the sales deck — inside one of the documents it is meant to govern.
///
/// APPEND-ONLY. A sign-off records which version it was checked against, so
/// changing the statement reopens everything signed against the old one — and
/// that is only computable while the old one still exists. Newest version is the
/// current one; nothing is ever edited in place.
model OpsProductStatement {
  id      String @id @default(uuid())
  version Int    @unique

  /// The line that says what this is, in the words the company actually uses.
  headline    String @db.Text
  /// The line to say out loud in the room.
  saidOutLoud String @map("said_out_loud") @db.Text

  isIt    String[] @map("is_it")
  /// The half that does the work: what a piece of marketing actually violates.
  isNotIt String[] @map("is_not_it")

  writtenAt DateTime @default(now()) @map("written_at")
  writtenBy String?  @map("written_by")
  /// Why it changed, so a version nobody can account for is visible as one.
  because   String?  @db.Text

  @@index([version])
  @@map("ops_product_statements")
}

/// WHAT WE PUT IN FRONT OF PEOPLE, AND WHETHER IT MATCHES WHAT WE SELL.
///
/// Decks, campaign content, site copy, newsletters. The register exists because
/// the fastest way to break a product's positioning is a piece of marketing
/// nobody checked — calling it a coaching tool, promising a use case it does not
/// support — and marketing is written under time pressure by whoever is closest
/// to the deadline.
///
/// `checkedAgainstVersion` is the whole point. A sign-off is only meaningful
/// against a fixed set of words, so it records WHICH version of the product
/// statement it passed, and changing the statement leaves every older sign-off
/// visibly stale rather than silently wrong.
model OpsResource {
  id String @id @default(uuid())

  title          String
  category       OpsResourceCategory
  /// Required when the category is OTHER: an unnamed 'other' is a drawer.
  categoryDetail String?             @map("category_detail")

  /// Where the thing itself lives. It is not stored here — this is a register,
  /// not a document store, and a copy kept here would go stale against the one
  /// people actually send.
  url String?

  /// The words being checked. Pasted, because a link cannot be read by a check.
  content String @db.Text

  addedById String   @map("added_by_id")
  addedAt   DateTime @default(now()) @map("added_at")

  /// WHAT THE CHECK FOUND, AND WHICH WORDS IT USED.
  ///
  /// `checks` holds one entry per claim in the product statement, each with a
  /// verdict and the sentence it is about. Kept as rows in JSON rather than a
  /// count, because "3 of 5" is only meaningful if the 3 can be opened.
  checks                Json?
  checkedAgainstVersion Int?      @map("checked_against_version")
  checkedAt             DateTime? @map("checked_at")
  /// Said by the model, kept verbatim, and never the verdict on its own.
  checkSays             String?   @map("check_says") @db.Text

  /// The three things most likely to go wrong with this piece. Written by a
  /// person, not the model: a risk somebody typed is a risk somebody owns.
  risks String[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@map("ops_resources")
}

/// The kinds of thing the register holds. OTHER exists so the list does not
/// have to be complete on day one, and carries a required detail so it cannot
/// become the drawer everything is filed in.
enum OpsResourceCategory {
  PITCH_DECK
  SALES_DECK
  CAMPAIGN_STRATEGY
  CAMPAIGN_CONTENT
  MARKETING_SITE_COPY
  NEWSLETTER
  OTHER
}

/// WHAT GROUNDWORK TOLD US, RECEIVED THE WAY A CUSTOMER RECEIVES IT.
///
/// Our back office has only ever SENT. It pushes people, objectives, evidence
/// and what this company decided, and it subscribed to nothing — so a commitment
/// somebody made in a check-in never reached the board they are measured on, and
/// a released report had to be gone and found.
///
/// Half of being a customer is receiving, and it is the half that flatters us
/// less. This is the record of it: every event, whether it verified, and what we
/// did about it.
///
/// A webhook from this product carries a fact and a pointer and never what
/// anybody said, so nothing here needs redacting — which is a property of that
/// design rather than of this table, and worth not relying on silently.
model OpsGroundworkEvent {
  id String @id @default(uuid())

  /// Their id for the delivery, so the same event arriving twice is one row.
  /// Retries are normal and a duplicate must not become a second fact.
  eventId String @unique @map("event_id")
  kind    String

  /// The body exactly as it arrived. Kept whole: a payload we reshaped on the
  /// way in is one we cannot re-read when we later work out what we should have
  /// done with it.
  payload Json

  /// Whether the signature checked out. A failure is RECORDED rather than
  /// dropped — somebody sending us badly signed events is a thing to know about,
  /// and a silent 401 tells nobody here.
  verified Boolean

  receivedAt DateTime @default(now()) @map("received_at")
  /// What we did, in a sentence, or null where we did nothing yet.
  actedOn    String?  @map("acted_on")

  @@index([kind, receivedAt])
  @@map("ops_groundwork_events")
}

model OpsMoatComponent {
  id        String @id @default(uuid())
  key       String @unique
  ordinal   Int
  name      String
  /// The definition, in the words it was written in. Not paraphrased.
  statement String @db.Text

  entries OpsMoatEntry[]

  @@map("ops_moat_components")
}

/// Something actually built on the moat.
///
/// The reason this table exists: "solidify the moat" was the one roadmap item
/// nothing could report on. Everything else — companies live, issues closed,
/// accounts moved — is countable, and an objective that cannot be counted is
/// the one that quietly stops being worked on while the measurable ones get
/// attention.
///
/// A row here is a claim that something was built, and it carries evidence, so
/// the count is openable like every other number in this system.
model OpsMoatEntry {
  id          String @id @default(uuid())
  componentId String @map("component_id")

  title       String
  description String? @db.Text

  /// Where somebody can go and see it: a pull request, a commit, a screen.
  evidenceUrl       String? @map("evidence_url")
  /// What it points at in our own records, when it points at something.
  relatedRecordType String? @map("related_record_type")
  relatedRecordId   String? @map("related_record_id")

  builtById String?  @map("built_by_id")
  builtAt   DateTime @map("built_at")

  createdAt DateTime @default(now()) @map("created_at")

  component OpsMoatComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@index([componentId, builtAt])
  @@map("ops_moat_entries")
}

// ===========================================================================
// COMMERCIAL CONTRIBUTION AND ATTRIBUTION
//
// What each person actually created, kept apart from what they are responsible
// for. The distinction is the whole system:
//
//   Company performance is not personal contribution.
//   Function ownership is not personal attribution.
//   Operational involvement is not origination.
//
// Sahar owns Sales and Market Acquisition. That means the health of the
// function is hers. It does NOT mean a client somebody else originated counts
// toward her personal target, and it does not mean a contributor with no
// commercial contribution is underperforming - commercial acquisition is not
// their job.
//
// There are exactly two contribution roles, and no others. No closer, no sales
// owner, no supported-the-sale, no helped-with-follow-up. Categories like those
// exist so that people can claim a piece of a deal for having been nearby, and
// every one of them makes the record less true.
// ===========================================================================

/// The commercial pipeline, from first contact to a client who stayed a year.
///
/// Retention is in the stages rather than a separate flag because a client who
/// paid once and left is a different commercial outcome from one who is still
/// paying at six months, and the pipeline should say which.
enum OpsCommercialStage {
  LEAD
  QUALIFIED
  DEMO_DISCOVERY
  PROPOSAL
  VERBAL_YES
  PAYING
  RETAINED_3_MONTH
  RETAINED_6_MONTH
  RETAINED_12_MONTH
  LOST
}

/// How far a positioning relationship has got.
///
/// The three middle stages are the point. An introduction is not a commercial
/// outcome, a meeting is not a commercial outcome, and being connected to
/// somebody important is not a commercial outcome - so the funnel records each
/// separately and the value is read from what came out of the far end.
enum OpsPositioningStage {
  TARGET
  INTRODUCTION
  MEETING
  QUALIFIED_ACCESS
  OPPORTUNITY_CREATED
  COMMERCIAL_OUTCOME
  /// Went nowhere. Kept rather than deleted: an introduction that produced
  /// nothing is a fact about the introduction, and hiding it would make every
  /// contributor's funnel look better than it was.
  CLOSED
}

/// Whether a claim of contribution has been looked at.
///
/// Attribution locks for ordinary users once an opportunity is QUALIFIED. Admin
/// can still change it, and every change stays in the history - the point is to
/// stop retrospective claims, not to stop corrections.
enum OpsAttributionState {
  /// Nobody has said who created this. The honest state for anything imported
  /// or historical: we do not infer origination from who typed the record.
  NEEDS_REVIEW
  CLAIMED
  APPROVED
  REJECTED
}

/// The two contribution roles. There are no others, deliberately.
enum OpsContributionRole {
  /// Who created the strategic access that ultimately produced this.
  POSITIONING_SOURCE
  /// Who actually generated the qualified commercial opportunity.
  OPPORTUNITY_ORIGINATOR
}

/// A commercial opportunity, with who created it and what it turned into.
model OpsCommercialOpportunity {
  id        String @id @default(uuid())
  companyId String @map("company_id")

  name            String
  opportunityType String? @map("opportunity_type")

  stage OpsCommercialStage @default(LEAD)

  /// WHO CREATED THIS. Both nullable, and both meaning something specific.
  ///
  /// A null originator is NEEDS_REVIEW, not "the person who owns sales". We do
  /// not infer origination from who created the record, who attended the
  /// meeting, who sent the proposal or who owns the function.
  /// A STATE PER ROLE, because they are two independent decisions.
  ///
  /// One shared state looked simpler and was wrong: approving Nate's positioning
  /// and Hafsah's origination, then rejecting Sahar's claim on the same deal, set
  /// the single field back to NEEDS_REVIEW and silently took the credit away from
  /// both of them. Found by running the worked example end to end, and invisible
  /// in the code - each write was correct on its own.
  positioningSourceId     String?             @map("positioning_source_id")
  positioningState        OpsAttributionState @default(NEEDS_REVIEW) @map("positioning_state")
  opportunityOriginatorId String?             @map("opportunity_originator_id")
  originatorState         OpsAttributionState @default(NEEDS_REVIEW) @map("originator_state")
  attributionLockedAt     DateTime?           @map("attribution_locked_at")

  /// Where the positioning came from, when it came from a tracked relationship.
  positioningRecordId String? @map("positioning_record_id")

  /// The campaign that produced this, where one did.
  ///
  /// Re-linked after the old pipeline was retired: campaigns pointed at that
  /// table, and without this a campaign could only report that it ran. A
  /// campaign that cannot name what it produced is an activity record, and this
  /// system is supposed to tell activity from outcomes.
  campaignId String? @map("campaign_id")

  /// WHO DOES THE WORK. Operational, and it creates no attribution whatsoever.
  nextAction        String?   @map("next_action")
  nextActionOwnerId String?   @map("next_action_owner_id")
  nextActionDueAt   DateTime? @map("next_action_due_at")

  /// Projected. Shown for pipeline, and it can never earn a credit.
  estimatedMrr           Decimal? @map("estimated_mrr") @db.Decimal(12, 2)
  estimatedContractValue Decimal? @map("estimated_contract_value") @db.Decimal(14, 2)

  /// Actual. What credits are computed from.
  actualMrr           Decimal?  @map("actual_mrr") @db.Decimal(12, 2)
  actualContractValue Decimal?  @map("actual_contract_value") @db.Decimal(14, 2)
  firstPaymentAt      DateTime? @map("first_payment_at")
  /// The date they stopped, when they stopped. Null while they are still paying.
  churnedAt           DateTime? @map("churned_at")

  currency String @default("USD")

  evidenceUrl String? @map("evidence_url")
  notes       String? @db.Text

  createdAt  DateTime  @default(now()) @map("created_at")
  lostAt     DateTime? @map("lost_at")
  lostReason String?   @map("lost_reason") @db.Text

  company  OpsCompany             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaign OpsMarketingActivity?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  payments OpsCommercialPayment[]
  claims   OpsAttributionClaim[]

  @@index([stage])
  @@index([opportunityOriginatorId, stage])
  @@index([positioningSourceId])
  @@index([originatorState])
  @@map("ops_commercial_opportunities")
}

/// Cash actually collected. Entered by hand until a payment provider is wired.
///
/// Separate from the opportunity's own amounts because a contract value is one
/// number and what arrived is a series of them - and every credit, every
/// revenue share and every retention milestone is computed from what arrived.
model OpsCommercialPayment {
  id            String @id @default(uuid())
  opportunityId String @map("opportunity_id")

  amount   Decimal  @db.Decimal(12, 2)
  currency String   @default("USD")
  paidAt   DateTime @map("paid_at")

  /// Where it can be seen: a Stripe id, a bank reference, an invoice number.
  reference String?
  /// `manual` today. When a provider is wired this says which one, so nobody
  /// has to guess whether a figure was typed or observed.
  source    String  @default("manual")

  recordedById String?  @map("recorded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  opportunity OpsCommercialOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([opportunityId, paidAt])
  @@map("ops_commercial_payments")
}

/// Somebody says they created something, and somebody else decides.
///
/// Every claim is kept, decided or not, with what it was based on and who
/// decided. A claim that was modified keeps the original: the history is the
/// thing that makes attribution defensible in a conversation about equity, and
/// a record that only holds the current answer cannot support one.
model OpsAttributionClaim {
  id            String @id @default(uuid())
  opportunityId String @map("opportunity_id")

  claimantId String              @map("claimant_id")
  role       OpsContributionRole

  /// What they say it was based on, in their words.
  claimedBasis String  @map("claimed_basis") @db.Text
  evidenceUrl  String? @map("evidence_url")

  state OpsAttributionState @default(CLAIMED)

  decidedById        String?   @map("decided_by_id")
  decidedAt          DateTime? @map("decided_at")
  decisionNote       String?   @map("decision_note") @db.Text
  /// Set when an approver changed who it was attributed to, so the original
  /// claim and the decision are both readable.
  modifiedToPersonId String?   @map("modified_to_person_id")

  createdAt DateTime @default(now()) @map("created_at")

  opportunity OpsCommercialOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([state, createdAt])
  @@index([claimantId])
  @@map("ops_attribution_claims")
}

/// Market access: a relationship, network or channel somebody opened up.
///
/// Recorded whether or not it produces anything, because that is the only way
/// to tell ten introductions that produced two clients from ten that produced
/// nothing. The counts are not stored - they are computed from the
/// opportunities that name this record, so nobody can improve their funnel by
/// editing a number.
model OpsPositioningRecord {
  id            String @id @default(uuid())
  contributorId String @map("contributor_id")

  /// Who or what was opened up. A person, an organisation, a network.
  personOrNetwork String  @map("person_or_network")
  organization    String?
  /// Introduction, distribution relationship, procurement access, investor
  /// access, ecosystem engagement. Free text: the kinds keep appearing.
  accessType      String  @map("access_type")

  stage       OpsPositioningStage @default(TARGET)
  openedAt    DateTime            @map("opened_at")
  evidenceUrl String?             @map("evidence_url")
  notes       String?             @db.Text

  /// The company it eventually concerned, where it concerned one.
  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")

  contributor OpsPerson @relation("OpsPositioningContributor", fields: [contributorId], references: [id], onDelete: Restrict)

  @@index([contributorId, stage])
  @@map("ops_positioning_records")
}

/// What a contributor's agreement entitles them to.
///
/// NO EQUITY IS STORED HERE. Not agreed, not proposed, not a pathway. The
/// numbers this system produces are meant to be good enough to hold up in a
/// conversation about equity - which is a different thing from the software
/// holding a figure for what somebody owns, and holding one would invite
/// exactly the inference this whole design refuses to make.
///
/// What is here is revenue share, because the alternative is worse. Without it
/// the system would assume every recorded originator receives the originator
/// share, and somebody would be told they are owed something they never agreed.
///
/// Attribution establishes what happened. The agreement establishes what
/// somebody is entitled to. Neither is ever inferred from the other.
model OpsContributorAgreement {
  id       String @id @default(uuid())
  personId String @unique @map("person_id")

  /// The originator share, where this person's agreement gives them one at all.
  /// Null means no entitlement, which is the default and is not a mistake.
  originatorSharePercent Decimal? @map("originator_share_percent") @db.Decimal(5, 2)
  originatorShareMonths  Int?     @map("originator_share_months")
  agreementNote          String?  @map("agreement_note") @db.Text

  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  person OpsPerson @relation("OpsContributorAgreementHolder", fields: [personId], references: [id], onDelete: Cascade)

  @@map("ops_contributor_agreements")
}

/// WHICH SETUP QUESTIONS A PERSON HAS READ AND SIGNED OFF.
///
/// This lived in `localStorage`, keyed on the check-in, which made it two things it should not have
/// been. It belonged to a BROWSER rather than to a person - a second admin opened Setup and found
/// two questions already signed off by whoever had used that machine, under a row reading "You have
/// signed this off". And it survived a reload but not a change of laptop, while the row it draws
/// claims somebody reviewed something.
///
/// A sign-off is a small record and it is still a record: it says a named person read a named
/// question on a named date. That is the kind of thing somebody points at later - "you signed this
/// off on the 8th" - and it cannot be kept somewhere a cleared cache erases.
///
/// DELIBERATELY NOT PART OF THE CHECK-IN'S OWN STATE. It gates nothing, blocks nothing and appears
/// in no report. It is one person's mark that they have looked, which is exactly what was asked for
/// ("something to make a person review each setup step and sign off, like a mark-done check sign").
model GroundSetupSignOff {
  id       String @id @default(uuid())
  groundId String @map("ground_id")
  userId   String @map("user_id")

  /// The setup question's number, as the page counts them.
  step Int

  signedAt DateTime @default(now()) @map("signed_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One mark per person per question. Pressing twice is not two sign-offs.
  @@unique([groundId, userId, step])
  @@index([groundId, userId])
  @@map("ground_setup_sign_offs")
}

/// WHAT THE LEAD TYPED IN SETUP, IN THEIR OWN WORDS (U.7 re-check). The brief is put together from
/// the answers setup drew out of the conversation, so the Context page could not honestly call it
/// "What you wrote". These are the person's own messages from the setup conversation, kept so the
/// page can show them to that person. A table of its own, rather than a column on grounds, so no
/// read of a check-in hands it on by spreading the row: it is served only where it is asked for,
/// and only to the person who wrote it while they lead the check-in.
model LeadSetupWords {
  id           String   @id @default(uuid())
  groundId     String   @unique @map("ground_id")
  authorUserId String   @map("author_user_id")
  text         String   @db.Text
  createdAt    DateTime @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@map("lead_setup_words")
}

/// THE RECORDS EACH KIND OF WORK'S BOARD NEEDS (request 76): a deal and its stage for sales, a
/// release or task for engineering, a ticket for support, a county and its project for a programme,
/// a party or a deadline for a law firm matter, a loan and its repayments, and so on.
///
/// One table rather than eleven, because every kind's records have the same bones: a name, where it
/// has got to, whose it is, when it is due, and what else was said about it. `kind` says which of
/// the board's records this is ("deal", "release", "ticket", "deadline", "party"...).
///
/// NEVER INVENTED. Every row comes either from a line somebody said in a check-in (`sourceEntryId`,
/// and the name must be in that line's words) or from the lead typing it (`addedByUserId`). A row
/// with neither is not written.
model WorkItem {
  id                 String    @id @default(uuid())
  groundId           String    @map("ground_id")
  kind               String
  name               String
  stage              String?
  ownerParticipantId String?   @map("owner_participant_id")
  dueAt              DateTime? @map("due_at")
  fields             Json?
  sourceEntryId      String?   @map("source_entry_id")
  addedByUserId      String?   @map("added_by_user_id")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId, kind])
  @@map("work_items")
}

/// WHERE A BLOCKER STARTED (D3, trace.txt): the steps a blocker went through across check-ins.
///
/// STORED WITHOUT NAMES, like a report. Each step holds the check-in it came from and the id of the
/// person who owns it, never a name; the sentences name nobody. Names are swapped in only when it is
/// served, for each step's own check-in, through the same wrapper every report goes through, and only
/// for the steps the reader may open. Built once when the record changes (`inputKey` says what it was
/// built from, so nothing new means nothing rebuilt), never on opening. `promptVersionId` is the
/// instructions that wrote it.
model BlockerTrace {
  id                 String   @id @default(uuid())
  organizationId     String   @map("organization_id")
  /// The handoff the chain was followed from. One trace each.
  anchorDependencyId String   @unique @map("anchor_dependency_id")
  /// The check-in the blocker ends in (where the anchor handoff was said) and where it started.
  endGroundId        String   @map("end_ground_id")
  startGroundId      String   @map("start_ground_id")
  /// [{ kind, groundId, personId | null, text, sourceId }], in order. No names.
  steps              Json
  /// "Where it started: ..." and the decision needed, written without any name.
  whereItStarted     String   @map("where_it_started") @db.Text
  decisionNeeded     String?  @map("decision_needed") @db.Text
  decisionOwnerParticipantId String? @map("decision_owner_participant_id")
  inputKey           String   @map("input_key")
  promptVersionId    String?  @map("prompt_version_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@index([endGroundId])
  @@index([organizationId])
  @@map("blocker_traces")
}

/// WHAT A LEAD CONFIRMED IS TRUE OF THE WHOLE COMPANY (week 20, request 17 e): a rule, a definition, a
/// principle, an owner, something about a client. It sits next to the knowledge cards ("how we do it
/// here") and is read the same way, but it is kept apart from them on purpose: a card is what the
/// company wrote down, and a person's account is measured against it; this is what a lead said in
/// setup, and it is only ever context. A row exists as OFFERED while the lead is being asked, and
/// counts only once it is KEPT, on the lead's yes. A no deletes it. `text` is the lead's own words
/// from the setup conversation: never a participant's words, never a private note (those are not
/// offered at all). `sourceLine` is what the screen reads under it ("Picked up from your check-in on
/// 22 September").
model OrganizationMemory {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  /// The check-in whose setup conversation heard it. A pointer only; the words are copied here.
  groundId       String?   @map("ground_id")
  /// rule | definition | principle | owner | client.
  kind           String    @db.VarChar(16)
  text           String    @db.Text
  /// OFFERED | KEPT.
  status         String    @default("OFFERED") @db.VarChar(8)
  offeredById    String    @map("offered_by_id")
  sourceLine     String    @map("source_line") @db.Text
  offeredAt      DateTime  @default(now()) @map("offered_at")
  keptById       String?   @map("kept_by_id")
  keptAt         DateTime? @map("kept_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@map("organization_memories")
}

/// THE COMPANY PAGE'S COMPANY-WIDE PICTURE (request 17, D2): how each priority is moving, where the
/// strategy is not reaching the work, what more than one team named, and what leadership says next
/// to what the check-ins show. Written once when the record changes, never when the page opens.
/// One row per organisation. Every item keeps `restsOn`, the ids of the check-ins it was built
/// from, and a reader is served an item only if they may open every one of them. No names are
/// stored here: people appear as counts, and an owner is held as the customer's own id.
model CompanyPicture {
  id              String   @id @default(uuid())
  organizationId  String   @unique @map("organization_id")
  /// [{ priorityId, number, tag, says, restsOn: [groundId] }]
  readings        Json
  /// [{ id, observation, question, forWhom: { kind: 'leadership' | 'owner', externalId? }, restsOn }]
  notReaching     Json     @map("not_reaching")
  /// [{ id, title, touches, teams: [{ team, says }], restsOn }]
  namedByTeams    Json     @map("named_by_teams")
  /// [{ id, area, youSaid, checkInsShow, restsOn }]
  saidAndShown    Json     @map("said_and_shown")
  /// What it was built from. The same record again means no second model call.
  inputKey        String   @map("input_key")
  promptVersionId String?  @map("prompt_version_id")
  builtAt         DateTime @default(now()) @map("built_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("company_pictures")
}

/// THE STRATEGY'S VERSIONS (decision 80, item 68): each time the organisation's priorities change, a
/// new version begins, with the day it began and the priorities it held. Written when a priority is
/// brought in, agreed or removed, never when the Company page opens. A check-in ran under the
/// version that was newest on the day it started, which is found from the dates, so no check-in row
/// carries a version. Holds the priorities' titles (which everybody in the organisation reads) and
/// the customer's own ids, never a person.
model StrategyVersion {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  number         Int
  startedAt      DateTime @map("started_at")
  /// [{ sourceSystem, externalId, title }], in the order the priorities were set.
  priorities     Json
  prioritiesKey  String   @map("priorities_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, number])
  @@map("strategy_versions")
}

// ---------------------------------------------------------------------------
// Self-learning counts (week 8b, decisions 55 and 57 point 9). COUNTS ONLY.
// ---------------------------------------------------------------------------

/// How each pattern, coaching step and probe source has fared, counted from records that already
/// exist. One row per scope (an organisation's id, or "ALL" for the total) and per thing. It holds
/// no person id, no name and no words: signals are counted, and nobody reads another person's
/// answers through them (decision 55). `suggestedWeight` is stored and, while the switch in
/// learning/a-suggested-weight.ts is off, read by nothing that detects, chooses or orders.
model LearningSignalCount {
  id              String   @id @default(uuid())
  /// An organisation's id, or "ALL" for the total across organisations.
  scope           String
  /// PATTERN (by code), COACHING_STEP (by the step's own sentence from the role map), or PROBE (by its source).
  kind            String
  key             String
  /// How many times there is an answer to "was it right" for this.
  judged          Int      @default(0)
  goodCount       Int      @default(0) @map("good_count")
  badCount        Int      @default(0) @map("bad_count")
  unsureCount     Int      @default(0) @map("unsure_count")
  /// For a pattern, how many the person also answered. Zero for the other kinds.
  answeredCount   Int      @default(0) @map("answered_count")
  /// Did the conversation happen: how many were due one, and how many had it.
  talkDue         Int      @default(0) @map("talk_due")
  talkHappened    Int      @default(0) @map("talk_happened")
  /// Did things change: how many show a later period, and in how many it did not come back or was done.
  changeJudged    Int      @default(0) @map("change_judged")
  changedCount    Int      @default(0) @map("changed_count")
  suggestedWeight Float    @default(1) @map("suggested_weight")
  /// False while there are too few signals for the weight to move from neutral.
  weightMoved     Boolean  @default(false) @map("weight_moved")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([scope, kind, key])
  @@index([kind, key])
  @@map("learning_signal_counts")
}

/// THE WEEKLY REPORT'S SENTENCE ABOUT EACH PERSON (week 12b, decision 43). One row per check-in per week,
/// built when a check-in comes in and never when somebody opens the page (decision 7). `eachPerson` holds
/// `{ participantId, says }` with `says` written by report label ("Participant A named ..."), never a
/// name: names are swapped in when it is served. It is written from what people named, never from how
/// their answers were rated.
model WeeklyReport {
  id         String   @id @default(uuid())
  groundId   String   @map("ground_id")
  /// The Monday the week starts on, in Lagos, as a date: "2026-09-21".
  weekStart  String   @map("week_start") @db.VarChar(10)
  eachPerson Json     @map("each_person")
  builtAt    DateTime @default(now()) @map("built_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@unique([groundId, weekStart])
  @@map("weekly_reports")
}

/// THE WAY OUT FOR AN ADDRESS WITH NO ROW ON ANY ROSTER (decision 109). The footer link used to exist only
/// for people on a roster; somebody invited by address, or who has only an account, had no way to stop
/// the mail. Keyed by the address alone, lower case. Read with `EmailPreference` by the one door every
/// mail goes through, so either one stops what we decided to send.
model EmailAddressPreference {
  id               String    @id @default(uuid())
  email            String    @unique
  unsubscribeToken String    @unique @map("unsubscribe_token")
  unsubscribedAt   DateTime? @map("unsubscribed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("email_address_preferences")
}

/// WHEN A LEAD READ A REPORT (decision 133). One row per lead per report (the check-in and its session),
/// written the first time they open it and kept with the latest time; opening it never rebuilds the report.
model ReportRead {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  sessionNumber Int      @map("session_number")
  userId        String   @map("user_id")
  firstReadAt   DateTime @default(now()) @map("first_read_at")
  lastReadAt    DateTime @default(now()) @map("last_read_at")

  @@unique([groundId, sessionNumber, userId])
  @@index([userId])
  @@map("report_reads")
}
