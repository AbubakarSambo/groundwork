// Groundwork — contribution intelligence platform
// Core unit is a "Ground" (an alignment ground): one situation, two parties,
// building toward one defined decision. See README for the product model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN // manages grounds, billing activation, sees the alignment feed
  /// Sets up check-ins for their own team. No admin powers of any kind: every privilege check in
  /// this codebase asks for ADMIN specifically. One READ is granted by role (fix plan E5, amending
  /// what this note used to say): a LEAD reads at the shared level on check-ins run by the leads of
  /// their own department - grounds/who-may-read-this-check-in.ts. Nothing else follows from LEAD.
  ///
  /// This was a boolean on User for about an hour. A role is what an admin already means when they
  /// say "my leads", and one field that says what somebody is beats two that have to agree.
  LEAD
  MEMBER // a regular person who checks in
  /// Somebody from ANOTHER company, added to one of your check-ins.
  ///
  /// They hold a membership so the organisation appears in their switcher and the check-in they
  /// were invited to is reachable - and nothing more. `MEMBER` was doing this job, which meant a
  /// guest counted as one of your people: in an organisation whose setting is "anyone may open a
  /// check-in", a guest from another company could open one and invite YOUR people, against YOUR
  /// billing. "Anyone" means anyone here, not anyone you have ever collaborated with.
  GUEST
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_SETUP
  PASSWORD_RESET
  PARTICIPANT_INVITE // magic link for a participant added to a ground
}

enum CareFeeStatus {
  NONE
  ACTIVE
  PAST_DUE
  CANCELLED
}

// The six entry states collapse into the scenario the initiator selects.
enum GroundScenario {
  NEW_HIRE
  NEW_COFOUNDER
  NEW_ADVISOR
  NEW_PROJECT
  NEW_MANAGER
  CONTRACT_RENEWAL
  RECOGNITION
  DRIFT
  CRISIS_ALIGNMENT
  OKR_ALIGNMENT
  WORKPLAN_BUDGET
  PULSE_CHECK
  REALIGN_TEAM
  PIP
  BOARD_STRATEGY
  COHORT_CHECK
  ACUTE_SHOCK // a jarring event just happened; build the shared picture before any decision
  /// A role changing hands. The only scenario the spec names that this enum did not already have -
  /// the rest were here, so detection proposes from the vocabulary that already exists rather than
  /// a parallel set of its own.
  ROLE_HANDOVER
  /// The honest default when a described situation matches no card.
  ///
  /// Before this, "Describe your own situation" carried REALIGN_TEAM in its card config, so a routing
  /// failure silently produced a "get a team back on the same page" ground - with that scenario's
  /// board, questions and end states - while telling the person they were getting "a general ground
  /// where each person gives their own read privately". For a cohort of managers who never work
  /// together that is the wrong shape entirely, and nothing said so.
  ///
  /// This is that general ground, existing in its own right rather than borrowed.
  OPEN_READ
  /// One honest read from everyone, once. The only single-session situation in the product.
  ///
  /// PULSE_CHECK IS NOT THIS, DESPITE THE NAME. Its pack is explicitly recurring - it asks "what has
  /// changed since the last check-in" - and its card is "a regular read on live work": you want to
  /// know what your team is doing, week after week, against what they own. That is a run.
  ///
  /// This is a snapshot. No setup, no objective, no cadence, no second session and no board: one
  /// round of "what is going well, what is stuck, what changed" and a report. It exists because
  /// those are two different things a person asks for, and only one of them was buildable - so
  /// somebody wanting a single temperature read had to open a recurring ground and abandon it.
  ///
  /// It is deliberately the one place where a single report is the right shape. Everything else in
  /// this enum is an objective agreed at the start and a run of check-ins testing work against it.
  SNAPSHOT

  /// THE ANCHOR SCENARIO: a lead who arrived from the shared link and brings up to 20 people for a month.
  ///
  /// It behaves exactly like NEW_PROJECT everywhere a situation decides something (every table that is keyed
  /// by this enum copies NEW_PROJECT's row), and differs only in its own name. It is saved so that the check-in
  /// keeps the situation it was started as, rather than being recorded as a project. Existing rows are untouched.
  HELP_TEAM_UNDERSTAND

  /// ONE LINE, SOME EMAIL ADDRESSES, AND A RHYTHM. THE LIGHTEST THING IN THIS ENUM.
  ///
  /// Hafsah, 18 September 2026: "You write one line about what you want to know, drop in their
  /// emails, and pick how often you want it - daily, weekly, every two weeks. They answer on their
  /// own link, and the updates come back to you as one picture."
  ///
  /// WHAT MAKES IT DIFFERENT FROM EVERYTHING ELSE HERE, and it is one thing: the lead's own line IS
  /// the question. Every other situation has the product composing the interview from a pack; this
  /// one has a person writing the question and the product carrying it, asking for whatever it takes
  /// to make an answer checkable, and nothing else.
  ///
  /// NOT PULSE_CHECK, which spends a whole first session establishing what each person owns before
  /// it asks how anything is going. Not SNAPSHOT, which happens once. This recurs, and it never
  /// sets anything up: somebody who wanted to set up targets would have opened a different card.
  TEAM_UPDATES

  /// INTERROGATE A GROUP ONCE, TO TURN WHAT THEY KNOW INTO A DIRECTION.
  ///
  /// The fourth use case Hafsah described on 19 September 2026, and the one that is not like the
  /// others: "use one conversation with a group to work out where we should focus." Twenty-four
  /// people - processors, distributors, researchers - each asked what they are trying to expand,
  /// what stops them, and where they would go if it went. Cross-referenced once, it produces a
  /// direction: regions, markets, value chains, actors, data gaps, networks, pilots.
  ///
  /// It is deliberately NOT a snapshot. A snapshot asks how things are going; this asks what they
  /// know. Run on the snapshot spine it asked twenty-four people to commit to a date, which is a
  /// survey with homework rather than a discovery session.
  DISCOVERY

  /// BEFORE SIGNING. Each side says independently what it thinks the agreement means, and the
  /// misunderstandings surface while they are still cheap. It ends when the contract is signed.
  CONTRACT_REVIEW

  /// AFTER SIGNING. Quiet, recurring, management by exception. A healthy quarter should produce a
  /// report saying the numbers reconcile and nothing needs anybody. See the note on
  /// CONTRACT_REVIEW for why these are two cards rather than one.
  IMPLEMENTATION_TRACKING
}

//
// PRIVATE (alignment) or SHARED (delivery). Chosen at creation, shown on every
// surface, NEVER switchable.
//
// Why immutable: if a ground could flip from private to shared, a participant
// who checked in believing their account was private would have it exposed.
// That is the worst possible failure for a trust product. Enforced at the data
// layer (updateTimeline and every other update path must reject a mode change)
// and guarded by a test that bites.
//
// PRIVATE: accounts are never visible to other parties. Output is the alignment
// report only. This is the product as it was before the board existed.
// SHARED: extracted, attributed entries feed a board everyone on the ground can
// read. Each person still ALSO has their own private report; the board is an
// additional surface, not a replacement.
//
enum GroundMode {
  PRIVATE
  SHARED
}

// Three moments from the conversation design.
enum GroundMoment {
  STARTING
  RECOGNITION
  RESOLUTION
}

enum GroundStatus {
  /// A member created this and an org admin has not accepted it yet. Nothing has
  /// been invited and no check-in can open: the approval is worthless if anybody
  /// has already been asked to take part. Admin-created grounds skip this.
  AWAITING_APPROVAL
  AWAITING_LEAD // admin created this for a lead; lead invited but has not confirmed yet
  OPEN // created, parties may not all be added
  AWAITING_PARTIES // waiting on check-ins
  REPORT_READY // legacy: report was ready but ground awaited manual billing activation. No longer written (since 60ce541, 2026-06-24) - report release now auto-activates straight to ACTIVE (reports.listener.ts). Retained for legacy rows + readers.
  ACTIVE // admin activated -> billing running
  PAUSED // temporarily paused (e.g. active legal proceedings detected)
  RESOLVED // both confirmed an end state
  STALLED // full period elapsed with no resolution
  CLOSED // permanent record, billing stopped
}

enum PartyType {
  INITIATOR // opened the ground
  PARTICIPANT // added by the initiator; never sees the initiator's record
}

enum CheckInStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  DECLINED // the person declined to take part - itself a useful record
}

enum TurnRole {
  AI
  PERSON
}

// Structured data extracted from a check-in. Belongs to the person.
/// HOW CHECKABLE A LINE IS, as the extraction read it.
///
/// HIGH: a document or a concrete fact. MEDIUM: a specific claim somebody could check.
/// LOW: subjective, or from memory alone.
enum Verifiability {
  HIGH
  MEDIUM
  LOW
}

enum RecordEntryType {
  SUCCESS_DEFINITION
  TIMEFRAME
  COMMITMENT

  /// A THING THAT HAPPENED. THE RECORD HAD NOWHERE TO PUT ONE.
  ///
  /// Found by running a lead's own path end to end. Three people delivered a quarter's plan and the
  /// closing report told the lead "Answered, and nothing specific enough to record came out of it"
  /// about both of them. The lines were in the record. They had been typed SUCCESS_DEFINITION - a
  /// bucket the per-person view deliberately hides, because that type is what good would LOOK like
  /// and printing it as though somebody had done it was an older bug.
  ///
  /// The model was not wrong so much as cornered. "All forty migrated by Friday" is not a
  /// definition of success and not something they agreed to deliver; it is a report of work done,
  /// and there was no type for that. So the same kind of sentence came back COMMITMENT in one round
  /// and SUCCESS_DEFINITION in the next, and half of it vanished from the page.
  ///
  /// On a product whose job is tracking whether a plan is being followed, progress had nowhere to
  /// live. It does now.
  PROGRESS
  ASK
  INTENT
  TOLERANCE
  WORRY
  TENSION
  /// WHERE SOMEBODY'S ACCOUNT OF A PROCESS AND THE WRITTEN ONE DIFFER.
  ///
  /// Not "they got it wrong". A written process nobody has updated since March is at least as
  /// likely to be the wrong one, and where nobody ever told them, the finding belongs to whoever
  /// should have. The entry records the difference and says both sides of it.
  ///
  /// It is in the person's OWN record and reaches them in their own report, like every other entry
  /// here. A hidden read on somebody's understanding would be a management dossier, which this
  /// product does not keep.
  OPERATING_DIFFERENCE
}

// Three-period rule: CANDIDATE until observed in 3 consecutive periods.
enum PatternStatus {
  CANDIDATE
  SURFACED
}

enum Cadence {
  DAILY
  WEEKLY
  FORTNIGHTLY
  MONTHLY
  SEQUENTIAL // no fixed schedule: the initiator's check-in opens the team's next round
  ONE_TIME // a single check-in, no follow-up round ever scheduled
}

enum BillingEventType {
  CARE_FEE // $25/month/account (platform fee)
  PARTICIPANT_FEE // $25/unique participant/month across active grounds
  SESSION_FEE // $5 per additional session
  SUBSCRIPTION_FEE // org subscription (Starter/SmallTeam/Growth/Business/Enterprise)
  FREE_EXTENSION // one-time free session extension per org
  CREDIT // a session given back by a platform admin, with the reason logged
}

enum SubscriptionPlan {
  STARTER // up to 5 people, $25/mo
  SMALL_TEAM // up to 20 people, $50/mo
  GROWTH // up to 100 people, $100/mo
  BUSINESS // up to 250 people, $200/mo
  SCALE // up to 1,000 people, $400/mo
  ENTERPRISE // unlimited, contact sales
}

enum BillingEventStatus {
  PENDING
  PAID
  FAILED
}

enum CompanyStage {
  IDEA
  PRE_REVENUE
  EARLY_REVENUE
  SCALING
}

// Admin-editable subscription pricing (Admin -> System -> Pricing). amountCents
// is the source of truth for what a plan costs; stripePriceId/stripeProductId
// are lazily created and cached the first time a checkout or plan change needs
// a real Stripe Price object, and are cleared whenever amountCents changes
// (Stripe Prices are immutable, so a price change means creating a new one, not
// editing the old one). No row for ENTERPRISE - that plan is contact-sales only.
model PricingPlan {
  plan            SubscriptionPlan @id
  /// Null for a contact-sales plan. `getOrCreateStripePrice` refuses a plan with no amount
  /// rather than charging zero, which is what an `Int @default(0)` here would have allowed.
  amountCents     Int?             @map("amount_cents")
  /// How many people the plan seats. Null means unlimited.
  ///
  /// This lived in TWO hardcoded maps - `BillingService.PLAN_MEMBER_CAPS` and the client's
  /// `PLAN_MEMBER_LIMITS`/`PLAN_MEMBER_CAPS` - while the prices beside them were already a
  /// database row an admin could edit. That is why Scale said 1,000 people in three places
  /// and the caps were the half of pricing that had already drifted.
  memberCap       Int?             @map("member_cap")
  stripeProductId String?          @map("stripe_product_id")
  stripePriceId   String?          @map("stripe_price_id")
  /// WHATSAPP, A PAID ADD-ON (decision 78). What WhatsApp costs a month on this plan, about 80% of
  /// the plan's price, edited at Admin, System, Pricing the way the plan price is. Null means the
  /// add-on cannot be bought on this plan by itself (Enterprise is arranged by contacting us).
  whatsappAddOnCents         Int?    @map("whatsapp_add_on_cents")
  /// The Stripe Price for the add-on, created only when the amount has none cached, and cleared
  /// whenever the amount changes, exactly as `stripePriceId` is.
  whatsappAddOnStripePriceId String? @map("whatsapp_add_on_stripe_price_id")
  /// How many WhatsApp messages an organisation on this plan may send in a calendar month. Null
  /// means no limit. At the limit, check-ins carry on in the app until the next month.
  whatsappMonthlyLimit       Int?    @map("whatsapp_monthly_limit")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@map("pricing_plans")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

/// ASKING FOR THE API, WHICH IS HOW ACCESS TO IT IS GRANTED.
///
/// It used to be sold: an organisation with a live subscription could hold a
/// machine token and everybody else was refused. That gate had two problems and
/// only one of them was about money. It made every integration test wait on a
/// billing state, and it meant we could not use our own API in our own back
/// office without paying ourselves — which is the acceptance test for the whole
/// thing, so failing it silently was the worst possible outcome.
///
/// So access is ASKED FOR and GRANTED. Somebody says what they intend to build,
/// somebody here reads it and decides, and that decision is a row with a name
/// and a date against it. A refusal can say which of those has not happened yet,
/// which "you have not paid" never could.
///
/// It is not the same thing as being free. What it is, is separable from
/// billing: what a customer pays for and what a customer may connect to are two
/// decisions, and tying them together meant neither could move without the
/// other.
model ApiAccessRequest {
  id             String @id @default(uuid())
  organizationId String @unique @map("organization_id")

  /// Who asked, and what they said they intend to build. Read by whoever
  /// decides, so an empty one is refused at the point of asking.
  requestedByUserId String   @map("requested_by_user_id")
  whatFor           String   @map("what_for") @db.Text
  requestedAt       DateTime @default(now()) @map("requested_at")

  status ApiAccessStatus @default(PENDING)

  /// Who decided, when, and why — for a refusal or a withdrawal especially.
  /// A decision nobody can account for later is one nobody can argue with.
  decidedByUserId String?   @map("decided_by_user_id")
  decidedAt       DateTime? @map("decided_at")
  note            String?   @db.Text

  /// THE TERMS WERE ACCEPTED AT THE POINT OF ASKING. The API terms forbid using what comes out of
  /// it to build or train a competing service; a request recorded without acceptance is refused,
  /// so every approved organisation has agreed to them and we can say when and to which version.
  acceptedTermsAt DateTime? @map("accepted_terms_at")
  termsVersion    String?   @map("terms_version")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, requestedAt])
  @@map("api_access_requests")
}

/// ONE ROW PER AUTHENTICATED MACHINE CALL. Written by the machine-token guard, read by the watch
/// that looks for an integration behaving like a scraper (reads far outnumbering writes, report
/// reads by the hundred, bursts) and by the per-credential rate limit. Pruned after 30 days.
model ApiCall {
  id             String   @id @default(uuid())
  organizationId String   @map("organization_id")
  clientId       String   @map("client_id")
  method         String
  path           String
  at             DateTime @default(now())

  @@index([organizationId, at])
  @@index([clientId, at])
  @@map("api_calls")
}

/// WHAT THE WATCH NOTICED ABOUT AN ORGANISATION'S USE OF THE API. Shown beside the access request
/// on the admin page, where the person who can throttle or withdraw is already looking.
model ApiUsageFlag {
  id             String    @id @default(uuid())
  organizationId String    @map("organization_id")
  kind           String
  detail         String    @db.Text
  raisedAt       DateTime  @default(now()) @map("raised_at")
  clearedAt      DateTime? @map("cleared_at")

  @@index([organizationId, raisedAt])
  @@index([clearedAt, raisedAt])
  @@map("api_usage_flags")
}

enum ApiAccessStatus {
  PENDING
  APPROVED
  DECLINED
  /// Granted and then taken back. Kept apart from DECLINED because they are
  /// different facts: one was never trusted, the other was and no longer is,
  /// and only the second needs somebody told.
  WITHDRAWN
}

/// WHERE AN ORGANISATION WANTS TO BE TOLD THINGS, OUTSIDE THIS PRODUCT.
///
/// Slack first, Teams next: both accept a posted payload at a URL somebody in the customer's
/// workspace creates, so neither needs us to be an installed app before it is useful. The URL is
/// a secret — anybody holding it can post into that channel — so it is never returned by any read.
model WorkspaceNotifier {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  /// Which workspace this posts into. The payload shape differs; nothing else does.
  kind WorkspaceKind

  /// The incoming-webhook address. Write-only: no route returns it.
  url String

  /// Said by the person who set it up, so a channel can be recognised later without opening Slack.
  channelSaid String? @map("channel_said")

  /// Off until somebody turns it on. A notifier that starts posting the moment a URL is pasted
  /// posts into a channel nobody has told yet.
  enabled Boolean @default(false)

  lastPostedAt DateTime? @map("last_posted_at")
  /// Why the last post failed, or null. Kept so a dead channel is visible without reading logs.
  lastError    String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, kind])
  @@map("workspace_notifiers")
}

enum WorkspaceKind {
  SLACK
  TEAMS
}

model Organization {
  membershipRequests MembershipRequest[]
  /// Which suites an admin has switched on, with their answers (E, U.17).
  suites             OrganizationSuite[]
  /// Requests for time off, for the leave suite (E2, U.17).
  leaveRequests      LeaveRequest[]
  /// What a lead confirmed is true of the whole company (week 20), kept next to the knowledge cards.
  memories           OrganizationMemory[]
  /// Hours for billing, for the time sheets suite (E3, U.17). Never evidence about anybody's work.
  timeEntries        TimeEntry[]
  timeWeeks          TimeWeek[]
  timeAgreements     TimeAgreement[]
  /// Performance reviews, for the reviews suite (E4, U.17).
  performanceReviews PerformanceReview[]
  /// When someone leaves: the checklist, and signs a team is under strain (E5, U.17).
  leavingChecklists  LeavingChecklist[]
  teamStrainSigns    TeamStrainSign[]
  /// The role map: the role interview's answers, and why a job nobody owns matters (E6, U.17).
  roleInterviews     RoleInterviewAnswer[]
  roleGapNotes       RoleGapNote[]
  /// Spending and budgets: requests to spend, and each team's budget for a month (E7, U.17).
  spendRequests      SpendRequest[]
  teamBudgets        TeamBudget[]
  /// Customers and deals: where each customer stands, as the engine writes it (E9, U.17).
  customerStandings  CustomerStanding[]
  /// Equipment: who has which laptop, phone or demo freezer, and how it is (E10, U.17).
  equipmentItems     EquipmentItem[]
  /// One record of who did what on a suite's request, and each change of a suite's rules (decision 85, build step 5).
  suiteEvents        SuiteEvent[]
  suiteQuestions     SuiteQuestion[]
  suiteRuleChanges   SuiteRuleChange[]
  evaluationsDue     EvaluationDue[]
  apiAccessRequest   ApiAccessRequest?
  whatWorked         WhatWorked[]
  acceptanceCriteria AcceptanceCriterion[]
  productMetrics     ProductMetric[]
  id                 String                @id @default(uuid())
  name               String
  slug               String                @unique
  email              String

  // Billing (Stripe, USD). Care fee is the always-on commitment device.
  stripeCustomerId       String?       @map("stripe_customer_id")
  careFeeStatus          CareFeeStatus @default(NONE) @map("care_fee_status")
  careFeeSubscriptionId  String?       @map("care_fee_subscription_id")
  defaultPaymentMethodId String?       @map("default_payment_method_id")
  gracePeriodUntil       DateTime?     @map("grace_period_until")
  freeSessionsUsed       Int           @default(0) @map("free_sessions_used")
  firstGroundUsed        Boolean       @default(false) @map("first_ground_used")
  freeExtensionUsed      Boolean       @default(false) @map("free_extension_used")
  allowCodeCreation      Boolean       @default(false) @map("allow_code_creation")

  // Org subscription
  subscriptionPlan      SubscriptionPlan? @map("subscription_plan")
  subscriptionStatus    String?           @map("subscription_status") // active | paused | cancelled
  subscriptionStripeId  String?           @map("subscription_stripe_id")
  subscriptionPeriodEnd DateTime?         @map("subscription_period_end")
  /// Set when a cancellation is scheduled: access runs to this date and then stops. The status stays
  /// `active` until Stripe deletes the subscription, because isSubscribed() reads `active` alone and
  /// a fifth status would have unsubscribed the customer the moment they asked to leave later.
  subscriptionEndsAt    DateTime?         @map("subscription_ends_at")

  /// THREE MONTHS ON THE HOUSE, AND WHY IT IS NOT A FAKE SUBSCRIPTION.
  ///
  /// We give some organisations free use for a period - a partner, a pilot, somebody we owe a
  /// favour. The tempting shortcut is to write `subscriptionStatus: 'active'` and a plan, because
  /// every gate already reads those two fields. It is also how an organisation ends up covered for
  /// ever: nothing in that pair carries an end, so the free run only stops if a cron remembers to
  /// stop it, and a cron that forgets costs money silently and for years.
  ///
  /// So a free run is its own pair of fields with a DATE in it, and `whatCoversThem` decides which
  /// of the three - paid, on the house, or the free tier - applies today. It expires by arithmetic.
  freeUntil DateTime?         @map("free_until")
  freePlan  SubscriptionPlan? @map("free_plan")
  /// THE FREE TRIAL (U.19, Hafsah's decision of 26 September): when this organisation was given its
  /// free months for being a team under the trial's size. Set once, so an organisation gets the
  /// trial once. The months themselves are `freeUntil` and `freePlan`, like any free run. Empty
  /// while the trial setting (`pricing.freeTrial`) is off, which it is by default.
  freeTrialStartedAt DateTime? @map("free_trial_started_at")
  /// WHATSAPP, A PAID ADD-ON (decision 78). Turned on by an admin of the organisation on Plan and
  /// billing. Nothing is charged during the free trial or on the free plan; once the trial has ended
  /// and the organisation pays for a plan, it is a second monthly line on its Stripe subscription.
  whatsappAddOnOn        Boolean   @default(false) @map("whatsapp_add_on_on")
  /// WHATSAPP IS ON FOR A FREE MONTH (Hafsah, 13 October 2026, evening): "This is turned on automatically but also for
  /// only a one month trial like your other trials; you pay for it when you add it on your subscription." Every new
  /// organisation gets a month from when it is made; every organisation already here got a month from the day this came
  /// in. After it, WhatsApp goes only where it was added to the subscription (`whatsappAddOnOn`).
  whatsappFreeUntil      DateTime? @default(dbgenerated("(now() + '1 mon'::interval)")) @map("whatsapp_free_until")
  whatsappAddOnChangedAt DateTime? @map("whatsapp_add_on_changed_at")
  /// The Stripe subscription item that charges the add-on, while it is charged.
  whatsappAddOnItemId    String?   @map("whatsapp_add_on_item_id")
  whatsappMonthlyUse     WhatsAppMonthlyUse[]

  companyStage CompanyStage? @map("company_stage")

  /// JOINING BY EMAIL DOMAIN (U.3, Hafsah, 26 September): "Anyone with an @baridi.co.ke email can
  /// join", as "Takes part". Set only while an admin has it switched on, and only to that admin's own
  /// confirmed domain, never a public mail provider (common/an-email-domain.ts). Unique, so one domain
  /// belongs to one organisation. Null means nobody joins by domain.
  joinDomain String? @unique @map("join_domain")

  /// THE ORGANISATION'S OWN TIME ZONE (B-094, 9 October 2026), a zone name such as "Africa/Nairobi". Every day a board, a report or Today writes in a
  /// sentence ("raised on 9 October", "Session 2 opens on 16 October") is the day in this zone, not the day in UTC. Null means nobody has said: the day is
  /// then worked out from where the people's phone numbers are, and failing that the product's own (common/the-organisations-own-day.ts).
  timeZone String? @map("time_zone")

  /// THE ORGANISATION'S OWN INVITE LINK (U.3): /j/<code>, where the code is the organisation's name
  /// with a random part, such as "baridi-7k2p". Joining through it gives "Takes part". Null while an
  /// admin has it off; turning it on again makes a new code, so an old link stops working.
  inviteLinkCode     String? @unique @map("invite_link_code")
  /// The admin who turned it on, named on the link's page as the prototype does.
  inviteLinkByUserId String? @map("invite_link_by_user_id")

  /// WHAT THE PERSON WHO CREATED IT SAID ABOUT ITS SIZE, on "Create an organisation" (U.3): "fewer"
  /// or "more" than `teamSizeLine` people, the free trial's team size they were shown. Only asked
  /// while the trial is on. Nothing grants a trial from it yet (U.19); it is kept so billing can.
  teamSizeSaid String? @map("team_size_said")
  teamSizeLine Int?    @map("team_size_line")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users               User[]
  grounds             Ground[]
  billingEvents       BillingEvent[]
  contributorCodes    ContributorCode[]
  styleProfiles       PersonStyleProfile[]
  memberships         OrganizationMembership[]
  subjects            Subject[]
  apiCredentials      ApiCredential[]
  people              Person[]
  importJobs          ImportJob[]
  quietPeriods        DetectionQuietPeriod[]
  webhookEndpoints    WebhookEndpoint[]
  embedConfig         EmbedConfig?
  whatsappConnection  WhatsAppConnection?
  commitments         Commitment[]
  todos               Todo[]
  assistantTurns      AssistantTurn[]
  assistantProposals  AssistantProposal[]
  knowledgeCards      KnowledgeCard[]
  knowledgeRetrievals KnowledgeRetrieval[]
  roles               Role[]
  primaryActionEvents PrimaryActionEvent[]
  scenarioCandidates  ScenarioCandidate[]
  emailPreferences    EmailPreference[]
  retentionPolicy     RetentionPolicy?
  departureRecords    DepartureRecord[]
  proposedChanges     ProposedChange[]
  detectorResults     DetectorResult[]
  roleAssignments     RoleAssignment[]
  onboardingTracks    OnboardingTrack[]
  onboardingStatuses  OnboardingStatus[]
  contributions       Contribution[]
  recommendations     Recommendation[]
  objectiveDrafts     ObjectiveDraft[]
  /// WHO MAY OPEN A CHECK-IN HERE: 'NAMED_LEADS' or 'EVERYONE'.
  ///
  /// Named leads by default. An organisation that has thought about it can open the door; one that
  /// has not should not discover it was open by finding a check-in nobody sanctioned. See
  /// `who-may-open-a-check-in.ts`, which is the only place the rule is expressed.
  /// THE PERSON WHO SET THIS ORGANISATION UP.
  ///
  /// Other admins cannot take their role or their account away; they can take anybody's. One
  /// asymmetry, not a hierarchy - every admin is otherwise an admin. See
  /// `the-person-who-set-this-up.ts`.
  ///
  /// Nullable, and null means nobody is protected rather than everybody. That is what was true for
  /// every existing organisation a minute before this shipped; reading it the other way would
  /// freeze their admin lists. The migration fills it in with each organisation's first admin.
  ///
  /// Not a relation: a `User` row can be soft-deleted and anonymised, and a foreign key would make
  /// that a choice between breaking the constraint and cascading away the record of who set the
  /// place up.
  ownerUserId         String?                  @map("owner_user_id")

  whoMayOpenCheckIns String @default("NAMED_LEADS") @map("who_may_open_check_ins")

  /// Whether a check-in somebody opens waits for an admin before anybody is invited.
  ///
  /// Separate from the setting above on purpose: "anybody may open one and it still waits" and
  /// "only my leads may open one and I trust them" are both real arrangements, and one combined
  /// control would make two of the four unreachable.
  checkInsNeedApproval Boolean @default(true) @map("check_ins_need_approval")

  interactions       Interaction[]
  knowledgeProposals KnowledgeProposal[]
  callRequests       CallRequest[]

  workspaceNotifiers WorkspaceNotifier[]

  /// OUR OWN ORGANISATIONS ARE NOT CUSTOMERS. Set by hand on Groundwork's own organisations; the
  /// platform panel counts nothing under one (prompts/what-the-platform-has-actually-done.ts).
  isInternal Boolean @default(false) @map("is_internal")

  @@map("organizations")
}

model User {
  id             String @id @default(uuid())
  organizationId String @map("organization_id")

  email               String   @unique
  passwordHash        String?  @map("password_hash")
  firstName           String   @map("first_name")
  lastName            String   @map("last_name")
  jobTitle            String?  @map("job_title")
  role                UserRole @default(MEMBER)
  isActive            Boolean  @default(true) @map("is_active")
  /// WAITING TO BE LET INTO THE ORGANISATION THEY WERE ADDED TO.
  ///
  /// True from the moment somebody accepts a check-in invitation to an organisation they were not
  /// already in, until an admin approves them. While it is true they hold NO SEAT - see
  /// common/seats.ts, which is the one definition every price and every cap reads - and they
  /// cannot open or answer a check-in. The audit trail is MembershipRequest; this is the flag the
  /// hot paths read, because a seat count cannot afford a join and a gate must not be able to miss.
  awaitingOrgApproval Boolean  @default(false) @map("awaiting_org_approval")
  isEmailVerified     Boolean  @default(false) @map("is_email_verified")
  isPlatformAdmin     Boolean  @default(false) @map("is_platform_admin")
  /// Minted into every session token and compared on every request. Bumped by a password reset, so
  /// the sessions that prompted the reset end with it (fix plan A10 / B16). Tokens from before the
  /// column carry no epoch and read as 0, which is every existing row's value: nobody is signed out
  /// by the deploy.
  tokenEpoch          Int      @default(0) @map("token_epoch")
  googleId            String?  @unique @map("google_id")
  emailNotifications  Boolean  @default(true) @map("email_notifications")
  /// When this person pressed "Got it" on the new admin's welcome card (U.3), so it does not come back
  /// on another device. Null means they have not.
  welcomeCardSeenAt   DateTime? @map("welcome_card_seen_at")
  // E.164 format (e.g. "+2348012345678"). Global uniqueness - one Groundwork
  // WhatsApp number serves everyone, so a phone number identifies exactly one
  // account, not one per org. Set by the user in Settings, or by an
  // admin/HR adding it on someone's behalf via the org roster.
  phoneNumber         String?  @unique @map("phone_number")

  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  membershipRequests MembershipRequest[]
  deletedAt          DateTime?           @map("deleted_at")

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tokens           EmailVerificationToken[]
  groundsInitiated Ground[]                    @relation("GroundInitiator")
  participantLinks GroundParticipant[]
  adminProfile     AdminProfile?
  contributorCodes ContributorCode[]           @relation("ContributorCodes")
  redeemedCodes    ContributorCode[]           @relation("RedeemedCodes")
  codeRedemptions  ContributorCodeRedemption[] @relation("CodeRedemptions")
  entryDraft       EntryDraft?
  styleProfiles    PersonStyleProfile[]
  memberships      OrganizationMembership[]
  setupSignOffs    GroundSetupSignOff[]

  @@index([organizationId])
  @@map("users")
}

// ---------------------------------------------------------------------------
// Server-side draft of an anonymous entry session, written the moment the
// person gives their email (POST /auth/entry-save) - the ISSUE-17 consent
// moment. Makes the post-verification commit independent of which browser
// opens the magic link: before this, the transcript and commit metadata lived
// only in the originating browser's localStorage, and a link opened anywhere
// else silently skipped the commit (the ground "vanished").
// One live draft per user (upserted). draftToken authorizes pre-auth updates
// from the entry page (org name, contributors typed after the email was
// sent). consumedAt + groundId make commit idempotent.
// ---------------------------------------------------------------------------
// A signup that has been asked for but not yet proved.
//
// NOTHING IS PROVISIONED UNTIL THE ADDRESS IS VERIFIED. Before this model
// existed, submitting an email on the entry flow's save panel immediately created
// a User with role ADMIN and an Organization, both live, with
// `is_email_verified = false`. Typing a stranger's work address provisioned an
// organisation and an admin account in their name, and they learned about it only
// if they happened to read the activation mail.
//
// Everything the signup needs now waits here - the address, the person's name,
// the organisation name if they typed one, and the whole anonymous session
// transcript - keyed to the verification token. The Organization, the User and
// the EntryDraft are created in one transaction when, and only when, the link in
// the mail is opened.
//
// `email` is unique so a second attempt refreshes the pending record rather than
// stacking duplicates. It is deliberately NOT a foreign key to anything: a
// pending signup is not yet a member of anything.
//
// See GW-001 in journey/run18/ISSUES-LOG.md.
/// SOMEBODY ASKING TO JOIN A CHECK-IN FROM A BROADCAST LINK, BEFORE THEY HAVE PROVED THE ADDRESS.
///
/// A join link proves you were given a link. It does not prove you own the address you typed into
/// the form — and the old flow signed you straight in as whoever that address belonged to, which
/// meant everybody holding the link could become the admin. Nothing is created now until the
/// address answers: no account, no participant, no check-in, no session. See
/// `entry/a-join-link-is-not-a-password.ts`.
model PendingJoin {
  id        String @id @default(uuid())
  /// The link they arrived on.
  joinToken String @map("join_token")

  /// The address they typed. Lower-cased. Unproven until this row is used.
  email     String

  /// What they told us about themselves, kept until the address answers for it.
  firstName       String? @map("first_name")
  lastName        String? @map("last_name")
  roleAsDescribed String? @map("role_as_described")
  department      String? @db.VarChar(120)

  /// The secret in the emailed link. Single use.
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([joinToken, email])
  @@map("pending_joins")
}

model PendingSignup {
  id           String   @id @default(uuid())
  email        String   @unique
  token        String   @unique
  firstName    String   @map("first_name")
  /// Only the entry flow leaves this empty; the two named signup paths carry it.
  lastName     String?  @map("last_name")
  orgName      String?  @map("org_name")
  /// Set when somebody signed up with a password. Held here rather than on a
  /// User, because a User is what must not exist before the address is proved.
  passwordHash String?  @map("password_hash")
  /// THE BROWSER THAT CHOSE THE PASSWORD (U.3 review, a security fix). The hash of a random key handed
  /// only to the browser that signed up. The password above is put on the account only when the
  /// confirmation is opened with that key; opened anywhere else, the password is thrown away and the
  /// person chooses one afterwards, as after a link-only sign-up. So somebody who signs up with another
  /// person's address cannot choose that person's password.
  passwordKeyHash String? @map("password_key_hash")
  // The anonymous session, carried verbatim so the ground can be built after
  // verification from any browser - not only the one that started it.
  payload      Json?
  history      Json?
  // The draft token the entry page keeps, so post-email edits (the org name
  // arrives this way) can still reach this record before there is a user.
  draftToken   String?  @unique @map("draft_token")
  /// Where in the app the person was going when they signed up, such as an organisation's invite
  /// link ("/j/baridi-7k2p"). Only a path inside this app is ever stored (common/a-path-in-this-app),
  /// and the confirmation carries them back to it (U.3).
  next         String?  @map("next_path")
  /// Set when Google proved the address and the person still has to choose where they work (U.3
  /// review): the account made from this waiting sign-up signs in with Google, and needs no password.
  googleId     String?  @map("google_id")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("pending_signups")
}

model EntryDraft {
  id         String    @id @default(uuid())
  userId     String    @unique @map("user_id")
  draftToken String    @unique @map("draft_token")
  payload    Json
  history    Json
  consumedAt DateTime? @map("consumed_at")
  groundId   String?   @map("ground_id")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("entry_drafts")
}

// ---------------------------------------------------------------------------
// Delivery log for outbound email, correlated to Resend by resend_id (the id
// returned by resend.emails.send; dev-mode sends get a dev-<uuid>). Status is
// updated by the Resend webhook (delivered / bounced / complained) - upserted
// by resend_id, so webhook retries are naturally idempotent. The latest
// invite-kind row per participant is mirrored onto
// GroundParticipant.inviteDeliveryStatus for cheap rendering.
// ---------------------------------------------------------------------------
/// MAIL SENT TO US, RATHER THAN BY US.
///
/// `hello@myground.work` is on the marketing site, in the footer, and on the pricing page next to
/// "Ask about Guided" - so it is the address a prospect writes to, and it landed in one person's
/// inbox where nobody else could see it and nothing could be picked up if she were away.
///
/// STORED WHOLE AND NEVER PARSED FOR MEANING. A person reads these. Nothing extracts an intent, and
/// nothing about a sender reaches any other part of the product: an inbound email is a message to
/// the company, not evidence about anybody.
model InboundMessage {
  id String @id @default(uuid())

  /// The provider's own id, so a webhook redelivery is not a second copy.
  providerId String? @unique @map("provider_id")

  fromAddress String  @map("from_address")
  fromName    String? @map("from_name")
  /// Which of our addresses it was sent to. More than one exists and they may not stay one inbox.
  toAddress   String  @map("to_address")
  subject     String? @db.Text
  /// Plain text where the sender sent any. HTML is deliberately not stored - see the controller.
  body        String? @db.Text

  /// When the sender sent it, per the provider. Not when we processed it.
  receivedAt DateTime  @map("received_at")
  /// Who on our side has read it, and when. Null is unread.
  readAt     DateTime? @map("read_at")
  readById   String?   @map("read_by_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([receivedAt])
  @@map("inbound_messages")
}

model EmailDelivery {
  id            String    @id @default(uuid())
  resendId      String    @unique @map("resend_id")
  email         String
  kind          String // PARTICIPANT_INVITE | LEAD_INVITE | MAGIC_LINK | REMINDER | OTHER
  participantId String?   @map("participant_id")
  groundId      String?   @map("ground_id")
  status        String    @default("SENT") // SENT | DELIVERED | BOUNCED | COMPLAINED
  detail        String?
  statusAt      DateTime? @map("status_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([participantId])
  @@map("email_deliveries")
}

// ---------------------------------------------------------------------------
// Per-admin preference profile — built from past grounds, used to deepen
// probing on new grounds. Never used to skip questions.
// ---------------------------------------------------------------------------
model AdminProfile {
  id        String   @id @default(uuid())
  userId    String   @unique @map("user_id")
  signals   Json     @default("[]") // string[] of observed preference signals
  /// The one-time code for a destructive admin action: { hash, expiresAt, used }.
  /// The service has always written here. The column did not exist, so every
  /// OTP request threw a 500 and every action behind one - disabling a code,
  /// adding a platform admin - had never worked. Two `@ts-ignore`s kept the
  /// compiler quiet about it.
  adminOtp  Json?    @map("admin_otp")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_profiles")
}

/// A one-time code the Google callback hands the browser in place of the JWT, redeemed within a
/// minute. It lived in a process-local Map, so a restart or a second instance broke Google sign-in
/// with "Invalid or expired exchange code" (fix plan B15). Deleted on use; the rest pruned daily.
model OAuthExchangeCode {
  id        String   @id @default(uuid())
  code      String   @unique
  token     String   @db.Text
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_exchange_codes")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  type      TokenType
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  /// For a sign-in link: where in the app the person was going when they asked for it. Only a path
  /// inside this app (common/a-path-in-this-app). Null for every other kind of link (U.3).
  next      String?   @map("next_path")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

// ---------------------------------------------------------------------------
// The Ground — the core transactional unit
// ---------------------------------------------------------------------------

model Ground {
  id             String         @id @default(uuid())
  organizationId String         @map("organization_id")
  initiatorId    String         @map("initiator_id")
  scenario       GroundScenario
  moment         GroundMoment
  status         GroundStatus   @default(OPEN)
  label          String
  // Alignment (private) vs delivery (shared). Immutable after creation - see the
  // GroundMode enum comment. Defaults to PRIVATE so any ground created by a path
  // that does not set it explicitly is private, never accidentally shared.
  mode           GroundMode     @default(PRIVATE)

  /// WHETHER THIS CHECK-IN IS ANSWERED ON WHATSAPP, WHEN THE ORGANISATION HAS A NUMBER.
  ///
  /// NULL means "whatever the organisation does", which is what every ground did before this
  /// existed: connected and the person has a number, so the opening notice goes to their phone.
  /// Nullable precisely so this column changes nothing that already runs - a boolean with a default
  /// would have decided for every ground in the database on the day it was added.
  ///
  /// True sends it. False keeps this one in Groundwork even though the organisation has a number,
  /// which is the case that had no way to be said at all: it was all of them or none of them.
  overWhatsApp Boolean? @map("over_whatsapp")

  /// USE SIMPLER WORDS: THE LEAD (OR AN ADMIN WHO RUNS IT) SWITCHES THIS ON FOR EVERYBODY IN THE CHECK-IN.
  ///
  /// False is every check-in that existed before, and it changes nothing: the conversation and
  /// everything sent afterwards read exactly as they did. True gives the model the same plain-words
  /// rule a person's own style profile can give it, for every person in the check-in, and sends the
  /// plainer form of every fixed sentence (the closing, the end card, the report message, reminders).
  /// A boolean with a default of false is safe here: nobody has been decided for.
  simplerWords Boolean @default(false) @map("simpler_words")

  /// WHAT THE ROOM IS ABOUT: THE AIMS, THE PLACES AND THE THINGS, READ ONCE WHEN A ROUND CLOSES.
  ///
  /// Forty people each said what they were trying to achieve, where, and about what crop. All of it
  /// sat in single sentences and nothing on the board added it up, so the one question the convener
  /// had - where is the weight - could not be answered from the page.
  ///
  /// It lives here rather than being read on every board open for the same reason the number read
  /// does: a board is opened many times a round by everybody on it, and this is one answer per
  /// round. Null means it has not been read yet, which the board says plainly rather than hiding.
  whatTheRoomIsAbout        Json? @map("what_the_room_is_about")
  whatTheRoomIsAboutSession Int?  @map("what_the_room_is_about_session")

  timelineDays     Int     @map("timeline_days")
  /// A CHECK-IN THAT RUNS UNTIL THE LEAD ENDS IT ("When I end it", request 37).
  ///
  /// True means there is no planned length and no planned last session. `timelineDays` is then 0, which
  /// every reader of the length already treats as "no end" (no deadline, no planned session count), so
  /// nothing can measure how far through it is or call it out of time. Only the lead ending it closes
  /// it. False is every check-in that existed before, unchanged.
  runsUntilEnded   Boolean @default(false) @map("runs_until_ended")
  /// DID THE LEAD CHOOSE THIS, OR DID WE.
  ///
  /// `timelineDays` is not nullable and `cadence` has a default, so both are set on every ground from
  /// the moment it exists - by the lead if they said so, and by `DEFAULT_TIMELINE_DAYS[scenario]` if
  /// they did not. The context chat's gap reader asked about duration only when it was ABSENT, and it
  /// is never absent, so the question G37 exists to ask has never once been asked.
  ///
  /// These say which it was. Found by trying to null the column to test the gap and discovering the
  /// constraint forbids it.
  timelineStated   Boolean @default(false) @map("timeline_stated")
  cadenceStated    Boolean @default(false) @map("cadence_stated")
  timelineWeeks    Int?    @map("timeline_weeks")
  cadence          Cadence @default(FORTNIGHTLY)
  cadenceAnchorDay Int?    @map("cadence_anchor_day") // weekly: 0=Sun..6=Sat ("every Monday"); monthly: 1-31 (day of month)

  /// WHICH DAYS THIS TEAM WORKS. 0=Sun..6=Sat. Empty means every day, which is the honest default
  /// for a product that does not know whose week this is.
  ///
  /// A daily cadence was `+1 day`, flat, so it landed on Saturday and it landed on Sunday. Nothing
  /// in the schema, the date maths or the form knew what a weekend was - and daily is the one
  /// cadence with no day picker, so "weekdays only" could not be said at all.
  ///
  /// IT IS CHOSEN, NEVER ASSUMED. Monday to Friday is not a fact about the world: field teams work
  /// Saturdays, and the week starts on Sunday in much of the region this is built for. So the form
  /// offers it and the empty list means nobody said, which is different from somebody saying every
  /// day - and both are rendered as what they are.
  workingDays     Int[]     @default([]) @map("working_days")
  startsAt        DateTime? @map("starts_at") // when the first scheduled check-in opens (start date)
  endsAt          DateTime? @map("ends_at") // no new check-ins scheduled after this (end date)
  endState        String?   @map("end_state") // the decision the process worked toward
  resolutionState String?   @map("resolution_state") // pre-agreed intended outcome set at creation
  brief           String?   @map("brief") // initiator's opening brief, written at ground creation
  /// THE SUBJECTS THIS BRIEF ASKS ABOUT, read once and kept: each with the lead's own words for it,
  /// one plain question, and the words that show somebody has covered it. Every respondent is asked
  /// about the same ground, which is the only way many separate answers add up to one picture.
  /// Coverage is computed from what people said and never stored. See
  /// the-ground-the-brief-asks-us-to-cover.ts.
  subjectsToCover Json? @map("subjects_to_cover")
  /// WHAT A COMPLETE ANSWER TO THIS BRIEF HOLDS: the comparable fields every respondent must end
  /// with - a named place, a quantity with its period, which of a few named situations they are in.
  ///
  /// A subject is a topic to raise; two people can both talk about volumes and leave nothing that
  /// can be put side by side. Two customers read the same report on 23 September 2026 and both said
  /// it only listed what people said: a hundred differently shaped answers cannot be counted,
  /// ranked or cut by kind of organisation, so the only thing left to write was atmosphere. Read
  /// once from the brief, confirmed by the lead, and identical for every respondent - a column that
  /// means something different for person 40 than person 4 is not a column.
  /// See what-a-complete-answer-holds.ts.
  whatACompleteAnswerHolds Json? @map("what_a_complete_answer_holds")
  /// What a participant reads under "About this check-in": the situation and what it is for, in the
  /// product's words, addressed to them. Written once from the brief at creation and again when the
  /// brief changes; guarded in code so no instruction to the product and none of the lead's first
  /// person reaches them. Null falls back to the declarative sentences of the brief.
  toldToParticipants String? @map("told_to_participants")
  /// THE KIND OF WORK THIS CHECK-IN IS ABOUT (request 76, Hafsah's ruling of 29 September 2026).
  /// One of the eleven kinds the prototype's example boards show ("sales org", "engineering
  /// release", "a law firm matter" and so on; the list is in board/the-kind-of-work.ts), or null
  /// when nobody can tell. Read from the lead's own words and the brief when setup is saved, checked
  /// in code against the eleven, and the lead can change it. The kind decides which records the
  /// board holds (deals and their stages, releases, tickets), never which sections a situation has.
  kindOfWork        String?   @map("kind_of_work")
  /// Who set it: "read" when Groundwork read it from setup, "lead" when the lead chose it. A lead's
  /// choice is never overwritten by a later read.
  kindOfWorkSetBy   String?   @map("kind_of_work_set_by")
  /// WHERE THIS CHECK-IN WAS STARTED FROM, when it was started from the anchor link (docs/anchor-scenario-plan.md, piece 15). "anchor" or
  /// null. Written once, when the lead saves what they said in the anchor conversation and the anchor switch is on. A check-in that holds it
  /// keeps behaving as an anchor check-in even if the switch is later turned off. Null on every check-in that exists.
  startedFrom       String?   @map("started_from")
  /// The organisation's own stage names for this kind of work, in order, when the lead has given
  /// them. Null means the kind's defaults, which are the prototype's (for sales: Contacted, Need
  /// established, Pitched, Qualified, Quoted, Won).
  workStages        Json?     @map("work_stages")
  groundAuditLog  Json?     @map("ground_audit_log") // append-only JSON log of timeline/cadence changes
  createdByUserId String?   @map("created_by_user_id") // the admin who set this up for a lead; null for self-serve grounds

  // Lifecycle / billing markers
  billingActivatedAt DateTime?     @map("billing_activated_at") // admin activated report
  billingEnabled     Boolean       @default(false) @map("billing_enabled")
  paymentConfirmed   Boolean       @default(false) @map("payment_confirmed")
  resolvedAt         DateTime?     @map("resolved_at")
  closedAt           DateTime?     @map("closed_at")
  pausedAt           DateTime?     @map("paused_at") // set when status transitions to PAUSED
  /// The status a hold was placed on, so lifting it can put the ground back where it was rather
  /// than guessing ACTIVE. Written by pauseGround, cleared by resumeGround. Null on any ground
  /// paused before this column existed; resume falls back to ACTIVE for those and says so.
  pausedFromStatus   GroundStatus? @map("paused_from_status")

  /// WHEN THE TIME RAN OUT, AND WHAT THIS CHECK-IN WAS BEFORE IT DID.
  ///
  /// STALLED is written by the 3am sweep when a check-in passes the time it was given. It used to
  /// sit with RESOLVED and CLOSED - two decisions somebody took - so it inherited their one
  /// property: no way back. A customer let a few check-ins wait, found them stalled, and had
  /// nothing anywhere to reopen them or extend the time; the check-ins were dead and so was
  /// everything already answered in them.
  ///
  /// So it remembers where it came from, exactly as `pausedFromStatus` does, and giving the
  /// check-in more time puts it back. A state a machine can put you in has to have a way out a
  /// person can use. See a-ground-that-has-ended.ts and reopenAfterStalling.
  stalledFromStatus  GroundStatus? @map("stalled_from_status")
  stalledAt          DateTime?     @map("stalled_at")
  /// One-shot: the lead was warned the time was about to run out, with a way to extend it. Null
  /// means never warned - which is how every stalled check-in before today arrived there, with no
  /// notice at all until it was already too late.
  stallWarningSentAt DateTime?     @map("stall_warning_sent_at")

  /// WHO CHASES, AND HOW OFTEN, BELONGS TO WHOEVER SET THE WORK UP.
  ///
  /// The schedule used to be a constant in the reminder service, which meant every
  /// ground in every organisation chased on the same three days whatever the work
  /// was. A fortnightly delivery and a week-long handover are not chased alike, and
  /// a lead who wants the chasing to stop had nowhere to say so.
  ///
  /// Days are counted from when the check-in opened. An empty list is a lead who
  /// wants nobody nudged; `chasingStopped` is the same answer said explicitly, and
  /// both are honoured, because a lead who turned it off and got emails anyway is a
  /// lead who turns the product off.
  chaseAfterDays Int[]   @default([3, 7, 14]) @map("chase_after_days")
  chasingStopped Boolean @default(false) @map("chasing_stopped")
  /// Whether the lead hears who has not started once the chasing is done with them.
  tellTheLead    Boolean @default(true) @map("tell_the_lead")

  sessionsBalance            Int      @default(1) @map("sessions_balance")
  // When true (default), participants cannot see each other's email address - only
  // their own. Names, roles, roster and presence stay visible. Initiator-only toggle;
  // enforced in the get() read path. (Column name predates the participant-to-participant
  // scope; it now hides contact from ALL other participants, not just cross-org.)
  restrictExternalVisibility Boolean  @default(true) @map("restrict_external_visibility")
  // Do the people on this ground actually see each other's work?
  //
  // Nullable on purpose: null means "nobody has said", and the scenario family
  // supplies a sensible default. Once the lead or an admin answers, their answer
  // wins - because the scenario cannot know. A cohort of trainers who share a
  // site do see each other; a delivery team split across regions does not. This
  // decides whether the board's fairness reads have any ground to stand on, so
  // guessing it from the scenario alone is how a competent person gets read as
  // absent (see reads.ts).
  peopleWorkTogether         Boolean? @map("people_work_together")
  /// Whether a participant is told, once, in their own session, what the lead has set for them and how
  /// it differs from what they have said - "Funmi has said the role should bring in $400k; you have said
  /// the first quarter is about relationships; this report will show both." The lead's expectation is
  /// shareable by design; this decides whether the product says the disagreement out loud. Default on.
  participantsHearTheLeadsExpectation Boolean @default(true) @map("participants_hear_the_leads_expectation")
  // Can the parties see who else is on this ground and how each is doing?
  //
  // Nullable: null means nobody has said, and the kind of ground supplies the
  // default - hidden where the period decides something about a person, shown
  // where they are delivering together. The lead or an admin overrides it,
  // because only they know whether seeing each other helps or corrodes. On a
  // probation cohort a visible roster tells four people exactly who their rivals
  // are; on a delivery team the same roster is how they coordinate.
  peersVisibleToEachOther    Boolean? @map("peers_visible_to_each_other")
  isFreeGround               Boolean  @default(true) @map("is_free_ground")
  accessCodeId               String?  @map("access_code_id")
  freeReason                 String?  @map("free_reason") // "FIRST_GROUND" | "ACCESS_CODE"
  /// HOW MANY PEOPLE A FREE GROUND HOLDS. FIVE, THE SAME NUMBER THE PRICING PAGE SELLS.
  ///
  /// This defaulted to 4 while `DEFAULT_FREE_MEMBER_LIMIT` was 5, so a free user's first check-in
  /// refused the fifth person the pricing page had just promised them - and the refusal quoted the
  /// wrong number while doing it. The call sites were fixed and this default was not, which meant any
  /// path that did not pass the cap explicitly recreated the bug.
  ///
  /// Kept as a column rather than read from pricing at check time because it is what the ground was
  /// SOLD as. A later change to the free tier must not silently shrink a ground somebody is already
  /// running.
  freeParticipantCap         Int      @default(5) @map("free_participant_cap")
  joinToken                  String?  @unique @map("join_token")

  /// THE FIRST THING THE PRODUCT SAYS TO SOMEBODY WHO ARRIVED THROUGH THE LINK, WRITTEN ONCE.
  ///
  /// An opener is composed from the brief and the scenario and nothing else - a link respondent has
  /// said nothing and the product knows nothing about them - so a hundred people through one link
  /// were each waiting fourteen to eighteen seconds for the same sentence to be written again.
  /// Kept here so the first person pays for it and nobody else does. Null on every ground until
  /// somebody opens the link, and never used for a named participant, whose opener can name them.
  openerForALink             String?  @map("opener_for_a_link")

  /// WHICH PIECE OF THE CUSTOMER'S OWN WORK THIS CHECK-IN IS ABOUT.
  ///
  /// Null for every ground made inside Groundwork, which is all of them today - a lead opening a
  /// check-in is not choosing from an imported list. It is set when a customer's system SUMMONS one
  /// against an objective, which is the only moment anybody has actually said which subject it is
  /// for.
  ///
  /// This is the link the org-level detectors were missing. Without it there is no way to ask
  /// whether two people describe the SAME objective differently, because there is no way to know
  /// they were talking about the same one - and inferring it from titles would mean deciding what
  /// somebody meant and then reporting a divergence based on the guess.
  ///
  /// An external id rather than a foreign key, for the same reason as everywhere else: the subject
  /// may not have been pushed yet, and a check-in must not fail to open for naming one that has not.
  subjectExternalId String? @map("subject_external_id")

  promptVersionId     String? @map("prompt_version_id")
  stripeScenarioSubId String? @map("stripe_scenario_sub_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  initiator         User                  @relation("GroundInitiator", fields: [initiatorId], references: [id])
  promptVersion     PromptVersion?        @relation(fields: [promptVersionId], references: [id])
  accessCode        ContributorCode?      @relation("GroundAccessCode", fields: [accessCodeId], references: [id])
  participants      GroundParticipant[]
  checkIns          CheckIn[]
  reportRounds      ReportRound[]
  reportNotices     ReportNotice[]
  report            Report?
  weeklyReports     WeeklyReport[]
  patternDetections PatternDetection[]
  resolution        Resolution?
  /// Groundwork's suggestions from a verdict, about someone in this check-in (C3, U.13).
  suggestions       Suggestion[]
  outcome           Outcome?
  outcomeFeedback   OutcomeFeedback[]
  billingEvents     BillingEvent[]
  documents         GroundDocument[]
  personObjectives  PersonObjective[]
  baselineEntries   GroundBaselineEntry[]
  setupSignOffs     GroundSetupSignOff[]
  leadContextNotes  LeadContextNote[]
  leadSetupWords    LeadSetupWords?
  commitments       GroundCommitment[]
  contextItems      GroundContextItem[]
  planProposals     PlanProposal[]
  pastesTaken       GroundPaste[]
  reportActivations ReportActivation[]
  roundCompletions  RoundCompletion[]
  objectives        GroundObjective[]
  gaps              CheckInGap[]
  /// Whether people on this check-in see each other's numbers. Narrow unless somebody chose
  /// otherwise: a default that publishes is not a default.
  whoSeesTargets    WhoSeesTargets        @default(THEIR_OWN) @map("who_sees_targets")

  /// WHETHER BEING BLOCKED IS EXPECTED TO COME WITH HAVING TRIED.
  ///
  /// "People get lazy, they don't nudge people to unblock them and they don't follow up." Stated by
  /// a chief of staff, and true of most work most of the time - so this is on by default and the
  /// conversation asks what was actually done before a blocker is recorded as one.
  ///
  /// It can be turned off, and the cases are real rather than theoretical: a cohort of new starters
  /// with no standing to chase anybody, an external party who cannot escalate inside somebody
  /// else's company, a crisis check-in where the point is to hear what happened and not to coach.
  /// Asking somebody what they tried, when trying was never theirs to do, is the fastest way to
  /// make a check-in feel like an interrogation.
  expectThemToUnblock        Boolean                     @default(true) @map("expect_them_to_unblock")
  dependencies               GroundDependency[]
  workMentions               WorkMention[]
  workItems                  WorkItem[]
  poll                       GroundPoll?
  participantRequests        ParticipantRequest[]
  contributorCodeRedemptions ContributorCodeRedemption[]
  // Versioned targets. A goal change is a new chapter, not an overwrite.
  baselines                  GroundBaseline[]
  participantNotes           ParticipantNote[]
  /// Who accepted or declined this ground, and when. Null on a ground that never
  /// needed accepting - an admin's own, or one created before the gate existed.
  approvedById               String?                     @map("approved_by_id")
  approvedAt                 DateTime?                   @map("approved_at")
  /// Why it was declined, in the admin's words. Shown to whoever created it.
  declineReason              String?                     @map("decline_reason") @db.Text
  deliveries                 Delivery[]
  documentsElsewhere         DocumentElsewhere[]
  reportedFigures            ReportedFigure[]
  differences                Difference[]
  agreements                 Agreement[]
  assertions                 Assertion[]
  parties                    GroundParty[]
  obligations                Obligation[]

  @@index([organizationId])
  @@index([status])
  /// A ground SUMMONED against an imported objective. Declared here as well as created in SQL,
  /// because an index Prisma does not know about is one the next generated migration drops.
  @@index([organizationId, subjectExternalId])
  @@map("grounds")
}

// WHAT A PERSON WAS LAST ASKED TO DO, AND WHAT HAPPENED TO IT.
//
// Coaching is one small step, then a wait, then the next step chosen from what
// actually happened. That only works if the step survives between sessions, so
// this is the memory the whole mechanic rests on.
//
// PRIVATE BY CONSTRUCTION. One row per person per ground, readable only by that
// person. It never reaches a report, a board, or a lead, and it must never be
// reachable from a resolution: a firing is the ultimate verdict on a person and
// this product does not produce verdicts. If somebody reviewing the code could
// wire this into a termination justification, the wall is not built right.
// People would never answer honestly again if their own coaching could be used
// against them.
// WHAT THE GROUND WAS AIMING AT, AND WHEN THAT CHANGED.
//
// Real work does not hold still: priorities shift, a project's definition of
// done moves, a hire's role is redefined. The coach must not keep coaching
// toward a superseded goal, and must never read the period before a pivot as
// failure against a bar that did not exist yet.
//
// That needs the target to be VERSIONED rather than overwritten. A goal change
// is a new chapter with a marked transition, never an erasure of the old one:
// effort toward the old goal stays real, and banked success stays banked.
//
// HARD GUARDRAIL: a goal change must never become a way to erase somebody's
// record or to manufacture failure. "The goal changed" cannot wipe a win and
// cannot declare anyone behind.
model GroundBaseline {
  id       String @id @default(uuid())
  groundId String @map("ground_id")
  ground   Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  // Sequential. Version 1 is what the ground was created with.
  version          Int     @default(1)
  // What success looks like, in the lead's own words, at this version.
  successLooksLike String? @map("success_looks_like")
  // What has to be true for it to be reachable.
  conditions       Json?
  // Why it changed, if they said. Never inferred, never invented.
  changeReason     String? @map("change_reason")
  /// DECISION 63, 30 September 2026: set only when stating this version was done by an admin
  /// standing in because the lead had left the organisation. See who-may-confirm-setup.ts.
  confirmedByAdminNote String? @map("confirmed_by_admin_note") @db.Text

  // When this version took effect. Everything before it belongs to the last one.
  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([groundId, version])
  @@index([groundId])
  @@map("ground_baselines")
}

model CoachingState {
  id            String            @id @default(uuid())
  participantId String            @unique @map("participant_id")
  participant   GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  // The single step last given. One at a time, never a list.
  currentStep       String? @map("current_step")
  // Which session it was given in, so the next one can open on it.
  stepGivenAt       Int?    @map("step_given_at")
  // Which staircase they are on, and how far up.
  staircase         String?
  staircasePosition Int     @default(0) @map("staircase_position")
  // Prior steps and what became of them: done, not done, did more, sideways.
  //
  // Kept because "you have not managed this twice" is the moment to shrink the
  // step or change tack, and without the history the coach repeats itself at
  // somebody, which is the failure this mechanic exists to avoid.
  history           Json?
  // What the last observation read: noticed, lookingLike, reason, the session, the outcome of the
  // last step. Kept so the first outputs can be read against the input that produced them.
  lastInput         Json?   @map("last_input")
  // Every observation ever made, one per session: { sessionNumber, noticed, reason }. Recurrence is
  // what makes a pattern; a step is offered only when the same thing was seen in two sessions.
  observations      Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("coaching_states")
}

model GroundParticipant {
  /// Things a check-in asked this person for and did not get. See CheckInGap.
  gaps                       CheckInGap[]
  /// Board targets that are this person's own. See GroundObjective.ownerParticipantId.
  objectivesOwned            GroundObjective[] @relation("ObjectiveOwner")
  whatWorked                 WhatWorked[]
  id                         String            @id @default(uuid())
  groundId                   String            @map("ground_id")
  /// The SHA-256 of the lower-cased address this link had before the account was erased. Erasure
  /// rewrites `email` to a deleted-... placeholder, which was the only key the retention sweep had,
  /// so an erased person's raw turns outlived the window (fix plan A16). The sweep matches this too.
  erasedFrom                 String?           @map("erased_from")
  userId                     String?           @map("user_id") // null until they accept the invite
  email                      String
  partyType                  PartyType
  // The lead chose "managing only" at confirm-lead: they oversee the ground but
  // never give their own account. Only ever true for an INITIATOR row. They are
  // NOT created a session-1 check-in and are excluded from the readiness count
  // in isSessionReadyForReport - otherwise the ground would wait forever on an
  // account that will never come. See grounds.service.ts confirmLead/isSessionReadyForReport.
  managingOnly               Boolean           @default(false) @map("managing_only")
  roleAsDescribed            String?           @map("role_as_described") // role as the initiator described it
  /// What the lead wrote when they added this person: what they are accountable for, in the lead's
  /// own words. It used to go into the invite email and nowhere else, so the one statement of what
  /// somebody was taken on to do was not on the record the reports read.
  remitAsGiven               String?           @map("remit_as_given") @db.Text
  /// WHO PUT THIS PERSON ON THE CHECK-IN: the lead, or the admin who set it up for them (U.4).
  /// Read by the door rule (participants/nobody-joins-your-company-by-being-invited-to-a-check-in.ts):
  /// somebody an admin of this organisation added does not wait for an admin. The rule used to ask the
  /// person who RUNS the check-in, so four people an admin added to a check-in she set up for a lead
  /// were all held for approval. Null on older rows and on doors with no adder (an open link), where
  /// the rule falls back to the person who runs it, as before. An id, not a relation: the adder may
  /// leave, and the row must not.
  addedByUserId              String?           @map("added_by_user_id")
  /// Whether they came in through the open link rather than being put on a roster. Recorded rather
  /// than inferred: `invitedAt` is set on a link respondent immediately, the `@unclaimed.invalid`
  /// address is replaced when they finish, and a null `userId` is also true of somebody invited who
  /// has not signed in. See an-open-link-has-no-roster.
  cameThroughTheLink         Boolean           @default(false) @map("came_through_the_link")
  /// THE NAME THEY GAVE. Somebody who answers through an open link has no sign-in and so no User
  /// row to carry a name; this is the name they typed at the end, beside where to send the report.
  /// Read wherever a first name would be. Hafsah, 22 Sep 2026: "we need to have the names of the
  /// people and their emails so we can release the report to them."
  nameGiven                  String?           @map("name_given") @db.VarChar(120)

  /// THE ORGANISATION THEY ANSWERED FOR. Same story as `nameGiven` and asked in the same breath:
  /// somebody answering an open link has no account, so nothing else on this row can say which
  /// company, institute or fund the answer is about. On a check-in run across a network - a hundred
  /// separate organisations on one link - that is the unit the whole report is about, and it was
  /// not being collected at all. Hafsah, 23 Sep 2026: "Name / Organisation / Email."
  organisationGiven          String?           @map("organisation_given") @db.VarChar(160)
  /// Whether they asked for the report. Null where nobody asked them (invited by the lead); true or
  /// false where the open link asked at the end. The release goes to those who said yes.
  wantsTheReport             Boolean?          @map("wants_the_report")
  /// Optional, never inferred, never guessed from an address; blank means blank. Captured beside the
  /// role at every door that adds a person (fix plan E2). A person with no department is in no
  /// department, which is "no scope", never "everyone's".
  department                 String?           @db.VarChar(120)
  /// The language this person writes in, ISO 639-1 (ha, sw, en). Read from their first message when
  /// nothing on the roster said. The conversation happens in it; the record stays in English.
  language                   String?           @db.VarChar(8)
  invitedAt                  DateTime?         @map("invited_at")
  /// WHEN THEY ACCEPTED THE INVITATION (Hafsah, 13 October 2026: "count someone as missed only if they joined
  /// the check-in (accepted the invitation) and then never opened a session"). Written when they press Join on
  /// their invitation or come in through the check-in's own join link. Being able to sign in, or having seen the
  /// welcome, is not accepting: a sign-in can exist before anybody accepts. See grounds/invited-not-joined-yet.ts.
  acceptedAt                 DateTime?         @map("accepted_at")
  notifiedAt                 DateTime?         @map("notified_at") // never added silently
  // Mirror of the LATEST invite-kind EmailDelivery status for this participant
  // (SENT | DELIVERED | BOUNCED | COMPLAINED) - written by the Resend webhook.
  inviteDeliveryStatus       String?           @map("invite_delivery_status")
  // Magic-link invite (cleared once accepted; userId is set on accept).
  inviteToken                String?           @unique @map("invite_token")
  inviteTokenExpiresAt       DateTime?         @map("invite_token_expires_at")
  /// The two stamps of the invite-expiry sweep (grounds.cron.ts), so each mail goes once.
  inviteExpiryWarnedAt       DateTime?         @map("invite_expiry_warned_at")
  inviteLapsedToldAt         DateTime?         @map("invite_lapsed_told_at")
  /// When this person last asked the lead for more time on a check-in that ran out (U.3, "Ask Wairimu
  /// for more time"). Once a day, so a lead is not flooded by one person pressing again.
  moreTimeAskedAt            DateTime?         @map("more_time_asked_at")
  // Rolling specificity scores (Agent 1) used for trust calibration / tone.
  specificityHistory         Float[]           @default([]) @map("specificity_history")
  lastNudgedAt               DateTime?         @map("last_nudged_at") // throttles reminder emails (B1)
  /// ADDED, BUT WAITING FOR A SEAT BEFORE ANYBODY WRITES TO THEM.
  ///
  /// Every plan is priced by team size, and adding somebody to a check-in used to be refused
  /// outright the moment the account was full - which stops the lead's work for a reason the lead
  /// usually cannot fix, since the person who can upgrade is somebody else. Walked on a real org,
  /// the opposite also happened: the org-level cap was never checked on this path at all, so seven
  /// people ended up on a plan the product said covered five.
  ///
  /// So a person over the cap is ADDED and not written to. The row exists, the lead can see who is
  /// on the check-in and that they are waiting, and the invitation goes out the moment an admin
  /// makes room. Nothing reaches the person until then: an invitation to a check-in they cannot
  /// open is worse than silence.
  awaitingSeat               Boolean           @default(false) @map("awaiting_seat")
  /// THE WAY OUT OF BEING CHASED. The invitation tells somebody they can simply ignore it, and
  /// then the reminders arrive anyway - so the mail carries a link that needs no login and this
  /// is where it lands. Deliberately NOT a decision about taking part: their invitation still
  /// works and nothing is recorded against them, because "stop reminding me" and "no" are two
  /// different sentences and only one of them is theirs to be asked for.
  /// See conversation/ignoring-it-should-be-enough.ts.
  remindersStoppedAt         DateTime?         @map("reminders_stopped_at")
  /// Long and random, minted the first time we write to them and kept afterwards - the invite
  /// token is cleared on accept, and the reminders outlive it.
  stopRemindersToken         String?           @unique @map("stop_reminders_token")
  /// When they were last told they have missed three rounds in a row. The absence reminder used to
  /// fire on one exact day, so nothing needed to remember it; now that a passed day is still due,
  /// this is what stops the same person being told every morning. Null means never told.
  absenceToldAt              DateTime?         @map("absence_told_at")
  soloArtifact               String?           @map("solo_artifact") @db.Text // single-party record summary after session 1 (B2)
  soloArtifactAt             DateTime?         @map("solo_artifact_at")
  soloArtifactShared         Boolean           @default(false) @map("solo_artifact_shared") // whether participant chose to share their individual report
  // Explicit "my account is accurate, I'm done" confirmation. Corrections
  // (startSelfCorrectionSession) remain possible after this is set - it does
  // not block them - but any correction session started afterward is stamped
  // CheckIn.isPostSignOff so it surfaces as a flagged, visible update rather
  // than silently reshaping a record the other party may have already seen.
  signedOffAt                DateTime?         @map("signed_off_at")
  // Which function map reads this person fairly (SALES, PRODUCT, ENGINEERING, ...).
  // Detection is CONTINUOUS, not a tag set once: the stated role is only a starting
  // prior, and the engine revises this from what the person's work is actually made
  // of over sessions. Someone titled "product manager" whose account is all
  // coordination and clearing blockers reads as functionally PROJECT_MANAGEMENT.
  // Confidence stays low until the pattern is consistent, and a low-confidence
  // profile must not be coached from - see role-maps.ts.
  // WHEN THEY ARRIVED, WENT AWAY, AND LEFT.
  //
  // The three-period rule is only fair while every period was one this person
  // was present for and able to answer in. Without dates the engine cannot tell
  // "said nothing" from "was not there", and the naive read is unkind in every
  // direction: a joiner is behind for weeks before they existed here, somebody
  // on parental leave accrues "went quiet", and a person who has left keeps
  // being coached and keeps being read.
  //
  // See participation-timeline.ts, which is the arithmetic these feed.
  joinedAt                   DateTime?         @map("joined_at") // null = present from the start
  /// WHEN THIS PERSON'S WORK STARTS, WHICH IS NOT WHEN THEY JOINED THE GROUND.
  ///
  /// Five situations are set up about somebody before they begin: a hire whose first day is next
  /// month, an advisor whose year has not opened, a manager taking over on the first. Agreeing what
  /// good looks like BEFORE anybody can be judged against it is the point of those grounds.
  ///
  /// `joinedAt` cannot carry it. The joiner HAS joined the ground - they were named at setup and have
  /// a check-in waiting. What they have not done is started the job. Without this, a period before
  /// their first day is indistinguishable from a period they were present for and went quiet in, and
  /// every read built on countable periods counts it against them.
  ///
  /// Null means the work was already underway, which is true of every row that existed before it.
  startsAt                   DateTime?         @map("starts_at")
  leftAt                     DateTime?         @map("left_at") // quit, removed, or let go. Freeze, never erase.
  // Authorized absence: the DATES ONLY.
  //
  // The engine must never store, infer, or surface the REASON. Medical,
  // parental, bereavement, sabbatical: none of it is the engine's business, all
  // of it is a liability, and "on leave" is the entire fact it needs. Shape is
  // [{ from, to }], to null while still away.
  leavePeriods               Json?             @map("leave_periods")
  coachingState              CoachingState?
  detectedFunction           String?           @map("detected_function")
  detectedFunctionConfidence Float?            @map("detected_function_confidence")
  detectedFunctionAt         DateTime?         @map("detected_function_at")
  /// A role guessed with low confidence is confirmed before it is used (decision 57, item 5). Set
  /// once the person confirms or corrects it in their own check-in, or the lead confirms or changes
  /// it on the Context page — by a userId, so it is always plain who. Until this is set, a read
  /// below LOW_CONFIDENCE_CONFIRM_THRESHOLD is never used for a role-tuned probe or coaching
  /// strategy (see function-detection.ts, needsRoleConfirmation); only the role-agnostic universal
  /// floor applies.
  detectedFunctionConfirmedAt DateTime?        @map("detected_function_confirmed_at")
  detectedFunctionConfirmedBy String?          @map("detected_function_confirmed_by")
  // THE COFOUNDER INTAKE IS GONE. Twelve free-text columns lived here -
  // founding/role/personal/exit intent, compensation/autonomy/recognition/
  // growth/relationship asks, financial floor, stress and relational tolerance -
  // each up to 4000 characters.
  //
  // They were written by a PATCH route, from a client function no page ever
  // called, and read by nothing: no report, no board, no prompt. The single
  // apparent reader was `hasIntake = !!foundingIntent`, which was returned to
  // the client and consumed by nothing either.
  //
  // So the schema stood ready to store someone's salary floor and how much
  // stress they can take, in a column no feature opened. Unused personal data is
  // not neutral - it is a liability that grows quietly, and this is a product
  // whose landing page makes promises about what happens to what people tell it.
  // The engine already learns this in conversation, where it is probed, evidenced
  // and visible to the person in their own record.
  createdAt                  DateTime          @default(now()) @map("created_at")

  ground                  Ground                   @relation(fields: [groundId], references: [id], onDelete: Cascade)
  user                    User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  checkIns                CheckIn[]
  recordEntries           RecordEntry[]
  notes                   ParticipantNote[]
  patternDetections       PatternDetection[]
  outcomeFeedback         OutcomeFeedback[]
  documents               GroundDocument[]
  personObjectives        PersonObjective[]
  leadContextNotes        LeadContextNote[]
  commitments       GroundCommitment[]
  contextItems      GroundContextItem[]
  resolutionConfirmations ResolutionConfirmation[]
  /// Groundwork's suggestions about this person (C3, U.13). See Suggestion.
  suggestionsAboutThem    Suggestion[]             @relation("SuggestionAbout")
  reportActivations       ReportActivation[]
  dependenciesFrom        GroundDependency[]       @relation("DependencyFrom")
  dependenciesOn          GroundDependency[]       @relation("DependencyOn")
  mentionsMade            WorkMention[]            @relation("MentionSource")
  mentionsAbout           WorkMention[]            @relation("MentionAbout")
  deliveries              Delivery[]
  documentsElsewhere      DocumentElsewhere[]

  @@unique([groundId, email])
  @@index([groundId])
  @@map("ground_participants")
}

// ---------------------------------------------------------------------------
// Conversation — each party checks in INDEPENDENTLY. Never cross-readable.
// ---------------------------------------------------------------------------

/// ONE SESSION OF A GROUND. What a user calls a check-in is `Ground`; a `CheckIn` row is one
/// person's one session of it, numbered by `sessionNumber`. The naming guards exempt the data model
/// on purpose - renaming this model is a much larger change than the one-word rule is worth - so
/// the fact is stated here, where the next reader meets it (fix plan B13).
model CheckIn {
  id            String @id @default(uuid())
  groundId      String @map("ground_id")
  participantId String @map("participant_id")
  sessionNumber Int    @map("session_number") // 1, 2, ...

  /// WHAT WE HAVE SO FAR: the typed record of what this conversation has established - claims with
  /// their measure, number, baseline, verification, owner, date and place, any contradictions
  /// between them, who we are talking to, and how many answers and remarks there have been.
  ///
  /// The conversation had none of this. It had the brief's items in a list and asked the next one,
  /// which is why 626 questions across a hundred conversations followed the brief's wording rather
  /// than anything anybody said. Everything that challenges, decomposes or asks a derived question
  /// reads from here, and the HOLES are computed in code rather than stored, so a requirement is
  /// decided in exactly one place. See what-we-have-so-far.ts.
  whatWeHave    Json?  @map("what_we_have")

  /// THIS PERSON'S ANSWERS, PUT INTO THE FIELDS A COMPLETE ANSWER HOLDS.
  ///
  /// The frame says what every answer must contain; this is what THIS answer contained, in the same
  /// shape as everybody else's, so a hundred conversations become a hundred rows that can be
  /// counted. Written when they finish, because that is when there is a whole answer to read and it
  /// costs one call rather than a hundred at once when the report runs.
  ///
  /// `couldNotSay` is kept apart from a blank on purpose: somebody who says they have no way to
  /// check a new supplier has answered the question, and twenty-nine of those is the product
  /// specification. See fitting-an-answer-into-the-frame.ts.
  theirAnswerFitted Json? @map("their_answer_fitted")

  /// GW-EXP-6. A SETUP CONVERSATION, NOT A SESSION.
  ///
  /// The lead's expectation-setting interview. It exists because a managing-only lead - somebody who
  /// runs a check-in and gives no account of their own - got no check-in at all, so nothing ever asked
  /// them what they expect of anybody and every expectation feature was dead for those grounds.
  ///
  /// It is NOT an account and must never be counted as one: not in "n of m sessions done", not in
  /// overdue, and never as testimony about the lead. Marked rather than inferred, because the thing it
  /// is excluded from is arithmetic in six places and a flag is checkable where a convention is not.
  isSetup                     Boolean       @default(false) @map("is_setup")
  /// SKILL or CONFIDENCE, where the person said as much about themselves IN THIS CHECK-IN. The
  /// classification and never the sentence: the shared report must be able to say "they said so
  /// themselves" without any surface but this one ever touching the transcript. See
  /// they-said-why-themselves.ts, and the bright line in no-surveillance.spec.ts that put it here.
  saidWhy                     String?       @map("said_why")
  status                      CheckInStatus @default(NOT_STARTED)
  availableFrom               DateTime?     @map("available_from") // cadence gate — session 2+ opens after this date
  startedAt                   DateTime?     @map("started_at")
  completedAt                 DateTime?     @map("completed_at")
  warningFiredAt              DateTime?     @map("warning_fired_at")
  sessionReadyNotifiedAt      DateTime?     @map("session_ready_notified_at") // one-shot: "your check-in is now open" email sent
  openedAnnouncedAt           DateTime?     @map("opened_announced_at") // one-shot: checkin.opened went to the organisation's webhooks
  patternsAnalyzedAt          DateTime?     @map("patterns_analyzed_at") // pattern sweep has processed this period
  closedReason                String?       @map("closed_reason") // "declined" or "auto_closed"; null when the person completed it
  /// One of managed | vague | directional | specific, worst first - enforced by a CHECK constraint in
  /// the database and ordered in one place (conversation/how-checkable-a-session-was.ts). The map that
  /// ranked "managed" above "directional" is gone.
  specificityLevel            String?       @map("specificity_level")
  /// Where the questions this session was given to work from came from, as plain keys such as
  /// "situation:PERFORMANCE", "role:ENGINEERING" or "pattern:D1". Written when the plan is made, and
  /// read only by the learning counts (week 8b), which set it beside how specific the answers were.
  /// Keys of the product's own questions, never anybody's words.
  probeSources                String[]      @default([]) @map("probe_sources")
  /// When scoring was TRIED. Set with a null level means the scorer failed; null means not scored yet.
  /// The two used to be one silence, and the report said "nobody was asked" about a fault of ours.
  specificityScoredAt         DateTime?     @map("specificity_scored_at")
  specificityDimensions       Json?         @map("specificity_dimensions")
  /// THE REPORT AS THE PERSON SAW IT WHEN THEY FINISHED.
  ///
  /// "I want the exact same forming report to be openable. I have not seen it anywhere, when I
  /// click it sends me back to the chat and the report looks nothing like what I got at the end."
  ///
  /// It looked nothing like it because it was gone. The entry flow built a full report - what we
  /// heard from you, how complete your account is, what is still open, where this leaves you - and
  /// wrote it into `GroundParticipant.soloArtifact`, the column `buildSoloArtifact` owns and
  /// overwrites about twenty seconds later with its own two-field summary. The screen the person
  /// remembered was destroyed by a background job, and what they opened afterwards was the
  /// replacement.
  ///
  /// So it gets its own home, on the session it belongs to. Whole and unedited, exactly the shape
  /// the screen rendered, so opening it later renders the same thing rather than a near-miss.
  sessionReport               Json?         @map("session_report")
  isClarification             Boolean       @default(false) @map("is_clarification") // true when session is correcting a flagged inference
  clarificationTarget         String?       @map("clarification_target") // inference id from report.inferences being corrected
  isSelfCorrection            Boolean       @default(false) @map("is_self_correction") // true when session is correcting the participant's OWN prior session
  closeHeldAt                 DateTime?     @map("close_held_at") // set once, the one time the close was held for a date, a number or a document
  /// The plan for this session, written by the product before the first question from everything the record
  /// holds about this person: what must be established, the questions in order, what to watch for, the coaching
  /// path, when it is done. Context for every turn, never a script. See the-plan-for-this-session.
  sessionPlan                 Json?         @map("session_plan")
  selfCorrectionTargetSession Int?          @map("self_correction_target_session") // the session number being corrected
  // True when this self-correction session was started AFTER the participant
  // had already signed off (GroundParticipant.signedOffAt). Not a block - just
  // a flag so the shared report can surface it as "updated after sign-off"
  // instead of blending it in as if it had always been there.
  isPostSignOff               Boolean       @default(false) @map("is_post_sign_off")
  // Closing-round marker: same conversation, flagged final - the person is
  // told to document thoroughly and the final report reads the whole arc.
  isFinal                     Boolean       @default(false) @map("is_final")
  /// THE LEAD'S CHECK-IN IS OPTIONAL (decision 133). True on every check-in of the lead (the INITIATOR row):
  /// after their first check-in the lead checks in only when they choose, and a session they skip is never
  /// counted as missed. Counts such as the missed check-ins pattern leave an optional row out unless it was answered.
  optional                    Boolean       @default(false)
  /// WHY THEY MISSED (decision 136). The reason a person gave, in their own words, for missing their check-ins, kept on the
  /// latest missed session. Served only to the person and to the lead of this check-in, beside the lead's line.
  missedReason                String?       @map("missed_reason") @db.Text
  missedReasonAt              DateTime?     @map("missed_reason_at")
  createdAt                   DateTime      @default(now()) @map("created_at")

  ground        Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant   GroundParticipant  @relation(fields: [participantId], references: [id], onDelete: Cascade)
  turns         ConversationTurn[]
  recordEntries RecordEntry[]
  workMentions  WorkMention[]
  /// WHEN THE LEAD WAS TOLD THIS ONE NEVER STARTED.
  ///
  /// Set once, after the chasing has finished with the person. Without it the
  /// lead hears the same names every morning, which is the chase moved one person
  /// along rather than an end to it.
  leadToldAt    DateTime?          @map("lead_told_at")

  @@unique([participantId, sessionNumber])
  @@index([groundId])
  @@map("check_ins")
}

model ConversationTurn {
  id        String   @id @default(uuid())
  checkInId String   @map("check_in_id")
  role      TurnRole
  content   String   @db.Text
  stage     String? // which conversation stage produced this turn
  /// WHAT THIS TURN ASKED OF SOMEBODY: 'evidence', 'reflection', or null for neither.
  ///
  /// Stamped when the turn is written so the balance between two parties can be counted WITHOUT
  /// ever reading one person's turns while answering another. That distinction is the whole reason
  /// this column exists rather than a query: an AI turn carries the person's own words reflected
  /// back at them, so loading Fay's turns into Eli's request is loading Fay's account into Eli's
  /// session, and the guard on check-in-scoped turn loads is right to refuse it. A count is not
  /// content; this makes the count available without the content.
  askedFor  String?  @map("asked_for")
  /// TWO TO FOUR SHORT ANSWERS THE PERSON MIGHT GIVE TO THIS TURN'S QUESTION (task 2.6, screens
  /// request 7a). Built from the question and their own last answer only. Stored so they survive a
  /// reload. Null for a turn that asks nothing. See conversation/suggested-answers.ts.
  suggestedAnswers Json? @map("suggested_answers")
  /// THE END CARD, ON THE TURN THAT CLOSED THE CONVERSATION (task 2.7, screens request 7b): what is
  /// now in the person's record and how each line is known. Served to that person only, on the
  /// transcript. See conversation/the-end-card.ts.
  endCard     Json? @map("end_card")
  /// THE RECORD LINES THE CARD WAS BUILT FROM, NOT YET WRITTEN. Nothing reaches record_entries until
  /// the person finishes; then exactly these are written, unless they said more after the card.
  /// Never served to anybody.
  recordDraft Json? @map("record_draft")
  createdAt DateTime @default(now()) @map("created_at")

  checkIn CheckIn @relation(fields: [checkInId], references: [id], onDelete: Cascade)

  @@index([checkInId])
  @@map("conversation_turns")
}

/// A note somebody deliberately wrote for other people who get stuck on the same thing. It is here
/// rather than lifted out of a check-in on their behalf: a team of twelve solves the same problem
/// twelve times, and the fix is not to harvest what works from the people it works for. See
/// what-worked-for-somebody-else.ts for why every obvious version of this is a league table.
model WhatWorked {
  id              String   @id @default(uuid())
  organizationId  String   @map("organization_id")
  /// The participant who wrote it, so it can be removed by them and nobody else.
  byParticipantId String   @map("by_participant_id")
  /// Their name at the time of writing. Shown, because they wrote it for other people to read and
  /// a tip from nobody cannot be asked a follow-up question.
  byName          String   @map("by_name")
  /// What they were stuck on, in their words. Matching happens on this.
  about           String   @db.Text
  /// What they did, in their words. Never a summary: a summary of a method is not the method.
  what            String   @db.Text
  offeredAt       DateTime @default(now()) @map("offered_at")

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  byParticipant GroundParticipant @relation(fields: [byParticipantId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("what_worked")
}

model RecordEntry {
  id            String          @id @default(uuid())
  participantId String          @map("participant_id")
  checkInId     String?         @map("check_in_id")
  type          RecordEntryType

  /// HOW CHECKABLE THIS LINE IS. A COLUMN, BECAUSE IT WAS LIVING IN THE TEXT.
  ///
  /// It was stamped on the front of `text` as "[VERIFIABILITY:HIGH] ..." with a comment saying why:
  /// "the RecordEntry schema does not yet have a dedicated column - this preserves the signal
  /// without a migration." A reasonable IOU, and it came due twice: once under people's names on
  /// the board, and once inside the line a lead is shown when accepting a number off the record -
  /// in code written the same evening. Every reader had to remember to strip it, and the fifth
  /// reader did not.
  ///
  /// Null on every row written before this column, and those still carry the marker in their text;
  /// the readers parse it as a fallback. New rows keep the text clean, which is what actually ends
  /// the leak: a marker that is not in the text cannot be printed by a reader who forgot.
  verifiability        Verifiability?
  text                 String         @db.Text // the person's exact words where possible
  recallBased          Boolean        @default(true) @map("recall_based") // false = anchored to a document
  anchoredDocumentId   String?        @map("anchored_document_id") // the uploaded document that backs this line, when one does
  anchoredPassage      String?        @map("anchored_passage") @db.Text // the document's words that back it, quoted short, so a false match can be seen
  anchoredOrigin       String?        @map("anchored_origin") @db.VarChar(24) // the backing document's origin, so generated notes do not count as a source
  documentSays         String?        @map("document_says") @db.Text // when a document they can see states the same thing differently: what it says, quoted short
  documentSaysId       String?        @map("document_says_id") // which document
  dimensionThreadKey   String?        @map("dimension_thread_key") // groups entries across sessions by theme
  anchored_question_id String?        @map("anchored_question_id") // which verbatim question produced this entry
  createdAt            DateTime       @default(now()) @map("created_at")
  /// Set by the person this row is about when they say it is not what they said. A disputed row stays
  /// on the record and stops counting toward every read. See the-wall-between-said-and-extracted.
  disputedAt           DateTime?      @map("disputed_at")
  /// True only when this line is the person's own words: its text appears, as one unbroken passage,
  /// in what they typed in this check-in (forgiving only capitals, spacing, end punctuation and curly
  /// or straight marks). A line the record reader tidied, joined or bracketed stays false. A report
  /// may only quote a line that is true. See reports/a-quote-is-what-they-said.
  saidWordForWord      Boolean        @default(false) @map("said_word_for_word")
  /// CONFIRMED BY THE PERSON WHO RECEIVED IT (week 6, the prototype's mark in B4 one-session.txt and
  /// team-report.txt). Set when the colleague who was waiting on this work says, in their own check-in,
  /// that it is no longer in their way, and this is the line that says it was delivered. Never set by
  /// the person themselves, and never by a departure. See conversation/confirmed-by-who-received-it.ts.
  confirmedAt              DateTime? @map("confirmed_at")
  confirmedByParticipantId String?   @map("confirmed_by_participant_id")

  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Restrict)
  checkIn     CheckIn?          @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([participantId])
  @@map("record_entries")
}

// ---------------------------------------------------------------------------
// Delivery board objects (SHARED-mode grounds only).
//
// The board is a delivery-shaped rendering of the delivery-relevant parts of
// the report. These models hold the things the report itself does not: the
// frame the lead set, the handoffs between people, the meeting record, and the
// availability poll. Everything else the board shows is derived from data that
// already exists (check-ins, record entries, the report, patterns).
//
// All of these are read-only on the board with one exception: the availability
// poll, because availability is logistics and never touches an account.
// ---------------------------------------------------------------------------

// A target the lead set. The board shows progress against these.
// HOW TO TALK TO ONE PERSON, REMEMBERED ACROSS GROUNDS.
//
// An eighteen-ground org run found the same colleague met as a stranger five
// times. One participant asked what a "ground" was in five separate grounds and
// got a good plain answer in each; the product never once remembered he asked.
//
// WHAT THIS DELIBERATELY DOES NOT HOLD: anything anyone said. No topics, no
// accounts, no ground names, no outcomes. A ground is a closed container - a
// person speaking to two colleagues in one and seven in another has to be able
// to trust that the two do not leak into the seven. Carrying content across
// would break the only promise the product really makes, and would mean someone
// on a performance plan in March has it following them into a cohort in June.
//
// So this holds only HOW to speak to them: do they need the vocabulary
// explained, do they answer in a line, have they asked who reads this. Style,
// never substance. Everything here could be shown to the person it describes
// without embarrassment, which is the bar it has to clear.
model PersonStyleProfile {
  id             String @id @default(uuid())
  userId         String @map("user_id")
  organizationId String @map("organization_id")

  // They asked what a product term meant. Explain plainly, do not assume.
  needsPlainLanguage Boolean @default(false) @map("needs_plain_language")
  // They answer briefly. Ask one thing at a time and expect short replies.
  answersBriefly     Boolean @default(false) @map("answers_briefly")
  // They have asked who reads this. Say so early, without being asked again.
  asksWhoReadsThis   Boolean @default(false) @map("asks_who_reads_this")
  // How many grounds they have taken part in. Orientation only.
  groundsSeen        Int     @default(0) @map("grounds_seen")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("person_style_profiles")
}

/// WHETHER PEOPLE SEE EACH OTHER'S NUMBERS.
///
/// Ten salespeople each saw all ten targets on their own first screen, and nobody decided that: it
/// fell out of the brief being a shared fact and a target being a board object. Both answers are
/// defensible - plenty of sales floors put the whole board on the wall on purpose - and neither
/// should be an accident of how the data is modelled. See whose-number-is-whose-business.ts.
enum WhoSeesTargets {
  THEIR_OWN
  EVERYBODY
}

/// SOMETHING A CHECK-IN ASKED FOR AND DID NOT GET.
///
/// The conversation asks for what the record is missing. Where somebody will not or cannot answer,
/// it is recorded here and let go rather than pressed - decided, because a person who feels
/// cornered gives compliant answers and those are worse than missing ones.
///
/// It stays open across rounds and closes the moment they answer it, in this round or a later one.
/// The lead sees an open gap on their own page; nobody sees a gap as a mark against anybody.
model CheckInGap {
  id            String    @id @default(uuid())
  groundId      String    @map("ground_id")
  participantId String    @map("participant_id")
  /// The slot's stable id, so a gap recorded in round one is the same gap in round six.
  slug          String
  /// What the record was missing, in the words the product uses about it. Never a question.
  what          String    @db.Text
  /// How many times it has been asked for. Past the limit the conversation stops asking.
  asked         Int       @default(1)
  /// WHETHER WE CAN ACTUALLY TELL THAT IT WAS NOT ANSWERED.
  ///
  /// Most slots are proved from the record: an entry of the right kind exists or it does not. A few
  /// have no type yet - what a goal sits under, whether two teams overlap - so the conversation can
  /// ask but nothing can confirm the answer, and they would otherwise sit open for ever against
  /// somebody who answered in their first sentence. Watched happen to a lead who had just said the
  /// group target was 120 million and why it mattered.
  ///
  /// False means: this was asked and we cannot tell. The lead is told that, rather than told they
  /// did not answer.
  certain       Boolean   @default(true)
  /// The round it was first recorded in, so a lead can see how long it has been open.
  firstRound    Int       @map("first_round")
  answeredAt    DateTime? @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, slug])
  @@index([groundId, answeredAt])
  @@map("check_in_gaps")
}

/// Which way is good for a target (decision 69), as one of the prototype's five kinds (decision 75, item 17).
/// AIM is "Up" (an aim to reach), LIMIT is "Lower is better" (a limit not to go over), RATE is a share or
/// ratio over a period to keep at or above its number, DEADLINE is a date to meet (`dueOn`), and ZERO is a
/// count to keep at zero, where any at all is a breach.
enum TargetDirection {
  AIM
  LIMIT
  RATE
  DEADLINE
  ZERO
}

model GroundObjective {
  id       String @id @default(uuid())
  groundId String @map("ground_id")
  name     String
  target   Int? // null = a qualitative objective, tracked but not counted

  /// WHOSE NUMBER THIS IS, WHERE IT IS SOMEBODY'S.
  ///
  /// A board target was the whole check-in's: "paying companies", "first response under four
  /// hours". Watched with a real team, a chief of staff set ten of them - one per salesperson,
  /// summing to the number committed to the board - and the product had nowhere to say which was
  /// whose. So every rep saw all ten, the board could not say where any one person stood, and the
  /// only read a manager wanted, ten rows against ten numbers, could not be built at all.
  ///
  /// Null keeps the original meaning and is still the common case: a target for the whole thing,
  /// belonging to nobody in particular.
  ownerParticipantId String? @map("owner_participant_id")
  /// THE LEAD SAYS PLAINLY WHEN THIS TARGET IS A DECISION ABOUT A PERSON (decision 46, 29 September
  /// 2026), never guessed from its wording.
  ///
  /// `whose-number-is-whose-business.ts` used to test the target's `name` against a pair of regular
  /// expressions ("decide", "confirm", "probation") to keep a decision like "Decide whether to
  /// confirm Aisha in her role" off everybody's board but the lead's - a guess, and every guess here
  /// is either a false positive that hides an ordinary team target from people who should see it, or
  /// a false negative that puts a decision about somebody's place on their own check-in. Hafsah: this
  /// is a field the lead sets when the target is made, set by the lead alone, never inferred.
  ///
  /// False on every row that existed before this column - existing targets are not guessed at either;
  /// they stay false until a lead marks one. `targetsFor` (whose-number-is-whose-business.ts) reads
  /// this instead of the old wording guess: a target with it set is shown to the check-in's lead and
  /// nobody else, whoever else is reading and whatever `whoSeesTargets` says.
  isADecisionAboutAPerson Boolean @default(false) @map("is_a_decision_about_a_person")
  /// AN AIM TO REACH, OR A LIMIT NOT TO GO OVER, SAID BY THE LEAD (decision 69, 1 October 2026).
  ///
  /// The board used to guess this from the words in the name ("budget", "within", "no more than"), and
  /// a guess read "Pumps sold under the new scheme" as a ceiling. Hafsah: each target carries a
  /// direction, set when the target is made. The words in the name can suggest it, and the lead
  /// confirms it. Null means not set: nobody has confirmed it yet, and the board keeps today's
  /// word-based guess (a-measure-that-goes-down-is-still-going-well.ts) until the lead sets one.
  /// The suggestion is never stored here; only what the lead confirmed is.
  direction TargetDirection?
  /// THE DATE TO MEET, for a target whose kind is DEADLINE (decision 75, item 17). Set by the lead, never
  /// read from the name. Null on every other kind, and on a deadline nobody has given a date for yet.
  dueOn     DateTime? @map("due_on") @db.Date
  /// Who SAID this target, when it came out of a check-in rather than the setup form. A target the
  /// lead set for a person is put to that person as the lead's expectation; one they set themselves
  /// is theirs. Without this the two read the same and a rep was asked about "the N4m gap that the
  /// opener set as your objective" (adversarial run, 20 Sep 2026). Null: set on the form at setup.
  setByParticipantId String? @map("set_by_participant_id")

  /// WHAT THE TARGET ASSUMES, ONE THING PER LINE: "6 reps each close about 4 sales." A target that
  /// does not say what it rests on cannot be given a second look when one of those things stops
  /// being true. Written by the lead; empty until somebody says. Read by whoever may read the target.
  assumes String[] @default([])

  /// WHAT THE RECORD SAYS THIS NUMBER IS, WHERE SOMEBODY REPORTED IT.
  ///
  /// The board already had the screen for this - "The record shows 40 for this, not 0. Use 40" -
  /// and a rule behind it that never once fired. It needed every word of the target's name to
  /// appear in one sentence plus a verb from a list of nine, and then it suggested the NUMBER OF
  /// MATCHING SENTENCES rather than the number somebody said. Run against a real quarter: the team
  /// reported "nine of the forty teams are migrated" and then "all forty migrated by Friday", and
  /// the board read 0 of 40 at the close. Zero of fourteen entries matched.
  ///
  /// So the reading is the model's - which sentence reports a number against which target, and what
  /// the number is - written once when a round closes, and the lead still accepts it in one press.
  /// Nothing here overwrites what a person set: this is a suggestion beside their number, and that
  /// rule was right and stays.
  suggestedCount     Int?    @map("suggested_count")
  /// The sentence it was read from, so the lead can see what they are accepting rather than a bare
  /// number from nowhere.
  suggestedSaid      String? @map("suggested_said") @db.Text
  /// The round it was read from, so a stale suggestion can be told from this week's.
  suggestedAtSession Int?    @map("suggested_at_session")

  // Snapshot of the count at the previous session, so the board can show the
  // delta ("+2 this session") without recomputing history every read.
  prevCount      Int      @default(0) @map("prev_count")
  count          Int      @default(0)
  // A dimension the lead ADDED mid-phase. A new target means nothing until
  // people have checked in against it, so the board flags it as new and shows
  // who has been asked and who has not.
  addedAtSession Int?     @map("added_at_session")
  sortOrder      Int      @default(0) @map("sort_order")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  ground    Ground                    @relation(fields: [groundId], references: [id], onDelete: Cascade)
  owner     GroundParticipant?        @relation("ObjectiveOwner", fields: [ownerParticipantId], references: [id], onDelete: SetNull)
  snapshots GroundObjectiveSnapshot[]

  @@index([groundId])
  @@index([ownerParticipantId])
  @@map("ground_objectives")
}

/// AN OBJECTIVE'S COUNT AS IT STOOD WHEN A ROUND CLOSED. Written by recordRoundCompletion, one row per
/// objective per round. "Moved this session" is the difference between two of these; with only one it
/// is not known, and says so, rather than reporting the lifetime total as this session's movement.
model GroundObjectiveSnapshot {
  id            String   @id @default(uuid())
  groundId      String   @map("ground_id")
  objectiveId   String   @map("objective_id")
  sessionNumber Int      @map("session_number")
  count         Int
  takenAt       DateTime @default(now()) @map("taken_at")

  objective GroundObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([objectiveId, sessionNumber])
  @@index([groundId, sessionNumber])
  @@map("ground_objective_snapshots")
}

enum DependencyStatus {
  BLOCKING
  WAITING
  CLEARED
}

/// WHAT KIND OF THING IS IN THE WAY, WHICH THE RECORD COULD NOT SAY.
///
/// A handoff knew who was waiting on whom and not what for. "We cannot ship because hardware is
/// delayed" and "both parts exist and the integration fails" and "this was known four weeks ago and
/// nobody raised it" are three different situations with three different people who can fix them,
/// and all three read identically as one person waiting on another. So the argument was settled by
/// whoever described it best.
///
/// SAID BY THE PERSON WAITING, ABOUT THEIR OWN WORK, like everything else on a handoff. Nobody
/// classifies somebody else's blocker.
enum BlockerKind {
  /// The thing does not exist yet on the other side.
  NOT_BUILT
  /// Both parts exist and do not work together.
  INTEGRATION
  /// What the two sides agreed the interface would be has changed.
  CONTRACT_CHANGED
  /// It cannot be tried: no rig, no environment, no access.
  CANNOT_TEST
  /// Somebody has to decide and has not.
  DECISION
  /// It was known early enough to plan around and was not raised. The only one that is about how
  /// the work was managed rather than about the work, which is why it is never inferred - it is
  /// recorded when the person waiting says so, and never derived from dates.
  SEEN_COMING
}

//
// A handoff between two people, extracted from a check-in when someone names a
// dependency. This is the board's real differentiator: the critical path is not
// who is behind, it is what is blocked on whom.
//
// Extracted from the OWN account of the person who is waiting (fromParticipant).
// Never created by one person asserting something about another's obligations
// without it appearing in their own account of their own work.
//
model GroundDependency {
  /// What kind of thing is in the way. Null is the ordinary state: most people describe a blocker
  /// without classifying it, and an unclassified blocker is still a blocker.
  blockerKind       BlockerKind? @map("blocker_kind")
  id                String       @id @default(uuid())
  groundId          String       @map("ground_id")
  fromParticipantId String       @map("from_participant_id")
  onParticipantId   String?      @map("on_participant_id") // null = waiting on someone/something outside the ground
  onLabel           String?      @map("on_label") // free text when the blocker is not a participant
  what              String       @db.Text // "the sales deck", "paying-user pricing"

  /// DID THIS PERSON NAME THE THING, OR ONLY SAY THEY WERE STUCK?
  ///
  /// Two different rows read the same in the database and mean opposite things to a reader.
  /// "Waiting on someone else, been a few weeks" is a real handoff whose subject was never named -
  /// the row belongs on the board, and the sentence "is waiting for waiting on someone else" does
  /// not. "Nobody has told us how this connects to anything" is a complaint the extraction should
  /// not have taken at all.
  ///
  /// WHY A COLUMN AND NOT A RULE OVER `what`. We had the rule: `namesWhatIsWaitedOn` reads the text
  /// against two word lists. It answers "how this connects to anything" wrong, and the only way to
  /// fix that is a longer list of words, then a longer one - an arms race against English. Whether
  /// somebody named the thing they are waiting on is a reading of what they said, which is the
  /// model's job, so the model is asked and the answer is kept. Code then uses it for shape and
  /// counting, which is code's job.
  ///
  /// NULL IS UNKNOWN, not false: every row written before this column existed has one, and the
  /// readers fall back to the word-list rule for those rather than calling them all unnamed.
  namedTheThing   Boolean?         @map("named_the_thing")
  // What happens once this clears. The board shows this so a handoff reads as a
  // consequence, not just a status.
  then            String?          @db.Text
  status          DependencyStatus @default(WAITING)
  /// Stamped once, the first time this handoff crosses the waiting threshold and is escalated.
  /// The column is what makes the sweep fire once rather than every night for as long as the
  /// handoff stays open - a nightly repeat of the same alert is how a customer learns to filter
  /// the channel, which costs them the alert that mattered.
  /// WHAT THEY SAID THEY HAD ACTUALLY DONE ABOUT IT, in their own words.
  ///
  /// A handoff knew who was waiting on whom and, later, what for. It never knew whether anybody had
  /// tried. Watched live: "I emailed finance twice, no answer" - three weeks on a blocker, and
  /// nothing in the record could tell that from somebody who had called, escalated and been
  /// refused. Their sentence, kept as they said it; the tiering is read off it at the point of use
  /// so the words stay the record and the judgement stays out of the column.
  triedSaid       String?          @map("tried_said") @db.Text
  escalatedAt     DateTime?        @map("escalated_at")
  sourceCheckInId String?          @map("source_check_in_id")
  /// THE OTHER CHECK-IN THIS HANDOFF WAITS ON (D3, U.16), when it waits on another team's check-in.
  ///
  /// Written by the engine, which is the one that can tell that "Finance" in Miriam's check-in is
  /// the Finance check-in (docs/requests-to-engine.md, request 18). Null is the ordinary state: most
  /// handoffs wait on somebody in the same check-in, or on something outside the organisation.
  ///
  /// Read by `CheckInLinksService` only, which shows each reader a link only from a check-in they
  /// may already open. A plain id, not a relation: a second relation to Ground would rename the
  /// existing one, and a check-in that is gone simply stops being one anybody may open.
  waitingOnGroundId String?        @map("waiting_on_ground_id")
  /// WHEN, IN THE PERSON'S OWN WORDS ("by Friday", "next week"), word for word and never rewritten.
  /// Kept only when those exact words are in what they said. Null when they gave no time.
  dueSaid           String?        @map("due_said") @db.Text
  /// The calendar day those words meant, read in code from `dueSaid` and the day it was said. Null
  /// when the words do not name a day ("soon", "after the audit"): a date is never guessed.
  dueOn             DateTime?      @map("due_on") @db.Date
  clearedAt       DateTime?        @map("cleared_at")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  ground          Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  fromParticipant GroundParticipant  @relation("DependencyFrom", fields: [fromParticipantId], references: [id], onDelete: Cascade)
  onParticipant   GroundParticipant? @relation("DependencyOn", fields: [onParticipantId], references: [id], onDelete: SetNull)

  @@index([groundId])
  /// The escalation sweep asks for open handoffs not yet escalated, oldest first. Declared here as
  /// well as created in SQL - an index Prisma does not know about is one the next generated
  /// migration drops.
  @@index([status, escalatedAt, createdAt])
  /// "Asked of this check-in by other teams" reads by the check-in being waited on.
  @@index([waitingOnGroundId])
  @@map("ground_dependencies")
}

// Why a piece of someone else's work showed up in this person's account.
enum WorkMentionKind {
  // Credit: this account says the other person moved something. Feeds the
  // hidden-contribution read - the quiet load-bearer whose own account is modest.
  CREDIT
  // Coverage: this account describes doing work that sits in the other person's
  // remit. Feeds "where work is landing".
  COVERAGE
  // Named as a blocker. Explains coverage rather than counting as it.
  BLOCKED_BY
}

// A resolved, ID-level reference from one person's account to ANOTHER
// participant's work.
//
// This exists because matching on first names is not good enough to carry a read
// about a person: it false-positives on common names, misses anyone referred to
// differently, and cannot tell crediting someone from covering for them. Both
// "where work is landing" and the hidden-contribution read need a precise answer
// to "whose work did this account reference, and in what sense", so it is
// resolved once, at extraction time, and stored as participant ids.
//
// sourceParticipant is whose account it appeared in; aboutParticipant is whose
// work it concerns. A name that does not resolve to a participant is DROPPED,
// never guessed - a wrong attribution here is worse than a missing one.
model WorkMention {
  id                  String          @id @default(uuid())
  groundId            String          @map("ground_id")
  sourceParticipantId String          @map("source_participant_id")
  aboutParticipantId  String          @map("about_participant_id")
  checkInId           String?         @map("check_in_id")
  sessionNumber       Int             @default(1) @map("session_number")
  kind                WorkMentionKind
  // The referenced work in the source's own words. Counted and summarised in the
  // product's words; never shown to the person it is about.
  text                String          @db.Text
  createdAt           DateTime        @default(now()) @map("created_at")

  ground            Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  sourceParticipant GroundParticipant @relation("MentionSource", fields: [sourceParticipantId], references: [id], onDelete: Cascade)
  aboutParticipant  GroundParticipant @relation("MentionAbout", fields: [aboutParticipantId], references: [id], onDelete: Cascade)
  checkIn           CheckIn?          @relation(fields: [checkInId], references: [id], onDelete: SetNull)

  @@index([groundId])
  @@index([aboutParticipantId])
  @@map("work_mentions")
}

//
// Availability poll. THE ONLY thing anyone adds on the board, because
// availability is logistics and never touches an account.
//
model GroundPoll {
  id        String   @id @default(uuid())
  groundId  String   @unique @map("ground_id")
  question  String
  createdAt DateTime @default(now()) @map("created_at")

  ground  Ground             @relation(fields: [groundId], references: [id], onDelete: Cascade)
  options GroundPollOption[]

  @@map("ground_polls")
}

model GroundPollOption {
  id        String   @id @default(uuid())
  pollId    String   @map("poll_id")
  label     String
  // GroundParticipant ids who marked themselves available for this option.
  whoIds    String[] @default([]) @map("who_ids")
  sortOrder Int      @default(0) @map("sort_order")

  poll GroundPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@index([pollId])
  @@map("ground_poll_options")
}

// ---------------------------------------------------------------------------
// The Report — the shared picture. Released to BOTH parties simultaneously.
// ---------------------------------------------------------------------------

/// WHEN A REVIEW FALLS DUE SOMEWHERE ELSE.
///
/// Groundwork does not evaluate anybody and this does not make it start. It is
/// our note of a date held in the customer's own system — a probation end, an
/// annual cycle — so that the record this product already produces can arrive
/// BEFORE the conversation rather than after it.
///
/// Its own table rather than a column on `Person`, for two reasons. `Person` is
/// a mirror of their directory and this is not in their directory; and a date
/// needs to say where it came from, which a column cannot.
model EvaluationDue {
  id               String @id @default(uuid())
  organizationId   String @map("organization_id")
  personExternalId String @map("person_external_id")

  /// The day the review happens. A date, not a timestamp — nobody's probation
  /// ends at 14:32, and a time would imply a precision the source does not have.
  dueOn DateTime @map("due_on") @db.Date
  /// What kind of review, in the customer's own word for it. Not an enum: their
  /// vocabulary, and a closed set here would refuse a company that calls it
  /// something else.
  kind  String

  /// Where the date came from, so a wrong one can be traced rather than argued
  /// about. The name of the system, or the person who typed it.
  source String

  /// Set when the manager has been told, so nobody is told twice about one
  /// review. Cleared by nothing — a second reminder is a second row.
  notifiedAt DateTime? @map("notified_at")

  createdAt DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, personExternalId, dueOn, kind])
  @@index([organizationId, dueOn, notifiedAt])
  @@map("evaluations_due")
}

model Report {
  id              String    @id @default(uuid())
  groundId        String    @unique @map("ground_id")
  sharedPicture   String    @map("shared_picture") @db.Text
  /// THE OPENING, ON ITS OWN, BECAUSE THE BOARD USED TO TAKE THE FIRST THREE SENTENCES.
  ///
  /// `how-a-check-in-is-going` built the board's summary by slicing `sharedPicture` - so every
  /// board in the twenty-four-scenario run led with the report's glued opening, which is problem 12
  /// of twelve. The opening is now written once, as plain sentences, and kept here so the board can
  /// read the sentence rather than guess at where it ends.
  ///
  /// Null on every report written before this column, and on any whose wording call fell back.
  theOpening      String?   @map("the_opening") @db.Text
  agreements      Json // where both accounts agree
  divergences     Json // the gap — never framed as one side being right
  centralQuestion String    @map("central_question") @db.Text
  engagement      Json? // engagement-quality + confidence header: per-party session counts, % document-backed, coverage band (B4)
  inferences      Json? // array of { id, text, participantId, sessionNumber } — items the AI inferred rather than directly quoted
  promptVersionId String?   @map("prompt_version_id")
  finalSynthesis  Json?     @map("final_synthesis") // closing-round report: per-goal arc lines, tier, end-state framing
  // Where a manager's account of how they led differs from a report's account
  // of how they were led. Produced by the same synthesis that finds divergences,
  // so it is stated as a gap and never quotes either side.
  leadershipGaps  Json?     @map("leadership_gaps")
  /// A HUNDRED ACCOUNTS ARE NOT TWO. The second read, written beside the alignment one where enough
  /// separate organisations answered for "where are they going and how do the kinds differ" to be a
  /// real question. Null on an ordinary two- or three-person check-in. See
  /// a-hundred-accounts-are-not-two.ts for its shape and for what it is forbidden to invent.
  networkPicture  Json?     @map("network_picture")

  /// THE JUDGEMENT OVER EVERY ANSWER: the gap, what the counts say, what to do about it, what this
  /// data cannot tell anybody, and what we failed to ask.
  ///
  /// Two customers read a report that listed what people said and called it worthless: "it did not
  /// classify things or assess or recommend well", "too abstract, talked in parables". Classifying
  /// and assessing are arithmetic over the fitted answers and no model touches them. Only the last
  /// part is written, and it is handed nothing but the table of counts, with every sentence required
  /// to carry a number that is in it - checked in code. See the-judgement-over-the-answers.ts.
  theJudgement    Json?     @map("the_judgement")
  /// Commitments, dependencies, patterns, gaps and what is still open, across every session.
  /// Arithmetic over rows: no model writes it and no model can leave it out.
  overTime        Json?     @map("over_time")
  /// How many people had answered when this report was last written. A report that is behind the
  /// answers says so, and a cron goes back for the ones who came after. Null on reports written
  /// before the column existed.
  builtFromAnswers Int?     @map("built_from_answers")
  /// The table the judgement was written from, kept so a reader can see the counts behind a
  /// sentence, and so the whole thing can be laid out as rows and columns. If it cannot be, we
  /// built a newsletter.
  theTable        String?   @map("the_table") @db.Text

  /// HOW THE ORGANISER CHOSE TO SHARE IT: 'NAMED' or 'ANONYMOUS'. Null until it is sent to anybody.
  /// The product never decides this - see whatTheRespondentsGet.
  sharedAs        String?   @map("shared_as") @db.VarChar(16)

  /// A discovery session's direction, read once at release and kept. It was computed on every read
  /// and, at twenty-four accounts, timed out on every read (adversarial run, 20 Sep 2026).
  direction       Json?
  /// The finding per person, written by the product from the record: purpose, standing, the lead's number
  /// against their own, worries, gaps. The half of the picture no guard can cut to a platitude. See
  /// the-finding-per-person.
  findings        Json?
  arcSignals      Json?     @map("arc_signals") // deterministic F1-F5 features per party (advisory surface reads this)
  releasedAt      DateTime? @map("released_at") // set once, atomically, for both
  /// EACH SESSION'S TEAM PICTURE IS RELEASED ON ITS OWN (decision 76, item 4). `releasedAt` says when
  /// the report was first shared, and it is set once. This says which sessions' pictures have been
  /// shared since, so a participant reads the team's picture only of a session that has been
  /// released, never a later one as the report grows into it. Empty until anything is released.
  /// See reports/each-sessions-picture-is-released-on-its-own.ts.
  releasedSessions Int[]    @default([]) @map("released_sessions")
  createdAt       DateTime  @default(now()) @map("created_at")
  /// WHEN THIS WAS LAST WRITTEN, WHICH IS NOT WHEN THE ROW WAS MADE.
  ///
  /// The report page compares the report's age against the newest completed check-in to decide
  /// whether somebody is reading a stale version, and it had only `createdAt` to compare against.
  /// Regeneration upserts this row rather than replacing it, so that timestamp stays at first
  /// generation for ever: the moment anybody checks in again, "someone has checked in since this
  /// was written, you are reading the previous version" becomes permanently true. Seen on a real
  /// check-in still showing that banner over a report that had already refreshed correctly - and
  /// the page polls every five seconds for as long as it believes it.
  updatedAt       DateTime  @updatedAt @map("updated_at")

  ground        Ground         @relation(fields: [groundId], references: [id], onDelete: Cascade)
  promptVersion PromptVersion? @relation(fields: [promptVersionId], references: [id])

  @@map("reports")
}

// ---------------------------------------------------------------------------
// Participant requests — suggested by existing participants to the initiator
// ---------------------------------------------------------------------------

enum ParticipantRequestStatus {
  PENDING
  APPROVED
  DISMISSED
}

model ParticipantRequest {
  id               String                   @id @default(uuid())
  groundId         String                   @map("ground_id")
  requestedByEmail String                   @map("requested_by_email")
  requestedEmail   String                   @map("requested_email")
  requestedName    String?                  @map("requested_name")
  reason           String                   @db.Text
  status           ParticipantRequestStatus @default(PENDING)
  createdAt        DateTime                 @default(now()) @map("created_at")

  ground Ground @relation(fields: [groundId], references: [id], onDelete: Cascade)

  @@index([groundId])
  @@map("participant_requests")
}

// ---------------------------------------------------------------------------
// Pattern detection — behavioural signals, NEVER verdicts. Three-period rule.
// ---------------------------------------------------------------------------

model PatternDetection {
  id               String        @id @default(uuid())
  groundId         String        @map("ground_id")
  participantId    String        @map("participant_id")
  code             String // D1..D8, B1..B12, K/E/R/F codes — see Part 4
  periodsObserved  Int           @default(1) @map("periods_observed")
  /// Every period this was actually observed in, gaps included. `periodsObserved` is the CONSECUTIVE
  /// run; this is the honest history, and three of these surfaces a pattern whether they touch or not.
  seenInSessions   Int[]         @default([]) @map("seen_in_sessions")
  lastPeriodNumber Int?          @map("last_period_number") // session number of the most recent period; enforces consecutiveness
  status           PatternStatus @default(CANDIDATE)
  observationText  String?       @map("observation_text") @db.Text // plain language, never a score
  // Accuracy feedback: did the admin or participant confirm this was accurate?
  accuracyRating   Boolean?      @map("accuracy_rating") // true = accurate, false = inaccurate, null = not yet rated
  ratedAt          DateTime?     @map("rated_at")
  ratedBy          String?       @map("rated_by") // userId of rater
  /// When it had been seen in three periods, which is when the person it is about may first read it.
  /// Set once by the detector and never moved, so the clock for the lead cannot be pushed back by
  /// a fourth sighting. See patterns/who-reads-a-pattern.
  readyAt          DateTime?     @map("ready_at")
  /// When the person it is about was first served it on their own page. The lead reads it only
  /// after this (and their answer, or three days), or a week after readyAt if they never open it.
  shownToPersonAt  DateTime?     @map("shown_to_person_at")
  /// What the person said is behind it, in their own words ("Say what's behind it"). Read by the
  /// person and, beside the pattern, by whoever runs the check-in. Never by a colleague.
  personAnswer     String?       @map("person_answer") @db.Text
  personAnsweredAt DateTime?     @map("person_answered_at")
  /// After talking a pattern through, the lead marks it right, wrong or not sure (decision 57, item
  /// 2). The person's own answer above counts as evidence too. Never shown to the person as a rating
  /// of them, and never to a colleague — only whoever runs the check-in reads it. The existing
  /// `accuracyRating` (platform admin) stays; this is separate.
  leadMark         LeadPatternMark? @map("lead_mark")
  leadMarkedAt     DateTime?        @map("lead_marked_at")
  leadMarkedBy     String?          @map("lead_marked_by") // userId of the lead who marked it
  /// The lead is nudged once to talk a pattern through, and can mark that they did (decision 57, item
  /// 3). The nudge goes away once this is set. The person may see that their lead has talked it
  /// through as a plain fact, never a verdict on them.
  talkedAboutAt       DateTime? @map("talked_about_at")
  talkedAboutBy       String?   @map("talked_about_by") // userId of the lead who marked it
  /// How many periods had been seen (seenInSessions/periodsObserved) at the moment `talkedAboutAt`
  /// was set — the anchor later check-ins derive "seen again after the talk" from, rather than
  /// storing that count itself and having it drift out of step with the honest history.
  talkedAboutAtPeriod Int?      @map("talked_about_at_period")
  /// What backed this detection, decision 57 item 4: the model's own reading, the matching
  /// number-based rule (PATTERN_DETECTORS), or both. 'model' | 'rule' | 'both'. Set when first
  /// observed and kept current as later periods are added — a rule that later agrees moves it from
  /// 'model' to 'both'. Read by the lead only, never the person or a colleague: when it is 'both',
  /// the lead is told "Two separate reads of the record found this." beside the pattern; the rule is
  /// evidence, never shown as an accusation or a score.
  evidenceSource   String?       @map("evidence_source")
  /// Which stored version of the detector's prompt (`pattern_detection`) read the check-in that last
  /// kept this pattern. Empty on rows written before the prompt was stored; those stay valid.
  promptVersionId  String?       @map("prompt_version_id")
  promptVersion    PromptVersion? @relation(fields: [promptVersionId], references: [id])
  firstSeenAt      DateTime      @default(now()) @map("first_seen_at")
  lastSeenAt       DateTime      @default(now()) @map("last_seen_at")
  createdAt        DateTime      @default(now()) @map("created_at")

  ground      Ground            @relation(fields: [groundId], references: [id], onDelete: Cascade)
  participant GroundParticipant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@unique([participantId, code])
  @@index([groundId])
  @@index([code, accuracyRating]) // for per-code accuracy aggregation
  @@map("pattern_detections")
}

/// The lead's own read of a pattern, after talking it through with the person (decision 57, item 2).
/// Never a rating served to the person or a colleague.
enum LeadPatternMark {
  RIGHT
  WRONG
  NOT_SURE
}

// ---------------------------------------------------------------------------
// Resolution — a ground closes only when BOTH parties confirm an end state.
// ---------------------------------------------------------------------------

model Resolution {
  id             String    @id @default(uuid())
  groundId       String    @unique @map("ground_id")
  endState       String    @map("end_state") // latest leading proposal; the agreed end state once closed
  decisionRights Json?     @map("decision_rights")
  /// Why the lead chose this outcome, in their own words (rule 6: a person decides, giving a reason).
  /// Read with the outcome by the people in the check-in and by an admin. Never by anyone else.
  reason         String?   @db.Text
  closedAt       DateTime? @map("closed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  ground        Ground                   @relation(fields: [groundId], references: [id], onDelete: Cascade)
  confirmations ResolutionConfirmation[]

  @@map("resolutions")
}

/// A SUGGESTION FROM A VERDICT, TOLD LIKE A SIGNAL (C3, U.13; decisions rule 6).
///
/// The engine may reach a verdict about one person in a check-in. Nobody ever reads it as a label.
/// The lead reads a suggestion ("Groundwork suggests ..."), with why, what would change it and the
/// person's own answer, and decides, giving a reason. The person reads the facts about their work
/// and the decision with its reasons, and can add their side or appeal. An admin decides an appeal.
///
/// WHAT HAS TO HAPPEN WHEN SOMEBODY LEAVES (E5, the "when someone leaves" suite, U.17): one list for
/// one person's last day, started by an admin, with its four steps in `LeavingStep`. It adds to the
/// product's handover and departures and changes neither: the handover brief is never read here, and
