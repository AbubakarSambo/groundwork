# --- App ---
PORT=3000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4321
FRONTEND_URL=http://localhost:5173
# Post-report guide: per-participant "bridge into the next conversation" coaching.
# Built and proven, but not yet rendered by any UI. OFF by default so it does not
# spend a Gemini call per participant per release into a void. Set to "true" only
# once a client surface shows each participant their guide.
POST_REPORT_GUIDE_ENABLED=true

# The confidence read: what the lead can weigh, and where the picture is thin.
#
# On, as of wave 14. It was written off by default because what sits behind it are
# sentences a person reads about their own record, and if that landed wrong the fix
# had to be one variable rather than a revert with reports already sent.
#
# Turned on after checking the arithmetic against a real closed twelve-session
# ground rather than a fixture. Both parties came back with no soft spots, which is
# the correct answer there - each corroborates the other, the detail moves session
# to session, and the one attached document is actually referred to. Each of the
# three spots was then shown to fire on a shape that deserves it, and the false
# positive Hafsah caught twice - a lead whose account is all targets nobody else
# could corroborate - correctly stays silent.
#
# The parse still refuses everything except the exact string "true".
CONFIDENCE_ENABLED=true

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/groundwork?schema=public"

# --- JWT ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Anthropic (conversation engine, report synthesis, pattern detection) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_MAX_TOKENS=2048

# --- Billing gate ---
# Set to "true" in production to enforce Stripe payment before activating grounds.
# Leave unset (or "false") in development to skip the payment wall.
BILLING_ENABLED=false

# --- Stripe (USD billing) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CARE_FEE_PRICE_ID=price_...   # $20/mo recurring care fee
STRIPE_CARE_FEE_CENTS=2000
STRIPE_SCENARIO_FEE_CENTS=5000       # $50/person/month
STRIPE_CALLBACK_URL=http://localhost:5173/billing/callback

# --- Resend (transactional email) ---
# REQUIRED: get your key from https://resend.com/api-keys
# Without a real key ALL emails (invites, password reset, magic links) are suppressed.
# The placeholder re_... is detected and falls back to console-only logging.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL="Groundwork <noreply@myground.work>"

# --- Google OAuth (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback
