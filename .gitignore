# Dependencies
node_modules/
# also match a node_modules symlink specifically (a symlink is not a
# directory, so the trailing-slash pattern above won't catch it - this
# regressed onto main once already via `git add -A` over a dev symlink)
**/node_modules

# Build output
dist/
.astro/

# Environment
.env
.env.local
.env.production

# Prisma
api/dist/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.sw?

# Logs
*.log
npm-debug.log*

# Live journey-test harness output. Never committed: these are raw transcripts of
# every check-in in a run - 122,000 lines from one eighteen-ground pass - and on a
# real deployment they would be people's own accounts of their work. The harness
# that produces them IS committed; what it produces is not. The written
# assessment is the deliverable, and it is kept.
api/journey/out/
api/journey/out-cohort/
api/journey/org-sim/out/*.json
api/journey/org-sim/out-paid/
api/journey/org-sim/out-verify/

# TypeScript incremental build cache - a local artifact, not source.
# It was tracked, so every typecheck showed up as a file change in every diff.
*.tsbuildinfo
